corAddModelFileAndSectionChoices( "tsmc18" "cor_fmom.scs" '("ff_fmom" "ss_fmom" "tt_fmom" ) )


corAddCorner( "tsmc18" "typ" )
corSetCornerGroupVariant( "tsmc18" "typ" "cor_std_mos.scs" "tt" )

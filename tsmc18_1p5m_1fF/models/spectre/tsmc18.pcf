libId = ddGetObj("tsmc18")
libPath = ddGetObjReadPath( libId )
pcfPath = strcat(libPath "/../models/spectre")
corAddProcess( "tsmc18" pcfPath  "multipleModelLib" )

corAddModelFileAndSectionChoices( "tsmc18" "cor_std_mos.scs" '("ff" "fs" "sf" "ss" "tt" ) )
corAddModelFileAndSectionChoices( "tsmc18" "cor_3v.scs" '("ff_3v" "fs_3v" "sf_3v" "ss_3v" "tt_3v" ) )
corAddModelFileAndSectionChoices( "tsmc18" "cor_m.scs" '("ff_m" "fs_m" "sf_m" "ss_m" "tt_m" ) )

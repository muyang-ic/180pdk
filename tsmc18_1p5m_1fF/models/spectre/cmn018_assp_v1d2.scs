section dio_dnw
// 
// **************************************************************
//                    MODEL OF DNW/PSUB DIODE                   *
// **************************************************************
model dnwpsub diode 
+ level=1                   is=1.40e-6*is_d_dnw       rs=1.0e-10*rs_d_dnw
+ n=1.03*n_d_dnw            bv=14.70                  ibv=1e-3

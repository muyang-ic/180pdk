+ cta=2.25e-3               ctp=1.60e-3               pta=2.80e-3
+ ptp=2.80e-3               tnom=25                   fc=0
+ ns=1.03*n_d_dnw           nz=1.03*n_d_dnw           imax=1e40
+ minr=1e-10                allow_scaling=yes
// 
// **************************************************************
//                     MODEL OF PW/DNW DIODE                    *
// **************************************************************
// 
model pwdnw diode 
+ level=1                   is=1.20e-6*is_d_dnw       rs=1.0e-10*rs_d_dnw
+ n=1.03*n_d_dnw            bv=14.50                  ibv=1e-3
+ isw=1.0e-12*jsw_d_dnw     area=4.0044e-8            pj=8.48e-4
+ cj=6.80e-4*cj_d_dnw       vj=0.585                  mj=0.350
+ cjsw=5.33e-10*cjsw_d_dnw  vjsw=0.585                mjsw=0.235
+ tlev=1                    eg=1.17                   xti=3
+ tbv1=-1*-1.10e-3          trs=3.44e-3               tlevc=1
+ cta=1.0e-3                ctp=1.53e-3               pta=1.4e-3
+ ptp=2.82e-3               tnom=25                   fc=0
+ ns=1.03*n_d_dnw           nz=1.03*n_d_dnw           imax=1e40
+ minr=1e-10                allow_scaling=yes
// 
endsection dio_dnw
 
 

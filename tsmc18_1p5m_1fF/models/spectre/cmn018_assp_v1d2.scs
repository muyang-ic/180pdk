+ / 5.0) * 1e12 + 2 * 0.0373e-15 * (lr * factor + 1.08u) / 5.0 * 1e6)
c5 ( body ne ) capacitor c=mf * (0.0863e-15 * ((lr * factor + 1.08u) * wr * factor 
+ / 5.0) * 1e12 + 2 * 0.0373e-15 * (lr * factor + 1.08u) / 5.0 * 1e6)
model rppoly resistor 
+ l=(lr * factor - dl) * 0.211                        w=mf * (wr * factor - dw)
+ kf=kf_rppolyhri_dis       af=2                      fexp=0.95
+ wdexp=1                      ldexp=1                      
ends rppolyhri_dis
 
endsection disres
 
 

section mos_3vna
// *********************************************************************************************
//                                                                            
//                   *
//                                    3.3V Native NMOS DEVICE MODELS          
//                   *
//                                                                            
//                   *
// *********************************************************************************************
 
 
// *********************************
//        Mismatch   model         * 
// *********************************
 
inline subckt nanch3_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=2.05e-7 dmci=3.15e-007 xw= + 0 + 
+ dxwn_3vna ad=(nf * dmcg + dmci) / factor * (w / nf + xw / factor) as=(nf * dmcg 
+ + dmci) / factor * (w / nf + xw / factor) pd=2 * (nf * dmcg + dmci) / factor + 
+ (nf + 1) * (w / nf + xw / factor) ps=2 * (nf * dmcg + dmci) / factor + (nf + 1) 
+ * (w / nf + xw / factor) nrd=dmcg / factor / nf / (w / nf + xw / factor) nrs=dmcg 
+ / factor / nf / (w / nf + xw / factor) sa=1.00e-05 / factor sb=1.00e-05 / factor 
+ sd=2 * dmcg / factor sca=0e-6 / factor scb=0e-6 / factor scc=0e-6 / factor mismatchflag=mismatchflag_mos_3vna 
+ temp1=parn1_3vna temp2=parn2_3vna fac1=0.791128 * temp1 * sigma + 0.624370 * temp2 
+ * sigma fac2=0.791128 * temp1 * sigma - 0.624370 * temp2 * sigma lef=l * factor 
+ - 1.5e-08 wef=w / nf * factor + 0 geo_fac=1 / sqrt(multi * nf * lef * wef * 1e12) 
+ vthmisn_3vna= - 0.00244288 * geo_fac * fac1 * mismatchflag dlmisn_3vna=0.00137060 
+ * geo_fac * lef * fac2 * mismatchflag dwmisn_3vna= - 0.00137060 * geo_fac * wef 
+ * fac2 * mismatchflag toxmisn_3vna=0.00137060 * geo_fac * toxn_3vna * fac2 * mismatchflag 
nanch3_mac ( n1 n2 n3 n4 ) nanch3 w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ nf=nf sa=sa sb=sb sd=sd sca=sca scb=scb scc=scc
// *** mismatch ***
model nanch3 bsim4  { 
     1: type=n 
+ lmin=1e-005-(dxln_3vna+dlmisn_3vna)                 lmax=0.00090001

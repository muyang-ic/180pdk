// *************************** NW diff(under OD) ***********************************
subckt rnwod_m ( n2 n1 body ) 
parameters lr=1u wr=1u mf=1 factor=1 rsh=r_rnwod_dis dw=0.141u ptc1=3.68e-3 
+ ptc2=9.54e-6 pvc1=2.77e-3 pvc2=2.49e-4 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) 
+ + ptc2 * (pt - 25.0) * (pt - 25.0) 
r1 ( n2 nm ) resistor r=rsh / mf * lr * factor / (4.0 * (wr * factor - dw)) * (1 
+ + pvc1 * abs(v(n2,n1)) + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r2 ( nm nn ) resistor r=rsh / mf * lr * factor / (4.0 * (wr * factor - dw)) * (1 
+ + pvc1 * abs(v(n2,n1)) + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r3 ( nn nx ) resistor r=rsh / mf * lr * factor / (4.0 * (wr * factor - dw)) * (1 
+ + pvc1 * abs(v(n2,n1)) + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
r4 ( nx n1 ) resistor r=rsh / mf * lr * factor / (4.0 * (wr * factor - dw)) * (1 
+ + pvc1 * abs(v(n2,n1)) + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
d1 ( body n2 ) nwdio area=mf * ((wr - dw / factor) * lr / 5.0) pj=mf * ((wr - dw 
+ / factor) + 2.0 * lr / 5.0)
d2 ( body nm ) nwdio area=mf * ((wr - dw / factor) * lr / 5.0) pj=mf * 2.0 * lr 
+ / 5.0
d3 ( body nn ) nwdio area=mf * ((wr - dw / factor) * lr / 5.0) pj=mf * 2.0 * lr 
+ / 5.0
d4 ( body nx ) nwdio area=mf * ((wr - dw / factor) * lr / 5.0) pj=mf * 2.0 * lr 
+ / 5.0
d5 ( body n1 ) nwdio area=mf * ((wr - dw / factor) * lr / 5.0) pj=mf * ((wr - dw 
+ / factor) + 2.0 * lr / 5.0)
ends rnwod_m
 

parameters rend_rpodrpo_dis=0.0000295 + (1.1697e-006) * a1_disres_rpo + (7.6822e-007) 
+ * a2_disres_rpo
parameters dxl_rpodrpo_dis=0e-6 + ( - 7.0544e-009) * a1_disres_rpo + (1.2907e-008) 

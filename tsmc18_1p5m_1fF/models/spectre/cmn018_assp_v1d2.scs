//   *
//             mench3     0.6   10.0           0.22    900      um            
//   *
//           ----------------------------------------------------------       
//   *
//         ( 3.3V Medium Vt NMOS with different geometric and corner models)  
//   *
//                                                                            
//   *
//       12.LIB TT_na                                                         
//   *
//              SS_na                                                         
//   *
//              FF_na                                                         
//   *
//              SF_na                                                         
//   *
//              FS_na                                                         
//   *
//          Model name    length range         width range     unit           
//   *
//                        low     high         low    high                    
//   *
//           ----------------------------------------------------------       
//   *
//             nanch      0.5   20.0           0.22    900      um            
//   *
//           ----------------------------------------------------------       
//   *
//         ( 1.8V native NMOS with different geometric and corner models)     
//   *
//                                                                            
//   *
//       13.LIB TT_3Vna                                                       
//   *
//              SS_3Vna                                                       
//   *
//              FF_3Vna                                                       
//   *
//              SF_3Vna                                                       
//   *
//              FS_3Vna                                                       
//   *
//          Model name    length range         width range     unit           
//   *
//                        low     high         low    high                    
//   *
//           ----------------------------------------------------------       
//   *
//             nanch3     1.2   20.0           0.22    900      um            
//   *
//           ----------------------------------------------------------       
//   *
//         ( 3.3V native NMOS with different geometric and corner models)     
//   *
//                                                                            
//   *
//        14.LIB mc_bip                                                       
//   *
//    ( 1.8V P+/NW/PSUB 10x10, 5x5, and 2x2 vertical PNP bipolar statistical  
//   *
//      model)                                                                
//   *
//                                                                            
//   *
//        15.LIB TT_BIP                                                       
//   *
//               SS_BIP                                                       
//   *
//               FF_BIP                                                       
//   *
//             Model name      emitter area      base area         unit       
//   *
//           ------------------------------------------------------------     
//   *
//               pnp10            10x10            16x16           um^2       
//   *
//               pnp5              5x5             11x11           um^2       
//   *
//               pnp2              2x2              8x8            um^2       
//   *
//               npn10            10x10            16x16           um^2       
//   *
//               npn5              5x5             11x11           um^2       
//   *
//               npn2              2x2              8x8            um^2       
//   *
//           ------------------------------------------------------------     
//   *
//         ( 1.8V P+/NW/PSUB 10x10, 5x5 and 2x2 vertical PNP bipolar and      
//   *
//                N+/PW/DNW  10x10, 5x5  and 2x2 vertical NPN bipolar )       
//   *
//                                                                            
//   *
//       16.LIB TT_BIP3                                                       
//   *
//              SS_BIP3                                                       
//   *
//              FF_BIP3                                                       
//   *
//             Model name      emitter area      base area         unit       
//   *
//           ------------------------------------------------------------     
//   *
//               pnp10_3          10x10            16x16           um^2       
//   *
//               pnp5_3            5x5             11x11           um^2       
//   *
//               pnp2_3            2x2              8x8            um^2       
//   *
//           ------------------------------------------------------------     
//   *
//         ( 3.3V P+/NW/PSUB 10x10, 5x5 and 2x2 vertical PNP bipolar )        
//   *
//                                                                            
//   *
//       17.LIB DIO                                                           
//   *
//         ( 1.8V P+/NW , N+/PW & NW/PSUB diode )                             
//   *
//                                                                            
//   *
//       18.LIB DIO3                                                          
//   *
//         ( 3.3V P+/NW , N+/PW , NW/PSUB & ESD diode )                       
//   *
//                                                                            
//   *
//       19.LIB DIO_M                                                         
//   *
//         ( 1.8V Medium Vt P+/NW , N+/PW & NW/PSUB diode )                   
//   *
//                                                                            
//   *
//       20.LIB DIO_3M                                                        
//   *
//         ( 3.3V Medium Vt P+/NW , N+/PW & NW/PSUB diode )                   
//   *
//                                                                            
//   *
//       21.LIB DIO_DNW                                                       
//   *
//         ( DNWPSUB & PWDNW diode )                                          
//   *
//                                                                            
//   *
//       22.LIB RES                                                           
//   *
//          (2T resist model)                                                 
//   *
//  Model name      structure                                                 
//   *
//  -----------------------------------------                                 
//   *
//   rnod         N+diff w/i silicide W>2um                                   
//   *
//   rnodw        N+diff w/i silicide 0.22um<W<2um                            
//   *
//   rpod         P+diff w/i silicide W>2um                                   
//   *
//   rpodw        P+diff w/i silicide 0.22um<W<2um                            
//   *
//   rnodrpo      N+diff w/o silicide 2um<=W                                  
//   *
//   rpodrpo      P+diff w/o silicide 2um<=W                                  
//   *
//   rnwod        NW diff(under OD)                                           
//   *
//   rnwsti       NW diff(under STI)                                          
//   *
//   rnpo1        N+Poly w/i silicide W>2um                                   
//   *
//   rnpo1w       N+Poly w/i silicide 0.18um<W<2um                            
//   *
//   rppo1        P+Poly w/i silicide W>2um                                   
//   *
//   rppo1w       P+Poly w/i silicide 0.18um<W<2um                            
//   *
//   rnpo1rpo     N+Poly w/o silicide 2um<W                                   
//   *
//   rppo1rpo     P+Poly w/o silicide 2um<W                                   
//   *
//   rm1          Metal 1 with W/S=0.23/0.23                                  
//   *
//   rm2~5        Metal 2 to 5 with W/S=0.28/0.28                             
//   *
//   rm6          Metal 6 with W/S=0.44/0.46                                  
//   *
//   rppolyhri    P-Poly w/o silicide 2um<W                                   
//   *
//                                                                            
//   *
//       23.LIB DISRES                                                        
//   *
//          (3T 5section resist model)                                        
//   *
//                                                                            
//   *
//       25.LIB  MC_BBMVAR                                                    
//   *
//    ( 1.8V /3.3V Standard-Vt NMOS in N-Well varactor statistical model)     
//   *
//                                                                            
//   *
//       26.LIB  TT_BBMVAR                                                    
//   *
//               SS_BBMVAR                                                    
//   *
//               FF_BBMVAR                                                    
//   *
//     ( 1.8V /3.3V Standard-Vt NMOS in N-Well varactor )                     
//   *
//                                                                            
//   *
//       27.LIB MIM                                                           
//   *
//         ( MiM Capacitance model )                                          
//   *
//                                                                            
//   *
//       28.LIB RTMOM                                                         
//   *
//         ( RTMON Capacitance model )                                        
//   *
//                                                                            
//   *
//       29.LIB FMOM                                                          
//   *
//         ( FMOM Capacitance model )                                         
//   *
//                                                                            
//   *
// *****************************************************************************
// ************************    FLAG FOR MISMATCH ******************
// 
//  NOTE: 
//   1. Mismatch effect is included in this model. User can use mismatchflag to 
//  
//      turn on or turn off this effect.
// 
// ***********************************************************************************************
// **********************     FLAG FOR FLICKER NOISE CORNERS SIMULATION  ************************
// 
//  NOTE:
//   1. Transistor
//      noiseflagn=0 for typical, noiseflagn=1 for worstcase, noiseflagn=-1 for 
//  best case
//      noiseflagp=0 for typical, noiseflagp=1 for worstcase, noiseflagp=-1 for 
//  best case
//   2. Resistor
//      rnoiseflag=0 for typical, rnoiseflag=1 for worstcase, rnoiseflag=-1 for 
//  best case
// 
// **********************************************************************************************
// 
// *****************************************************************************
//                                                                            
//   *
//  1)To use these models directly by programming in this style:              
//   *
//                                                                            
//   *
//      .lib 'cmn018_assp_v1d2.scs' model_name                                  
//   *
//                                                                            
//   *
//                                                                            
//   *
//     EX: .lib 'cmn018_assp_v1d2.scs' TT                                       
//   *
//         for typical 1.8V N,PMOS                                            
//   *
//         .lib 'cmn018_assp_v1d2.scs' TT_33              			     *
//         for typical 3.3V N,PMOS                                            
//   *
//   note:                                                                    
//   *
//       corner_name                                                          
//   *
//        TT : typical model for 1.8V devices                                 
//   *
//        SS : Slow NMOS Slow PMOS model for 1.8V devices                     
//   *
//        FF : Fast NMOS Fast PMOS model for 1.8V devices                     
//   *
//        SF : Slow NMOS Fast PMOS model for 1.8V devices                     
//   *
//        FS : Fast NMOS Slow PMOS model for 1.8V devices                     
//   *
//                                                                            
//   *
//        TT_3V : typical model for 3.3V devices                              
//   *
//        SS_3V : Slow NMOS Slow PMOS model for 3.3V devices                  
//   *
//        FF_3V : Fast NMOS Fast PMOS model for 3.3V devices                  
//   *
//        SF_3V : Slow NMOS Fast PMOS model for 3.3V devices                  
//   *
//        FS_3V : Fast NMOS Slow PMOS model for 3.3V devices                  
//   *
//                                                                            
//   *
//        TT_M : typical model for 1.8V devices                               
//   *
//        SS_M : Slow NMOS Slow PMOS model for 1.8V medium vt devices         
//   *
//        FF_M : Fast NMOS Fast PMOS model for 1.8V medium vt devices         
//   *
//        SF_M : Slow NMOS Fast PMOS model for 1.8V medium vt devices         
//   *
//        FS_M : Fast NMOS Slow PMOS model for 1.8V medium vt devices         
//   *
//                                                                            
//   *
//        TT_3M : typical model for 3.3V devices                              
//   *
//        SS_3M : Slow NMOS Slow PMOS model for 3.3V medium vt devices        
//   *
//        FF_3M : Fast NMOS Fast PMOS model for 3.3V medium vt devices        
//   *
//        SF_3M : Slow NMOS Fast PMOS model for 3.3V medium vt devices        
//   *
//        FS_3M : Fast NMOS Slow PMOS model for 3.3V medium vt devices        
//   *
//                                                                            
//   *
//        TT_NA : typical model for 1.8V native NMOS                          
//   *
//        SS_NA : Slow NMOS for 1.8V native NMOS                              
//   *
//        FF_NA : Fast NMOS for 1.8V native NMOS                              
//   *
//        SF_NA : Slow NMOS for 1.8V native NMOS                              
//   *
//        FS_NA : Fast NMOS for 1.8V native NMOS                              
//   *
//                                                                            
//   *
//        TT_3VNA : typical model for 3.3V native NMOS                        
//   *
//        SS_3VNA : Slow NMOS for 3.3V native NMOS                            
//   *
//        FF_3VNA : Fast NMOS for 3.3V native NMOS                            
//   *
//        SF_3VNA : Slow NMOS for 3.3V native NMOS                            
//   *
//        FS_3VNA : Fast NMOS for 3.3V native NMOS                            
//   *
//                                                                            
//   *
//  2)HDIF depends on your layout poly spacer to contact center distance.     
//   *
//    The value listed here is TSMC minimum-rule value. You can change it     
//   *
//    according to your layout.                                               
//   *
//                                                                            
//   *
// ***************************************************************************** 
//  
// *********************************************************************************** 
//     
// *********************** Statistical Model Usage ***********************************
// 
//  Monte Carlo simulation can be done by setting "MONTE=val" in netlist. 
//  It produces a number (val) of randomly generated values. 
//  The following netlist is an example to show how to use statistical model in 
//  
//  HSPICE format for an Idsat 500-trail simulation :
// 
//      .option  nopage nomod
//      +        newtol numdgt=7 relmos=1e-4 absmos=1e-8 relv=1e-4 relvdc=1e-4 
//  ingold=2 gmindc=1e-18
// 
//      .temp 25.000
//      .lib 'cmn018_assp_v1d2.scs' stat
//      .lib 'cmn018_assp_v1d2.scs' MC
// 
//      Vgs g 0 1.0
//      Vss s 0 0
//      Vbs b 0 0
//      Vds1 d1 0 1.0
//      Vds2 d2 0 1.0
//      mdut1 d1 g s b nch w=10u l=0.18u
//      xmdut2 d2 g s b nch_mac w=10u l=0.1u sc=20u wpeflag=1 rgflag=1 mismatchflag=1
//      .op
//      .dc vgs 0 1.000000 1.0000 MONTE=500
//      .end
// 
//  The following netlist is an example to show how to use statistical model in 
//  
//  HSPICE format for an Idsat 25 sample simulation :
// 
//      .option  nopage nomod
//      +        newtol numdgt=7 relmos=1e-4 absmos=1e-8 relv=1e-4 relvdc=1e-4 
//  ingold=2 gmindc=1e-18
// 
//      .temp 25.000
// 
//      Vgs g 0 1.0
//      Vss s 0 0
//      Vbs b 0 0
//      Vds1 d1 0 1.0
//      Vds2 d2 0 1.0
//      mdut1 d1 g s b nch w=10u l=0.18u
//      xmdut2 d2 g s b nch_mac w=10u l=0.1u sc=20u wpeflag=1 rgflag=1
//      .op
//      .dc vgs 0 1.000000 1.0000
//      .lnc 'lhs_svt.spf'
//      .end
// 
// ***********************************************************************************
// *********************** Miamtch Model Usage ***********************************
// 
//  Monte Carlo simulation can be done by setting "MONTE=val" in netlist. 
//  It produces a number (val) of randomly generated values. 
//  The following netlist is an example to show how to use statistical model in 
//  
//  HSPICE format for an Idsat 1000-trail simulation :
// 
//      .option  nopage nomod
//      +        newtol numdgt=7 relmos=1e-4 absmos=1e-8 relv=1e-4 relvdc=1e-4 
//  ingold=2 gmindc=1e-18
// 
//      .temp 25.000
//      .lib 'cmn018_assp_v1d2.scs' TT
// 
//      Vgs g 0 1.8
//      Vss s 0 0
//      Vbs b 0 0
//      Vds1 d1 0 1.8
//      Vds2 d2 0 1.8
//      mdut1 d1 g s b nch w=10u l=0.18u
//      xmdut2 d2 g s b nch_mac w=10u l=0.18u mismatchflag=1
//      .op
//      .dc vgs 0 1.8000000 1.80000 MONTE=1000
//      .end
// *********************************************************************************** 
//     
 
 
section stat_mis 
statistics { 
 mismatch { 
  vary parn1 dist=gauss std=1/1 
  vary parn2 dist=gauss std=1/1 
  vary parp1 dist=gauss std=1/1 
  vary parp2 dist=gauss std=1/1 
  } 
 } 
endsection stat_mis 
 
section stat_mis_3v 
statistics { 
 mismatch { 
  vary parn1_3V dist=gauss std=1/1 
  vary parn2_3V dist=gauss std=1/1 
  vary parp1_3V dist=gauss std=1/1 
  vary parp2_3V dist=gauss std=1/1 
  } 
 } 
endsection stat_mis_3v 
 
section stat_mis_m 
statistics { 
 mismatch { 
  vary parn1m dist=gauss std=1/1 
  vary parn2m dist=gauss std=1/1 
  vary parp1m dist=gauss std=1/1 
  vary parp2m dist=gauss std=1/1 
  } 
 } 
endsection stat_mis_m 
 
section stat_mis_3m 
statistics { 
 mismatch { 
  vary parn1_3M dist=gauss std=1/1 
  vary parn2_3M dist=gauss std=1/1 
  } 
 } 
endsection stat_mis_3m 
 
section stat_mis_na 
statistics { 
 mismatch { 
  vary parn1_na dist=gauss std=1/1 
  vary parn2_na dist=gauss std=1/1 
  } 
 } 
endsection stat_mis_na 
 
section stat_mis_3vna 
statistics { 
 mismatch { 
  vary parn1_3VNA dist=gauss std=1/1 
  vary parn2_3VNA dist=gauss std=1/1 
  } 
 } 
endsection stat_mis_3vna 
 
section stat_mis_bip 
statistics { 
 mismatch { 
  vary par_bjtp1 dist=gauss std=1/1 
  vary par_bjtp2 dist=gauss std=1/1 
  vary par_bjtn1 dist=gauss std=1/1 
  vary par_bjtn2 dist=gauss std=1/1 
  } 
 } 
endsection stat_mis_bip 
 
section stat_mis_res 
statistics { 
 mismatch { 
  vary par_res dist=gauss std=1/1 
  } 
 } 
endsection stat_mis_res 
 
section stat_mis_disres 
statistics { 
 mismatch { 
  vary par_res_dis dist=gauss std=1/1 
  } 
 } 
endsection stat_mis_disres 
 
section stat_mis_mim 
statistics { 
 mismatch { 
  vary par_mim dist=gauss std=1/1 
  } 
 } 
endsection stat_mis_mim 
 
section stat_mis_rtmom 
statistics { 
 mismatch { 
  vary par_mom dist=gauss std=1/1 
  } 
 } 
endsection stat_mis_rtmom 
 
section stat_mis_fmom 
statistics { 
 mismatch { 
  vary par_fmom dist=gauss std=1/1 
  } 
 } 
endsection stat_mis_fmom 
 
 

section setup
parameters noiseflagn=0
parameters noiseflagp=0
parameters ccoflag=1
parameters mismatchflag_mos=1
 
endsection setup
 

section setup_m
parameters noiseflagn_m=0
parameters noiseflagp_m=0
parameters ccoflag_m=1
parameters mismatchflag_mos_m=1
 
endsection setup_m
 

section setup_na
parameters noiseflagn_na=0
parameters ccoflag_na=1
parameters mismatchflag_mos_na=1
 
endsection setup_na
 

section setup_3v
parameters noiseflagn_3v=0
parameters noiseflagp_3v=0
parameters ccoflag_3v=1
parameters mismatchflag_mos_3v=1
 
endsection setup_3v
 

section setup_3m
parameters noiseflagn_3m=0
parameters ccoflag_3m=1
parameters mismatchflag_mos_3m=1
 
endsection setup_3m
 

section setup_3vna
parameters noiseflagn_3vna=0
parameters ccoflag_3vna=1
parameters mismatchflag_mos_3vna=1
 
endsection setup_3vna
 

section setup_bip
parameters mismatchflag_bip=1
endsection setup_bip
 

section setup_res
parameters rnoiseflag_res=0
parameters mismatchflag_res=0
endsection setup_res
 

section setup_disres
parameters rnoiseflag_disres=0
parameters mismatchflag_disres=0
endsection setup_disres
 

section setup_rtmom
parameters mismatchflag_rtmom=0
endsection setup_rtmom
 

section setup_fmom
parameters mismatchflag_fmom=0
endsection setup_fmom
 

section setup_mim
parameters mismatchflag_mim=0
endsection setup_mim
 
// **************************   LIBRARY OF statistical CORNER CASE            
//  ***************************

section stat
parameters random1=0
parameters random2=0
parameters random3=0
parameters random4=0
parameters random6=0
parameters random7=0
parameters random8=0
parameters random9=0
parameters par1=random1
parameters par2=random2
parameters par3=random3
parameters par4=random4
parameters par6=random6
parameters par7=random7
parameters par8=random8
parameters par9=random9

statistics {
    process {
        vary random1 dist=gauss std=1/3
        vary random2 dist=gauss std=1/3
        vary random3 dist=gauss std=1/3
        vary random4 dist=gauss std=1/3
        vary random6 dist=gauss std=1/3
        vary random7 dist=gauss std=1/3
        vary random8 dist=gauss std=1/3
        vary random9 dist=gauss std=1/3
        }
    }
 
endsection stat
 
// *****************************   LIBRARY OF mote carlo CORNER CASE   *******************************

section mc
include "cmn018_assp_v1d2.scs" section=setup
parameters parn1=0
parameters parn2=0

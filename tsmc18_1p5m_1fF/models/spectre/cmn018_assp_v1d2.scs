endsection mc_mim
 
 

section mim
// *************************************************************************************************
//  2) MIM BaseBand CAPACITOR MODEL :
// 
// 
//      ## library files:
//      
//      1. The BB 1.0fF MIM capacitors without Shield are modeled with 2T sub-circuit 
//  'mimcap_1p0_sin'      
// 
//       .subckt mimcap_1p0_sin : Typical model,  
// 
//      2. The BB 1.0fF MIM capacitors without Shield are modeled with 3T sub-circuit 
//  'mimcap_1p0_sin_3t'      
// 
//       .subckt mimcap_1p0_sin_3t : Typical model,  
//       
//      3. The BB 2.0fF MIM capacitors without Shield are modeled with 2T sub-circuit 
//  'mimcap_2p0_sin'      
// 
//       .subckt mimcap_2p0_sin : Typical model,  
// 
//      4. The BB 2.0fF MIM capacitors without Shield are modeled with 3T sub-circuit 
//  'mimcap_2p0_sin_3t'      
// 
//       .subckt mimcap_2p0_sin_3t : Typical model,  
//       
//       
//             Model name                     lt                wt          unit
//                                        low    high       low    high
//             -------------------------------------------------------------------
//             mimcap_1p0_sin              4      30         4      30       um
//             mimcap_1p0_sin_3t           4      30         4      30       um
//             mimcap_2p0_sin              4      30         4      30       um
//             mimcap_2p0_sin_3t           4      30         4      30       um
//             -------------------------------------------------------------------
//             **lt: length dimension of top metal
//             **wt: width dimension of top metal
//             **lt >= wt
//             **lay: metal layer number of stack-up, such as 1P6M, lay=6.
//         The CTM enclosure by CBM with 0.4um/per side is based on the minimum 
//  design rule 
//         for parasitic capacitance pre-simulation in PDK.
//             
// *************************************************************************************************
// *************************** 2 T 1p0 MiM cap ********************************************
subckt mimcap_1p0_sin ( top bottom ) 
parameters lt=10u wt=10u factor=1 mf=1 mismatchflag=mismatchflag_mim geo_fac=1 / 
+ sqrt(mf * lt * factor * wt * factor * 1e12) factmis=0.0181 * geo_fac * par_mim 
+ * mismatchflag cmim_para=(1 + factmis) * ((wt * factor * lt * factor * 1e12 * 
+ 1.025) + 2 * (wt * factor + lt * factor) * 1e6 * 0.2425) * 1e-15 * (1 + (temp 
+ - 25) *  - 5.225e-5 + (temp - 25) ** 2 * 1e-8) 
 
cmim (top bottom) bsource q=cmim_para*(v(top,bottom)+0.5*v(top,bottom)**(2)*6.16e-5+1/3*v(top,bottom)**3*-2.05e-5)*cmimbb_mimfac*mf
 
ends mimcap_1p0_sin
 
// *************************** 3 T 1p0 MiM cap ********************************************
subckt mimcap_1p0_sin_3t ( top bottom gnode ) 
parameters lt=10u wt=10u lay=6 factor=1 mf=1 mismatchflag=mismatchflag_mim geo_fac=1 
+ / sqrt(mf * lt * factor * wt * factor * 1e12) factmis=0.0181 * geo_fac * par_mim 
+ * mismatchflag cmim_para=(1 + factmis) * ((wt * factor * lt * factor * 1e12 * 
+ 1.025) + 2 * (wt * factor + lt * factor) * 1e6 * 0.2425) * 1e-15 * (1 + (temp 
+ - 25) *  - 5.225e-5 + (temp - 25) ** 2 * 1e-8) cox_para=((lt * factor * 1e6 
+ + 0.8) * (wt * factor * 1e6 + 0.8) * 0.005071 + 2 * ((lt * factor * 1e6 + 0.8) 
+ + (wt * factor * 1e6 + 0.8)) * 0.0112) * 1e-15 
 
cmim (top bottom) bsource q=cmim_para*(v(top,bottom)+0.5*v(top,bottom)**(2)*6.16e-5+1/3*v(top,bottom)**3*-2.05e-5)*cmimbb_mimfac*mf
 
cox ( bottom gnode ) capacitor c=cox_para * ((1 / (15.90757 + (4.14141672) * (lay 
+ - 4))) / 0.041337843) * cm5bb_mimfac * mf
// 
ends mimcap_1p0_sin_3t
 
// *************************** 2 T 2p0 MiM cap ********************************************
subckt mimcap_2p0_sin ( top bottom ) 
parameters lt=10u wt=10u factor=1 mf=1 mismatchflag=mismatchflag_mim geo_fac=1 / 
+ sqrt(mf * lt * factor * wt * factor * 1e12) factmis=0.0177 * geo_fac * par_mim 
+ * mismatchflag cmim_para=(1 + factmis) * ((wt * factor * lt * factor * 1e12 * 
+ 1.955) + 2 * (wt * factor + lt * factor) * 1e6 * 0.27) * 1e-15 * (1 + (temp 
+ - 25) *  - 2.94e-5 + (temp - 25) ** 2 * 0e-8) 
 
cmim (top bottom) bsource q=cmim_para*(v(top,bottom)+0.5*v(top,bottom)**(2)*12.8E-5+1/3*v(top,bottom)**3*-5.7E-5)*cmimbb_mimfac*mf
 
ends mimcap_2p0_sin
 
// *************************** 3 T 2p0 MiM cap ********************************************
subckt mimcap_2p0_sin_3t ( top bottom gnode ) 
parameters lt=10u wt=10u lay=6 factor=1 mf=1 mismatchflag=mismatchflag_mim geo_fac=1 
+ / sqrt(mf * lt * factor * wt * factor * 1e12) factmis=0.0177 * geo_fac * par_mim 
+ * mismatchflag cmim_para=(1 + factmis) * ((wt * factor * lt * factor * 1e12 * 
+ 1.955) + 2 * (wt * factor + lt * factor) * 1e6 * 0.27) * 1e-15 * (1 + (temp 
+ - 25) *  - 2.94e-5 + (temp - 25) ** 2 * 0e-8) cox_para=((lt * factor * 1e6 + 
+ 0.8) * (wt * factor * 1e6 + 0.8) * 0.005071 + 2 * ((lt * factor * 1e6 + 0.8) + 
+ (wt * factor * 1e6 + 0.8)) * 0.0112) * 1e-15 
 
cmim (top bottom) bsource q=cmim_para*(v(top,bottom)+0.5*v(top,bottom)**(2)*12.8E-5+1/3*v(top,bottom)**3*-5.7E-5)*cmimbb_mimfac*mf
 
cox ( bottom gnode ) capacitor c=cox_para * ((1 / (15.90757 + (4.14141672) * (lay 
+ - 4))) / 0.041337843) * cm5bb_mimfac * mf
// 
ends mimcap_2p0_sin_3t
 
 
endsection mim
 
 

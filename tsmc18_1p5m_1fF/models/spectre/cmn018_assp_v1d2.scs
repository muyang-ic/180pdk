// *********************************
 
inline subckt pch3_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=2.05e-007 dmci=3.15e-007 xw= + 0 
+ + dxwp_3v ad=(nf * dmcg + dmci) / factor * (w / nf + xw / factor) as=(nf * dmcg 
+ + dmci) / factor * (w / nf + xw / factor) pd=2 * (nf * dmcg + dmci) / factor + 
+ (nf + 1) * (w / nf + xw / factor) ps=2 * (nf * dmcg + dmci) / factor + (nf + 1) 
+ * (w / nf + xw / factor) nrd=dmcg / factor / nf / (w / nf + xw / factor) nrs=dmcg 
+ / factor / nf / (w / nf + xw / factor) sa=1e-005 / factor sb=1e-005 / factor sd=2 
+ * dmcg / factor sca=0e-6 / factor scb=0e-6 / factor scc=0e-6 / factor mismatchflag=mismatchflag_mos_3v 
+ temp1=parp1_3v temp2=parp2_3v fac1=0.801230 * temp1 * sigma + 0.598357 * temp2 
+ * sigma fac2=0.801230 * temp1 * sigma - 0.598357 * temp2 * sigma lef=l * factor 
+ - 1.5e-08 wef=w / nf * factor + 0 geo_fac=1 / sqrt(multi * nf * lef * wef * 1e12) 
+ vthmisp_3v=0.00399735 * geo_fac * fac1 * mismatchflag dlmisp_3v=0.00132084 * geo_fac 
+ * lef * fac2 * mismatchflag dwmisp_3v= - 0.00132084 * geo_fac * wef * fac2 * mismatchflag 
+ toxmisp_3v=0.00132084 * geo_fac * toxp_3v * fac2 * mismatchflag 
pch3_mac ( n1 n2 n3 n4 ) pch3 w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ nf=nf sa=sa sb=sb sd=sd sca=sca scb=scb scc=scc

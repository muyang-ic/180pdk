section bb_mvar
 
// *************************************************************************
//                                                                         *
//                  1.8V IO NMOS in N-Well varactor MODEL                  *
//                                                                         *
// *************************************************************************
subckt nmoscap ( ng nds ) 
parameters lr=1e-6 wr=1e-6 mr=1 factor=1 area=lr * factor * wr * factor * mr pj=2 
+ * wr * factor * mr dt=temp - 25 cgmin=(3.727e-10 * pj + 2.008e-03 * area) * 
+ (1 + 4.84e-5 * dt + 8.53e-7 * dt * dt) * cmv_bb_cgmin dcg=( - 2.42e-11 * pj + 
+ 3.298e-03 * area) * (1 - 8.303e-5 * dt - 2.889e-7 * dt * dt) * cmv_bb_dcg dvgs= 
+ - 0.08179 - 1.531e-04 * dt vgnorm=0.3939 + 5.273e-04 * dt 
cg ( ng nds ) bsource q=((cgmin+dcg)*v(ng,nds)+vgnorm*dcg*ln(cosh((v(ng,nds)-dvgs)/vgnorm)))
ends nmoscap
 
// *************************************************************************
//                                                                         *
//                  3.3V IO NMOS in N-Well varactor MODEL                  *
//                                                                         *
// *************************************************************************
subckt nmoscap_33 ( ng nds ) 
parameters lr=1e-6 wr=1e-6 mr=1 factor=1 area=lr * factor * wr * factor * mr pj=2 
+ * wr * factor * mr dt=temp - 25 cgmin=(3.334e-10 * pj + 1.549e-03 * area) * 
+ (1 + 3.001e-4 * dt + 6.033e-6 * dt ** 2) * cmv_bb_cgmin dcg=( - 1.655e-11 * pj 
+ + 1.769e-03 * area) * (1 - 2.486e-4 * dt - 2.636e-6 * dt ** 2) * cmv_bb_dcg dvgs= 
+ - 0.2032 + 3.961e-05 * dt vgnorm=0.635 + 1.755e-04 * dt 
cg ( ng nds ) bsource q=((cgmin+dcg)*v(ng,nds)+vgnorm*dcg*ln(cosh((v(ng,nds)-dvgs)/vgnorm)))
ends nmoscap_33
 
endsection bb_mvar
 
 

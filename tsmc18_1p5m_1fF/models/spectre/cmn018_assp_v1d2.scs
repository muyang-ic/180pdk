section res
// ************************************
//        2T Resister model           *
// ************************************
// *************************** N+ OD w/i silicide W>2um resistor model ***********************************
subckt rnod ( n1 n2 ) 
parameters l=1u w=1u factor=1 mf=1 mismatchflag=mismatchflag_res geo_fac=1 
+ / sqrt(mf * l * factor * w * factor * 1e12) factmis=0.00822 * geo_fac * par_res 
+ * mismatchflag rsh=r_rnod * (1 + factmis) dw=-0.0765u ptc1=3.35e-3 ptc2=4.31e-7 
+ pvc1=7.56e-5 pvc2=1.24e-3 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt 
+ - 25.0) * (pt - 25.0) 
r1 ( n1 n2 ) resistor r=rsh / mf * l * factor / (w * factor - dw) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
ends rnod
 
// *************************** N+ OD w/i silicide 0.22um<W<2um ***********************************
subckt rnodw ( n1 n2 ) 
parameters l=1u w=1u factor=1 mf=1 mismatchflag=mismatchflag_res geo_fac=1 
+ / sqrt(mf * l * factor * w * factor * 1e12) factmis=0.00822 * geo_fac * par_res 
+ * mismatchflag rsh=r_rnodw * (1 + factmis) dw=-0.0765u ptc1=3.35e-3 ptc2=4.31e-7 
+ pvc1=7.56e-5 pvc2=1.24e-3 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt 
+ - 25.0) * (pt - 25.0) 
r1 ( n1 n2 ) resistor r=rsh / mf * l * factor / (w * factor - dw) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
ends rnodw
 
// *************************** P+ OD w/i silicide W>2um ***********************************
subckt rpod ( n1 n2 ) 
parameters l=1u w=1u factor=1 mf=1 mismatchflag=mismatchflag_res geo_fac=1 
+ / sqrt(mf * l * factor * w * factor * 1e12) factmis=0.01604 * geo_fac * par_res 
+ * mismatchflag rsh=r_rpod * (1 + factmis) dw=-0.08u ptc1=3.44e-3 ptc2=5.02e-7 
+ pvc1=-2.51e-4 pvc2=1.03e-3 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt 
+ - 25.0) * (pt - 25.0) 
r1 ( n1 n2 ) resistor r=rsh / mf * l * factor / (w * factor - dw) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
ends rpod
 
// *************************** P+ OD w/i silicide 0.22um<W<2um ***********************************
subckt rpodw ( n1 n2 ) 
parameters l=1u w=1u factor=1 mf=1 mismatchflag=mismatchflag_res geo_fac=1 
+ / sqrt(mf * l * factor * w * factor * 1e12) factmis=0.01604 * geo_fac * par_res 
+ * mismatchflag rsh=r_rpodw * (1 + factmis) dw=-0.08u ptc1=3.44e-3 ptc2=5.02e-7 
+ pvc1=-2.51e-4 pvc2=1.03e-3 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt 
+ - 25.0) * (pt - 25.0) 
r1 ( n1 n2 ) resistor r=rsh / mf * l * factor / (w * factor - dw) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
ends rpodw
 
// *************************** NW diff(under OD) ***********************************
subckt rnwod ( n1 n2 ) 
parameters l=1u w=1u factor=1 mf=1 rsh=r_rnwod dw=0.141u ptc1=3.68e-3 ptc2=9.54e-6 
+ pvc1=2.77e-3 pvc2=2.49e-4 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt 
+ - 25.0) * (pt - 25.0) 
r1 ( n1 n2 ) resistor r=rsh / mf * l * factor / (w * factor - dw) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
ends rnwod
// *************************** NW diff(under STI) ***********************************
subckt rnwsti ( n1 n2 ) 
parameters l=1u w=1u factor=1 mf=1 rsh=r_rnwsti dw=0.182u ptc1=2.97e-3 ptc2=1.10e-5 
+ pvc1=8.06e-3 pvc2=-3.32e-4 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt 
+ - 25.0) * (pt - 25.0) 
r1 ( n1 n2 ) resistor r=rsh / mf * l * factor / (w * factor - dw) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
ends rnwsti
// *************************** N+ Poly w/i silicide W>2um ***********************************
subckt rnpo1 ( n1 n2 ) 
parameters l=1u w=1u factor=1 mf=1 mismatchflag=mismatchflag_res geo_fac=1 
+ / sqrt(mf * l * factor * w * factor * 1e12) factmis=0.00941 * geo_fac * par_res 
+ * mismatchflag rsh=r_rnpo1 * (1 + factmis) dw=-0.057u ptc1=2.92e-3 ptc2=2.66e-7 
+ pvc1=1.35e-3 pvc2=7.15e-3 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt 
+ - 25.0) * (pt - 25.0) 
r1 ( n1 n2 ) resistor r=rsh / mf * l * factor / (w * factor - dw) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
ends rnpo1
 
// *************************** N+ Poly w/i silicide 0.18um<W<2um ***********************************
subckt rnpo1w ( n1 n2 ) 
parameters l=1u w=1u factor=1 mf=1 mismatchflag=mismatchflag_res geo_fac=1 
+ / sqrt(mf * l * factor * w * factor * 1e12) factmis=0.00941 * geo_fac * par_res 
+ * mismatchflag rsh=r_rnpo1w * (1 + factmis) dw=-0.057u ptc1=2.92e-3 ptc2=2.66e-7 
+ pvc1=1.35e-3 pvc2=7.15e-3 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt 
+ - 25.0) * (pt - 25.0) 
r1 ( n1 n2 ) resistor r=rsh / mf * l * factor / (w * factor - dw) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
ends rnpo1w
 
// *************************** P+ Poly w/i silicide W>2um ***********************************
subckt rppo1 ( n1 n2 ) 
parameters l=1u w=1u factor=1 mf=1 mismatchflag=mismatchflag_res geo_fac=1 
+ / sqrt(mf * l * factor * w * factor * 1e12) factmis=0.01320 * geo_fac * par_res 
+ * mismatchflag rsh=r_rppo1 * (1 + factmis) dw=-0.025u ptc1=2.88e-3 ptc2=5.01e-7 
+ pvc1=-7.89e-4 pvc2=6.19e-3 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt 
+ - 25.0) * (pt - 25.0) 
r1 ( n1 n2 ) resistor r=rsh / mf * l * factor / (w * factor - dw) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
ends rppo1
 
// *************************** P+ Poly w/i silicide 0.18um<W<2um ***********************************
subckt rppo1w ( n1 n2 ) 
parameters l=1u w=1u factor=1 mf=1 mismatchflag=mismatchflag_res geo_fac=1 
+ / sqrt(mf * l * factor * w * factor * 1e12) factmis=0.01320 * geo_fac * par_res 
+ * mismatchflag rsh=r_rppo1w * (1 + factmis) dw=-0.025u ptc1=2.88e-3 ptc2=5.01e-7 
+ pvc1=-7.89e-4 pvc2=6.19e-3 pt=temp tfac=1.0 + ptc1 * (pt - 25.0) + ptc2 * (pt 
+ - 25.0) * (pt - 25.0) 
r1 ( n1 n2 ) resistor r=rsh / mf * l * factor / (w * factor - dw) * (1 + pvc1 * abs(v(n2,n1)) 
+ + pvc2 * v(n2,n1) * v(n2,n1)) * tfac
ends rppo1w
 

+ cta=9.06e-4               ctp=7.7e-4                pta=1.70e-3
+ ptp=1.60e-3               tnom=25                   fc=0
+ ns=1.0*n_d_3              nz=1.0*n_d_3              imax=1e40
+ minr=1e-10                allow_scaling=yes
// **************************************************************
//                       MODEL OF P+/NW DIODE                   *
// **************************************************************
model pdio_3 diode 
+ level=1                   is=1.900e-7*is_d_3        rs=1.0e-10*rs_d_3
+ n=1.0*n_d_3               bv=10.53                  ibv=1e-3
+ isw=5.02e-13*jsw_d_3      area=3.78e-8              pj=9.59e-4
+ cj=1.01e-3*cj_d_3         vj=0.805                  mj=0.395
+ cjsw=1.2e-10*cjsw_d_3     vjsw=0.805                mjsw=0.338
+ tlev=1                    eg=1.17                   xti=3
+ tbv1=-1*-8.1e-4           trs=1.2e-4                tlevc=1
+ cta=9.940197e-4           ctp=9.19e-4               pta=1.57e-3
+ ptp=1.57e-3               tnom=25                   fc=0
+ ns=1.0*n_d_3              nz=1.0*n_d_3              imax=1e40
+ minr=1e-10                allow_scaling=yes
// **************************************************************
//                       MODEL OF NW/Psub DIODE                 *
// **************************************************************
model nwdio_3 diode 
+ level=1                   is=6.50e-7*is_d_3         rs=1.0e-10*rs_d_3
+ n=1.03*n_d_3              bv=14.75                  ibv=1e-3
+ isw=9.75e-13*jsw_d_3      area=7.5e-8               pj=1.1e-3
+ cj=1.337566e-4*cj_d_3     vj=0.5846489              mj=0.3883243
+ cjsw=5.333577e-10*cjsw_d_3                          vjsw=0.5846489
+ mjsw=0.2345684            tlev=1                    eg=1.17
+ xti=3                     tbv1=-1*-9.6e-4           trs=1.125e-3
+ tlevc=1                   cta=2.8425e-3             ctp=1.5284e-3
+ pta=2.819e-3              ptp=2.819e-3              tnom=25
+ fc=0                      ns=1.03*n_d_3             nz=1.03*n_d_3
+ imax=1e40                 minr=1e-10                allow_scaling=yes
// **************************************************************
//                       MODEL OF ESD DIODE                     *
// **************************************************************
model endio_3 diode 
+ level=1                   cj=1.416999e-3*cj_d_3     vj=0.6798575
+ mj=0.3357974              tnom=25                   fc=0
+ ns=1                      nz=1                      imax=1e40
+ minr=1e-10                allow_scaling=yes
// 
endsection dio3

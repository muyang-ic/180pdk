inline subckt mench3_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=2.05e-7 dmci=3.15e-007 xw= + 0 + 
+ dxwn_3m ad=(nf * dmcg + dmci) / factor * (w / nf + xw / factor) as=(nf * dmcg 
+ + dmci) / factor * (w / nf + xw / factor) pd=2 * (nf * dmcg + dmci) / factor + 
+ (nf + 1) * (w / nf + xw / factor) ps=2 * (nf * dmcg + dmci) / factor + (nf + 1) 
+ * (w / nf + xw / factor) nrd=dmcg / factor / nf / (w / nf + xw / factor) nrs=dmcg 
+ / factor / nf / (w / nf + xw / factor) sa=1.00e-05 / factor sb=1.00e-05 / factor 
+ sd=2 * dmcg / factor sca=0e-6 / factor scb=0e-6 / factor scc=0e-6 / factor mismatchflag=mismatchflag_mos_3m 
+ temp1=parn1_3m temp2=parn2_3m fac1=0.579082 * temp1 * sigma + 0.815269 * temp2 
+ * sigma fac2=0.579082 * temp1 * sigma - 0.815269 * temp2 * sigma lef=l * factor 
+ - 0.015e-6 wef=w / nf * factor + 0 geo_fac=1 / sqrt(multi * nf * lef * wef * 1e12) 
+ vthmisn_3m=0.00376962 * geo_fac * fac1 * mismatchflag dlmisn_3m=0.00153195 * geo_fac 
+ * lef * fac2 * mismatchflag dwmisn_3m= - 0.00153195 * geo_fac * wef * fac2 * mismatchflag 
+ toxmisn_3m=0.00153195 * geo_fac * toxn_3m * fac2 * mismatchflag 
mench3_mac ( n1 n2 n3 n4 ) mench3 w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ nf=nf sa=sa sb=sb sd=sd sca=sca scb=scb scc=scc

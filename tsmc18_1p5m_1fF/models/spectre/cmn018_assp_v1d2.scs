include "cmn018_assp_v1d2.scs" section=dio
endsection ss_dio
// *****************************    LIBRARY OF FAST CASE    ******************************

section ff_dio
parameters is_d=1.3
parameters jsw_d=2.0
parameters n_d=1.0025
parameters rs_d=0.8
parameters cj_d=0.93
parameters cjsw_d=0.93
include "cmn018_assp_v1d2.scs" section=dio
endsection ff_dio
// 

section dio
// 
// **************************************************************
//                       MODEL OF N+/PW DIODE                   *
// **************************************************************
model ndio diode 
+ is=4.98e-7*is_d           isw=4.12e-13*jsw_d        rs=1.0e-10*rs_d
+ n=1.06*n_d                cj=9.81e-04*cj_d          cjsw=1.185e-10*cjsw_d
+ bv=11.25                  area=3.78e-8              pj=9.59e-4
+ mj=0.359                  mjsw=0.202                vj=0.6882682
+ vjsw=0.32                 trs=1.3e-3                tbv1=-1*-8.8e-4
+ cta=9.05e-4               ctp=8.09e-04              pta=1.49e-3
+ ptp=8.94e-04              ibv=0.03                  tnom=25
+ fc=0                      tlev=1                    tlevc=1
+ xti=3                     eg=1.17                   level=1
+ ns=1.06*n_d               nz=1.06*n_d               imax=1e40
+ minr=1e-10                allow_scaling=yes
 
// **************************************************************
//                       MODEL OF P+/NW DIODE                   *
// **************************************************************
model pdio diode 
+ level=1                   is=1.760e-7*is_d          rs=1.0e-10*rs_d
+ n=1.02*n_d                bv=10.2                   ibv=1e-3
+ isw=2.71e-13*jsw_d        area=3.78e-8              pj=9.59e-4
+ cj=1.12e-3*cj_d           vj=0.860                  mj=0.440
+ cjsw=1.345e-10*cjsw_d     vjsw=0.6                  mjsw=0.338
+ tlev=1                    eg=1.17                   xti=3
+ tbv1=-1*-8.8e-4           trs=1.2e-4                tlevc=1
+ cta=9.18e-04              ctp=8.86e-04              pta=1.61e-03
+ ptp=1.25e-03              tnom=25                   fc=0
+ ns=1.02*n_d               nz=1.02*n_d               imax=1e40
+ minr=1e-10                allow_scaling=yes
// **************************************************************
//                       MODEL OF NW/Psub DIODE                 *
// **************************************************************
model nwdio diode 
+ level=1                   is=6.50e-7*is_d           rs=1.0e-10*rs_d
+ n=1.03*n_d                bv=14.75                  ibv=1e-3
+ isw=9.75e-13*jsw_d        area=7.5e-8               pj=1.1e-3
+ cj=1.337566e-4*cj_d       vj=0.5846489              mj=0.3883243
+ cjsw=5.333577e-10*cjsw_d  vjsw=0.5846489            mjsw=0.2345684
+ tlev=1                    eg=1.17                   xti=3
+ tbv1=-1*-9.6e-4           trs=1.125e-3              tlevc=1
+ cta=2.8425e-3             ctp=1.5284e-3             pta=2.819e-3
+ ptp=2.819e-3              tnom=25                   fc=0
+ ns=1.03*n_d               nz=1.03*n_d               imax=1e40
+ minr=1e-10                allow_scaling=yes
// 
endsection dio

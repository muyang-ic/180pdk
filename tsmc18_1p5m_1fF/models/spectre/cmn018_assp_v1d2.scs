//   *
//    ( Common statistical library )                                          
//   *
//                                                                            
//   *
//        2.LIB MC                                                            
//   *
//    ( 1.8V Std-Vt statistical models with different device geometries)      
//   *
//                                                                            
//   *
//        3.LIB MC_3V                                                         
//   *
//    ( 3.3V Std-Vt statistical models with different device geometries)      
//   *
//                                                                            
//   *
//        4.LIB MC_M                                                          
//   *
//    ( 1.8V Med-Vt statistical models with different device geometries)      
//   *
//                                                                            
//   *
//        5.LIB MC_3M                                                         
//   *
//    ( 3.3V Med-Vt statistical models with different device geometries)      
//   *
//                                                                            
//   *
//        6.LIB MC_na                                                         
//   *
//    ( 1.8V Native device statistical models with different device           
//   *
//      geometries)                                                           
//   *
//                                                                            
//   *
//        7.LIB MC_3VNA                                                       
//   *
//    ( 3.3V Native device statistical models with different devic            
//   *
//      geometries)                                                           
//   *
//                                                                            
//   *
//        8.LIB TT                                                            
//   *
//              SS                                                            
//   *
//              FF                                                            
//   *
//              SF                                                            
//   *
//              FS                                                            
//   *
//          Model name    length range         width range     unit           
//   *
//                        low     high         low    high                    
//   *
//           ----------------------------------------------------------       
//   *
//             nch        0.18   20.0           0.22    900      um           
//   *
//           ----------------------------------------------------------       
//   *
//             pch        0.18   20.0           0.22    900      um           
//   *
//           ----------------------------------------------------------       
//   *
//         ( 1.8V Normal devices with different geometric and corner models)  
//   *
//                                                                            
//   *
//        9.LIB TT_3V                                                         
//   *
//              SS_3V                                                         
//   *
//              FF_3V                                                         
//   *
//              SF_3V                                                         
//   *
//              FS_3V                                                         
//   *
//          Model name    length range         width range     unit           
//   *
//                        low     high         low    high                    
//   *
//           ----------------------------------------------------------       
//   *
//             nch3       0.35  20.0           0.22    900      um            
//   *
//             pch3       0.30  20.0           0.22    900      um            
//   *
//           ----------------------------------------------------------       
//   *
//         ( 3.3V normal devices  with different                              
//   *
//           geometric and corner models)                                     
//   *
//                                                                            
//   *
//       10.LIB TT_M                                                          
//   *
//              SS_M                                                          
//   *
//              FF_M                                                          
//   *
//              SF_M                                                          
//   *
//              FS_M                                                          
//   *
//          Model name    length range         width range     unit           
//   *
//                        low     high         low    high                    
//   *
//           ----------------------------------------------------------       
//   *
//             mench      0.30  20.0           0.22    900      um            
//   *
//             mepch      0.25  20.0           0.22    900      um            
//   *
//           ----------------------------------------------------------       
//   *
//         ( 1.8V Medium Vt devices with different geometric and corner models)*
//                                                                            
//   *
//       11.LIB TT_3M                                                         
//   *

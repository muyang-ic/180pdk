+ * abs(v(n1,ne)) + pvce3) - tanh(pvce3)))
d1 ( body ns ) ndio area=mf * ((wr - dw / factor) * (lr - dl / factor) / 5.0) pj=mf 
+ * ((wr - dw / factor) + 2.0 * (lr - dl / factor) / 5.0)
d2 ( body nm ) ndio area=mf * ((wr - dw / factor) * (lr - dl / factor) / 5.0) pj=mf 
+ * (2.0 * (lr - dl / factor) / 5.0)
d3 ( body nn ) ndio area=mf * ((wr - dw / factor) * (lr - dl / factor) / 5.0) pj=mf 
+ * (2.0 * (lr - dl / factor) / 5.0)
d4 ( body nx ) ndio area=mf * ((wr - dw / factor) * (lr - dl / factor) / 5.0) pj=mf 
+ * (2.0 * (lr - dl / factor) / 5.0)
d5 ( body ne ) ndio area=mf * ((wr - dw / factor) * (lr - dl / factor) / 5.0) pj=mf 
+ * ((wr - dw / factor) + 2.0 * (lr - dl / factor) / 5.0)

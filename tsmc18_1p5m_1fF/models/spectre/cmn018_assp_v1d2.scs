// *************************** N+ OD w/o silicide 2um<=W ***********************************
subckt rnodrpo ( n1 n2 ) 
parameters l=1u w=1u factor=1 mf=1 mismatchflag=mismatchflag_res geo_fac=1 
+ / sqrt(mf * l * factor * w * factor * 1e12) factmis=0.03120 * geo_fac * par_res 
+ * mismatchflag rsh=r_rnodrpo * (1 + factmis) rend0=rend_rnodrpo * (1 + factmis) 
+ dl=0.000e+00 + dxl_rnodrpo dw= - 9.770e-08 + dxw_rnodrpo pt=temp pvce1=0.0189 
+ pvce2=3.92 pvce3=0.182 ptce1=7.691e-04 ptce2=-1.678e-06 pvcp1=-0.299 pvcp2=-0.00000764 
+ pvcp3=2.449 ptcp1=1.478e-03 ptcp2=5.250e-07 tface=1.0 + ptce1 * (pt - 25.0) + 
+ ptce2 * (pt - 25.0) * (pt - 25.0) tfacp=1.0 + ptcp1 * (pt - 25.0) + ptcp2 * (pt 
+ - 25.0) * (pt - 25.0) 
rend1 ( n1 3 ) resistor r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(n1,3)) + pvce3) - tanh(pvce3)))
rpure ( 3 4 ) resistor r=rsh / mf * (l * factor - dl) / (w * factor - dw) * tfacp 
+ * (1 + pvcp1 * (tanh(pvcp2 * abs(v(3,4) / (l * factor - dl)) + pvcp3) - tanh(pvcp3)))
rend2 ( 4 n2 ) resistor r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(4,n2)) + pvce3) - tanh(pvce3)))
ends rnodrpo
 

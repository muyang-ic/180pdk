inline subckt mench_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=2.05e-007 dmci=3.15e-007 xw= + 0 
+ + dxwnm ad=(nf * dmcg + dmci) / factor * (w / nf + xw / factor) as=(nf * dmcg 
+ + dmci) / factor * (w / nf + xw / factor) pd=2 * (nf * dmcg + dmci) / factor + 
+ (nf + 1) * (w / nf + xw / factor) ps=2 * (nf * dmcg + dmci) / factor + (nf + 1) 
+ * (w / nf + xw / factor) nrd=dmcg / factor / nf / (w / nf + xw / factor) nrs=dmcg 
+ / factor / nf / (w / nf + xw / factor) sa=1.00e-05 / factor sb=1.00e-05 / factor 
+ sd=2 * dmcg / factor sca=0e-6 / factor scb=0e-6 / factor scc=0e-6 / factor mismatchflag=mismatchflag_mos_m 
+ temp1=parn1m temp2=parn2m fac1=0.639217 * temp1 * sigma + 0.769027 * temp2 * sigma 
+ fac2=0.639217 * temp1 * sigma - 0.769027 * temp2 * sigma lef=l * factor - 1.5e-08 
+ wef=w / nf * factor + 0 geo_fac=1 / sqrt(multi * nf * lef * wef * 1e12) vthmisnm=0.00220296 
+ * geo_fac * fac1 * mismatchflag dlmisnm=0.00162770 * geo_fac * lef * fac2 * mismatchflag 
+ dwmisnm= - 0.00162770 * geo_fac * wef * fac2 * mismatchflag toxmisnm=0.00162770 
+ * geo_fac * toxnm * fac2 * mismatchflag 
mench_mac ( n1 n2 n3 n4 ) mench w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ nf=nf sa=sa sb=sb sd=sd sca=sca scb=scb scc=scc

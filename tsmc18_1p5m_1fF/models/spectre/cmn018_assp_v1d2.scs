// ***********************************************************************
 

section rtmom
// *****************************************************************************************
//                                                                            
//               *
//            018 BB RTMOM                                                    
//               *
//                                                                            
//               *
//            parameter range: nv : 6~288, nh : 6~288                         
//               *
//                             nv and nh should be even fingers               
//               *
//                             w(width):0.28u ~0.32u                          
//               *
//                             s(spacing):0.28u ~0.32u                        
//               *
//                             stm(start metal layer):M1,M2,M3                
//               *
//                             spm(stop metal layer):M3,M4,M5                 
//               *
//                             Total metal is at least 3 layers stacked with ploy 
//  shield   *
//                             mismatchflag : 0 represents no mis-match       
//               *
//                                            1 represents Parallel mis-match 
//               *
//                                                                            
//               *
//                                                                            
//               *
// *****************************************************************************************
subckt crtmom ( a b p ) 
parameters nv=32 nh=32 w=0.28u s=0.28u stm=1 spm=5 factor=1 mf=1 mismatchflag=mismatchflag_rtmom 
+ layno=spm - stm + 1 laym1=int(layno / spm) layodd=int((layno + (stm - 2) * (stm 
+ - 3) * (stm - 4) * (stm - 5) / (24) + (stm - 1) * (stm - 2) * (stm - 4) * (stm 
+ - 5) / (4) + (stm - 1) * (stm - 2) * (stm - 3) * (stm - 4) / 24) / 2) - laym1 
+ layeven=int((layno + (stm - 1) * (stm - 3) * (stm - 4) * (stm - 5) / ( - 6) + 
+ (stm - 1) * (stm - 2) * (stm - 3) * (stm - 5) / ( - 6)) / 2) edg=((layodd + 5300 
+ / 5300 * laym1) * (nv - 1) * (nh * (w * factor + s * factor) - s * factor) + layeven 
+ * (nh - 1) * (nv * (w * factor + s * factor) - s * factor)) area=nv * nh / 2 * 
+ w * factor * (layno - 1) fri1=(2 * nh * nv * w * factor) * (layno - 1) fri2=((layodd 
+ + laym1) * nv * w * factor + layeven * nh * w * factor) + layeven * (nv * (w * 
+ factor + s * factor) - s * factor + 0.5u) * 2 + layno * 0.28u * 2 + (layodd + 
+ 5300 / 5300 * laym1) * (nh * (w * factor + s * factor) - s * factor) * 2 abm=((nv 
+ * (w * factor + s * factor) - s * factor + (0.28u + 0.5u) * 2) + (nh * (w * factor 
+ + s * factor) - s * factor + 0.5u)) * 0.28u afm=(nv * w * factor * (nh * (w * 
+ factor + s * factor) - s * factor + 0.5u)) / 2 pf=(nh * (w * factor + s * factor) 
+ - s * factor + 0.5u) * (nv) * 2 / 2 + 2 * ((nv * (w * factor + s * factor) - s 
+ * factor + (0.5u + 0.28u) * 2) + (nh * (w * factor + s * factor) - s * factor 
+ + 0.5u + 0.28u)) pfb=((nh * (w * factor + s * factor) - s * factor) + 0.5u + 0.28u) 
+ * 2.7 cc1=0.023964608 / (s * factor * 1e6) - 0.000227392 / (w * factor * 1e6) 
+ - 0.000501253 / (s * factor * 1e6) / (w * factor * 1e6) + 0.008322715 cc2=0.0497 
+ cf=0.015000000 * (s * factor * 1e6) - 0.002500000 * (w * factor * 1e6) + 0.006250000 
+ * (s * factor * 1e6) * (w * factor * 1e6) + 0.001339500 ca=0.000000000 * (s * 
+ factor * 1e6) + 0.040000000 * (w * factor * 1e6) + 0.000000000 * (s * factor * 
+ 1e6) * (w * factor * 1e6) - 0.000100000 ca_p_a=((stm - 2) * (stm - 3) / (1 - 2) 
+ / (1 - 3) * (0.000000000) + (stm - 1) * (stm - 3) / (2 - 1) / (2 - 3) * (0.000000000) 
+ + (stm - 1) * (stm - 2) / (3 - 1) / (3 - 2) * (0.000000000)) ca_p_b=((stm - 2) 
+ * (stm - 3) / (1 - 2) / (1 - 3) * (0.065000000) + (stm - 1) * (stm - 3) / (2 - 
+ 1) / (2 - 3) * (0.017500000) + (stm - 1) * (stm - 2) / (3 - 1) / (3 - 2) * (0.010250000)) 
+ ca_p_c=((stm - 2) * (stm - 3) / (1 - 2) / (1 - 3) * (0.000000000) + (stm - 1) 
+ * (stm - 3) / (2 - 1) / (2 - 3) * (0.000000000) + (stm - 1) * (stm - 2) / (3 - 
+ 1) / (3 - 2) * (0.000000000)) ca_p_d=((stm - 2) * (stm - 3) / (1 - 2) / (1 - 3) 
+ * (0.000100000) + (stm - 1) * (stm - 3) / (2 - 1) / (2 - 3) * (0.000040000) + 
+ (stm - 1) * (stm - 2) / (3 - 1) / (3 - 2) * ( - 0.000019000)) cf_p_a=((stm - 2) 
+ * (stm - 3) / (1 - 2) / (1 - 3) * (0.031750000) + (stm - 1) * (stm - 3) / (2 - 
+ 1) / (2 - 3) * (0.005750000) + (stm - 1) * (stm - 2) / (3 - 1) / (3 - 2) * (0.002750000)) 
+ cf_p_b=((stm - 2) * (stm - 3) / (1 - 2) / (1 - 3) * (0.006000000) + (stm - 1) 
+ * (stm - 3) / (2 - 1) / (2 - 3) * ( - 0.002500000) + (stm - 1) * (stm - 2) / (3 
+ - 1) / (3 - 2) * ( - 0.002250000)) cf_p_c=((stm - 2) * (stm - 3) / (1 - 2) / (1 
+ - 3) * ( - 0.018750001) + (stm - 1) * (stm - 3) / (2 - 1) / (2 - 3) * (0.006250000) 
+ + (stm - 1) * (stm - 2) / (3 - 1) / (3 - 2) * (0.006250000)) cf_p_d=((stm - 2) 
+ * (stm - 3) / (1 - 2) / (1 - 3) * ( - 0.000779500) + (stm - 1) * (stm - 3) / (2 
+ - 1) / (2 - 3) * (0.001288500) + (stm - 1) * (stm - 2) / (3 - 1) / (3 - 2) * (0.001129500)) 
+ ca_p=(ca_p_a * (s * factor * 1e6) + ca_p_b * (w * factor * 1e6) + ca_p_c * (s 
+ * factor * 1e6) * (w * factor * 1e6) + ca_p_d) cf_p=cf_p_a * (s * factor * 1e6) 
+ + cf_p_b * (w * factor * 1e6) + cf_p_c * (s * factor * 1e6) * (w * factor * 1e6) 
+ + cf_p_d cc_p=0.0451 slope_mis=(0.01611) geo_fac=1 / sqrt(((cc1 * edg * 1e-9 + 
+ cf * 1e-9 * fri1 + ca * 1e-9 * area + cc2 * 1e-9 * fri2) + (ca_p * (abm + afm) 
+ / (w * factor * 1e6) * 1e-3 + cf_p * pf * 1e-9 + cc_p * pfb * 1e-9)) * 1e15 * 
+ mf) factmis=slope_mis * geo_fac * par_mom * mismatchflag 
// 
cab ( a b ) bsource q=(1+factmis)*(cc1*edg*1e-9+cf*1e-9*fri1+ca*1e-9*area+cc2*1e-9*fri2)*(1+(temp-25)*(30.05*1e-6)+(temp-25)*(temp-25)*(-9e-8))*(v(a,b)-1*1e-6*1/2*v(a,b)**2+0.5*1e-6*1/3*v(a,b)**3)*mf*rtmom_fac
cpa ( a p ) bsource q=(1+factmis)*(ca_p*(abm+afm)/(w*factor*1e6)*1e-3+cf_p*pf*1e-9+cc_p*pfb*1e-9)*(1+(temp-25)*(30.05*1e-6)+(temp-25)*(temp-25)*(-9e-8))*(v(a,p)-1*1e-6*1/2*v(a,p)**2+0.5*1e-6*1/3*v(a,p)**3)*mf*rtmom_fac
cpb ( b p ) bsource q=(1+factmis)*(ca_p*(abm+afm)/(w*factor*1e6)*1e-3+cf_p*pf*1e-9+cc_p*pfb*1e-9)*(1+(temp-25)*(30.05*1e-6)+(temp-25)*(temp-25)*(-9e-8))*(v(b,p)-1*1e-6*1/2*v(b,p)**2+0.5*1e-6*1/3*v(b,p)**3)*mf*rtmom_fac
ends crtmom
 
endsection rtmom
 
 
// **********************************************************************
//              	              FMOM                                    *
// **********************************************************************
// ************ Library of typical corner *******************************

section tt_fmom
include "cmn018_assp_v1d2.scs" section=setup_fmom
parameters par_fmom=0
parameters fmom_fac=1
parameters fmom_fac2=1
include "cmn018_assp_v1d2.scs" section=fmom
endsection tt_fmom
 
// ************ Library of slow corner **********************************

section ss_fmom
include "cmn018_assp_v1d2.scs" section=setup_fmom
parameters par_fmom=0
parameters fmom_fac=1.2
parameters fmom_fac2=1.4
include "cmn018_assp_v1d2.scs" section=fmom
endsection ss_fmom
 
// ************ Library of fast corner **********************************

section ff_fmom
include "cmn018_assp_v1d2.scs" section=setup_fmom
parameters par_fmom=0
parameters fmom_fac=0.8
parameters fmom_fac2=0.6
include "cmn018_assp_v1d2.scs" section=fmom
endsection ff_fmom
 
// ************ Library of MC corner **********************************

section mc_fmom
include "cmn018_assp_v1d2.scs" section=setup_fmom
parameters par_fmom=0
parameters a1_mom=mompar * 1.0000e+000 / 3
parameters fmom_fac=1.0000e+000 + (2.0000e-001) * a1_mom
parameters fmom_fac2=1.0000e+000 + (4.0000e-001) * a1_mom
 
include "cmn018_assp_v1d2.scs" section=fmom
endsection mc_fmom
// ******************************************************************************************

section fmom
// ******************************************************************************************
//                                                                            
//                *
// 0.18umBB FMOM                                                              
//     		  *
//                                                                            
//                *
//            parameter range: nr :8~290(should be even fingers)				  *
//                             lr :3u ~ 168u						  *
//                             w(width):0.28u ~ 0.32u				    	  *
//                             s(spacing):0.28u ~ 0.32u					  *
//                             stm(start metal layer):M1,M2,M3                
//       	  *
//                             spm(stop metal layer):M3,M4,M5                 
//     		  *
//                             Total metal is at least 3 layers stacked with ploy 
//  shield    *
//              		     L Bus metal width (with via) : 0.28um (Non scalable)   
//        *		
//              		     Dummy Bus Width = finger width                         
//        *		
//               		     Dummy Bus Space = finger space                        
//         *			
//                             Ftip = 0.5um (Non scalable)          	         
//           *
//                             Distance between DBW and pickup metal : 0.5um (Non 
//  scalable) *
//                             mismatchflag=0 for no mismatch                 
//                *
//                             mismatchflag=1 for parallel                    
//                *
//                                                                            
//                *
// ******************************************************************************************
 
subckt cfmom ( a b p ) 
parameters nr=8 lr=167.5u w=0.32u s=0.32u stm=2 spm=5 mf=1 factor=1 mismatchflag=mismatchflag_fmom 
+ ww=w * 1e6 * factor ss=s * 1e6 * factor ll=lr * 1e6 * factor layno=spm - stm + 
+ 1 lnr=nr * (ww + ss) - ss j1=(stm - 2) * (stm - 3) * (stm - 4) * (stm - 5) * (stm 
+ - 6) / (1 - 2) / (1 - 3) / (1 - 4) / (1 - 5) / (1 - 6) j2=(stm - 1) * (stm - 3) 
+ * (stm - 4) * (stm - 5) * (stm - 6) / (2 - 1) / (2 - 3) / (2 - 4) / (2 - 5) / 
+ (2 - 6) j3=(stm - 1) * (stm - 2) * (stm - 4) * (stm - 5) * (stm - 6) / (3 - 1) 
+ / (3 - 2) / (3 - 4) / (3 - 5) / (3 - 6) tcc1=24.002 * 1e-6 tcc2=0.033 * 1e-6 vcc1=0.6976 
+ * 1e-6 vcc2= - 0.5168 * 1e-6 tfac=1 + tcc1 * (temp - 25) + tcc2 * (temp - 
+ 25) * (temp - 25) wb=0.28 * 1e-6 ftip=0.5 * 1e-6 cfg=((1.58502456697802e-03 
+ / ww + 4.97834615382138e-02 / ss +  - 8.69991468352519e-03 / ww / ss + 0.141092575577826)) 
+ * (0.887) cfg_t=(( - 1.45133875490407e-03 / ww + 0.051901629507603 / ss +  - 1.7164057841426e-03 
+ / ww / ss + 0.058158748650859)) * (0.86) cfg_b=(( - 7.51670687057387e-04 / ww 
+ + 5.19814417344521e-02 / ss +  - 1.45077745025167e-03 / ww / ss + 4.69794855516748e-02)) 
+ * (0.92) cfg_b_m1=((6.65867866332224e-04 / ww + 5.27140572153396e-02 / ss +  - 
+ 1.35294557061935e-03 / ww / ss + 0.021114140335185)) * (1) cfge=(( - 3.58921897506737e-03 
+ / ww + 2.17531337273711e-02 / ss + 2.22078239338076e-04 / ww / ss + 3.39251743618729e-02)) 
+ * (1.03) cfge_t=(( - 2.067472379465e-04 / ww + 1.89594574185258e-02 / ss +  - 
+ 5.90024678651475e-04 / ww / ss + 4.78083405448536e-02)) * (0.59) cfge_b=(( - 4.08481609189726e-03 
+ / ww + 2.07839555057359e-02 / ss + 5.31365394776244e-04 / ww / ss + 3.24968359914656e-02)) 
+ * (1.19) cfge_b_m1=((2.0613984133751e-03 / ww + 2.68051143896327e-02 / ss +  - 
+ 1.14880307083888e-03 / ww / ss + 1.08626496746679e-03)) * (1) cbus=(0.066188) 
+ * (1.52) cbus_t=(0.070721) * (1) cbus_b=(0.062123) * (1.62) cbus_b_m1=(0.052392) 
+ * (1) cfinger=((layno - 2) * cfg + cfg_t + cfg_b * (j2 + j3) + cfg_b_m1 * j1) 
+ / 2 * (nr - 3) * ll cedge=((layno - 2) * cfge + cfge_t + cfge_b * (j2 + j3) + 
+ cfge_b_m1 * j1) * ll * 2 cedge2=((layno - 2) * cbus + cbus_t + cbus_b * (j2 + 
+ j3) + cbus_b_m1 * j1) * nr * ww cp_m1fg=j1 * (7.07541668838077e-02 * ww + 6.21037700315025e-02 
+ * ss + 6.24999341603259e-04 * ww * ss + 1.28949596878795e-03) * 0.988 cp_m2fg=j2 
+ * (1.80585317457402e-02 * ww + 1.73843253965345e-02 * ss +  - 2.97619037915623e-05 
+ * ww * ss + 8.04933863307867e-05) * 1.103 cp_m3fg=j3 * (1.03166466568724e-02 * 
+ ww + 1.00910117360319e-02 * ss + 5.05958000334281e-05 * ww * ss + 3.52388072156329e-05) 
+ * 1.116 cp_m1fge=j1 * (0.135273359618694 * ww + 1.35405398464984e-02 * ss +  - 
+ 0.247736013611283 * ww * ss +  - 2.34920544459968e-03) * 1 cp_m2fge=j2 * (9.96401910145081e-04 
+ * ww +  - 4.1542717932859e-03 * ss +  - 8.39105828027469e-05 * ww * ss + 1.56738096602432e-02) 
+ * 0.881 cp_m3fge=j3 * (6.16953923242438e-03 * ww + 1.87598430851836e-03 * ss + 
+ 8.26070374619411e-03 * ww * ss +  - 8.46620765503368e-04) * 3.178 cp_fg=(cp_m1fg 
+ + cp_m2fg + cp_m3fg) * 0.828 cp_fge=(cp_m1fge + cp_m2fge + cp_m3fge) * 3.85 cpb=j1 
+ * (0.072592) * (1) + j2 * (0.035557) * (0.75) + j3 * (0.020533) * (0.868) cm1pk=(0.072592) 
+ * (1) cp_finger=(cp_fg * (nr / 2 - 1) + cp_fge) * (ll + ftip * 1e6) cp_bus=cpb 
+ * lnr * 0.651 cp_pk=j1 * cm1pk * (ll + ftip * 1e6 + 2 * wb * 1e6) mis=((mismatchflag 
+ - 1) / (0 - 1) * (0) + (mismatchflag - 0) / (1 - 0) * (2.3014)) geo_fac=1 / sqrt((cfinger 
+ + cedge + cedge2) * mf) factmis=mis / 1.414 / 100 * par_fmom * geo_fac 
// 
// 
cab ( a b ) bsource q=(1+factmis)*(cfinger+cedge+cedge2)*(tfac)*(v(a,b)+vcc1*1/2*v(a,b)**2+vcc2*1/3*v(a,b)**3)*1e-15*mf*fmom_fac
cpa ( a p ) bsource q=(cp_finger+cp_bus+cp_pk)*(tfac)*(v(a,p)+vcc1*1/2*v(a,p)**2+vcc2*1/3*v(a,p)**3)*1e-15*mf*fmom_fac2
cpb ( b p ) bsource q=(cp_finger+cp_bus+cp_pk)*(tfac)*(v(b,p)+vcc1*1/2*v(b,p)**2+vcc2*1/3*v(b,p)**3)*1e-15*mf*fmom_fac2
 
ends cfmom
 
// ******************************************************************************************
//                                                                            
//                *
// 0.18umBB FMOM   MULTI-X-COUPLE MISMATCH APPLICATION                        
//   		  *
// (FMOM multi-x-couple type device is only valid in array number=2)  		      
//      *
//            parameter range: nr :8~290(should be even fingers)				  *
//                             lr :3u ~ 168u						  *
//                             w(width):0.28u ~ 0.32u				    	  *
//                             s(spacing):0.28u ~ 0.32u					  *
//                             stm(start metal layer):M1,M2,M3                
//       	  *
//                             spm(stop metal layer):M3,M4,M5                 
//     		  *
//                             Total metal is at least 3 layers stacked with ploy 
//  shield    *
//              		     L Bus metal width (with via) : 0.28um (Non scalable)   
//        *		
//              		     Dummy Bus Width = finger width                         
//        *		
//               		     Dummy Bus Space = finger space                        
//         *			
//                             Ftip = 0.5um (Non scalable)          	         
//           *
//                             Distance between DBW and pickup metal : 0.5um (Non 
//  scalable) *
//                             mismatchflag=0 for no mismatch                 
//                *
//                             mismatchflag=1 for multi-x-couple              
//                *
//                                                                            
//                *
// ******************************************************************************************
 
subckt cfmom_mx ( a b a1 b1 p ) 
parameters nr=8 lr=167.5u w=0.32u s=0.32u stm=2 spm=5 mf=1 factor=1 mismatchflag=mismatchflag_fmom 
+ ww=w * 1e6 * factor ss=s * 1e6 * factor ll=lr * 1e6 * factor layno=spm - stm + 
+ 1 lnr=nr * (ww + ss) - ss j1=(stm - 2) * (stm - 3) * (stm - 4) * (stm - 5) * (stm 
+ - 6) / (1 - 2) / (1 - 3) / (1 - 4) / (1 - 5) / (1 - 6) j2=(stm - 1) * (stm - 3) 
+ * (stm - 4) * (stm - 5) * (stm - 6) / (2 - 1) / (2 - 3) / (2 - 4) / (2 - 5) / 
+ (2 - 6) j3=(stm - 1) * (stm - 2) * (stm - 4) * (stm - 5) * (stm - 6) / (3 - 1) 
+ / (3 - 2) / (3 - 4) / (3 - 5) / (3 - 6) tcc1=24.002 * 1e-6 tcc2=0.033 * 1e-6 vcc1=0.6976 
+ * 1e-6 vcc2= - 0.5168 * 1e-6 tfac=1 + tcc1 * (temp - 25) + tcc2 * (temp - 
+ 25) * (temp - 25) wb=0.28 * 1e-6 ftip=0.5 * 1e-6 cfg=((1.58502456697802e-03 
+ / ww + 4.97834615382138e-02 / ss +  - 8.69991468352519e-03 / ww / ss + 0.141092575577826)) 
+ * (0.887) cfg_t=(( - 1.45133875490407e-03 / ww + 0.051901629507603 / ss +  - 1.7164057841426e-03 
+ / ww / ss + 0.058158748650859)) * (0.86) cfg_b=(( - 7.51670687057387e-04 / ww 
+ + 5.19814417344521e-02 / ss +  - 1.45077745025167e-03 / ww / ss + 4.69794855516748e-02)) 
+ * (0.92) cfg_b_m1=((6.65867866332224e-04 / ww + 5.27140572153396e-02 / ss +  - 
+ 1.35294557061935e-03 / ww / ss + 0.021114140335185)) * (1) cfge=(( - 3.58921897506737e-03 
+ / ww + 2.17531337273711e-02 / ss + 2.22078239338076e-04 / ww / ss + 3.39251743618729e-02)) 
+ * (1.03) cfge_t=(( - 2.067472379465e-04 / ww + 1.89594574185258e-02 / ss +  - 
+ 5.90024678651475e-04 / ww / ss + 4.78083405448536e-02)) * (0.59) cfge_b=(( - 4.08481609189726e-03 
+ / ww + 2.07839555057359e-02 / ss + 5.31365394776244e-04 / ww / ss + 3.24968359914656e-02)) 
+ * (1.19) cfge_b_m1=((2.0613984133751e-03 / ww + 2.68051143896327e-02 / ss +  - 
+ 1.14880307083888e-03 / ww / ss + 1.08626496746679e-03)) * (1) cbus=(0.066188) 
+ * (1.52) cbus_t=(0.070721) * (1) cbus_b=(0.062123) * (1.62) cbus_b_m1=(0.052392) 
+ * (1) cfinger=((layno - 2) * cfg + cfg_t + cfg_b * (j2 + j3) + cfg_b_m1 * j1) 
+ / 2 * (nr - 3) * ll cedge=((layno - 2) * cfge + cfge_t + cfge_b * (j2 + j3) + 
+ cfge_b_m1 * j1) * ll * 2 cedge2=((layno - 2) * cbus + cbus_t + cbus_b * (j2 + 
+ j3) + cbus_b_m1 * j1) * nr * ww cp_m1fg=j1 * (7.07541668838077e-02 * ww + 6.21037700315025e-02 
+ * ss + 6.24999341603259e-04 * ww * ss + 1.28949596878795e-03) * 0.988 cp_m2fg=j2 
+ * (1.80585317457402e-02 * ww + 1.73843253965345e-02 * ss +  - 2.97619037915623e-05 
+ * ww * ss + 8.04933863307867e-05) * 1.103 cp_m3fg=j3 * (1.03166466568724e-02 * 
+ ww + 1.00910117360319e-02 * ss + 5.05958000334281e-05 * ww * ss + 3.52388072156329e-05) 
+ * 1.116 cp_m1fge=j1 * (0.135273359618694 * ww + 1.35405398464984e-02 * ss +  - 
+ 0.247736013611283 * ww * ss +  - 2.34920544459968e-03) * 1 cp_m2fge=j2 * (9.96401910145081e-04 
+ * ww +  - 4.1542717932859e-03 * ss +  - 8.39105828027469e-05 * ww * ss + 1.56738096602432e-02) 
+ * 0.881 cp_m3fge=j3 * (6.16953923242438e-03 * ww + 1.87598430851836e-03 * ss + 
+ 8.26070374619411e-03 * ww * ss +  - 8.46620765503368e-04) * 3.178 cp_fg=(cp_m1fg 
+ + cp_m2fg + cp_m3fg) * 0.828 cp_fge=(cp_m1fge + cp_m2fge + cp_m3fge) * 3.85 cpb=j1 
+ * (0.072592) * (1) + j2 * (0.035557) * (0.75) + j3 * (0.020533) * (0.868) cm1pk=(0.072592) 
+ * (1) cp_finger=(cp_fg * (nr / 2 - 1) + cp_fge) * (ll + ftip * 1e6) cp_bus=cpb 
+ * lnr * 0.651 cp_pk=j1 * cm1pk * (ll + ftip * 1e6 + 2 * wb * 1e6) mis=((mismatchflag 
+ - 1) / (0 - 1) * (0) + (mismatchflag - 0) / (1 - 0) * (0.6796)) geo_fac=1 / sqrt((cfinger 
+ + cedge + cedge2) * mf) factmis=mis / 1.414 / 100 * par_fmom * geo_fac 
// 
// 
cab ( a b ) bsource q=(1+factmis)*(cfinger+cedge+cedge2)*(tfac)*(v(a,b)+vcc1*1/2*v(a,b)**2+vcc2*1/3*v(a,b)**3)*1e-15*mf*fmom_fac
cpa ( a p ) bsource q=(cp_finger+cp_bus+cp_pk)*(tfac)*(v(a,p)+vcc1*1/2*v(a,p)**2+vcc2*1/3*v(a,p)**3)*1e-15*mf*fmom_fac2
cpb ( b p ) bsource q=(cp_finger+cp_bus+cp_pk)*(tfac)*(v(b,p)+vcc1*1/2*v(b,p)**2+vcc2*1/3*v(b,p)**3)*1e-15*mf*fmom_fac2
 
ca1b1 ( a1 b1 ) bsource q=(1+factmis)*((cfinger+cedge+cedge2)*(tfac)*(v(a1,b1)+vcc1*1/2*v(a1,b1)**2+vcc2*1/3*v(a1,b1)**3)*1e-15*mf*fmom_fac)
cpa1 ( a1 p ) bsource q=(cp_finger+cp_bus+cp_pk)*(tfac)*(v(a1,p)+vcc1*1/2*v(a1,p)**2+vcc2*1/3*v(a1,p)**3)*1e-15*mf*fmom_fac2
cpb1 ( b1 p ) bsource q=(cp_finger+cp_bus+cp_pk)*(tfac)*(v(b1,p)+vcc1*1/2*v(b1,p)**2+vcc2*1/3*v(b1,p)**3)*1e-15*mf*fmom_fac2
 
ends cfmom_mx
 
endsection fmom
endlibrary tsmclib

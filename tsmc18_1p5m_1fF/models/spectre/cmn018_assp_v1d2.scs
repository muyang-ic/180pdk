parameters l=1u w=1u factor=1 mf=1 mismatchflag=mismatchflag_res geo_fac=1 
+ / sqrt(mf * l * factor * w * factor * 1e12) factmis=0.03056 * geo_fac * par_res 
+ * mismatchflag rsh=r_rnpo1rpo * (1 + factmis) rend0=rend_rnpo1rpo * (1 + factmis) 
+ dl=0.000e+00 + dxl_rnpo1rpo dw=7.100e-08 + dxw_rnpo1rpo pt=temp pvce1=0.5 pvce2=-9.5 
+ pvce3=1.432 ptce1=-1.584e-03 ptce2=-3.950e-07 pvcp1=-0.117 pvcp2=0.0000041 pvcp3=-1.88 
+ ptcp1=-1.506e-03 ptcp2=2.679e-06 tface=1.0 + ptce1 * (pt - 25.0) + ptce2 * (pt 
+ - 25.0) * (pt - 25.0) tfacp=1.0 + ptcp1 * (pt - 25.0) + ptcp2 * (pt - 25.0) * 
+ (pt - 25.0) 
rend1 ( n1 3 ) resistor r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(n1,3)) + pvce3) - tanh(pvce3)))
rpure ( 3 4 ) resistor r=rsh / mf * (l * factor - dl) / (w * factor - dw) * tfacp 
+ * (1 + pvcp1 * (tanh(pvcp2 * abs(v(3,4) / (l * factor - dl)) + pvcp3) - tanh(pvcp3)))
rend2 ( 4 n2 ) resistor r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(4,n2)) + pvce3) - tanh(pvce3)))
ends rnpo1rpo
 

section mos
// *********************************************************************************************
 
// *********************************************************************************************
//                                                                            
//                   *
//                               1.8 V STD-SVT  NMOS DEVICE MODELS            
//                   *
//                                                                            
//                   *
// *********************************************************************************************
 
// *********************************
//        Mismatch   model         * 
// *********************************
 
inline subckt nch_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=2.05e-007 dmci=3.15e-007 xw= + 0 
+ + dxwn ad=(nf * dmcg + dmci) / factor * (w / nf + xw / factor) as=(nf * dmcg + 
+ dmci) / factor * (w / nf + xw / factor) pd=2 * (nf * dmcg + dmci) / factor + (nf 
+ + 1) * (w / nf + xw / factor) ps=2 * (nf * dmcg + dmci) / factor + (nf + 1) * 
+ (w / nf + xw / factor) nrd=dmcg / factor / nf / (w / nf + xw / factor) nrs=dmcg 
+ / factor / nf / (w / nf + xw / factor) sa=1.00e-05 / factor sb=1.00e-05 / factor 
+ sd=2 * dmcg / factor sca=0e-6 / factor scb=0e-6 / factor scc=0e-6 / factor mismatchflag=mismatchflag_mos 
+ temp1=parn1 temp2=parn2 fac1=0.621546 * temp1 * sigma + 0.783379 * temp2 * sigma 
+ fac2=0.621546 * temp1 * sigma - 0.783379 * temp2 * sigma lef=l * factor - 1.5e-08 
+ wef=w / nf * factor + 0 geo_fac=1 / sqrt(multi * nf * lef * wef * 1e12) vthmisn=0.00273276 
+ * geo_fac * fac1 * mismatchflag dlmisn=0.00176696 * geo_fac * lef * fac2 * mismatchflag 
+ dwmisn= - 0.00176696 * geo_fac * wef * fac2 * mismatchflag toxmisn=0.00176696 
+ * geo_fac * toxn * fac2 * mismatchflag 
nch_mac ( n1 n2 n3 n4 ) nch w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ nf=nf sa=sa sb=sb sd=sd sca=sca scb=scb scc=scc
// *** mismatch ***
model nch bsim4  { 
     1: type=n 
+ lmin=1e-005-(dxln+dlmisn) lmax=2e-05                wmin=1.003e-005-(dxwn+dwmisn)
+ wmax=90.003e-05           version=4.5               rgeomod=1
+ binunit=2                 paramchk=1                mobmod=0
+ capmod=2                  igcmod=0                  igbmod=0
+ diomod=1                  rdsmod=1                  rbodymod=0
+ rgatemod=0                permod=1                  acnqsmod=0
+ trnqsmod=0                tempmod=0                 wpemod=1
+ tnom=25                   toxe=(toxn+toxmisn)       toxm=(toxn+toxmisn)
+ dtox=5.958e-010           epsrox=3.9                wint=1.02e-008
+ lint=2.595e-008           ll=0                      wl=0
+ lln=1                     wln=1                     lw=0
+ ww=0                      lwn=1                     wwn=1
+ lwl=0                     wwl=0                     llc=0
+ wlc=0                     lwc=0                     wwc=0
+ lwlc=0                    wwlc=0                    xl=-1.5e-08+(dxln+dlmisn)
+ xw=0+(dxwn+dwmisn)        dlc=2.595e-008+dlcn       dwc=0
+ xpart=1                   toxref=3e-009             dlcig=2.5e-009
+ vth0=0.43953+(dvthn+vthmisn)                        k1=0.448
+ k2=0.044342+dk2           k3=-3.7                   k3b=1.2
+ w0=0                      dvt0=0.09708              dvt1=0.3053
+ dvt2=-0.6939              dvt0w=0                   dvt1w=0
+ dvt2w=0                   dsub=0.633                minv=-0.34
+ voffl=-1.22e-009          dvtp0=1.46e-006           dvtp1=0
+ lpe0=9.921e-009           lpeb=2.178e-008           web=0
+ wec=0                     scref=1e-006              kvth0we=0.0034927135
+ lkvth0we=0                wkvth0we=0                pkvth0we=0
+ k2we=0.0038               lk2we=0                   wk2we=0
+ pk2we=0                   xj=1.6e-007               ngate=9e+019
+ ndep=5.8e+017             nsd=1e+020                phin=0
+ cdsc=0                    cdscb=0                   cdscd=0
+ cit=0.00082854+dcitn      voff=-0.13055+dvoffn      nfactor=0.94972
+ eta0=0.22771+deta0n       etab=-0.308               ud=0
+ lud=0                     wud=0                     pud=0
+ ku0we=0                   lku0we=0                  wku0we=0
+ pku0we=0                  u0=0.030526+du0n          ua=-1.1118e-009
+ ub=2.3263e-018            uc=1.9167e-010            vsat=73329+dvsatn
+ a0=1.0724+da0n            ags=0.50072               a1=0
+ a2=0.995                  b0=0                      b1=0
+ keta=-0.051375            dwg=0                     dwb=0
+ pclm=0.71887+dpclmn       pdiblc1=0                 pdiblc2=0.000975+dpdiblc2n
+ pdiblcb=0                 drout=0.5                 pvag=0.6279
+ delta=0.005               pscbe1=4.5e+008           pscbe2=1e-020
+ fprout=0                  pdits=0                   pditsd=0
+ pditsl=0                  rsh=6.8                   rdsw=200
+ rsw=90.88                 rdw=90.88                 prwg=0
+ prwb=0                    wr=1                      alpha0=1.454e-007
+ alpha1=2.295              beta0=17.8                agidl=2.593e-009
+ bgidl=1.8508e+009         cgidl=0.25                egidl=0.2624

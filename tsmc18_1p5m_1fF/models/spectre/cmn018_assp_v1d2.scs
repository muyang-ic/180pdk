// *********************************
//        Mismatch   model         * 
// *********************************
 
inline subckt mepch_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=2.05e-007 dmci=3.15e-007 xw= + 0 
+ + dxwpm ad=(nf * dmcg + dmci) / factor * (w / nf + xw / factor) as=(nf * dmcg 
+ + dmci) / factor * (w / nf + xw / factor) pd=2 * (nf * dmcg + dmci) / factor + 
+ (nf + 1) * (w / nf + xw / factor) ps=2 * (nf * dmcg + dmci) / factor + (nf + 1) 
+ * (w / nf + xw / factor) nrd=dmcg / factor / nf / (w / nf + xw / factor) nrs=dmcg 
+ / factor / nf / (w / nf + xw / factor) sa=1.00e-05 / factor sb=1.00e-05 / factor 
+ sd=2 * dmcg / factor sca=0e-6 / factor scb=0e-6 / factor scc=0e-6 / factor mismatchflag=mismatchflag_mos_m 
+ temp1=parp1m temp2=parp2m fac1=0.909065 * temp1 * sigma + 0.416655 * temp2 * sigma 
+ fac2=0.909065 * temp1 * sigma - 0.416655 * temp2 * sigma lef=l * factor - 1.5e-08 
+ wef=w / nf * factor + 0 geo_fac=1 / sqrt(multi * nf * lef * wef * 1e12) vthmispm=0.00309015 
+ * geo_fac * fac1 * mismatchflag dlmispm=0.00258677 * geo_fac * lef * fac2 * mismatchflag 
+ dwmispm= - 0.00258677 * geo_fac * wef * fac2 * mismatchflag toxmispm=0.00258677 
+ * geo_fac * toxpm * fac2 * mismatchflag 
mepch_mac ( n1 n2 n3 n4 ) mepch w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ nf=nf sa=sa sb=sb sd=sd sca=sca scb=scb scc=scc

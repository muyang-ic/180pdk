section mc_bip
include "cmn018_assp_v1d2.scs" section=setup_bip
parameters par_bjtp1=0
parameters par_bjtp2=0
parameters par_bjtn1=0
parameters par_bjtn2=0
parameters par1mc_bip=0
parameters a1mc_bip=par1mc_bip * 3.0000e+000 * 3 / 3
parameters isa=1.0000e+000 + ( - 1.0000e-001) * a1mc_bip
parameters bfa=1.0000e+000 + ( - 5.0000e-002) * a1mc_bip
parameters nfa=1.0000e+000 + ( - 1.6667e-003) * a1mc_bip
parameters rba=1.0000e+000 + (6.6667e-002) * a1mc_bip
parameters rea=1.0000e+000 + (6.6667e-002) * a1mc_bip
parameters rca=1.0000e+000 + (6.6667e-002) * a1mc_bip
parameters rbma=1.0000e+000 + (6.6667e-002) * a1mc_bip
parameters cjea=1.0000e+000 + (1.6667e-002) * a1mc_bip
parameters cjca=1.0000e+000 + (1.6667e-002) * a1mc_bip

statistics {
    process {
        vary par1mc_bip dist=gauss std=1/3
        }
    }
 
 
include "cmn018_assp_v1d2.scs" section=bip
endsection mc_bip
 


section tt_dio
parameters is_d=1.0
parameters jsw_d=1.0
parameters n_d=1.000
parameters rs_d=1.0
parameters cj_d=1.00
parameters cjsw_d=1.00
include "cmn018_assp_v1d2.scs" section=dio
endsection tt_dio
// *****************************    LIBRARY OF SLOW CASE    ******************************

section ss_dio
parameters is_d=0.7

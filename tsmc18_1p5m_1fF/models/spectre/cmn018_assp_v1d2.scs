subckt rpodrpo ( n1 n2 ) 
parameters l=1u w=1u factor=1 mf=1 mismatchflag=mismatchflag_res geo_fac=1 
+ / sqrt(mf * l * factor * w * factor * 1e12) factmis=0.03708 * geo_fac * par_res 
+ * mismatchflag rsh=r_rpodrpo * (1 + factmis) rend0=rend_rpodrpo * (1 + factmis) 
+ dl=0.000e+00 + dxl_rpodrpo dw= - 7.850e-08 + dxw_rpodrpo pt=temp pvce1=0.3 pvce2=-3.6 
+ pvce3=0.01 ptce1=-1.550e-03 ptce2=1.100e-06 pvcp1=-6.968 pvcp2=-0.0000002037 pvcp3=2.1 
+ ptcp1=1.383e-03 ptcp2=8.632e-07 tface=1.0 + ptce1 * (pt - 25.0) + ptce2 * (pt 
+ - 25.0) * (pt - 25.0) tfacp=1.0 + ptcp1 * (pt - 25.0) + ptcp2 * (pt - 25.0) * 
+ (pt - 25.0) 
rend1 ( n1 3 ) resistor r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(n1,3)) + pvce3) - tanh(pvce3)))
rpure ( 3 4 ) resistor r=rsh / mf * (l * factor - dl) / (w * factor - dw) * tfacp 
+ * (1 + pvcp1 * (tanh(pvcp2 * abs(v(3,4) / (l * factor - dl)) + pvcp3) - tanh(pvcp3)))
rend2 ( 4 n2 ) resistor r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(4,n2)) + pvce3) - tanh(pvce3)))
ends rpodrpo
 
// *************************** P+ Poly w/o silicide 2um<W ***********************************
subckt rppo1rpo ( n1 n2 ) 
parameters l=1u w=1u factor=1 mf=1 mismatchflag=mismatchflag_res geo_fac=1 
+ / sqrt(mf * l * factor * w * factor * 1e12) factmis=0.01146 * geo_fac * par_res 
+ * mismatchflag rsh=r_rppo1rpo * (1 + factmis) rend0=rend_rppo1rpo * (1 + factmis) 
+ dl=0.000e+00 + dxl_rppo1rpo dw=3.000e-08 + dxw_rppo1rpo pt=temp pvce1=-0.35 
+ pvce2=13.5 pvce3=-2.5 ptce1=-2.086e-03 ptce2=1.175e-06 pvcp1=-0.0097 pvcp2=0.0000055 
+ pvcp3=-1.3 ptcp1=-2.380e-04 ptcp2=8.850e-07 tface=1.0 + ptce1 * (pt - 25.0) + 
+ ptce2 * (pt - 25.0) * (pt - 25.0) tfacp=1.0 + ptcp1 * (pt - 25.0) + ptcp2 * (pt 
+ - 25.0) * (pt - 25.0) 
rend1 ( n1 3 ) resistor r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(n1,3)) + pvce3) - tanh(pvce3)))
rpure ( 3 4 ) rppoly r=rsh / mf * (l * factor - dl) / (w * factor - dw) * tfacp 
+ * (1 + pvcp1 * (tanh(pvcp2 * abs(V(3,4) / (l * factor - dl)) + pvcp3) - tanh(pvcp3)))
rend2 ( 4 n2 ) resistor r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(4,n2)) + pvce3) - tanh(pvce3)))
model rppoly resistor 
+ l=(l * factor - dl) / 1   w=mf * (w * factor - dw)
+ kf=kf_rppo1rpo            af=2                      fexp=0.98
+ wdexp=1                      ldexp=1                      
ends rppo1rpo
 
// *************************** P- Poly w/o silicide 2um<W ***********************************
subckt rppolyhri ( n1 n2 ) 
parameters l=1u w=1u factor=1 mf=1 mismatchflag=mismatchflag_res geo_fac=1 
+ / sqrt(mf * l * factor * w * factor * 1e12) factmis=0.00964 * geo_fac * par_res 
+ * mismatchflag rsh=r_rppolyhri * (1 + factmis) rend0=rend_rppolyhri * (1 + factmis) 
+ dl= - 1.900e-09 + dxl_rppolyhri dw=4.161e-08 + dxw_rppolyhri pt=temp pvce1=-0.2909 
+ pvce2=-33.02 pvce3=0.8339 ptce1=-7.700e-04 ptce2=1.294e-07 pvcp1=-0.0364 pvcp2=0.0000045 
+ pvcp3=-1.85 ptcp1=-9.200e-04 ptcp2=1.750e-06 tface=1.0 + ptce1 * (pt - 25.0) + 
+ ptce2 * (pt - 25.0) * (pt - 25.0) tfacp=1.0 + ptcp1 * (pt - 25.0) + ptcp2 * (pt 
+ - 25.0) * (pt - 25.0) 
rend1 ( n1 3 ) resistor r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(n1,3)) + pvce3) - tanh(pvce3)))
rpure ( 3 4 ) rppoly r=rsh / mf * (l * factor - dl) / (w * factor - dw) * tfacp 
+ * (1 + pvcp1 * (tanh(pvcp2 * abs(V(3,4) / (l * factor - dl)) + pvcp3) - tanh(pvcp3)))
rend2 ( 4 n2 ) resistor r=rend0 / mf / w / factor * tface * (1 + pvce1 * (tanh(pvce2 
+ * abs(v(4,n2)) + pvce3) - tanh(pvce3)))
model rppoly resistor 
+ l=(l * factor - dl) / 1   w=mf * (w * factor - dw)
+ kf=kf_rppolyhri           af=2                      fexp=0.95
+ wdexp=1                      ldexp=1                      
ends rppolyhri
 

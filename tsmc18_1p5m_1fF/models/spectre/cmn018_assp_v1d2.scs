parameters lr=1u wr=1u mf=1 factor=1 mismatchflag=mismatchflag_disres geo_fac=1 
+ / sqrt(mf * lr * factor * wr * factor * 1e12) factmis=0.03120 * geo_fac * par_res_dis 

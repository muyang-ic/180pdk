// *********************************************************************************************

section mos_3v
// *********************************************************************************************
 

 
// *********************************************************************************************
//                                                                            
//                   *
//                                    3.3V NMOS DEVICE MODELS                 
//                     *
//                                                                            
//                   *
// *********************************************************************************************
 
// *********************************
//        Mismatch   model         * 
// *********************************
 
inline subckt nch3_mac ( n1 n2 n3 n4 ) 
parameters l=1u w=1u multi=1 nf=1 factor=1 sigma=1 dmcg=2.05e-7 dmci=3.15e-007 xw= + 0 + 
+ dxwn_3v ad=(nf * dmcg + dmci) / factor * (w / nf + xw / factor) as=(nf * dmcg 
+ + dmci) / factor * (w / nf + xw / factor) pd=2 * (nf * dmcg + dmci) / factor + 
+ (nf + 1) * (w / nf + xw / factor) ps=2 * (nf * dmcg + dmci) / factor + (nf + 1) 
+ * (w / nf + xw / factor) nrd=dmcg / factor / nf / (w / nf + xw / factor) nrs=dmcg 
+ / factor / nf / (w / nf + xw / factor) sa=1.00e-05 / factor sb=1.00e-05 / factor 
+ sd=2 * dmcg / factor sca=0e-6 / factor scb=0e-6 / factor scc=0e-6 / factor mismatchflag=mismatchflag_mos_3v 
+ temp1=parn1_3v temp2=parn2_3v fac1=0.401010 * temp1 * sigma + 0.916074 * temp2 
+ * sigma fac2=0.401010 * temp1 * sigma - 0.916074 * temp2 * sigma lef=l * factor 
+ - 0.015e-6 wef=w / nf * factor + 0 geo_fac=1 / sqrt(multi * nf * lef * wef * 1e12) 
+ vthmisn_3v=0.00653247 * geo_fac * fac1 * mismatchflag dlmisn_3v=0.00213862 * geo_fac 
+ * lef * fac2 * mismatchflag dwmisn_3v= - 0.00213862 * geo_fac * wef * fac2 * mismatchflag 
+ toxmisn_3v=0.00213862 * geo_fac * toxn_3v * fac2 * mismatchflag 
nch3_mac ( n1 n2 n3 n4 ) nch3 w=w l=l ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=multi 
+ nf=nf sa=sa sb=sb sd=sd sca=sca scb=scb scc=scc
// *** mismatch ***
model nch3 bsim4  { 
     1: type=n 
+ lmin=1e-005-(dxln_3v+dlmisn_3v)                     lmax=900.01e-6
+ wmin=1.003e-005-(dxwn_3v+dwmisn_3v)                 wmax=900.01e-6
+ version=4.5               gbmin=1.00e-12            tempmod=0
+ rbsb=50                   ud=0                      rbdb=50
+ rgeomod=1                 rbpb=50                   rshg=1
+ rbps=50                   rbpd=50                   ngcon=1
+ binunit=2                 paramchk=1                mobmod=0

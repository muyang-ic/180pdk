*************************************
**************************** N+ OD w/i silicide W>2um resistor model ***********************************
.subckt rnod n1 n2 l=length w=width scale=1 mf=1 mismatchflag='mismatchflag_res'
.param geo_fac ='1/sqrt(mf*l*scale*w*scale*1e12)'
.param factmis='0.00822*geo_fac*par_res*mismatchflag'
.param rsh='r_rnod*(1+factmis)' 
.param dw=-0.0765u 
.param ptc1=3.35e-3 ptc2=4.31e-7 pvc1=7.56e-5 pvc2=1.24e-3 
.param pt='temper'
.param tfac='1.0+ptc1*(pt-25.0)+ptc2*(pt-25.0)*(pt-25.0)'
r1 n1 n2 'rsh/mf*l*scale/(w*scale-dw)*(1+pvc1*abs(v(n2,n1))+pvc2*v(n2,n1)*v(n2,n1))*tfac'
.ends rnod


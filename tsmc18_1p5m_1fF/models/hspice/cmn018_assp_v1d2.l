**************************************************************************
*                                                                        *
*                 1.8V IO NMOS in N-Well varactor MODEL                  *
*                                                                        *
**************************************************************************
.subckt nmoscap ng nds lr=1e-6 wr=1e-6 Mr=1 scale=1
.param area='lr*scale*wr*scale*Mr'
.param pj='2*wr*scale*Mr'
.param dT='temper-25'
.param Cgmin='(3.727E-10*pj+2.008E-03*area)*(1+4.84E-5*dT+8.53E-7*dT*dT)*cmv_bb_cgmin'
.param dCg='(-2.42E-11*pj+3.298E-03*area)*(1-8.303E-5*dT-2.889E-7*dT*dT)*cmv_bb_dcg'
.param dVgs='-0.08179-1.531E-04*dT'
.param Vgnorm='0.3939+5.273E-04*dT'
cg ng nds '(Cgmin+dCg*(1.0+tanh((v(ng,nds)-dVgs)/Vgnorm)))'
.ends nmoscap

**************************************************************************
*                                                                        *
*                 3.3V IO NMOS in N-Well varactor MODEL                  *
*                                                                        *
**************************************************************************
.subckt nmoscap_33 ng nds lr=1e-6 wr=1e-6 Mr=1 scale=1
.param area='lr*scale*wr*scale*Mr'
.param pj='2*wr*scale*Mr'
.param dT='temper-25'
.param Cgmin='(3.334E-10*pj+1.549E-03*area)*(1+3.001E-4*dT+6.033E-6*dT**2)*cmv_bb_cgmin'
.param dCg='(-1.655E-11*pj+1.769E-03*area)*(1-2.486E-4*dT-2.636E-6*dT**2)*cmv_bb_dcg'
.param dVgs='-0.2032+3.961E-05*dT'
.param Vgnorm='0.635+1.755E-04*dT'
cg ng nds '(Cgmin+dCg*(1.0+tanh((v(ng,nds)-dVgs)/Vgnorm)))'
.ends nmoscap_33

.ENDL BB_MVAR



************************************************************************

.LIB RTMOM
******************************************************************************************
*                                                                                        *
*           018 BB RTMOM                                                                 *
*                                                                                        *
*           parameter range: nv : 6~288, nh : 6~288                                      *
*                            nv and nh should be even fingers                            *
*                            w(width):0.28u ~0.32u                                       *
*                            s(spacing):0.28u ~0.32u                                     *
*                            stm(start metal layer):M1,M2,M3                             *
*                            spm(stop metal layer):M3,M4,M5                              *
*                            Total metal is at least 3 layers stacked with ploy shield   *
*                            mismatchflag : 0 represents no mis-match                    *
*                                           1 represents Parallel mis-match              *
*                                                                                        *
*                                                                                        *
******************************************************************************************
.subckt crtmom a b p nv=32 nh=32 w=0.28u s=0.28u stm=1 spm=5 scale=1 mf=1 mismatchflag='mismatchflag_rtmom'
.param 
+ layno='spm-stm+1'
+ laym1='INT(layno/spm)'
+ layodd='INT((layno+(stm-2)*(stm-3)*(stm-4)*(stm-5)/(24)+(stm-1)*(stm-2)*(stm-4)*(stm-5)/(4)+(stm-1)*(stm-2)*(stm-3)*(stm-4)/24)/2)-laym1'
+ layeven='INT((layno+(stm-1)*(stm-3)*(stm-4)*(stm-5)/(-6)+(stm-1)*(stm-2)*(stm-3)*(stm-5)/(-6))/2)'
*
+ Edg='((layodd+5300/5300*laym1)*(nv-1)*(nh*(w*scale+s*scale)-s*scale)+layeven*(nh-1)*(nv*(w*scale+s*scale)-s*scale))'
+ AREA='nv*nh/2*w*scale*(layno-1)'
+ FRI1='(2*nh*nv*w*scale)*(layno-1)'
+ FRI2='((layodd+laym1)*nv*w*scale+layeven*nh*w*scale)+layeven*(nv*(w*scale+s*scale)-s*scale+0.5u)*2+layno*0.28u*2+(layodd+5300/5300*laym1)*(nh*(w*scale+s*scale)-s*scale)*2'
+ Abm ='((nv*(w*scale+s*scale)-s*scale+(0.28u+0.5u)*2)+(nh*(w*scale+s*scale)-s*scale+0.5u))*0.28u'
+ Afm ='(nv*w*scale*(nh*(w*scale+s*scale)-s*scale+0.5u))/2'
+ Pf ='(nh*(w*scale+s*scale)-s*scale+0.5u)*(nv)*2/2+2*((nv*(w*scale+s*scale)-s*scale+(0.5u+0.28u)*2)+(nh*(w*scale+s*scale)-s*scale+0.5u+0.28u))'
+ Pfb ='((nh*(w*scale+s*scale)-s*scale)+0.5u+0.28u)*2.7'
*
+ Cc1 ='0.023964608/(s*scale*1e6)-0.000227392/(w*scale*1e6)-0.000501253/(s*scale*1e6)/(w*scale*1e6)+0.008322715'
+ Cc2 ='0.0497'
+ Cf ='0.015000000*(s*scale*1e6)-0.002500000*(w*scale*1e6)+0.006250000*(s*scale*1e6)*(w*scale*1e6)+0.001339500'
+ Ca ='0.000000000*(s*scale*1e6)+0.040000000*(w*scale*1e6)+0.000000000*(s*scale*1e6)*(w*scale*1e6)-0.000100000'
*
+ ca_p_a='((stm-2)*(stm-3)/(1-2)/(1-3)*(0.000000000)+(stm-1)*(stm-3)/(2-1)/(2-3)*(0.000000000)+(stm-1)*(stm-2)/(3-1)/(3-2)*(0.000000000))'
+ ca_p_b='((stm-2)*(stm-3)/(1-2)/(1-3)*(0.065000000)+(stm-1)*(stm-3)/(2-1)/(2-3)*(0.017500000)+(stm-1)*(stm-2)/(3-1)/(3-2)*(0.010250000))'
+ ca_p_c='((stm-2)*(stm-3)/(1-2)/(1-3)*(0.000000000)+(stm-1)*(stm-3)/(2-1)/(2-3)*(0.000000000)+(stm-1)*(stm-2)/(3-1)/(3-2)*(0.000000000))'
+ ca_p_d='((stm-2)*(stm-3)/(1-2)/(1-3)*(0.000100000)+(stm-1)*(stm-3)/(2-1)/(2-3)*(0.000040000)+(stm-1)*(stm-2)/(3-1)/(3-2)*(-0.000019000))'
*
+ cf_p_a='((stm-2)*(stm-3)/(1-2)/(1-3)*(0.031750000)+(stm-1)*(stm-3)/(2-1)/(2-3)*(0.005750000)+(stm-1)*(stm-2)/(3-1)/(3-2)*(0.002750000))'
+ cf_p_b='((stm-2)*(stm-3)/(1-2)/(1-3)*(0.006000000)+(stm-1)*(stm-3)/(2-1)/(2-3)*(-0.002500000)+(stm-1)*(stm-2)/(3-1)/(3-2)*(-0.002250000))'
+ cf_p_c='((stm-2)*(stm-3)/(1-2)/(1-3)*(-0.018750001)+(stm-1)*(stm-3)/(2-1)/(2-3)*(0.006250000)+(stm-1)*(stm-2)/(3-1)/(3-2)*(0.006250000))'
+ cf_p_d='((stm-2)*(stm-3)/(1-2)/(1-3)*(-0.000779500)+(stm-1)*(stm-3)/(2-1)/(2-3)*(0.001288500)+(stm-1)*(stm-2)/(3-1)/(3-2)*(0.001129500))'
*
+ Ca_p ='(ca_p_a*(s*scale*1e6)+ca_p_b*(w*scale*1e6)+ca_p_c*(s*scale*1e6)*(w*scale*1e6)+ca_p_d)'
+ Cf_p ='cf_p_a*(s*scale*1e6)+cf_p_b*(w*scale*1e6)+cf_p_c*(s*scale*1e6)*(w*scale*1e6)+cf_p_d'
+ Cc_p ='0.0451'
*
+ slope_mis='(0.01611)'
*
+ geo_fac ='1/sqrt(((Cc1*Edg*1e-9+Cf*1e-9*FRI1+Ca*1e-9*AREA+Cc2*1e-9*FRI2)+(Ca_p*(Abm+Afm)/(w*scale*1e6)*1e-3+Cf_p*Pf*1e-9+Cc_p*Pfb*1e-9))*1e15*mf)'
+ factmis='slope_mis*geo_fac*par_mom*mismatchflag'
*
Cab a b '(1+factmis)*(Cc1*Edg*1e-9+Cf*1e-9*FRI1+Ca*1e-9*AREA+Cc2*1e-9*FRI2)*(1+(temper-25)*(30.05*1e-6)+(temper-25)*(temper-25)*(-9e-8))*(1-1*1e-6*v(a,b)+0.5*1e-6*v(a,b)*v(a,b))*mf*RTMOM_fac'
Cpa a p '(1+factmis)*(Ca_p*(Abm+Afm)/(w*scale*1e6)*1e-3+Cf_p*Pf*1e-9+Cc_p*Pfb*1e-9)*(1+(temper-25)*(30.05*1e-6)+(temper-25)*(temper-25)*(-9e-8))*(1-1*1e-6*v(a,p)+0.5*1e-6*v(a,p)*v(a,p))*mf*RTMOM_fac'
Cpb b p '(1+factmis)*(Ca_p*(Abm+Afm)/(w*scale*1e6)*1e-3+Cf_p*Pf*1e-9+Cc_p*Pfb*1e-9)*(1+(temper-25)*(30.05*1e-6)+(temper-25)*(temper-25)*(-9e-8))*(1-1*1e-6*v(b,p)+0.5*1e-6*v(b,p)*v(b,p))*mf*RTMOM_fac'
.ends crtmom

.ENDL RTMOM



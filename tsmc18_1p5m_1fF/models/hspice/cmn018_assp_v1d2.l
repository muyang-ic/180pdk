*******************************************************************************************
.LIB FMOM
*******************************************************************************************
*                                                                                         *
*0.18umBB FMOM                                                                 		  *
*                                                                                         *
*           parameter range: nr :8~290(should be even fingers)				  *
*                            lr :3u ~ 168u						  *
*                            w(width):0.28u ~ 0.32u				    	  *
*                            s(spacing):0.28u ~ 0.32u					  *
*                            stm(start metal layer):M1,M2,M3                     	  *
*                            spm(stop metal layer):M3,M4,M5                    		  *
*                            Total metal is at least 3 layers stacked with ploy shield    *
*             		     L Bus metal width (with via) : 0.28um (Non scalable)         *		
*             		     Dummy Bus Width = finger width                               *		
*              		     Dummy Bus Space = finger space                               *			
*                            Ftip = 0.5um (Non scalable)          	                  *
*                            Distance between DBW and pickup metal : 0.5um (Non scalable) *
*                            mismatchflag=0 for no mismatch                               *
*                            mismatchflag=1 for parallel                                  *
*                                                                                         *
*******************************************************************************************

.subckt cfmom a b p nr=8 lr=167.5u w=0.32u s=0.32u stm=2 spm=5 mf=1 scale=1 mismatchflag='mismatchflag_fmom'
.param 
+ ww = 'w*1e6*scale'
+ ss = 's*1e6*scale'
+ ll = 'lr*1e6*scale'
+ layno = 'spm-stm+1'
+ lnr = 'nr*(ww+ss)-ss'
*
+ j1 = '(stm-2)*(stm-3)*(stm-4)*(stm-5)*(stm-6)/(1-2)/(1-3)/(1-4)/(1-5)/(1-6)'
+ j2 = '(stm-1)*(stm-3)*(stm-4)*(stm-5)*(stm-6)/(2-1)/(2-3)/(2-4)/(2-5)/(2-6)'
+ j3 = '(stm-1)*(stm-2)*(stm-4)*(stm-5)*(stm-6)/(3-1)/(3-2)/(3-4)/(3-5)/(3-6)'
*
+ tcc1  = '24.002*1e-6'
+ tcc2  = '0.033*1e-6'
+ vcc1  = '0.6976*1e-6'
+ vcc2  = '-0.5168*1e-6'
+ tfac = '1+tcc1*(temper-25)+tcc2*(temper-25)*(temper-25)'
*
+ wb = '0.28*1e-6'
+ ftip  = '0.5*1e-6'
*
*
+ Cfg   = '((1.58502456697802E-03/ww+4.97834615382138E-02/ss+-8.69991468352519E-03/ww/ss+0.141092575577826))*(0.887)'
+ Cfg_t = '((-1.45133875490407E-03/ww+0.051901629507603/ss+-1.7164057841426E-03/ww/ss+0.058158748650859))*(0.86)'
+ Cfg_b = '((-7.51670687057387E-04/ww+5.19814417344521E-02/ss+-1.45077745025167E-03/ww/ss+4.69794855516748E-02))*(0.92)'
+ Cfg_b_m1 = '((6.65867866332224E-04/ww+5.27140572153396E-02/ss+-1.35294557061935E-03/ww/ss+0.021114140335185))*(1)'
+ Cfge   = '((-3.58921897506737E-03/ww+2.17531337273711E-02/ss+2.22078239338076E-04/ww/ss+3.39251743618729E-02))*(1.03)'
+ Cfge_t = '((-2.067472379465E-04/ww+1.89594574185258E-02/ss+-5.90024678651475E-04/ww/ss+4.78083405448536E-02))*(0.59)'
+ Cfge_b = '((-4.08481609189726E-03/ww+2.07839555057359E-02/ss+5.31365394776244E-04/ww/ss+3.24968359914656E-02))*(1.19)'
+ Cfge_b_m1 = '((2.0613984133751E-03/ww+2.68051143896327E-02/ss+-1.14880307083888E-03/ww/ss+1.08626496746679E-03))*(1)'
+ Cbus  = '(0.066188)*(1.52)'
+ Cbus_t  = '(0.070721)*(1)'
+ Cbus_b  = '(0.062123)*(1.62)'
+ Cbus_b_m1  = '(0.052392)*(1)'
*
+ Cfinger = '((layno-2)*Cfg+Cfg_t+Cfg_b*(j2+j3)+Cfg_b_m1*j1)/2*(nr-3)*ll'
+ Cedge   = '((layno-2)*Cfge+Cfge_t+Cfge_b*(j2+j3)+Cfge_b_m1*j1)*ll*2'
+ Cedge2  = '((layno-2)*Cbus+Cbus_t+Cbus_b*(j2+j3)+Cbus_b_m1*j1)*nr*ww'
*
+ Cp_m1fg = 'j1*(7.07541668838077E-02*ww+6.21037700315025E-02*ss+6.24999341603259E-04*ww*ss+1.28949596878795E-03)*0.988'
+ Cp_m2fg = 'j2*(1.80585317457402E-02*ww+1.73843253965345E-02*ss+-2.97619037915623E-05*ww*ss+8.04933863307867E-05)*1.103'
+ Cp_m3fg = 'j3*(1.03166466568724E-02*ww+1.00910117360319E-02*ss+5.05958000334281E-05*ww*ss+3.52388072156329E-05)*1.116'
+ Cp_m1fge = 'j1*(0.135273359618694*ww+1.35405398464984E-02*ss+-0.247736013611283*ww*ss+-2.34920544459968E-03)*1'
+ Cp_m2fge = 'j2*(9.96401910145081E-04*ww+-4.1542717932859E-03*ss+-8.39105828027469E-05*ww*ss+1.56738096602432E-02)*0.881'
+ Cp_m3fge = 'j3*(6.16953923242438E-03*ww+1.87598430851836E-03*ss+8.26070374619411E-03*ww*ss+-8.46620765503368E-04)*3.178'
+ Cp_fg  = '(Cp_m1fg+Cp_m2fg+Cp_m3fg)*0.828'
+ Cp_fge = '(Cp_m1fge+Cp_m2fge+Cp_m3fge)*3.85'
+ Cpb    = 'j1*(0.072592)*(1)+j2*(0.035557)*(0.75)+j3*(0.020533)*(0.868)'
+ Cm1pk  = '(0.072592)*(1)'
*
+ Cp_finger = '(Cp_fg*(nr/2-1)+Cp_fge)*(ll+Ftip*1e6)'
+ Cp_bus = 'Cpb*lnr*0.651'
+ Cp_pk  = 'j1*Cm1pk*(ll+ftip*1e6+2*wb*1e6)'
*
+ mis='((mismatchflag-1)/(0-1)*(0)+(mismatchflag-0)/(1-0)*(2.3014))'
*
+ geo_fac ='1/sqrt((Cfinger+Cedge+Cedge2)*mf)'
+ factmis='mis/1.414/100*par_fmom*geo_fac'
*
*
Cab a b '(1+factmis)*(Cfinger+Cedge+Cedge2)*(tfac)*(1+vcc1*v(a,b)+vcc2*v(a,b)*v(a,b))*1e-15*mf*FMOM_fac'
Cpa a p '(Cp_finger+Cp_bus+Cp_pk)*(tfac)*(1+vcc1*v(a,p)+vcc2*v(a,p)*v(a,p))*1e-15*mf*FMOM_fac2'
Cpb b p '(Cp_finger+Cp_bus+Cp_pk)*(tfac)*(1+vcc1*v(b,p)+vcc2*v(b,p)*v(b,p))*1e-15*mf*FMOM_fac2'

.ends cfmom

*******************************************************************************************
*                                                                                         *
*0.18umBB FMOM   MULTI-X-COUPLE MISMATCH APPLICATION                         		  *
*(FMOM multi-x-couple type device is only valid in array number=2)  		          *
*           parameter range: nr :8~290(should be even fingers)				  *
*                            lr :3u ~ 168u						  *
*                            w(width):0.28u ~ 0.32u				    	  *
*                            s(spacing):0.28u ~ 0.32u					  *
*                            stm(start metal layer):M1,M2,M3                     	  *
*                            spm(stop metal layer):M3,M4,M5                    		  *
*                            Total metal is at least 3 layers stacked with ploy shield    *
*             		     L Bus metal width (with via) : 0.28um (Non scalable)         *		
*             		     Dummy Bus Width = finger width                               *		
*              		     Dummy Bus Space = finger space                               *			
*                            Ftip = 0.5um (Non scalable)          	                  *
*                            Distance between DBW and pickup metal : 0.5um (Non scalable) *
*                            mismatchflag=0 for no mismatch                               *
*                            mismatchflag=1 for multi-x-couple                            *
*                                                                                         *
*******************************************************************************************

.subckt cfmom_mx a b a1 b1 p nr=8 lr=167.5u w=0.32u s=0.32u stm=2 spm=5 mf=1 scale=1 mismatchflag='mismatchflag_fmom'
.param 
+ ww = 'w*1e6*scale'
+ ss = 's*1e6*scale'
+ ll = 'lr*1e6*scale'
+ layno = 'spm-stm+1'
+ lnr = 'nr*(ww+ss)-ss'
*
+ j1 = '(stm-2)*(stm-3)*(stm-4)*(stm-5)*(stm-6)/(1-2)/(1-3)/(1-4)/(1-5)/(1-6)'
+ j2 = '(stm-1)*(stm-3)*(stm-4)*(stm-5)*(stm-6)/(2-1)/(2-3)/(2-4)/(2-5)/(2-6)'
+ j3 = '(stm-1)*(stm-2)*(stm-4)*(stm-5)*(stm-6)/(3-1)/(3-2)/(3-4)/(3-5)/(3-6)'
*
+ tcc1  = '24.002*1e-6'
+ tcc2  = '0.033*1e-6'
+ vcc1  = '0.6976*1e-6'
+ vcc2  = '-0.5168*1e-6'
+ tfac = '1+tcc1*(temper-25)+tcc2*(temper-25)*(temper-25)'
*
+ wb = '0.28*1e-6'
+ ftip  = '0.5*1e-6'
*
*
+ Cfg   = '((1.58502456697802E-03/ww+4.97834615382138E-02/ss+-8.69991468352519E-03/ww/ss+0.141092575577826))*(0.887)'
+ Cfg_t = '((-1.45133875490407E-03/ww+0.051901629507603/ss+-1.7164057841426E-03/ww/ss+0.058158748650859))*(0.86)'
+ Cfg_b = '((-7.51670687057387E-04/ww+5.19814417344521E-02/ss+-1.45077745025167E-03/ww/ss+4.69794855516748E-02))*(0.92)'
+ Cfg_b_m1 = '((6.65867866332224E-04/ww+5.27140572153396E-02/ss+-1.35294557061935E-03/ww/ss+0.021114140335185))*(1)'
+ Cfge   = '((-3.58921897506737E-03/ww+2.17531337273711E-02/ss+2.22078239338076E-04/ww/ss+3.39251743618729E-02))*(1.03)'
+ Cfge_t = '((-2.067472379465E-04/ww+1.89594574185258E-02/ss+-5.90024678651475E-04/ww/ss+4.78083405448536E-02))*(0.59)'
+ Cfge_b = '((-4.08481609189726E-03/ww+2.07839555057359E-02/ss+5.31365394776244E-04/ww/ss+3.24968359914656E-02))*(1.19)'
+ Cfge_b_m1 = '((2.0613984133751E-03/ww+2.68051143896327E-02/ss+-1.14880307083888E-03/ww/ss+1.08626496746679E-03))*(1)'
+ Cbus  = '(0.066188)*(1.52)'
+ Cbus_t  = '(0.070721)*(1)'
+ Cbus_b  = '(0.062123)*(1.62)'
+ Cbus_b_m1  = '(0.052392)*(1)'
*
+ Cfinger = '((layno-2)*Cfg+Cfg_t+Cfg_b*(j2+j3)+Cfg_b_m1*j1)/2*(nr-3)*ll'
+ Cedge   = '((layno-2)*Cfge+Cfge_t+Cfge_b*(j2+j3)+Cfge_b_m1*j1)*ll*2'
+ Cedge2  = '((layno-2)*Cbus+Cbus_t+Cbus_b*(j2+j3)+Cbus_b_m1*j1)*nr*ww'
*
+ Cp_m1fg = 'j1*(7.07541668838077E-02*ww+6.21037700315025E-02*ss+6.24999341603259E-04*ww*ss+1.28949596878795E-03)*0.988'
+ Cp_m2fg = 'j2*(1.80585317457402E-02*ww+1.73843253965345E-02*ss+-2.97619037915623E-05*ww*ss+8.04933863307867E-05)*1.103'
+ Cp_m3fg = 'j3*(1.03166466568724E-02*ww+1.00910117360319E-02*ss+5.05958000334281E-05*ww*ss+3.52388072156329E-05)*1.116'
+ Cp_m1fge = 'j1*(0.135273359618694*ww+1.35405398464984E-02*ss+-0.247736013611283*ww*ss+-2.34920544459968E-03)*1'
+ Cp_m2fge = 'j2*(9.96401910145081E-04*ww+-4.1542717932859E-03*ss+-8.39105828027469E-05*ww*ss+1.56738096602432E-02)*0.881'
+ Cp_m3fge = 'j3*(6.16953923242438E-03*ww+1.87598430851836E-03*ss+8.26070374619411E-03*ww*ss+-8.46620765503368E-04)*3.178'
+ Cp_fg  = '(Cp_m1fg+Cp_m2fg+Cp_m3fg)*0.828'
+ Cp_fge = '(Cp_m1fge+Cp_m2fge+Cp_m3fge)*3.85'
+ Cpb    = 'j1*(0.072592)*(1)+j2*(0.035557)*(0.75)+j3*(0.020533)*(0.868)'
+ Cm1pk  = '(0.072592)*(1)'
*
+ Cp_finger = '(Cp_fg*(nr/2-1)+Cp_fge)*(ll+Ftip*1e6)'
+ Cp_bus = 'Cpb*lnr*0.651'
+ Cp_pk  = 'j1*Cm1pk*(ll+ftip*1e6+2*wb*1e6)'
*
+ mis='((mismatchflag-1)/(0-1)*(0)+(mismatchflag-0)/(1-0)*(0.6796))'
*
+ geo_fac ='1/sqrt((Cfinger+Cedge+Cedge2)*mf)'
+ factmis='mis/1.414/100*par_fmom*geo_fac'
*
*
Cab a b '(1+factmis)*(Cfinger+Cedge+Cedge2)*(tfac)*(1+vcc1*v(a,b)+vcc2*v(a,b)*v(a,b))*1e-15*mf*FMOM_fac'
Cpa a p '(Cp_finger+Cp_bus+Cp_pk)*(tfac)*(1+vcc1*v(a,p)+vcc2*v(a,p)*v(a,p))*1e-15*mf*FMOM_fac2'
Cpb b p '(Cp_finger+Cp_bus+Cp_pk)*(tfac)*(1+vcc1*v(b,p)+vcc2*v(b,p)*v(b,p))*1e-15*mf*FMOM_fac2'

Ca1b1 a1 b1 '(1+factmis)*((Cfinger+Cedge+Cedge2)*(tfac)*(1+vcc1*v(a1,b1)+vcc2*v(a1,b1)*v(a1,b1))*1e-15*mf*FMOM_fac)'
Cpa1 a1 p '(Cp_finger+Cp_bus+Cp_pk)*(tfac)*(1+vcc1*v(a1,p)+vcc2*v(a1,p)*v(a1,p))*1e-15*mf*FMOM_fac2'
Cpb1 b1 p '(Cp_finger+Cp_bus+Cp_pk)*(tfac)*(1+vcc1*v(b1,p)+vcc2*v(b1,p)*v(b1,p))*1e-15*mf*FMOM_fac2'

.ends cfmom_mx

.ENDL FMOM

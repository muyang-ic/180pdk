capm4_1p0_hl_2ta = geomAndNot(capm4_1p0_hla CTMDMY_3t)  ;
capm4_1p0_hl_2t = geomAnd(capm4_1p0_hl_2ta HLMIMCAP1P0)  ; 2T HL M4*CTM5 capacitance is 1.0fF per unit area.
;

; ***** Define connectivity/via layer -- psub_under_nbl ****
psub_under_nbl = geomOr(psub_term NBL)  ;

; ***** Define connectivity/via layer -- pa14g2_reg ****
pa14g2_reg = geomButtOrOver(pa14_r5 hvnw_nw)  ;

; ***** Define connectivity/via layer -- vargt ****
vargt = geomAndNot(vargt4 OD2)  ;1.8V baseband varactor

; ***** Define connectivity/via layer -- mom4p1 ****
mom4p1 = geomButtOrOver(mom4p11 MOMDMY25)  ;

; ***** Define connectivity/via layer -- nhvpwdnw_4t_col ****
nhvpwdnw_4t_colr = geomAnd(HVNW nhvpwdnw_4t_reg3)  ;

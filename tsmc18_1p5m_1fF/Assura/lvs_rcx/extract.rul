ngthvau = geomAnd(ngthva_hv27b HVDMY2)  ;

; ***** Define connectivity/via layer -- ngthva ****
ngthva2 = geomAndNot(ngthva1 NBL)  ;
ngthva3 = geomAndNot(ngthva2 LVGDMY)  ;
ngthva4 = geomAndNot(ngthva3 DNW)  ;

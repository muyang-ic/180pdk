;
;* Define device -- xdev mimcap_1p0_sin_3t
capm4_1p0_3t1 = geomButtOrOver(capm4_3t capdmy1p0)  ;
capm4_1p0_3t = geomAndNot(capm4_1p0_3t1 HLMIMCAP1P0)  ;
;
;* Define device -- xdev mimcap_2p0_sin_3t

; ***** Define connectivity/via layer -- mom3m2 ****
mom3p21 = geomAnd(metal3 MOMDMY24)  ;
mom3m2 = geomAndNot(mom3p21 geomButtOrOver(mom3p21 MOMDMY25))  ;

; ***** Define connectivity/via layer -- psub_under_dnw_via ****
psub_under_dnw = geomOr(psub_term DNW)  ;
psub_under_dnw_via = geomAnd(psub_term psub_under_dnw)  ;

; ***** Define connectivity/via layer -- hia_rf_via ****
hia_rf_via1 = geomAnd(RFDMY_HIA_psub psub)  ;
rw1 = geomAndNot(BULK ANWEL)  ;
rw_inside_dnw = geomInside(rw1 DNW)  ;
rw_inside_nbl = geomInside(rw1 NBL)  ;
rw_dnw_nbl = geomOr(rw_inside_dnw rw_inside_nbl)  ;
rw_inside_hvnwi = geomInside(rw1 HVNWi)  ;
rw = geomOr(rw_dnw_nbl rw_inside_hvnwi)  ;
hia_rf_via2 = geomAndNot(hia_rf_via1 rw)  ;
nw_dnw1 = geomButtOrOver(NWELL DNW)  ;
nw_dnw = geomButtOrOver(nw_dnw1 rw)  ;
hia_rf_via = geomAndNot(hia_rf_via2 nw_dnw)  ;

; ***** Define connectivity/via layer -- odCont ****
odCont1 = geomAndNot(pl1co POLY1)  ;
fgtCont1 = geomAnd(PO1 CONT)  ;
fgtCont = geomAnd(FGT fgtCont1)  ;
odCont = geomAndNot(odCont1 fgtCont)  ;

; ***** Define connectivity/via layer -- nwhvpwnbl60_emit ****
nwhvpwnbl60_emit = geomAnd(nwhvpwnbl_emit_2 HV60DMY)  ;

; ***** Define connectivity/via layer -- sbd_hv_dio ****
sbd_hole1 = geomHoles(PIMP innermost) ;
sbd_hole2 = geomHoles(RPO)  ;
sbd_hv_dio1 = geomAnd(sbd_hole1 sbd_hole2)  ;
sbd_hole3 = geomHoles(SH_P)  ;
sbd_hv_dio2 = geomAnd(sbd_hv_dio1 sbd_hole3)  ;
sbd_hv_dio3 = geomAnd(sbd_hv_dio2 DIODMY)  ;
sbd_hv_dio5 = geomAnd(sbd_hv_dio3 HV60DMY)  ;
sbd_hv_dio6 = geomAnd(sbd_hv_dio5 HVNW)  ;
sbd_hv_dio7 = geomAnd(sbd_hv_dio6 NBL)  ;
sbd_hv_dio = geomAnd(sbd_hv_dio7 M1)  ;

; ***** Define connectivity/via layer -- pa32g5_ac ****
pa32g5_ac = geomAnd(pa32g5_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- nlvpwnbl60_emit ****
nlvpwnbl60_emit = geomAnd(nlvpwnbl_emit_2 HV60DMY)  ;

; ***** Define connectivity/via layer -- ngthvs ****
ngthvs = geomAndNot(ngthvs2 MACRODMY)  ;

; ***** Define connectivity/via layer -- ind_mt ****
sz_inddmy = geomSize(INDDMY -50)  ;
ovlp_inddmy = geomAndNot(INDDMY sz_inddmy)  ;
mt_1ovlp_inddmy = geomAnd(mt4x ovlp_inddmy)  ;
inddmy_std = geomButtOrOver(INDDMY mt_1ovlp_inddmy)  ;
ind_std_dmy = geomButtOrOver(ind_dmy inddmy_std)  ;
std_ind1 = geomAnd(mt5x ind_std_dmy)  ;
std_ind2 = geomSize(std_ind1 2)  ;
std_ind3 = geomSize(std_ind2 -2)  ; SIZE OVER_UNDER BY 2 maximum spacing 3
std_hole = geomHoles(std_ind3)  ;
std_ind4 = geomButtOrOver(std_ind1 std_hole)  ;
ind_mt1 = geomAndNot(std_ind1 std_ind4)  ;
s_ind_dmy = geomSize(ind_dmy -50)  ;
ind_mt2 = geomAnd(ind_mt1 s_ind_dmy)  ;
std_ind5 = geomButtOrOver(ind_mt1 ind_mt2)  ;
ind_mt_a = geomAndNot(ind_mt1 std_ind5)  ;
sym_ct_mu_x_20k_ind = geomGetTexted( INDDMY IND_TEXT "spiral_sym_ct_mu_x_20k" )
ind_mt_b = geomAndNot(ind_mt_a geomButtOrOver(ind_mt_a sym_ct_mu_x_20k_ind))  ;
sym_ct_mu_x_40k_ind = geomGetTexted( INDDMY IND_TEXT "spiral_sym_ct_mu_x_40k" )
ind_mt = geomAndNot(ind_mt_b geomButtOrOver(ind_mt_b sym_ct_mu_x_40k_ind))  ;

; ***** Define connectivity/via layer -- phvnwdpw_col ****
phvnwdpw_base = geomCat(pwhvnwdpw_base)  ;
phvnwdpw_cols = geomButtOnly(HVPW phvnwdpw_base)  ;
phvnwdpw_col1 = geomOr(phvnwdpw_cols phvnwdpw_base)  ;
phvnwdpw_col = geomAndNot(phvnwdpw_col1 phvnwdpw_emit1)  ;

; ***** Define connectivity/via layer -- nemit ****
nemit = geomAndNot(nemit_gen OD2)  ;

; ***** Define connectivity/via layer -- rfdmy56_via ****

; ***** Define connectivity/via layer -- pwhvnwdpw_emit ****
pwhvnwdpw_emit = geomAnd(pwhvnwdpw_emit_2 HV40DMY)  ;

; ***** Define connectivity/via layer -- nbl_nplug ****
nwell_no_dpw = geomAndNot(nxwell geomButtOrOver(nxwell DPW))  ;
nbl_nplug1 = geomAnd(nwell_no_dpw NBL)  ; commanded by pywangi 
nbl_nplug2 = geomAnd(HVNWi NBL)  ;
nbl_nplug3 = geomOr(nbl_nplug1 nbl_nplug2)  ;

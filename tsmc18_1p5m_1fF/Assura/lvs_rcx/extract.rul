; ***** Define connectivity/via layer -- ndld24g5_ac ****
ndld24g5_r1 = geomAnd(ndld_gate2 HV40DMY)  ;
ndld24g5_ac = geomAnd(ndld24g5_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- ncoll ****
ncollrg = geomAndNot(ncollrg1 ULLNW)  ;
ncoll1 = geomButtOnly(ncollrg pbase)  ;
ncoll = geomOr(ncoll1 pbase)  ;define 1.8V BJT[NV] collector

; ***** Define connectivity/via layer -- indm5p ****
indm5 = geomAnd(indm5a metal5)  ;

hvndfs_bcd46d = geomAnd(hvndfs_bcd46c HVPW)  ;
hvndfs_bcd46 = geomAnd(hvndfs_bcd46d HVPBi)  ;
hvndfs_bcd12a = geomButtOrOver(tndiff nld_r3)  ;
hvndfs_bcd12 = geomAnd(hvndfs_bcd12a HVPB)  ; Source of HV NMOS
hvndfs1 = geomOr(hvndfs_bcd46 hvndfs_bcd12)  ;

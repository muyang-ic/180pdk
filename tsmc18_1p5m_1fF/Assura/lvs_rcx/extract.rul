capm4ud1 = geomAndNot(capm4b RFDUMMYUD)  ;
capm4ud2 = geomAndNot(capm4ud1 CTMDMY)  ;
capm4_ud = geomAnd(capm4ud2 CTMDMYUD)  ;
capm4_ud_2t = geomAndNot(capm4_ud CTMDMY_3t)  ;
CTMDMYall = geomOr(CTMDMY CTMDMYUD)  ;
capdmy1p0a = geomAndNot(CTMDMYall CTMDMY1p5)  ;
capdmy1p0 = geomAndNot(capdmy1p0a CTMDMY2p0)  ;ctmdmy1p0
capm4_1p0_ud1 = geomButtOrOver(capm4_ud_2t capdmy1p0)  ;
capm4_1p0_ud2 = geomAndNot(capm4_1p0_ud1 HLMIMCAP1P0)  ;
capm4_2t = geomAndNot(capm4 CTMDMY_3t)  ;
capm4_1p01 = geomButtOrOver(capm4_2t capdmy1p0)  ;
capm4_1p0 = geomAndNot(capm4_1p01 HLMIMCAP1P0)  ;
capm4_1p0_udc = geomOr(capm4_1p0_ud2 capm4_1p0)  ;
;
;* Define device -- xdev C2
capdmy2p0a = geomAndNot(CTMDMYall CTMDMY1p0)  ;
capdmy2p0b = geomAndNot(capdmy2p0a CTMDMY1p5)  ;
capdmy2p0 = geomAnd(capdmy2p0b CTMDMY2p0)  ;ctmdmy2p0
capm4_2p0_ud1 = geomButtOrOver(capm4_ud_2t capdmy2p0)  ;
capm4_2p0 = geomButtOrOver(capm4_2t capdmy2p0)  ;
capm4_2p0_udc = geomOr(capm4_2p0_ud1 capm4_2p0)  ;
;
;* Define device -- xdev mimcap_1p5

extractDevice("mimcap_1p0_sin_hl" capm4_1p0_hl_2t ctm("TOP") metal4("BOT")
	spiceModel( "mimcap_1p0_sin_hl" )
	cellView( "mimcap_1p0_sin_hl ivpcell" )
	flagMalformed )
	area_CAP = measureParameter(area (capm4_1p0_hl_2t) 1e-12)
	pj_CAP = measureParameter(perimeter (capm4_1p0_hl_2t) 1e-6)
	A_CAP    = measureParameter(area (capm4_1p0_hl_2t))
	P_CAP   = measureParameter(perimeter (capm4_1p0_hl_2t))
	P_2_CAP = calculateParameter( P_CAP * P_CAP)
	AC4 = calculateParameter( A_CAP * 16)
	KKK = calculateParameter( P_2_CAP-AC4)
	SQ = calculateParameter(sqrt(KKK))
	wt = calculateParameter( ((P_CAP - SQ)/4) * 1e-6)
	lt = calculateParameter( ((P_CAP + SQ)/4) * 1e-6)
	M = calculateParameter( lt/lt )
	LAY = calculateParameter( lt/lt*5 )
	nameParameter( LAY "lay" )
	nameParameter( LAY "mLvl" )
	nameParameter( lt "lt")
	nameParameter( lt "l")
	nameParameter( wt "wt")
	nameParameter( wt "w")
	nameParameter( M "m" )
	if( !avSwitch( "spice_extraction") then  
		saveProperty( capm4_1p0_hl_2t "model" "mimcap_1p0_sin_hl")
	)
	rcxLayer(capm4_1p0_hl_2t)


; ***** Define connectivity/via layer -- coll ****
collsur = geomButtOnly(psub nbase)  ;
coll1a = geomOr(collsur nbase)  ;  define BJT[PV] collector
collsura = geomButtOnly(collsur emit)  ;
coll1b = geomAndNot(coll1a collsura)  ;
coll = geomAndNot(coll1b emit)  ;  define pnp collector

; ***** Define connectivity/via layer -- ngt_lhl ****
ngt_lhl1 = geomAndNot(ngthv_hv27a geomButtOrOver(ngthv_hv27a RPO))  ;
ngt_lhl2 = geomAnd(ngt_lhl1 HVPW)  ;
ngt_lhl3 = geomAnd(ngt_lhl2 LHLDMY)  ;
ngt_lhl = geomAndNot(ngt_lhl3 DNW)  ;

; ***** Define connectivity/via layer -- indm5m ****
indm5m = geomAnd(indm5 IND_MP)  ;

; ***** Define connectivity/via layer -- pa32g5_reg ****
pa32g5_reg = geomAndNot(pa32g5_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- rfpad_r ****
m5_pad = geomAnd(M5 RFPADDMY)  ;
rfpad1 = geomAnd(RFPADDMY m5_pad)  ;
m4_pad = geomAnd(M4 RFPADDMY)  ;
rfpad2 = geomButtOrOver(rfpad1 m4_pad)  ;
rpoly = geomOr(POLY1 DPO)  ;
rfpad3 = geomAnd(rfpad2 rpoly)  ;
rfpad = geomButtOrOver(rfpad3 VIA4)  ;
rfpad_r = geomCat(rfpad)  ;

; ***** Define connectivity/via layer -- nlvpwnbl_col ****
nlvpwnbl_cols = geomButtOnly(nlvpwnbl_colr nlvpwnbl_base)  ;
nlvpwnbl_col1 = geomOr(nlvpwnbl_cols nlvpwnbl_base)  ;
nlvpwnbl_emit2 = drc(nlvpwnbl_emit 3.999 < area < 4.001) ;
nlvpwnbl_col = geomAndNot(nlvpwnbl_col1 nlvpwnbl_emit2)  ;

; ***** Define connectivity/via layer -- nhvpwnbl_col ****
nhvpwnbl_cols = geomButtOnly(nhvpwnbl_cols3 nhvpwnbl_base)  ;

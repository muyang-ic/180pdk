pwpepinbl_dio_5_60_r = geomButtOrOver(pwpepinbl_dio_60b OD2)  ;  5v pwpepinbl_dio_5 diode
;
;* Define device -- xdev ppnblpepi_dio
hv_nbl1 = geomAnd(NBL HV40DMY)  ;
hv_nbl40 = geomButtOrOver(NBL hv_nbl1)  ;
ppnblpepidio_r = geomAndNot(hv_nbl40 geomButtOrOver(hv_nbl40 nblpepidio))  ;
;
;* Define device -- xdev ppnblpepi_dio_60
hv_nbl2 = geomAnd(NBL HV60DMY)  ;
hv_nbl60 = geomButtOrOver(NBL hv_nbl2)  ;
ppnblpepidio_60_r = geomAndNot(hv_nbl60 geomButtOrOver(hv_nbl60 nblpepidio_60))  ;
;
;* Define device -- xdev ppdpwnbl_dio
ppdpwnbldio_r1 = geomAnd(DPW hv_nbl40)  ;
ppdpwnbldio_r2 = geomAndNot(ppdpwnbldio_r1 geomButtOrOver(ppdpwnbldio_r1 dpwnbldio))  ;
ppdpwnbldio_r = geomAndNot(ppdpwnbldio_r2 geomButtOrOver(ppdpwnbldio_r2 hvndfd))  ;
;
;* Define device -- xdev ppdpwnbl_dio_60
ppdpwnbldio_60_r1 = geomAnd(DPW hv_nbl60)  ;
ppdpwnbldio_60_r2 = geomAndNot(ppdpwnbldio_60_r1 geomButtOrOver(ppdpwnbldio_60_r1 dpwnbldio_60))  ;
ppdpwnbldio_60_r3 = geomAndNot(ppdpwnbldio_60_r2 geomButtOrOver(ppdpwnbldio_60_r2 BJTDMY))  ;
ppdpwnbldio_60_r = geomAndNot(ppdpwnbldio_60_r3 geomButtOrOver(ppdpwnbldio_60_r3 hvndfd))  ;
;
;* Define device -- xdev ppldpwhvnw_dio
ppldpwhvnwdio1 = geomAnd(LDPW HVNWi)  ;
ppldpwhvnwdio_r = geomButtOrOver(ppldpwhvnwdio1 nch_hvnw_6t_reg)  ;
;
;* Define device -- xdev pphvnwpsub_dio
pphvnwpsubdio1 = geomButtOrOver(HVNWi ppldpwhvnwdio_r)  ;
pphvnwpsubdio2 = geomButtOrOver(HVNWi pch_5t_reg)  ;
pphvnwpsubdio_r = geomOr(pphvnwpsubdio1 pphvnwpsubdio2)  ;
;
;* Define device -- xdev ppnbldio_hv_iso
nbldio_hv_iso_r1 = geomAnd(NBL HVOX)  ;
nbldio_hv_iso_r = geomButtOrOver(nbldio_hv_iso_r1 ngthvish_reg)  ;
;
;* Define device -- xdev pphvpwdio_hv_iso
hvpwdio_hv_iso_r1 = geomAnd(HVPW nbldio_hv_iso_r1)  ;
hvpwdio_hv_iso_r = geomButtOrOver(hvpwdio_hv_iso_r1 ngthvish_reg)  ;
;
;* Define device -- xdev pphvnwdnwpsubhvpw_dio_iso_ac
hvnwdnwpsubhvpw_dio_iso_r1 = geomButtOrOver(DNW HVDMY)  ;
hvnwdnwpsubhvpw_dio_iso_r2 = geomButtOrOver(hvnwdnwpsubhvpw_dio_iso_r1 HVNW)  ;
hvnwdnwpsubhvpw_dio_iso_ac_r = geomButtOrOver(hvnwdnwpsubhvpw_dio_iso_r2 DIO3TDMY)  ;
;
;* Define device -- xdev pphvnwdnwpsubhvpw_dio_iso
hvnwdnwpsubhvpw_dio_iso_r = geomAndNot(hvnwdnwpsubhvpw_dio_iso_r2 geomButtOrOver(hvnwdnwpsubhvpw_dio_iso_r2 DIODMYa))  ;
;
;* Define device -- xdev pphvnwpsubhvpw_dio_iso_ac
hvnwpsubhvpw_dio_iso_ac_r1 = geomAndNot(HVNW NBL)  ;
hvnwpsubhvpw_dio_iso_ac_r2 = geomAndNot(hvnwpsubhvpw_dio_iso_ac_r1 DNW)  ;
hvnwpsubhvpw_dio_iso_ac_r3 = geomAnd(hvnwpsubhvpw_dio_iso_ac_r2 HVDMY)  ;
hvnwpsubhvpw_dio_iso_ac_r = geomButtOrOver(hvnwpsubhvpw_dio_iso_ac_r3 DIO3TDMY)  ;
;
;* Define device -- xdev dnwpsub
dnwdio_b = geomButtOrOver(nxwell DNW)  ;
dnwdio_a = geomInside(nxwell DNW)  ;
dnwdio_c = geomAndNot(dnwdio_b dnwdio_a)  ;
dnwdio_d = geomButtOrOver(DNW dnwdio_c)  ;
dnwdio_e = geomAndNot(dnwdio_d HVNW)  ;
dnwdio_f = geomAndNot(dnwdio_e geomButtOrOver(dnwdio_e HVDMY))  ;filter DNW/PSUB in HV27V Isolated HVNMOS
dnwdio = geomAndNot(dnwdio_f rfdmy56)  ;
;
;* Define device -- xdev pwdnw
rwdio_b1 = geomAndNot(DNW nxwell)  ;
rwdio_b2 = geomAndNot(rwdio_b1 HVNW)  ;
rwdio_b3 = geomAndNot(rwdio_b2 geomButtOrOver(rwdio_b2 HVDMY))  ;filter PW/DNW in HV27V Isolated HVNMOS
rwdio_b4 = geomAndNot(rwdio_b3 BJTDMY)  ;
rwdio_a = geomAndNot(rwdio_b4 DMYLD)  ;
rwdio = geomAndNot(rwdio_a rfdmy56)  ;
;
;* Define device -- xdev pnwdio
nw_hole = geomHoles(nxwell)  ;
nw_noring = geomAndNot(nxwell geomButtOrOver(nxwell nw_hole))  ;
nbase_all = geomOr(nbase nbase_od2)  ;
bjtdmy_nbase_all = geomButtOrOver(BJTDMY nbase_all)  ; BJTDMY in pnp devices
pnwdio0 = geomAndNot(nw_noring bjtdmy_nbase_all)  ;
pnwdio1 = geomAndNot(pnwdio0 geomButtOrOver(pnwdio0 RWDMY1))  ;
pnwdio2 = geomOutside(pnwdio1 nwdio)  ;
pnwdio3 = geomOutside(pnwdio2 nwdio_IO)  ;
pnwdio4 = geomButtOnly(pnwdio3 psub)  ;
pnwdio5 = geomAndNot(pnwdio4 geomButtOrOver(pnwdio4 DNW))  ;
pnwdio6 = geomAndNot(pnwdio5 geomButtOrOver(pnwdio5 NBL))  ;
pnwdio7 = geomAndNot(pnwdio6 ULLNW)  ;
pnwdio8 = geomAndNot(pnwdio7 OD3)  ;
pnwdio_od2 = geomButtOrOver(pnwdio8 OD2)  ; pnwdio_5
pnwdio = geomAndNot(pnwdio8 pnwdio_od2)  ; pnwdio
;
;* Define device -- xdev pnwdio_ull
pnwdio1_ull = geomAnd(pnwdio6 ULLNW)  ;
pnwdio2_ull = geomButtOrOver(pnwdio1_ull OD3)  ;
pnwdio_ull_od2 = geomButtOrOver(pnwdio2_ull OD2)  ; ULL pnwdio_5_ull
pnwdio_ull = geomAndNot(pnwdio2_ull pnwdio_ull_od2)  ; ULL pnwdio_ull
;
;* Define device -- xdev pnwdio_ell
pnwdio1_ell = geomAnd(pnwdio6 ULLNW)  ;
pnwdio2_ell = geomButtOrOver(pnwdio1_ell ELLDMY)  ;
pnwdio3_ell = geomButtOrOver(pnwdio2_ell OD3)  ;
pnwdio_ell_od2 = geomButtOrOver(pnwdio3_ell OD2)  ; ULL pnwdio_5_ell
pnwdio_ell = geomAndNot(pnwdio3_ell pnwdio_ell_od2)  ; ULL pnwdio_ell
;
;* Define device -- nmos nch_sf3
tngate_cis1 = geomAnd(gate_lv CIRPO)  ;
tngate_cis2 = geomAnd(tngate_cis1 OD2)  ;
tngate_cis31 = geomButtOrOver(tngate_cis2 NIMP)  ;
tngate_cis3 = geomAndNot(tngate_cis31 NMOS_VT)  ;
tngate_cis4 = geomInside(tngate_cis3 PWELLX)  ;
tngate_cis5 = geomAnd(tngate_cis4 CELLM)  ;
nsfgate1 = geomAndNot(tngate_cis5 CELL_RS)  ;
nsfgate2 = geomAndNot(nsfgate1 geomButtOrOver(nsfgate1 CELL_TX))  ;
nsfgate = geomAndNot(nsfgate2 CELL_SL)  ;  3.3V Source follower nmos cell device
;
;* Define device -- nmos nch_rt3
nrtgate1 = geomAnd(tngate_cis5 CELL_RS)  ;
nrtgate = geomAndNot(nrtgate1 CELL_SL)  ;  3.3V Reset gate nmos cell device
;
;* Define device -- nmos nch_rs3
nrsgate1 = geomAndNot(tngate_cis5 CELL_RS)  ;
nrsgate = geomAnd(nrsgate1 CELL_SL)  ;  3.3V Row Select gate nmos cell device
;
;* Define device -- xdev nch_tg3
tngate_cis6 = geomStraddle(tngate_cis3 PWELLX)  ;
tngate_cis7 = geomButtOrOver(tngate_cis6 NPS)  ;
tngate_cis8 = geomButtOrOver(tngate_cis7 PPS)  ;
tngate_cis9 = geomButtOrOver(tngate_cis8 CELLH)  ;
tngate_cis10 = geomAnd(tngate_cis9 CELLM)  ;
ntggate = geomButtOrOver(tngate_cis10 CELL_TX)  ;  3.3V transfer gate nmos cell device
;
;* Define device -- xdev pindio_cis
pindio1 = geomStraddle(diff PWELLX)  ;
pindio2 = geomAnd(pindio1 CELLM)  ;
pindio3 = geomAnd(pindio2 CELLH)  ;
pindio4 = geomAnd(pindio3 PPS)  ;
pindio5 = geomAndNot(pindio4 POLY1)  ;
pindio = geomAnd(pindio5 NPS)  ;
;
;* Define device -- nmos ST
cngate1 = geomAnd(tngate1 CIRPO)  ;
PWELL = geomOr(psub PWELLX)  ;
cngate2 = geomButtOrOver(cngate1 PWELL)  ;
cngate3 = geomAnd(cngate2 OD2)  ;
cngate4 = geomAnd(cngate3 NMOS_VT)  ;
cngate6 = geomAndNot(cngate4 CELLM)  ;
cngate = geomAndNot(cngate6 CELLH)  ;   3.3V Select transistor nmos cell device
;
;* Define device -- nmos RT
cnhgate = geomAnd(cngate6 CELLH)  ;   3.3V Rest transistor nmos cell device
;
;* Define device -- nmos SF
cngate5 = geomAnd(cngate4 CELLM)  ;
cnmgate = geomAndNot(cngate5 CELLH)  ;   3.3V Source follower nmos cell device
;
;* Define device -- diode DC
wdio_s1 = geomAndNot(nps2 PWELLX)  ;
wdio_s2 = geomAndNot(wdio_s1 geomButtOrOver(wdio_s1 POLY1))  ;
wdio_s3 = geomAndNot(wdio_s2 CI)  ;
wdio_s = geomAndNot(wdio_s3 PPS)  ;   NPS_PSUB diode
;
;* Define device -- diode DY
pwdio_s = geomAnd(wdio_s3 PPS)  ;   NPSPPS_PSUB diode
;
;* Define device -- xdev DZ1
cwdio_s = geomAnd(wdio_s2 CI)  ;   CI_PSUB diode
;
;* Define device -- diode nwdio_bg_cis
nwdio_bg1 = geomAnd(diff OD2)  ;
nwdio_bg2 = geomAnd(nwdio_bg1 CIRPO)  ;
nwdio_bg3 = geomAnd(nwdio_bg2 BGP)  ;
nwdio_bg = geomAnd(nwdio_bg3 BGN)  ;
;
;* Define device -- nmos HZ
hvgate_flash = geomAnd(gate_norf hvwell)  ; special for flash
hngate1 = geomAnd(hvgate_flash NIMP)  ;
hngate2 = geomAnd(hngate1 NOPW)  ;
hzgate1 = geomAndNot(hngate2 HNVT)  ;
hzgate2 = geomAndNot(hzgate1 NTN)  ;
hzgate = geomAndNot(hzgate2 nfgate)  ;
;
;* Define device -- nmos HN
hngate = geomAnd(hngate2 HNVT)  ;
;
;* Define device -- pmos HP
hpgate1 = geomAnd(hvgate_flash PIMP)  ;
hpgate2 = geomAnd(hpgate1 HVNW)  ;
hpgate3 = geomAndNot(hpgate2 geomButtOrOver(hpgate2 NWELL))  ;separate M(HP) from MP(pch_5t) (BCD12V)
hpgate = geomAndNot(hpgate3 geomButtOrOver(hpgate3 PDD_BCD))  ;separate M(HP) from LDDP(pa14_g2) (BCD12V)
;
;* Define device -- xdev DZ2
zenpdif1 = geomButtOrOver(pdio_b dz_ring)  ;
zenpdif = geomAnd(zenpdif1 HVNW)  ;  Zenar diode (flash) P+/HVNW
;
;* Define ERC or other layers
psub_float1 = geomAndNot(psub geomButtOrOver(psub RWDMY))  ; exclude HVPW resistor for floating psub check
psub_float2 = geomAndNot(psub_float1 geomButtOrOver(psub_float1 BJTDMY))  ; exclude psub BJT for floating psub check
psub_float = geomAndNot(psub_float2 geomButtOrOver(psub_float2 gate_hv))  ; exclude psub of LDMOS Drain for floating psub check
c_pmall = geomAndNot(nxwell NTN)  ; pmos all for WPE (clear tone)
c_pmcore = geomAndNot(c_pmall OD2)  ; pmos all for WPE (clear tone)
c_pmIO = geomAnd(c_pmall OD2)  ; pmos all for WPE (clear tone)
celdiffg = geomOr(fggate tndiff)  ;
erc_exclude1 = geomOr(VARDMYX VARG3)  ;
erc_exclude = geomOr(erc_exclude1 VARG6)  ;
erc_mos_gates = geomAndNot(gate_norf erc_exclude)  ;
erc_nmos_gates1 = geomButtOrOver(erc_mos_gates NIMP)  ;
erc_nmos_gates2 = geomAndNot(erc_nmos_gates1 nxwell)  ;
erc_nmos_gates3 = geomAndNot(erc_nmos_gates2 HVNW)  ;
erc_nmos_gates4 = geomAndNot(erc_nmos_gates3 NDD)  ;
erc_nmos_gates = geomAndNot(erc_nmos_gates4 NDD_BCD)  ;
HVNW_float1 = geomAndNot(HVNW geomButtOrOver(HVNW RWDMY))  ; exclude resistor for floating HVNW check
HVNW_float2 = geomAndNot(HVNW_float1 geomButtOrOver(HVNW_float1 rpbody_r))  ;
HVNW_float3 = geomAndNot(HVNW_float2 geomButtOrOver(HVNW_float2 rpdd_hv))  ;
HVNW_float4 = geomAndNot(HVNW_float3 geomButtOrOver(HVNW_float3 BJTDMY))  ; exclude HVNW BJT for floating HVNW check
HVNW_float5 = geomAndNot(HVNW_float4 geomButtOrOver(HVNW_float4 DIODMY))  ; exclude HVNW DIODE for floating HVNW check
HVNW_float = geomAndNot(HVNW_float5 geomButtOrOver(HVNW_float5 gate_hv))  ; exclude HVNW of LDMOS Drain for floating HVNW check
erc_pmos_gates1 = geomButtOrOver(erc_mos_gates PIMP)  ;
erc_pmos_gates2 = geomAnd(erc_pmos_gates1 nxwell)  ;
erc_pmos_gates3 = geomAnd(erc_pmos_gates1 HVNW)  ;
erc_pmos_gates4 = geomOr(erc_pmos_gates2 erc_pmos_gates3)  ;
erc_pmos_gates = geomAndNot(erc_pmos_gates4 PDD)  ;
nw_ntn = geomOr(nxwell NTN)  ;
c_nmIO = geomAndNot(OD2 nw_ntn)  ; nmos IO for WPE (clear tone) 
nxwell_float1 = geomAndNot(nxwell geomButtOrOver(nxwell VARDMY))  ; exclude nwell under VAR for floating nwell check
nxwell_float2 = geomAndNot(nxwell_float1 geomButtOrOver(nxwell_float1 RWDMY))  ; exclude nwell resistor for floating nwell check
nxwell_float = geomAndNot(nxwell_float2 geomButtOrOver(nxwell_float2 BJTDMY))  ; exclude nwell under BJTDMY for floating nwell check
celdifnf = geomOr(nfgate tndiff)  ;
poly_erc1 = geomButtOrOver(OD zd_hv_dio12)  ;od interact zd_dio reg layer
poly_erc = geomAndNot(POLY1 geomButtOrOver(POLY1 poly_erc1))  ;
d_nmcore = geomOr(OD2 nw_ntn)  ; nmos core for WPE (Dark tone)
c_nmcore = geomAndNot(BULK d_nmcore)  ; nmos core for WPE (clear tone)


; ***** logic operation from XDEV statements *****
MOM_field1 = geomAnd(M1 MOMDMY1)
MOM_field2 = geomAnd(M2 MOMDMY2)
MOM_field3 = geomAnd(M3 MOMDMY3)
MOM_field4 = geomAnd(M4 MOMDMY4)
MOM_field5 = geomAnd(M5 MOMDMY5)
MOM_pin3 = geomAnd( metal3 MOMDMY22 )    
MOM_pin4 = geomAnd( metal4 MOMDMY22 )    
F_reg1a = drc( MOM_field1 0 < sep < 0.565 opposite parallel shielded) 
F_reg1  = geomAndNot( geomAnd( F_reg1a MOMDMY1 ) M1 )
F_reg2a = drc( MOM_field2 0 < sep < 0.565 opposite parallel shielded) 
F_reg2  = geomAndNot( geomAnd( F_reg2a MOMDMY2 ) M2 )
F_reg3a = drc( MOM_field3 0 < sep < 0.565 opposite parallel shielded) 
F_reg3  = geomAndNot( geomAnd( F_reg3a MOMDMY3 ) M3 )
F_reg4a = drc( MOM_field4 0 < sep < 0.565 opposite parallel shielded) 
F_reg4  = geomAndNot( geomAnd( F_reg4a MOMDMY4 ) M4 )
mom13_1 = geomButtOrOver(MOMDMY3 MOM_field1)
mom13_2 = geomButtOrOver(mom13_1 MOM_field2)
mom13_3 = geomButtOrOver(mom13_2 MOM_field3)
mom13_idt = geomAndNot(MOM_field3 MOM_field2)
mom13_4 = geomAndNot(mom13_3 geomButtOrOver(mom13_3 MOM_field4))
mom13_reg1 = geomAndNot(mom13_4 geomButtOrOver(mom13_4 RFDUMMY))
mom13_reg0 = geomAndNot(mom13_reg1 RFDUMMY1)
mom13_reg = geomButtOrOver(mom13_reg0 mom13_idt)
mom13_reg_rf0 = geomAnd(mom13_reg1 RFDUMMY1)
mom13_reg_rf = geomButtOrOver(mom13_reg_rf0 mom13_idt)
fmom13_reg1	= geomAndNot(mom13_4 geomButtOrOver(mom13_4 RFDUMMY))
fmom13_reg2	= geomAndNot(fmom13_reg1 geomButtOrOver(fmom13_reg1 RFDUMMY1))
fmom13_reg3	= geomAndNot(fmom13_reg2 geomButtOrOver(fmom13_reg2 mom13_idt))
fmom13_reg4	= geomButtOrOver(fmom13_reg3 MOMDMY100) 
fmom13_reg5	= geomAndNot(fmom13_reg4  geomButtOrOver(fmom13_reg4 MOMDMY22))
fmom13_reg	= geomButtOrOver(fmom13_reg5 NIMP) 
fmom13_rf_reg1 = geomButtOrOver(mom13_4 RFDUMMY1)
fmom13_rf_reg2 = geomAndNot(fmom13_rf_reg1 geomButtOrOver(fmom13_rf_reg1 mom13_idt))
fmom13_rf_reg3 = geomButtOrOver(fmom13_rf_reg2 MOMDMY100)
fmom13_rf_reg4 = geomAndNot(fmom13_rf_reg3 geomButtOrOver(fmom13_rf_reg3 MOMDMY22))
fmom13_rf_reg  = geomButtOrOver(fmom13_rf_reg4 NIMP)
fmom13_mx_reg1 = geomAndNot(MOMDMY22 geomButtOrOver(MOMDMY22 RFDUMMY))
fmom13_mx_reg2 = geomAndNot(fmom13_mx_reg1 geomButtOrOver(fmom13_mx_reg1 RFDUMMY1))
fmom13_mx_reg3 = geomButtOrOver(fmom13_mx_reg2 mom13_4)
fmom13_mx_reg4 = geomAndNot(fmom13_mx_reg3 geomButtOrOver(fmom13_mx_reg3 mom13_idt))
fmom13_mx_reg5 = geomButtOrOver(fmom13_mx_reg4 MOMDMY100)
fmom13_mx_reg  = geomButtOrOver(fmom13_mx_reg5 NIMP)
mom13_mx_aux   = geomAnd(mom13_4 MOMDMY22)
mom14_1 = geomButtOrOver(MOMDMY4 MOM_field1)
mom14_2 = geomButtOrOver(mom14_1 MOM_field2)
mom14_3 = geomButtOrOver(mom14_2 MOM_field3)
mom14_4 = geomButtOrOver(mom14_3 MOM_field4)
mom14_idt = geomAndNot(MOM_field4 MOM_field3)
mom14_reg1 = geomAndNot(mom14_4 geomButtOrOver(mom14_4 RFDUMMY))
mom14_reg0 = geomAndNot(mom14_reg1 RFDUMMY1)
mom14_reg = geomButtOrOver(mom14_reg0 mom14_idt)
mom14_reg_rf0 = geomAnd(mom14_reg1 RFDUMMY1)
mom14_reg_rf = geomButtOrOver(mom14_reg_rf0 mom14_idt)
fmom14_reg1	= geomAndNot(mom14_4 geomButtOrOver(mom14_4 RFDUMMY))
fmom14_reg2	= geomAndNot(fmom14_reg1 geomButtOrOver(fmom14_reg1 RFDUMMY1))
fmom14_reg3	= geomAndNot(fmom14_reg2 geomButtOrOver(fmom14_reg2 mom14_idt))
fmom14_reg4	= geomButtOrOver(fmom14_reg3 MOMDMY100) 
fmom14_reg5	= geomAndNot(fmom14_reg4  geomButtOrOver(fmom14_reg4 MOMDMY22))
fmom14_reg	= geomButtOrOver(fmom14_reg5 NIMP) 
fmom14_rf_reg1 = geomButtOrOver(mom14_4 RFDUMMY1)
fmom14_rf_reg2 = geomAndNot(fmom14_rf_reg1 geomButtOrOver(fmom14_rf_reg1 mom14_idt))
fmom14_rf_reg3 = geomButtOrOver(fmom14_rf_reg2 MOMDMY100)
fmom14_rf_reg4 = geomAndNot(fmom14_rf_reg3 geomButtOrOver(fmom14_rf_reg3 MOMDMY22))
fmom14_rf_reg  = geomButtOrOver(fmom14_rf_reg4 NIMP)
fmom14_mx_reg1 = geomAndNot(MOMDMY22 geomButtOrOver(MOMDMY22 RFDUMMY))
fmom14_mx_reg2 = geomAndNot(fmom14_mx_reg1 geomButtOrOver(fmom14_mx_reg1 RFDUMMY1))
fmom14_mx_reg3 = geomButtOrOver(fmom14_mx_reg2 mom14_4)
fmom14_mx_reg4 = geomAndNot(fmom14_mx_reg3 geomButtOrOver(fmom14_mx_reg3 mom14_idt))
fmom14_mx_reg5 = geomButtOrOver(fmom14_mx_reg4 MOMDMY100)
fmom14_mx_reg  = geomButtOrOver(fmom14_mx_reg5 NIMP)
mom14_mx_aux   = geomAnd(mom14_4 MOMDMY22)
mom24_1 = geomAndNot(MOMDMY4 geomButtOrOver(MOMDMY4 MOM_field1))
mom24_2 = geomButtOrOver(mom24_1 MOM_field2)
mom24_3 = geomButtOrOver(mom24_2 MOM_field3)
mom24_4 = geomButtOrOver(mom24_3 MOM_field4)
mom24_idt = geomAndNot(MOM_field4 MOM_field3)
mom24_reg1 = geomAndNot(mom24_4 geomButtOrOver(mom24_4 RFDUMMY))
mom24_reg0 = geomAndNot(mom24_reg1 RFDUMMY1)
mom24_reg = geomButtOrOver(mom24_reg0 mom24_idt)
mom24_reg_rf0 = geomAnd(mom24_reg1 RFDUMMY1)
mom24_reg_rf = geomButtOrOver(mom24_reg_rf0 mom24_idt)
fmom24_reg1	= geomAndNot(mom24_4 geomButtOrOver(mom24_4 RFDUMMY))
fmom24_reg2	= geomAndNot(fmom24_reg1 geomButtOrOver(fmom24_reg1 RFDUMMY1))
fmom24_reg3	= geomAndNot(fmom24_reg2 geomButtOrOver(fmom24_reg2 mom24_idt))
fmom24_reg4	= geomButtOrOver(fmom24_reg3 MOMDMY100) 
fmom24_reg5	= geomAndNot(fmom24_reg4  geomButtOrOver(fmom24_reg4 MOMDMY22))
fmom24_reg	= geomButtOrOver(fmom24_reg5 NIMP) 
fmom24_rf_reg1 = geomButtOrOver(mom24_4 RFDUMMY1)
fmom24_rf_reg2 = geomAndNot(fmom24_rf_reg1 geomButtOrOver(fmom24_rf_reg1 mom24_idt))
fmom24_rf_reg3 = geomButtOrOver(fmom24_rf_reg2 MOMDMY100)
fmom24_rf_reg4 = geomAndNot(fmom24_rf_reg3 geomButtOrOver(fmom24_rf_reg3 MOMDMY22))
fmom24_rf_reg  = geomButtOrOver(fmom24_rf_reg4 NIMP)
fmom24_mx_reg1 = geomAndNot(MOMDMY22 geomButtOrOver(MOMDMY22 RFDUMMY))
fmom24_mx_reg2 = geomAndNot(fmom24_mx_reg1 geomButtOrOver(fmom24_mx_reg1 RFDUMMY1))
fmom24_mx_reg3 = geomButtOrOver(fmom24_mx_reg2 mom24_4)
fmom24_mx_reg4 = geomAndNot(fmom24_mx_reg3 geomButtOrOver(fmom24_mx_reg3 mom24_idt))
fmom24_mx_reg5 = geomButtOrOver(fmom24_mx_reg4 MOMDMY100)
fmom24_mx_reg  = geomButtOrOver(fmom24_mx_reg5 NIMP)
mom24_mx_aux   = geomAnd(mom24_4 MOMDMY22)
sbd_w = drc(schottky_p schottky_n sep < 0.49 opposite)
jvar_nr = geomEnclose(jvar_rf3t jvarp_rf keep == 36)   ; nr ==36
jvar_ws = geomEnclose(jvar_rf3t jvarp_rf ignore == 36) ; nr != 36
w_fac   = drc(jvarp_rf jvarn_rf sep < 0.29 opposite)
jvar_nr = geomEnclose(jvar_rf3t jvarp_rf keep == 36)   ; nr ==36
jvar_ws = geomEnclose(jvar_rf3t jvarp_rf ignore == 36) ; nr != 36
w_fac   = drc(jvarp_rf jvarn_rf sep < 0.29 opposite)


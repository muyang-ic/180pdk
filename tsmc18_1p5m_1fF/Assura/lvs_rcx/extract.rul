; ***** Define connectivity/via layer -- nwhvpwnbl_emit ****
nwhvpwnbl_emit = geomAnd(nwhvpwnbl_emit_2 HV40DMY)  ;

; ***** Define connectivity/via layer -- dpwc ****
dpwc = geomAnd(DPW HVPW)  ;

; ***** Define connectivity/via layer -- hvnwdpwnbl_col ****
hvnwdpwnbl_cols = geomButtOnly(nlvpwnbl_colr hvnwdpwnbl_base)  ;
hvnwdpwnbl_col1 = geomOr(hvnwdpwnbl_cols hvnwdpwnbl_base)  ;
hvnwdpwnbl_col = geomAndNot(hvnwdpwnbl_col1 hvnwdpwnbl60_emit)  ;

; ***** Define connectivity/via layer -- pa40g5ron_reg ****
pa40g5ron_reg = geomAndNot(pa40g5ron_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- nhvpwnbl_emit ****
nhvpwnbl_emit = geomAnd(nhvpwnbl_emit_2 HV40DMY)  ;

; ***** Define connectivity/via layer -- ngthva_lg ****
ngthva_lg = geomAnd(ngthva2 LVGDMY)  ;

; ***** Define connectivity/via layer -- mim_nw_via ****
mim_nw_via = geomAnd(mim_term nxwell)  ;

; ***** Define connectivity/via layer -- pgthvs ****
pgthvs2 = geomAndNot(pgthvs1 LVGDMY)  ;
pgthvs = geomAndNot(pgthvs2 MACRODMY)  ;

; ***** Define connectivity/via layer -- poly_psub ****
poly_psub = geomAnd(poly_term psub)  ;

; ***** Define connectivity/via layer -- ngthvi_mac ****
ngthvi2 = geomAnd(ngthva1 DNW)  ;
ngthvi3 = geomAndNot(ngthvi2 LVGDMY)  ;
ngthvi_mac = geomAnd(ngthvi3 MACRODMY)  ;

; ***** Define connectivity/via layer -- coll_od2 ****
collsur_3 = geomButtOnly(psub nbase_od2)  ;
coll2a = geomOr(collsur_3 nbase_od2)  ;  define BJT[PV] collector
collsurb = geomButtOnly(collsur_3 emit_od2)  ;
coll2b = geomAndNot(coll2a collsurb)  ;
coll_od2 = geomAndNot(coll2b emit_od2)  ;  define pnp collector

; ***** Define connectivity/via layer -- nld60g5_reg ****
nld60g5_reg = geomAndNot(nld60g5_r1 nld60g5_ac)  ;

; ***** Define connectivity/via layer -- ncoll_od2 ****
ncoll2 = geomButtOnly(ncollrg pbase_od2)  ;
ncoll_od2 = geomOr(ncoll2 pbase_od2)  ;define 3.3/5V BJT[N1] collector

;//#############################################

nhvpwnbl_col = geomAndNot(nhvpwnbl_col1 nhvpwnbl_emit_2)  ;

; ***** Define connectivity/via layer -- metal6 ****
if(avSwitch("Cu_RDL") then
  metal6 = geomCat(MD)  ;
else    
  metal6 = geomCat(AP_Cu)  ;
) ;  ;

; ***** Define connectivity/via layer -- nld14g2_mac ****
nld14g2_mac = geomAnd(nld14g2_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- pidiff ****
tdiff1 = geomAndNot(mdiff NIMP)  ;
tdiff2 = geomAndNot(tdiff1 PIMP)  ;

pm_cbd = geomAnd(PLMIDE CBD)  ;

; ***** Define connectivity/via layer -- pgthva_lg ****
pgthva1 = geomAndNot(pgthv3b pgthvs1)  ;
pgthva_lg = geomAnd(pgthva1 LVGDMY)  ;

; ***** Define connectivity/via layer -- ell_ncoll ****
ell_ncollrg = geomAnd(ull_ncollrg1 ELLDMY)  ;
ell_ncoll1 = geomButtOnly(ell_ncollrg pbase)  ;
ell_ncoll = geomOr(ell_ncoll1 pbase)  ;

; ***** Define connectivity/via layer -- pa18g5_ac ****
pa18g5_ac = geomAnd(pa18g5_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- indpin ****
indpin = geomAnd(mt4x ind_dmy)  ;

; ***** Define connectivity/via layer -- lcesdm ****
lcesdm = geomAnd(tndiff lcesd_m)  ;

; ***** Define connectivity/via layer -- poly_hvnw ****
poly_hvnw = geomAnd(poly_term HVNW)  ;

; ***** Define connectivity/via layer -- nplug ****
nplug1a = geomAnd(tndiff nxwell)  ;
nplug1b = geomAnd(tndiff HVNW)  ;
nplug1_1 = geomOr(nplug1a nplug1b)  ;
nplug1c = geomAnd(tndiff NDD)  ;
nplug1_2 = geomOr(nplug1_1 nplug1c)  ;
nplug1d = geomAnd(tndiff NDD_BCD)  ;
nplug1 = geomOr(nplug1_2 nplug1d)  ;
nplug3 = geomButtOrOver(nplug1 CONT)  ;
tpdiffco = geomButtOrOver(tpdiff CONT)  ;
nplug2 = geomButtOrOver(nplug1 tpdiffco)  ;
nplug = geomOr(nplug3 nplug2)  ; define N_well contact

; ***** Define connectivity/via layer -- ngthvan_mac ****
ngthvan_mac = geomAnd(ngthva4 MACRODMY)  ;

; ***** Define connectivity/via layer -- lcesdp ****
lcesdp = geomAnd(tpdiff lcesd_p)  ;

; ***** Define connectivity/via layer -- pgt_lhl ****
pgt_lhl1 = geomAndNot(pgthv_hv27a geomButtOrOver(pgthv_hv27a RPO))  ;
pgt_lhl2 = geomAnd(pgt_lhl1 HVNW)  ;

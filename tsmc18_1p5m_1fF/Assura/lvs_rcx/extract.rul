; ***** Define connectivity/via layer -- ngthvs_lg ****
ngthvs_lg = geomAnd(ngthvs1 LVGDMY)  ;

; ***** Define connectivity/via layer -- ntap ****
nwells = geomOr(nxwell HVNW)  ;
ntap1 = geomAnd(tndiff nwells)  ;
ntap2 = geomButtOrOver(ntap1 CONT)  ;
ntap3 = geomButtOrOver(ntap1 tpdiffco)  ;

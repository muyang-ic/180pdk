; ***** Define connectivity/via layer -- ngt_lhli ****
ngt_lhli = geomAnd(ngt_lhl3 DNW)  ;

; ***** Define connectivity/via layer -- ptap ****
ptap1 = geomAnd(tpdiff psub)  ;

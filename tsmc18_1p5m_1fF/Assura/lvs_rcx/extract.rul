    FGT        = layer(   96 type(  0) )     ; Floating gate (FLGT)
    HVII       = layer(   97 type(  0) )     ; Common source for high voltage implant
    MCEL       = layer(  122 type(  0) )     ; define for memory cell rule checking
    HNVT       = layer(   91 type(  0) )     ; for HN not allowed with dnwell
    HVNWi      = layer(   99 )     ; for HP
    NOPW       = layer(  116 )     ; for HN, HZ "PSUB" in design rule manual
    ULLNW      = layer(  128 type(  0) )     ; layer to form ull pmos 
    OD3        = layer(  101 type(  0) )     ; layer to form ull devices
    ELLDMY     = layer(  127 type(  2) )     ; layer to form ell devices to destinguish ull devices
    CELLM      = layer(  133 type(  0) )     ; Define blocking region of Cell VT implantation for medium VT NMOS 
    CELLH      = layer(  133 type(  1) )     ; Define Cell High VT implantation (only for standard CIS)
    NPS        = layer(  133 type(  2) )     ; Define N type photo sensor implantation
    PL         = layer(  133 type(  3) )     ; Planarization mask for 8" TCF5 color filter technology
    GM         = layer(  133 type(  4) )     ; Green mask for 8" TCF5 color filter technology
    RM         = layer(  133 type(  5) )     ; Red mask for 8" TCF5 color filter technology
    BM         = layer(  133 type(  6) )     ; Blue mask for for 8" TCF5 color filter technology
    ML         = layer(  133 type(  7) )     ; Microlens spacer mask for 8" TCF5 color filter technology
    PPS        = layer(  133 type(  8) )     ; Define P type photo sensor implantation
    NMOS_VT    = layer(  133 type(  9) )     ; For logic VT implant
    CI         = layer(  133 type( 10) )     ; Cell DDD implant for CMOS image sensor process
    CIRPO      = layer(  133 type( 11) )     ; Define od salicide protection in pixel
    GM1        = layer(  133 type( 12) )     ; Green1 mask for for 8" TCF5 color filter technology
    GM2        = layer(  133 type( 13) )     ; Green2 mask for for 8" TCF5 color filter technology
    CELLD      = layer(  133 type( 14) )     ; TSMC internally used layer for CMOS image process
    BGP        = layer(  133 type( 21) )     ; Buried gate P implant
    BGN        = layer(  133 type( 22) )     ; Buried gate N implant
    CELL_TX    = layer(  133 type( 23) )     ; Cell_Tx implant
    CELL_RS    = layer(  133 type( 24) )     ; Rest implant
    CAP_IMP    = layer(  133 type( 25) )     ; Capacitor implant
    CELL_SL    = layer(  133 type( 30) )     ; Select implant
    BASE_N     = layer(  250 type(  1) )     ; PNP base for an extra BJT N-type Base implant
    LDDMY      = layer(  127 type(  0) )     ; dummy layer to cover HVMOS area 
    ESD2DUMMY  = layer(  137 type(  0) )     ; for lcesd1_rf and lcesd2_rf devices
    lcesd1     = layer(  160 type(  5) )     ; dummy layer for lcesd1_rf device
    lcesd2     = layer(  160 type(  6) )     ; dummy layer for lcesd2_rf device
    lcesd_p    = layer(  160 type(  7) )     ; dummy layer for rf lcesd device's PLUS and MINUS pin
    lcesd_m    = layer(  160 type(  8) )     ; dummy layer for rf lcesd device's MINUS pin
    MTDUM      = layer(  182 type(  5) )     ; dummy layer for bb 5/6t mos
    POFUSE     = layer(  232 type(  0) )     ; dummy layer for poly fuse
    HVTN       = layer(  142 )     ; FOR HV_40 NMOS
    HVTP       = layer(  143 )     ; FOR HV_40 PMOS
    NBL        = layer(  179 )     ; Implant with arsenic form low resistive paths for the NPN collectors, for HV process
    HVOX       = layer(  180 )     ; HVOX for HV process
    HVPBi      = layer(  202 )     ; drawing layer for HV P-BODY layer
    MTP_2T2C   = layer(  122 type(  3) )     ; layer to define MTP_2T2C IP region
    H18VNWDMY  = layer(  122 type(  4) )     ; layer to define 18V NW region
    SH_P       = layer(  141 type(  1) )     ; Shielding Pwell
    SH_N       = layer(  141 type(  2) )     ; Shielding Nwell
    DMYLD      = layer(  141 type( 31) )     ; Dummy layer for logic operation, use DMYLD to cover LDMOS area
    LDPW       = layer(  141 type( 32) )     ; P-Well region of LDNMOS
    NDD_BCD    = layer(  141 type( 50) )     ; HV32V: N-type drift region at drain side, for HV device to sustain the high breakdonw voltage
    PDD_BCD    = layer(  141 type( 49) )     ; HV32V: P-type drift region at drain side, for HV device to sustain the high breakdonw voltage
    NDD        = layer(  141 type( 64) )     ; definition of HV device N deep drain (NDD) implantation of HV device
    PDD        = layer(  141 type( 65) )     ; definition of HV device P deep drain (PDD) implantation of HV device
    DPW        = layer(  141 type( 51) )     ;  FOR HV_40 device
    HV40DMY    = layer(  141 type( 52) )     ; layer to form all HV devices.
    HVDMY2     = layer(  141 type( 53) )     ; layer to separate different voltage device in the same process 
    PA24DMY    = layer(  141 type( 60) )     ; dummy layer to form pa24g5 device.
    NLD24DMY   = layer(  141 type( 61) )     ; dummy layer to form nld24g5 device.
    NLVT       = layer(  141 type( 63) )     ; dummy layer to define low Vt 5V NMOS for 0.18um BCD process
    MHMDMY     = layer(  141 type( 66) )     ; dummy layer for MHM device
    HV18DMY    = layer(  141 type( 68) )     ; To define HV 18V device pattern.
    HV32DMY    = layer(  141 type( 69) )     ; To define HV 32V device pattern
    HV60DMY    = layer(  141 type( 70) )     ; To define HV 60V devices pattern.
    LHLDMY     = layer(  141 type( 71) )     ; To define LHL devices.
    MACRODMY   = layer(  182 type(  1) )     ; dummy layer to form  macro model devices.
    LVGDMY     = layer(  209 type(  1) )     ; Low Vg model devices dummy layer
    VIA_MEMS   = layer(  214 type(  0) )     ; define MEMS VIA
    MEMS       = layer(  215 type(  0) )     ; define MEMS struture
    HLMIMCAP1P0 = layer(  131 type( 11) )     ; dummy layer for 1p0 hlmim cap
    M0         = layer(  210 type(  0) )     ; landing pad for SiCr TFR
    MSi        = layer(  210 type(  1) )     ; resistor for SiCr TFR
    SICR_V1    = layer(  210 type(  2) )     ; Via1 belog to SiCr TFR
    IND_TEXT     = text( 139 type( 37) idOnly)
  ; define no port text layer 
  ; define text layer 
    UBM_text  = textToPin( 207 type(  1) )
    metal1_text  = textToPin(  40 )
    metal2_text  = textToPin(  41 )
    metal3_text  = textToPin(  42 )
    metal4_text  = textToPin(  43 )
    metal5_text  = textToPin(  44 )
    metal6_text_AP  = textToPin( 189 type(103) ) 
    metal6_text_MD  = textToPin( 159 ) 
    UBM_ptext  = textToPin( 207 type(  1) )
    metal1_ptext  = textToPin(  40 )
    metal2_ptext  = textToPin(  41 )
    metal3_ptext  = textToPin(  42 )
    metal4_ptext  = textToPin(  43 )
    metal5_ptext  = textToPin(  44 )
    metal6_ptext_AP  = textToPin( 189 type(103) )
    metal6_ptext_MD  = textToPin( 159 )
    BULK2 = cellBoundary("*")
); end gds2 layerDefs 
; #############################################
; # LOGIC OPERATION POOL                      #
; #############################################

; Form BULK layer
if( !avSwitch( "CELL_BULK" ) then
 BULK1       = geomBkgnd() 
 BULK        = geomSize( BULK1 0.005)
else
 BULK        = geomSize( BULK2 0.005)
)

; ***** Define connectivity/via layer -- nhvpwdnw_4t_base ****
nhvpwdnw_4t_reg1 = geomAnd(DNW BJTDMY_4t)  ;
HVDMY1 = geomOr(HV40DMY HV60DMY)  ;
HVDMY = geomOr(HVDMY1 HVOX)  ;
nhvpwdnw_4t_reg2 = geomAnd(nhvpwdnw_4t_reg1 HVDMY)  ;
HVNWc = geomAndNot(HVNWi LDPW)  ;
HVNWb = geomAndNot(HVNWc PDD_BCD)  ;
RPDMY = geomAndNot(RPDMYX RPDMY1)  ;
HVPB = geomAndNot(HVPBi geomButtOrOver(HVPBi RPDMY))  ;
HVNWa = geomAndNot(HVNWb HVPB)  ;
RWDMYa = geomOr(RWDMYX RWDMY1)  ;
HVNW = geomAndNot(HVNWa RWDMYa)  ;
nhvpwdnw_4t_reg3 = geomButtOrOver(nhvpwdnw_4t_reg2 HVNW)  ;
HVPWa = geomAndNot(HVDMY HVNW)  ;
RWDMY = geomAndNot(RWDMYX RWDMY1)  ;
HVPWb = geomAndNot(HVPWa RWDMY)  ;
POLY1 = geomOr(POLY1i DPO)  ;
RPDMYa = geomOr(RPDMYX RPDMY1)  ;
diff1 = geomOr(OD DOD)  ;
diff = geomAndNot(diff1 RODMY)  ;
rp1 = geomAndNot(RPDMYa geomButtOrOver(RPDMYa diff))  ;
p1rdum = geomButtOrOver(rp1 POLY1)  ; poly1 resistor dummy
respa = geomAnd(POLY1 p1rdum)  ;
resp = geomButtOrOver(respa POLY1i)  ;
polya = geomAndNot(POLY1 resp)  ; poly1 interconnect
MOMDMYall_0 = geomOr(MOMDMY0 MOMDMY1)  ;
MOMDMYall_1 = geomOr(MOMDMYall_0 MOMDMY2)  ;
MOMDMYall_2 = geomOr(MOMDMYall_1 MOMDMY3)  ;
MOMDMYall_3 = geomOr(MOMDMYall_2 MOMDMY4)  ;
MOMDMYall_4 = geomOr(MOMDMYall_3 MOMDMY5)  ;
crt_poly1 = geomButtOrOver(POLY1 MOMDMYall_4)  ;
crt_poly = geomAnd(crt_poly1 MOMDMYall_4)  ;
polyb = geomAndNot(polya crt_poly)  ; BULK of MOM
polyc = geomAndNot(polyb POFUSE)  ;
tfgt = geomAnd(FGT POLY1)  ;
poly = geomAndNot(polyc tfgt)  ;
drdum = geomButtOrOver(RPDMYa diff)  ; diff resistor dummy
resd = geomAnd(diff drdum)  ; diff resistor layer
mdiff = geomAndNot(diff resd)  ; diff interconnect
gate1 = geomAnd(poly mdiff)  ;
DIODMYa1 = geomOr(DIODMY DIO4TDMY)  ;
DIODMYa = geomOr(DIODMYa1 DIO3TDMY)  ;
gate2 = geomAndNot(gate1 DIODMYa)  ;
gate_all = geomAndNot(gate2 geomButtOrOver(gate2 MOMDMYall_4))  ;
gate_rf1 = geomAnd(gate1 RFDUMMY1)  ;
poly_rf1 = geomButtOrOver(poly CONT)  ;
poly_rf = geomButtOrOver(poly_rf1 DRAIN)  ;
gate_rf2 = geomAnd(gate_rf1 poly_rf)  ;
VARDMYA1 = geomAndNot(VARDMYX VARG3)  ;
VARDMYA2 = geomAndNot(VARDMYA1 VARG6)  ;
VARDMY = geomAndNot(VARDMYA2 JVARD)  ;
gate_rf3 = geomAndNot(gate_rf2 VARDMY)  ;
gate_rf = geomAndNot(gate_rf3 JVARD)  ;
gate_rf_mdiff = geomButtOrOver(mdiff gate_rf)  ;
gate_norf = geomAndNot(gate_all gate_rf_mdiff)  ;
gate_hv = geomButtOrOver(gate_norf HVDMY)  ; special for BCD12v
nld_r1 = geomAnd(gate_hv NIMP)  ;
nld_r2 = geomButtOrOver(nld_r1 HVPB)  ;
nld_r3 = geomAnd(nld_r2 HVNWi)  ;
nld12_r1 = geomButtOrOver(nld_r3 NDD_BCD)  ;
nld12_r2 = geomAndNot(nld12_r1 HVOX)  ;
nld12g2_r1 = geomButtOrOver(nld12_r1 nld12_r2)  ;
HVPWc = geomAndNot(HVPWb geomButtOrOver(HVPWb nld12g2_r1))  ;
nthin1 = geomAnd(mdiff NIMP)  ;
ydio_a = geomAnd(ESD3DMY OD)  ;
ydio_c = geomSize(ydio_a -0.2)  ;
ydio_d = geomAnd(ydio_c NIMP)  ;
ydio_e = geomAnd(ydio_d RPO)  ;
ydio_f = geomAndNot(ydio_e NWELL)  ;
ydio_g = geomAnd(ESD3DMY POLY1)  ;
ydio_h = geomSize(ydio_g 0.2)  ;
ydio_i = geomAndNot(ydio_f ydio_h)  ;
ydio_j = geomSize(ydio_i -0.8)  ;
ydio = geomSize(ydio_j 0.6)  ;
nthin = geomAndNot(nthin1 ydio)  ; define N+ thin oxide
nthin_hv1 = geomButtOrOver(nthin gate_hv)
nthin_hv2 = geomSize(nthin_hv1 0.1 edges)
nthin_hv3 = geomInside(nthin_hv2 HVNW)
nthin_hv4 = geomGetEdge(nthin_hv1 butting nthin_hv3 wholeEdge )
nthin_hv5 = geomSize(nthin_hv4 2.0 edges)
nthin_hv = geomOr(nthin nthin_hv5) ;
nld14_r2 = geomAnd(poly nthin_hv)  ;
nld14_r1 = geomAndNot(nld_r3 geomButtOrOver(nld_r3 NDD_BCD))  ;
nld14_r3 = geomButtOrOver(nld14_r2 nld14_r1)  ;
nld14_r4 = geomButtOrOver(nld14_r3 NDD_BCD)  ;
nld14_r5 = geomAndNot(nld14_r4 HVOX)  ;
nld14g2_r1 = geomButtOrOver(nld14_r4 nld14_r5)  ;
HVPW = geomAndNot(HVPWc geomButtOrOver(HVPWc nld14g2_r1))  ;
nhvpwdnw_4t_base = geomAnd(nhvpwdnw_4t_reg3 HVPW)  ;

; ***** Define connectivity/via layer -- hvndfd ****
tndiff1 = geomAndNot(nthin gate_all)  ; define N+ diffusion region
pthin = geomAnd(mdiff PIMP)  ; define P+ thin oxide
tpdiff = geomAndNot(pthin gate_all)  ; define P+ diffusion region
np_ovlp = geomAnd(tpdiff tndiff1)  ;
dz_ring1 = geomAnd(np_ovlp RPO)  ;
dz_ring = geomSize(dz_ring1 0.01)  ;
tndiff2 = geomAndNot(tndiff1 dz_ring)  ;
hvwell1 = geomButtOrOver(NOPW DNW)  ;
hvwell2 = geomAndNot(NOPW hvwell1)  ;
hvwell3 = geomOr(hvwell2 HVNW)  ;
hvwell = geomAndNot(hvwell3 geomButtOrOver(hvwell3 HVDMY))  ;
celdif1 = geomAnd(mdiff hvwell)  ;
celdif2 = geomAnd(celdif1 MCEL)  ; Hvdiff + MCell
celdif = geomAndNot(celdif2 RODMY)  ;
fggate1 = geomAndNot(FGT tfgt)  ;
fggate2 = geomAnd(fggate1 celdif)  ;
fggate3 = geomAnd(fggate2 HVII)  ;
fggate4 = geomAnd(fggate3 RPO)  ;
fggate = geomAnd(fggate4 NOPW)  ;
tmcdiff1 = geomAndNot(celdif fggate)  ;
nfgate1 = geomAndNot(POLY1 tfgt)  ;
nfgate2 = geomAnd(nfgate1 celdif)  ;
nfgate3 = geomAnd(nfgate2 NOPW)  ;
nfgate = geomAnd(nfgate3 NIMP)  ; Poly + Mcel - overlap of Poly and FGT
tmcdiff = geomAndNot(tmcdiff1 nfgate)  ;
tndiff = geomOr(tndiff2 tmcdiff)  ;
hvndfs_bcd46a = geomAnd(tndiff HVDMY1)  ;
hvndfd_bcd46a = geomButtOrOver(HVNW hvndfs_bcd46a)  ;
ngthv1 = geomAnd(gate_hv NIMP)  ;
ngthv2 = geomAnd(ngthv1 HVPW)  ;
ngthv3 = geomAnd(ngthv2 NBL)  ;
ngthv4 = geomButtOrOver(ngthv3 HVPBi)  ;
ngthv5 = geomButtOrOver(ngthv4 DPW)  ;
hvndfd_bcd46 = geomButtOrOver(hvndfd_bcd46a ngthv5)  ;
hvndfd_bcd12 = geomButtOrOver(HVNW nld_r3)  ; Drain of HV NMOS
hvndfd1 = geomOr(hvndfd_bcd46 hvndfd_bcd12)  ;
hvndfs_hv32a = geomAnd(tndiff HVOX)  ;
hvndfd_hv32a = geomButtOrOver(HVNW hvndfs_hv32a)  ;
hvndfd_hv32 = geomButtOrOver(hvndfd_hv32a ngthv1)  ;
hvndfd2 = geomOr(hvndfd1 hvndfd_hv32)  ;
ngthv_hv27a = geomButtOrOver(gate_hv NIMP)  ;
ngthv_hv27b = geomButtOrOver(ngthv_hv27a RPO)  ;
ngthv_hv27c = geomAnd(ngthv_hv27b HVPW)  ;
ngthv_hv27 = geomAndNot(ngthv_hv27c NDD)  ;
hvndfd_hv27 = geomButtOrOver(NDD ngthv_hv27)  ;
hvndfd3 = geomOr(hvndfd2 hvndfd_hv27)  ;
ngthvish_reg1 = geomAnd(ngthv3 HVOX)  ;
ngthvish_reg2 = geomButtOrOver(ngthvish_reg1 RPO)  ;
ngthvish_reg3 = geomAndNot(ngthvish_reg2 NDD_BCD)  ;
ngthvish_reg = geomButtOnly(geomOutside(ngthvish_reg3 NDD_BCD) NDD_BCD keep == 2 ) ;
hvndfd_iso28 = geomButtOrOver(NDD_BCD ngthvish_reg)  ;
hvndfd = geomOr(hvndfd3 hvndfd_iso28)  ;

; ***** Define connectivity/via layer -- nld24g5_ac ****
nld_gate1 = geomButtOrOver(ngthv5 SH_P)  ;
nld_gate2 = geomAndNot(nld_gate1 geomButtOrOver(nld_gate1 VTDN))  ;
nld_gate = geomAnd(nld_gate2 HV40DMY)  ;
nld24g5_r1 = geomAnd(nld_gate NLD24DMY)  ;
hvndfd_nld18g5 = geomButtOrOver(hvndfd_bcd46 SH_N)  ;
nld24g5_r2 = geomAndNot(nld24g5_r1 geomButtOrOver(nld24g5_r1 hvndfd_nld18g5))  ;
nld24g5_ac = geomAnd(nld24g5_r2 MACRODMY)  ;

; ***** Define connectivity/via layer -- indm3c ****
indm5a = geomSize(INDDMY 0.005)  ;
M3X = geomOr(M3 DUM3)  ;
M3Y = geomAndNot(M3X M3SLOT)  ;
indm3 = geomAnd(indm5a M3Y)  ;
indm3c = geomAnd(indm3 IND_D4)  ;

; ***** Define connectivity/via layer -- nhvpwnbl_base ****
npwnbl_reg1 = geomAnd(NBL BJTDMY)  ;
npwnbl_reg2b1 = geomAnd(npwnbl_reg1 HVDMY1)  ;
npwnbl_reg2b = geomAndNot(npwnbl_reg2b1 HVOX)  ;
nlvpwnbl_base1 = geomAnd(HVPW npwnbl_reg2b)  ;
nlvpwnbl_base2 = geomAndNot(nlvpwnbl_base1 geomButtOrOver(nlvpwnbl_base1 DPW))  ;
nhvpwnbl_base1 = geomAndNot(nlvpwnbl_base2 geomButtOrOver(nlvpwnbl_base2 SH_P))  ;
nlvpwnbl_colr = geomAnd(HVNW npwnbl_reg2b)  ;
nhvpwnbl_cols1a = geomAndNot(nlvpwnbl_colr geomButtOrOver(nlvpwnbl_colr SH_N))  ;
nhvpwnbl_cols1 = geomButtOrOver(nhvpwnbl_cols1a HV40DMY)  ;
nhvpwnbl_cols2a = geomButtOrOver(nlvpwnbl_colr SH_N)  ;
nhvpwnbl_cols2 = geomButtOrOver(nhvpwnbl_cols2a HV60DMY)  ;
nhvpwnbl_cols3 = geomOr(nhvpwnbl_cols1 nhvpwnbl_cols2)  ;
nhvpwnbl_base = geomButtOrOver(nhvpwnbl_base1 nhvpwnbl_cols3)  ;

; ***** Define connectivity/via layer -- npwnbl_emit ****
npwnbl_reg2a1 = geomAnd(npwnbl_reg1 HVOX)  ;
npwnbl_reg2a = geomAndNot(npwnbl_reg2a1 HVDMY1)  ;
npwnbl_emit1 = geomAnd(tndiff npwnbl_reg2a)  ;
npwnbl_base = geomAnd(HVPW npwnbl_reg2a)  ;
npwnbl_emit = geomAnd(npwnbl_emit1 npwnbl_base)  ;

; ***** Define connectivity/via layer -- ngthvsn_mac ****
ngthv3a = geomAnd(ngthv2 HVOX)  ;
ngthv3b = geomAndNot(ngthv3a geomButtOrOver(ngthv3a NDD))  ;
ngthv3c = geomAndNot(ngthv3b geomButtOrOver(ngthv3b HVPB))  ;
ngthv3d = geomAndNot(ngthv3c geomButtOrOver(ngthv3c LHLDMY))  ;
ngthv3e = geomAndNot(ngthv3d geomButtOrOver(ngthv3d NDD_BCD))  ;
tndifin = geomInside(nthin poly)  ;
ngthvs1 = geomButtOrOver(ngthv3e tndifin)  ;
ngthvs2 = geomAndNot(ngthvs1 LVGDMY)  ;
ngthvsn_mac = geomAnd(ngthvs2 MACRODMY)  ;

; ***** Define connectivity/via layer -- pa18g5_reg ****
pgthv1 = geomButtOrOver(gate_hv PIMP)  ; special for hv27
pgthv2 = geomAnd(pgthv1 NBL)  ;
pgthv3 = geomAnd(pgthv2 HVNW)  ;
pgthv46 = geomButtOrOver(pgthv3 SH_N)  ;
pgthv4a = geomAnd(pgthv46 HV40DMY)  ;
hvpdfs_bcd46a = geomAnd(tpdiff HVDMY1)  ;
hvpdfd_bcd46 = geomButtOrOver(HVPW hvpdfs_bcd46a)  ;
hvpdfd_bcd40a = geomButtOrOver(hvpdfd_bcd46 SH_P)  ;
hvpdfd_bcd40b = geomButtOrOver(hvpdfd_bcd40a pgthv46)  ;
hvpdfd_bcd40 = geomButtOrOver(hvpdfd_bcd40b HV40DMY)  ;
pgthv4 = geomButtOrOver(pgthv4a hvpdfd_bcd40)  ;
pa18g5_r1 = geomAnd(pgthv4 HV18DMY)  ; PA18G5 gate
pa18g5_reg = geomAndNot(pa18g5_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- emit ****
ttdiff = geomAnd(tpdiff BJTDMY)  ;
nxwell1 = geomOr(NWELL BASE_N)  ;
nxwell2 = geomOr(nxwell1 ULLNW)  ;
nxwell = geomAndNot(nxwell2 RWDMYa)  ;
nbase_a = geomAndNot(nxwell geomButtOrOver(nxwell DNW))  ;
nbase_b = geomAndNot(nbase_a geomButtOrOver(nbase_a NBL))  ;
nbase_gen1 = geomAnd(nbase_b BJTDMY)  ;
nbase_gen2 = geomAndNot(nbase_gen1 OD3)  ;
nbase_gen = geomAndNot(nbase_gen2 ULLNW)  ;
nbase = geomAndNot(nbase_gen OD2)  ; define 1.8V BJT[PV] base terminal
emit_temp1 = geomAnd(ttdiff nbase)  ; define 1.8V BJT[PV] emitter
emit = geomAndNot(emit_temp1 hvwell)  ;

; ***** Define connectivity/via layer -- ydio_hole ****
ydio_hole = geomHoles(ydio)  ;

; ***** Define connectivity/via layer -- nld18g5_ac ****
nld18g5_r1 = geomAnd(nld_gate HV18DMY)  ;
nld18g5_r2 = geomButtOrOver(nld18g5_r1 hvndfd_nld18g5)  ;
nld18g5_ac = geomAnd(nld18g5_r2 MACRODMY)  ;

; ***** Define connectivity/via layer -- nld60g5_ac ****
nld60g5_r1 = geomAnd(nld_gate2 HV60DMY)  ;
nld60g5_ac = geomAnd(nld60g5_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- rfdmy56 ****
rfdmy56 = geomOr(RFDUMMY5T RFDUMMY6T)  ;

; ***** Define connectivity/via layer -- polyCont ****
pl2co = geomAnd(POLY2 CONT)  ; define POLY2 contact
pl1co = geomAndNot(CONT pl2co)  ; define OD/POLY1 contact
polyCont = geomAnd(pl1co POLY1)  ;

; ***** Define connectivity/via layer -- ngthvia ****
ngthva_hv27a = geomButtOnly(geomOutside(ngthv_hv27 NDD) NDD keep == 1 ) ;
ngthvia = geomAnd(ngthva_hv27a DNW)  ;

; ***** Define connectivity/via layer -- nld14g12_mac ****
nld14g12_r1 = geomAndNot(nld14_r4 geomButtOrOver(nld14_r4 nld14_r5))  ;
nld14g12_mac = geomAnd(nld14g12_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- pgthvsn_mac ****
pgthv_hv18a = geomAnd(pgthv1 DNW)  ;
pgthv_hv18b = geomAnd(pgthv_hv18a HVNW)  ;
pgthv_hv18c = geomAnd(pgthv_hv18b HVOX)  ;
pgthv_hv18d = geomAndNot(pgthv_hv18c geomButtOrOver(pgthv_hv18c PDD))  ;
tpdifin = geomInside(pthin poly)  ;
pgthvs_hv18a = geomButtOrOver(pgthv_hv18d tpdifin)  ;
pgthvs_hv18b = geomAndNot(pgthvs_hv18a LVGDMY)  ;
pgthvsn_mac = geomAnd(pgthvs_hv18b MACRODMY)  ;

; ***** Define connectivity/via layer -- nld40g5_ac ****
nld32g5_r1 = geomAnd(nld_gate HV32DMY)  ;
nld40g5_r1 = geomAndNot(nld_gate nld32g5_r1)  ;
nld40g5_r2 = geomAndNot(nld40g5_r1 nld24g5_r1)  ;
nld40g5_r3 = geomAndNot(nld40g5_r2 nld18g5_r1)  ;
nld40g5_r4 = geomAndNot(nld40g5_r3 geomButtOrOver(nld40g5_r3 hvndfd_nld18g5))  ;
nld40g5_ac = geomAnd(nld40g5_r4 MACRODMY)  ;

; ***** Define connectivity/via layer -- ctm ****
ctm = geomCat(CTM4)  ;

; ***** Define connectivity/via layer -- nhvpwdnw_4t_emit ****
nhvpwdnw_4t_emit = geomAnd(tndiff nhvpwdnw_4t_base)  ;

; ***** Define connectivity/via layer -- mim_hvpw_via ****
mim_block = geomAnd(CTM4 M4)  ;
capm4a = geomButtOrOver(mim_block VIA4i)  ;
RFDUMMY = geomAndNot(RFDUMMYX RFDUMMY1)  ;
capm4b = geomAndNot(capm4a RFDUMMY)  ;
RFDUMMYall = geomOr(RFDUMMY1 RFDUMMYUD)  ;
capm4c = geomAndNot(capm4b RFDUMMYall)  ;
capm4d = geomAnd(capm4c CTMDMY)  ;
capm4 = geomAndNot(capm4d CTMDMYUD)  ;
capm4_3t = geomAnd(capm4 CTMDMY_3t)  ;
mim_term = geomSize(capm4_3t 0.005)  ;
mim_hvpw_via = geomAnd(mim_term HVPW)  ;

; ***** Define connectivity/via layer -- ull_coll ****
psub2_ring1 = geomSize(PSUB2 0.01)  ;
psub2_ring = geomAndNot(psub2_ring1 PSUB2)  ;
snbl = geomSize(NBL 0.01)  ;
iso_hvnwa = geomAndNot(HVNWi HVDMY)  ;
ANWEL1 = geomOr(nxwell iso_hvnwa)  ;
ANWEL = geomOr(ANWEL1 HVNW)  ;
nbl_hvnw = geomAnd(snbl ANWEL)  ;
ptsub1 = geomAndNot(BULK psub2_ring)  ;
ptsub2 = geomAndNot(ptsub1 nbl_hvnw)  ;
ptsub = geomInside(ptsub2 NBL)  ;
nbl_hvnw_ring = geomButtOrOver(nbl_hvnw ptsub)  ;
ppsub = geomOr(psub2_ring nbl_hvnw_ring)  ;
psuba = geomAndNot(BULK ppsub)  ;
trwell = geomAnd(RWDMYa NWELL)  ; 
psubb = geomAndNot(psuba trwell)  ;
rhvnw1 = geomAnd(HVNWa RWDMYX)  ;
psubc = geomAndNot(psubb rhvnw1)  ;
rhvpw1 = geomAnd(HVPWa RWDMYX)  ;
psubd = geomAndNot(psubc rhvpw1)  ;
psube = geomAndNot(psubd HVNWa)  ;
psub = geomAndNot(psube nxwell)  ;
ull_nbase_gen2 = geomAnd(nbase_gen1 OD3)  ;
ull_nbase_gen3 = geomAnd(ull_nbase_gen2 ULLNW)  ;
ull_nbase_gen = geomAndNot(ull_nbase_gen3 ELLDMY)  ;
ull_nbase = geomAndNot(ull_nbase_gen OD2)  ; define 1.8V ULL BJT base terminal
ull_collsur = geomButtOnly(psub ull_nbase)  ;
ull_coll1a = geomOr(ull_collsur ull_nbase)  ;  define BJT[PV] collector
ull_emit_temp1 = geomAnd(ttdiff ull_nbase)  ; define 1.8V ULL BJT emitter
ull_emit = geomAndNot(ull_emit_temp1 hvwell)  ;
ull_collsura = geomButtOnly(ull_collsur ull_emit)  ;
ull_coll1b = geomAndNot(ull_coll1a ull_collsura)  ;
ull_coll = geomAndNot(ull_coll1b ull_emit)  ;  define pnp collector

; ***** Define connectivity/via layer -- pgthvsu ****
pgthv_hv27a = geomButtOrOver(gate_hv PIMP)  ;
pgthv_hv27b = geomButtOrOver(pgthv_hv27a RPO)  ;
pgthv_hv27c = geomAnd(pgthv_hv27b HVNW)  ;
pgthv_hv27 = geomAndNot(pgthv_hv27c PDD)  ;
pgthvs_hv27 = geomButtOnly(geomOutside(pgthv_hv27 PDD) PDD keep == 2 ) ;
pgthvsu = geomAnd(pgthvs_hv27 HVDMY2)  ;

; ***** Define connectivity/via layer -- pa60g5soa_ac ****
pgthv6a = geomAnd(pgthv46 HV60DMY)  ;
hvpdfd_bcd60a = geomAndNot(hvpdfd_bcd46 geomButtOrOver(hvpdfd_bcd46 SH_P))  ;
hvpdfd_bcd60b = geomButtOrOver(hvpdfd_bcd60a pgthv46)  ;
hvpdfd_bcd60 = geomButtOrOver(hvpdfd_bcd60b HV60DMY)  ;
pgthv6 = geomButtOrOver(pgthv6a hvpdfd_bcd60)  ;
pa60g5soa_r1 = geomAnd(pgthv6 HVDMY2)  ; PA60G5 FULL SOA gate
pa60g5soa_ac = geomAnd(pa60g5soa_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- tfr ****
tfr = geomAndNot(M0 MSi)  ;

; ***** Define connectivity/via layer -- RFDMY_HIA_psub ****
RFDMY_HIA_bulk1 = geomAnd(nxwell HIA_DUMMY)  ;
RFDMY_HIA_bulk2 = geomInside(RFDMY_HIA_bulk1 RFDUMMY1)  ;
RFDMY_HIA_bulk = geomButtOrOver(RFDUMMY1 RFDMY_HIA_bulk2)  ;
RFDMY_HIA_psub = geomAndNot(RFDMY_HIA_bulk nxwell)  ;

; ***** Define connectivity/via layer -- nemit_od2 ****
npnrg_dnw1 = geomAnd(DNW BJTDMY)  ;
npnrg_dnw = geomAndNot(npnrg_dnw1 HVDMY)  ;
npnrg_nbl1 = geomAnd(NBL BJTDMY)  ;
npnrg_nbl = geomAndNot(npnrg_nbl1 HVDMY)  ;
npnrg = geomOr(npnrg_dnw npnrg_nbl)  ;
nndiff = geomAnd(tndiff npnrg)  ;
pbase_gen1 = geomAnd(psub npnrg)  ;define 1.8V BJT[NV] base terminal
pbase_gen = geomButtOrOver(pbase_gen1 nxwell)  ;define 1.8V BJT[NV] base terminal
nemit_gen1 = geomAnd(nndiff pbase_gen)  ;define 1.8V BJT[NV] emitter
nemit_gen2 = geomAndNot(nemit_gen1 hvwell)  ;
nemit_gen = geomAndNot(nemit_gen2 OD3)  ;
nemit_od2 = geomButtOrOver(nemit_gen OD2)  ;

; ***** Define connectivity/via layer -- pgthvs_lg ****
pgthv3a = geomAnd(pgthv3 HVOX)  ;
pgthv3b = geomAndNot(pgthv3a geomButtOrOver(pgthv3a PDD))  ;
pgthvs1 = geomButtOrOver(pgthv3b tpdifin)  ;
pgthvs_lg = geomAnd(pgthvs1 LVGDMY)  ;

; ***** Define connectivity/via layer -- emit_od2 ****
nbase_od2 = geomButtOrOver(nbase_gen OD2)  ; define 3.3V BJT[P1] base terminal
emit_od2_temp1 = geomAnd(ttdiff nbase_od2)  ; define 3.3V BJT[P1] emitter
emit_od2 = geomAndNot(emit_od2_temp1 hvwell)  ;

; ***** Define connectivity/via layer -- pa14g12_reg ****
pa14_r1 = geomButtOrOver(gate_hv PIMP)  ;
pa14_r2 = geomButtOrOver(pa14_r1 HVOX)  ;
pa14_r3 = geomButtOrOver(pa14_r2 RPO)  ;
pa14_r4 = geomButtOrOver(pa14_r3 PDD_BCD)  ;
pa14_r5 = geomAnd(pa14_r4 HVNWi)  ;
hvnw_nw = geomAnd(NWELL HVNW)  ; special for BCD12v process
pa14g12_reg = geomAndNot(pa14_r5 geomButtOrOver(pa14_r5 hvnw_nw))  ;

; ***** Define connectivity/via layer -- hvpdfs ****
hvpdfs_bcd46b = geomAnd(hvpdfs_bcd46a SH_N)  ;
hvpdfs_bcd46c = geomAnd(hvpdfs_bcd46b HVNW)  ;
hvpdfs_bcd46 = geomAnd(hvpdfs_bcd46c NBL)  ;
hvpdfs_bcd12 = geomButtOrOver(tpdiff pa14_r5)  ; Source of HV PMOS
hvpdfs1 = geomOr(hvpdfs_bcd46 hvpdfs_bcd12)  ;
hvpdfs_hv32a = geomAnd(tpdiff HVOX)  ;
hvpdfs_hv32b = geomAnd(hvpdfs_hv32a NBL)  ;
hvpdfs_hv32 = geomAnd(hvpdfs_hv32b HVNW)  ;
hvpdfs2 = geomOr(hvpdfs1 hvpdfs_hv32)  ;
hvpdfs_hv27a = geomAndNot(hvpdfs_hv32a NBL)  ;
hvpdfs_hv27 = geomAnd(hvpdfs_hv27a HVNW)  ;
hvpdfs = geomOr(hvpdfs2 hvpdfs_hv27)  ;

; ***** Define connectivity/via layer -- phvnwdpw60_emit ****
pwhvnwdpw_reg1 = geomAnd(DPW BJTDMY)  ;
pwhvnwdpw_reg2 = geomAnd(pwhvnwdpw_reg1 HVDMY1)  ;
pwhvnwdpw_reg3 = geomAndNot(pwhvnwdpw_reg2 HVOX)  ;
pwhvnwdpw_base = geomAnd(HVNW pwhvnwdpw_reg3)  ;
pwhvnwdpw_emit1 = geomAnd(tpdiff pwhvnwdpw_base)  ;
phvnwdpw_emit1 = geomAndNot(pwhvnwdpw_emit1 geomButtOrOver(pwhvnwdpw_emit1 SH_P))  ;
phvnwdpw60_emit = geomAnd(phvnwdpw_emit1 HV60DMY)  ;

; ***** Define connectivity/via layer -- metal2 ****
M2X = geomOr(M2 DUM2)  ;
M2Y = geomAndNot(M2X M2SLOT)  ;
RMDMY2 = geomOr(RMDMY2i RMDMY)  ;
M2Z = geomAnd(M2Y RMDMY2)  ;
mt2res = geomButtOrOver(M2Z M2)  ; metal2 resistor
metal2 = geomAndNot(M2Y mt2res)  ; metal2 interconnect

; ***** Define connectivity/via layer -- poly_term ****
poly_term1 = geomAnd(POLY1 RPDMY1)  ;
poly_term2 = geomSize(poly_term1 0.005)  ;
poly_term = geomAndNot(poly_term2 poly_term1)  ;

; ***** Define connectivity/via layer -- nlvpwnbl_emit ****
nlvpwnbl_emit1 = geomAnd(tndiff npwnbl_reg2b)  ;
nlvpwnbl_base3 = geomButtOrOver(nlvpwnbl_base2 SH_P)  ;
nlvpwnbl_base = geomAnd(nlvpwnbl_base3 NOPW)  ;
nlvpwnbl_emit_2 = geomAnd(nlvpwnbl_emit1 nlvpwnbl_base)  ;
nlvpwnbl_emit = geomAnd(nlvpwnbl_emit_2 HV40DMY)  ;

; ***** Define connectivity/via layer -- mom3p1 ****
RMDMY3 = geomOr(RMDMY3i RMDMY)  ;
M3Z = geomAnd(M3Y RMDMY3)  ;
mt3res = geomButtOrOver(M3Z M3)  ; metal3 resistor
metal3 = geomAndNot(M3Y mt3res)  ; metal3 interconnect
mom3p11 = geomAnd(metal3 MOMDMY23)  ;
mom3p1 = geomButtOrOver(mom3p11 MOMDMY25)  ;

; ***** Define connectivity/via layer -- metal4 ****
M4X = geomOr(M4 DUM4)  ;
M4Y = geomAndNot(M4X M4SLOT)  ;
RMDMY4 = geomOr(RMDMY4i RMDMY)  ;
M4Z = geomAnd(M4Y RMDMY4)  ;
mt4res = geomButtOrOver(M4Z M4)  ; metal4 resistor
mt4x = geomAndNot(M4Y mt4res)  ;
ind_dmy1 = geomAnd(RFDUMMY1 INDDMY)  ;
ind_dmy2 = geomAnd(ind_dmy1 NTN)  ;
ind_dmy = geomSize(ind_dmy2 -0.005)  ;
metal4 = geomAndNot(mt4x ind_dmy)  ;

; ***** Define connectivity/via layer -- dnwc ****
dnwc = geomAnd(DNW nxwell)  ;

; ***** Define connectivity/via layer -- nhvpwnbl60_emit ****
nhvpwnbl_emit1 = geomAnd(tndiff nhvpwnbl_base)  ;
nhvpwnbl_emit_2 = geomAndNot(nhvpwnbl_emit1 SH_N)  ;
nhvpwnbl60_emit = geomAnd(nhvpwnbl_emit_2 HV60DMY)  ;

; ***** Define connectivity/via layer -- pa24g5_reg ****
pa24g5_r1 = geomAnd(pgthv4 PA24DMY)  ; PA24G5 gate
pa24g5_reg = geomAndNot(pa24g5_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- nld24g5_reg ****
nld24g5_reg = geomAndNot(nld24g5_r2 nld24g5_ac)  ;

; ***** Define connectivity/via layer -- tiod ****
tioda = geomAndNot(diff tpdiff)  ;
tiodb = geomAndNot(tioda tndiff)  ;
tiod1 = geomAndNot(tiodb POLY1)  ;
tiod2 = geomAndNot(tiod1 RPO)  ;
tiod3 = geomAndNot(tiod2 RPDMYa)  ;
tiod = geomAndNot(tiod3 RWDMYa)  ;

; ***** Define connectivity/via layer -- ngthvi_lg ****
ngthva1 = geomAndNot(ngthv3e ngthvs1)  ;
ngthvi1 = geomAnd(ngthva1 NBL)  ;
ngthvi_lg = geomAnd(ngthvi1 LVGDMY)  ;

; ***** Define connectivity/via layer -- n_psub ****
n_psub = geomAndNot(BULK psub2_ring)  ;

; ***** Define connectivity/via layer -- nwhvpwnbl_col ****
nwhvpwnbl_base1 = geomAndNot(nlvpwnbl_base2 NOPW)  ;
nwhvpwnbl_base2a = geomButtOrOver(nwhvpwnbl_base1 SH_P)  ;
nwhvpwnbl_base2b = geomButtOrOver(nwhvpwnbl_base2a HV40DMY)  ;
nwhvpwnbl_base3a = geomAndNot(nwhvpwnbl_base1 geomButtOrOver(nwhvpwnbl_base1 SH_P))  ;
nwhvpwnbl_base3b = geomButtOrOver(nwhvpwnbl_base3a HV60DMY)  ;
nwhvpwnbl_base = geomOr(nwhvpwnbl_base2b nwhvpwnbl_base3b)  ;
nwhvpwnbl_cols = geomButtOnly(nlvpwnbl_colr nwhvpwnbl_base)  ;
nwhvpwnbl_col1 = geomOr(nwhvpwnbl_cols nwhvpwnbl_base)  ;
nwhvpwnbl_emit1 = geomAnd(tndiff nwhvpwnbl_base)  ;
nwhvpwnbl_emit_2 = geomAnd(nwhvpwnbl_emit1 SH_N)  ;
nwhvpwnbl_col = geomAndNot(nwhvpwnbl_col1 nwhvpwnbl_emit_2)  ;

; ***** Define connectivity/via layer -- psub_term ****
psub_term1 = geomAndNot(psub DNW)  ;
psub_term2 = geomAndNot(psub_term1 HVNWi)  ;
psub_term3 = geomAndNot(psub_term2 NBL)  ;
nxwell_dnwa = geomButtOrOver(nxwell DNW)  ;
nxwell_dnw = geomAndNot(nxwell_dnwa DNW)  ;
psub_term = geomOr(psub_term3 nxwell_dnw)  ;

; ***** Define connectivity/via layer -- ndld40g5_ac ****
ndld_gate1 = geomButtOrOver(ngthv5 VTDN)  ;
ndld_gate2 = geomAndNot(ndld_gate1 geomButtOrOver(ndld_gate1 SH_P))  ;
ndld40g5_r1 = geomAnd(ndld_gate2 HV60DMY)  ;
ndld40g5_ac = geomAnd(ndld40g5_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- hvnwpsub_col ****
hvnw_reg1 = geomAnd(HVNWi BJTDMY)  ;
hvnw_base1 = geomAnd(hvnw_reg1 HVOX)  ;
hvnw_base2 = geomAndNot(hvnw_base1 geomButtOrOver(hvnw_base1 NBL))  ;
hvnw_base = geomAndNot(hvnw_base2 HVDMY1)  ;
hvnwpsub_cols = geomButtOnly(psub hvnw_base)  ;
hvnwpsub_col1 = geomOr(hvnwpsub_cols hvnw_base)  ;
phvnwpsub_emit1 = geomAnd(tpdiff hvnw_base)  ;
hvnwpsub_col = geomAndNot(hvnwpsub_col1 phvnwpsub_emit1)  ;

; ***** Define connectivity/via layer -- pa40g5soa_ac ****
pa40g5_r1 = geomAndNot(pgthv4 pa18g5_r1)  ;
pa40g5_r2 = geomAndNot(pa40g5_r1 pa24g5_r1)  ;
pa32g5_r1 = geomAnd(pgthv4 HV32DMY)  ; PA32G5 gate
pa40g5_r3 = geomAndNot(pa40g5_r2 pa32g5_r1)  ;
pa40g5soa_r1 = geomAnd(pa40g5_r3 HVDMY2)  ; PA40G5 FULL SOA gate
pa40g5soa_ac = geomAnd(pa40g5soa_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- s_tpdiff ****
d_tpdiff = geomAnd(tpdiff DRAIN)  ;
s_tpdiff1 = geomAndNot(tpdiff d_tpdiff)  ;
s_tpdiff = geomButtOrOver(s_tpdiff1 gate_rf)  ;

; ***** Define connectivity/via layer -- rndd_term ****
rndd_term1 = geomAnd(mdiff NDD)  ;
rndd_term = geomButtOrOver(rndd_term1 NIMP)  ;

; ***** Define connectivity/via layer -- ngthva_mac ****
ngthva_hv27b = geomAndNot(ngthva_hv27a DNW)  ;
ngthva_mac = geomAndNot(ngthva_hv27b HVDMY2)  ;

; ***** Define connectivity/via layer -- mom4p2 ****
mom4p21 = geomAnd(metal4 MOMDMY24)  ;
mom4p2 = geomButtOrOver(mom4p21 MOMDMY25)  ;

; ***** Define connectivity/via layer -- gate1_not_IO1 ****
gate_lv1 = geomAndNot(gate_norf geomButtOrOver(gate_norf HVDMY))  ;
gate_lv = geomAndNot(gate_lv1 hvwell)  ;
gate1_not_IO1 = geomAndNot(gate_lv OD2)  ;

; ***** Define connectivity/via layer -- VIA5 ****
if(avSwitch("Cu_RDL") then
  VIA5 = geomCat(VIAD)  ;
else    
  VIA5 = geomCat(CB)  ;
) ;  ;

; ***** Define connectivity/via layer -- iso_hvnw ****
iso_hvnw = geomAndNot(iso_hvnwa RWDMY)  ;

; ***** Define connectivity/via layer -- ldpwhvnwpsub_emit ****
hvnw_reg2 = geomAndNot(hvnw_reg1 HVDMY)  ;
ldpwhvnwpsub_emit1 = geomAnd(tpdiff hvnw_reg2)  ;
ldpwhvnwpsub_emit_2 = geomOutside(ldpwhvnwpsub_emit1 tndiff)  ;
ldpwhvnwpsub_emit = geomAnd(ldpwhvnwpsub_emit_2 LDPW)  ;

; ***** Define connectivity/via layer -- nld12g12_reg ****
nld12g12_r1 = geomAndNot(nld12_r1 geomButtOrOver(nld12_r1 nld12_r2))  ;
nld12g12_reg = geomAndNot(nld12g12_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- nps2 ****
nps2 = geomAnd(NPS CIRPO)  ;

; ***** Define connectivity/via layer -- pa50g5_reg ****
pa50g5_r1 = geomAndNot(pgthv6 HVDMY2)  ; PA50G5 gate
pa50g5_reg = geomAndNot(pa50g5_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- mim_po ****
capm4_rf3ta1 = geomAnd(capm4b CTMDMY)  ;
capm4_rf3ta2 = geomAndNot(capm4_rf3ta1 CTMDMYUD)  ;
capm4_rf3ta3 = geomAnd(capm4_rf3ta2 RFDUMMY1)  ;
capm4_rf3ta = geomAndNot(capm4_rf3ta3 RFDUMMYUD)  ;
capm4_rf3t_shield_poly = geomInside(capm4_rf3ta POLY1)  ; Added by KMLiu
mim_po = geomButtOrOver(POLY1 capm4_rf3t_shield_poly)  ;

; ***** Define connectivity/via layer -- pa24g5_ac ****
pa24g5_ac = geomAnd(pa24g5_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- pwhvnwdpw_col ****
pwhvnwdpw_cols = geomButtOnly(HVPW pwhvnwdpw_base)  ;
pwhvnwdpw_col1 = geomOr(pwhvnwdpw_cols pwhvnwdpw_base)  ;
pwhvnwdpw_emit_2 = geomButtOrOver(pwhvnwdpw_emit1 SH_P)  ;
pwhvnwdpw_col = geomAndNot(pwhvnwdpw_col1 pwhvnwdpw_emit_2)  ;

; ***** Define connectivity/via layer -- hvpdfd ****
hvpdfd1 = geomOr(hvpdfd_bcd40 hvpdfd_bcd60)  ;
hvpdfd_bcd12 = geomButtOrOver(PDD_BCD pa14_r5)  ; Drain of HV PMOS
hvpdfd2 = geomOr(hvpdfd1 hvpdfd_bcd12)  ;
hvpdfd_hv32 = geomButtOrOver(HVPW pgthv3)  ;
hvpdfd3 = geomOr(hvpdfd2 hvpdfd_hv32)  ;
hvpdfd_hv27 = geomButtOrOver(PDD pgthv_hv27)  ;
hvpdfd4 = geomOr(hvpdfd3 hvpdfd_hv27)  ;
hvpdfd_hv18 = geomButtOrOver(HVPW pgthv_hv18b)  ;
hvpdfd = geomOr(hvpdfd4 hvpdfd_hv18)  ;

; ***** Define connectivity/via layer -- nldpwhvnw_emit ****
nldpwhvnw_base = geomAnd(LDPW hvnw_reg2)  ;
nldpwhvnw_emit = geomAnd(tndiff nldpwhvnw_base)  ;

; ***** Define connectivity/via layer -- pbase_od2 ****
pbase_od2 = geomButtOrOver(pbase_gen OD2)  ;

; ***** Define connectivity/via layer -- ull_ncoll ****
ncollrg1 = geomAnd(nxwell npnrg)  ;
ull_ncollrg1 = geomAnd(ncollrg1 ULLNW)  ;
ull_ncollrg = geomAndNot(ull_ncollrg1 ELLDMY)  ;
pbase = geomAndNot(pbase_gen OD2)  ;
ull_ncoll1 = geomButtOnly(ull_ncollrg pbase)  ;
ull_ncoll = geomOr(ull_ncoll1 pbase)  ;define 1.8V BJT[NV] collector

; ***** Define connectivity/via layer -- ndld40g5_reg ****
ndld40g5_reg = geomAndNot(ndld40g5_r1 ndld40g5_ac)  ;

; ***** Define connectivity/via layer -- metal5 ****
M5X = geomOr(M5 DUM5)  ;
M5Y = geomAndNot(M5X M5SLOT)  ;
RMDMY5 = geomOr(RMDMY5i RMDMY)  ;
M5Z = geomAnd(M5Y RMDMY5)  ;
mt5res = geomButtOrOver(M5Z M5)  ; metal5 resistor
mt5x = geomAndNot(M5Y mt5res)  ;
metal5 = geomAndNot(mt5x ind_dmy)  ;

; ***** Define connectivity/via layer -- nxwell_npn ****
ncolls_all = geomButtOnly(ncollrg1 pbase_gen)  ;
ncollsa_all = geomButtOnly(ncolls_all nemit_gen1)  ;
nxwell_npn = geomAndNot(ncolls_all ncollsa_all)  ;

; ***** Define connectivity/via layer -- ell_coll ****
ell_nbase_gen = geomAnd(ull_nbase_gen3 ELLDMY)  ;
ell_nbase = geomAndNot(ell_nbase_gen OD2)  ; define 1.8V ELL BJT base terminal
ell_collsur = geomButtOnly(psub ell_nbase)  ;
ell_coll1a = geomOr(ell_collsur ell_nbase)  ;  define BJT[PV] collector
ell_emit_temp1 = geomAnd(ttdiff ell_nbase)  ; define 1.8V ELL BJT emitter
ell_emit = geomAndNot(ell_emit_temp1 hvwell)  ;
ell_collsura = geomButtOnly(ell_collsur ell_emit)  ;
ell_coll1b = geomAndNot(ell_coll1a ell_collsura)  ;
ell_coll = geomAndNot(ell_coll1b ell_emit)  ;  define pnp collector

; ***** Define connectivity/via layer -- hvnwdpwnbl60_emit ****
hvnwdpwnbl_emit1 = geomAnd(tndiff npwnbl_reg2b)  ;
hvnwdpwnbl_base1 = geomAnd(DPW npwnbl_reg2b)  ;
hvnwdpwnbl_base2 = geomButtOrOver(HVPW hvnwdpwnbl_base1)  ;
hvnwdpwnbl_base = geomOr(hvnwdpwnbl_base1 hvnwdpwnbl_base2)  ;
hvnwdpwnbl_emit_2 = geomAnd(hvnwdpwnbl_emit1 hvnwdpwnbl_base)  ;
hvnwdpwnbl_emit3 = geomAnd(hvnwdpwnbl_emit_2 SH_N)  ;
hvnwdpwnbl_emit4 = geomAnd(hvnwdpwnbl_emit3 HVNW)  ;
hvnwdpwnbl60_emit = geomAnd(hvnwdpwnbl_emit4 HV60DMY)  ;

; ***** Define connectivity/via layer -- pgthvau ****
pgthva_hv27 = geomButtOnly(geomOutside(pgthv_hv27 PDD) PDD keep == 1 ) ;
pgthvau = geomAnd(pgthva_hv27 HVDMY2)  ;

; ***** Define connectivity/via layer -- phvnwpsub_emit ****
phvnwpsub_emit = geomAndNot(phvnwpsub_emit1 geomButtOrOver(phvnwpsub_emit1 PDD))  ;

; ***** Define connectivity/via layer -- mom4m2 ****
mom4m2 = geomAndNot(mom4p21 geomButtOrOver(mom4p21 MOMDMY25))  ;

; ***** Define connectivity/via layer -- nld12g12_mac ****
nld12g12_mac = geomAnd(nld12g12_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- VIA3 ****
cv3 = geomAnd(VIA3i CTM3)  ; via for CTM3/M4
VIA3 = geomAndNot(VIA3i cv3)  ; via for M4/M4

; ***** Define connectivity/via layer -- ntgdrain ****
ntgdrain = geomAnd(tndiff CELL_TX)  ;

; ***** Define connectivity/via layer -- psub_under_hvnw_via ****
psub_under_hvnw = geomOr(psub_term HVNWi)  ;
psub_under_hvnw_via = geomAnd(psub_term psub_under_hvnw)  ;

; ***** Define connectivity/via layer -- pplug ****
pplug0 = geomAnd(tpdiff psub)  ;
PDD_in_hvnw = geomInside(PDD HVNW)  ;
pplug_in_pdd = geomAnd(tpdiff PDD_in_hvnw)  ;
pplug1 = geomOr(pplug0 pplug_in_pdd)  ;
pplug3 = geomButtOrOver(pplug1 CONT)  ;
tndiffco = geomButtOrOver(tndiff CONT)  ;
pplug2 = geomButtOrOver(pplug1 tndiffco)  ;
pplug = geomOr(pplug3 pplug2)  ; define p_sub contact

; ***** Define connectivity/via layer -- nld12g2_mac ****
nld12g2_mac = geomAnd(nld12g2_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- schottky_n ****
schottky_n1 = geomAnd(mdiff NIMP)  ;
schottky_n2 = geomAnd(schottky_n1 nxwell)  ;

nbl_nplug5 = geomAndNot(nbl_nplug4 SH_P)  ;
nbl_nplug6 = geomButtOrOver(nbl_nplug5 CONT)  ;
hvnw_dpw1 = geomInside(HVNW DPW)  ;
hvnw_dpw = geomButtOrOver(hvnw_dpw1 SH_N)  ;
nbl_nplug = geomAndNot(nbl_nplug6 hvnw_dpw)  ;


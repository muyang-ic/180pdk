; ***** Define connectivity/via layer -- nld32g5_reg ****
nld32g5_reg = geomAndNot(nld32g5_r2 nld32g5_ac)  ;

; ***** Define connectivity/via layer -- pgthvs_mac ****
pgthvs_mac = geomAndNot(pgthvs_hv27 HVDMY2)  ;

; ***** Define connectivity/via layer -- nld18g5_reg ****
nld18g5_reg = geomAndNot(nld18g5_r2 nld18g5_ac)  ;

; ***** Define connectivity/via layer -- s_tndiff ****
s_tndiff1 = geomAndNot(tndiff d_tndiff)  ;
s_tndiff = geomButtOrOver(s_tndiff1 gate_rf)  ;

; ***** Define connectivity/via layer -- mom3p2 ****
mom3p2 = geomButtOrOver(mom3p21 MOMDMY25)  ;

; ***** Define connectivity/via layer -- npwnbl_col ****
npwnbl_colr = geomAnd(HVNW npwnbl_reg2a)  ;
npwnbl_cols = geomButtOnly(npwnbl_colr npwnbl_base)  ;
npwnbl_col1 = geomOr(npwnbl_cols npwnbl_base)  ;
npwnbl_col = geomAndNot(npwnbl_col1 npwnbl_emit)  ;

; ***** Define connectivity/via layer -- ctm_via ****
ctm_via = geomCat(cv4)  ;

; ***** Define connectivity/via layer -- schottky_p ****
schottky_p1 = geomStraddle(diff PIMP)  ;
schottky_p2 = geomAnd(schottky_p1 nxwell)  ;

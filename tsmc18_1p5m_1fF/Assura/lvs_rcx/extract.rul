extractDevice("nch_hvnw_6t" nch_hvnw_6t_reg tndiff("D") poly("G") tndiff("S") psub("B") iso_hvnw("HVNW_ISO") psub_under_hvnw("SUB") physical
  spiceModel( "nch_hvnw_6t" )
  cellView( "nch_hvnw_6t ivpcell"  )
  flagMalformed)
   w_NMOS   = measureParameter(length (nch_hvnw_6t_reg butting tndiff) 0.5e-6)
   area_NMOS    = measureParameter(area (nch_hvnw_6t_reg) 1e-12)
   l_NMOS   = calculateParameter(area_NMOS/w_NMOS)
   areaS    = measureParameter( area (tndiff) 1e-12 )
   periS    = measureParameter( perimeter (tndiff) 1e-6 )
   attachParameter( areaS ("ad" "D") ("as" "S") nch_hvnw_6t_reg shared)
   attachParameter( periS ("pd" "D") ("ps" "S") nch_hvnw_6t_reg shared)
   if( avSwitch("ZERO_NRDS") then
   nrSD = calculateParameter(l_NMOS - l_NMOS)
   else
   nrSD = calculateParameter(((areaS/w_NMOS)/w_NMOS))
   )
   attachParameter( nrSD  ("nrd" "D") ("nrs" "S") nch_hvnw_6t_reg shared)
   nameParameter( w_NMOS "w" )
   nameParameter( l_NMOS "l" )
   attachParameter( w_NMOS "wf" nch_hvnw_6t_reg )
   hvnw_area    = measureParameter( area (iso_hvnw) 0 )
   hvnw_pj  = measureParameter( perimeter (iso_hvnw) 0 )
   pw_area  = measureParameter( area (psub) 0 )
   pw_pj    = measureParameter( perimeter (psub) 0 )
   attachParameter( hvnw_area "hvnw_area" nch_hvnw_6t_reg )
   attachParameter( hvnw_pj "hvnw_pj" nch_hvnw_6t_reg )
   attachParameter( pw_area "pw_area" nch_hvnw_6t_reg )
   attachParameter( pw_pj "pw_pj" nch_hvnw_6t_reg )
   if( !avSwitch( "spice_extraction") then
     saveProperty( nch_hvnw_6t_reg "model" "nch_hvnw_6t" )
   ) ; if

    gateL =  calculateParameter( l_NMOS * 1e6 )
    gateW =  calculateParameter( w_NMOS * 1e6 )
    measureSTI( nch_hvnw_6t_reg
                OD
                60
                output( invSA invSB )
                calculateExp(  sw/gateW/(sa + gateL*0.5)
                   sw/gateW/(sb + gateL*0.5)
                ) )
    SA = calculateParameter( (1/invSA - 0.5*gateL) * 1e-6 )
    nameParameter( SA "sa")
    SB = calculateParameter( (1/invSB - 0.5*gateL) * 1e-6 )
    nameParameter( SB "sb")

;    psub_proximity is followed mask logic operation
WPE_predict( poly, tndiff, nch_hvnw_6t_reg, "n", c_nmcore )


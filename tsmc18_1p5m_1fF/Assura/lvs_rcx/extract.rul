; ***** Define connectivity/via layer -- d_tndiff ****
d_tndiff = geomAnd(tndiff DRAIN)  ;

; ***** Define connectivity/via layer -- poly_hvpw ****
poly_hvpw = geomAnd(poly_term HVPW)  ;

; ***** Define connectivity/via layer -- ngthvsu ****
ngthvsu = geomAnd(ngthvs_hv27b HVDMY2)  ;

; ***** Define connectivity/via layer -- pa60g5soa_reg ****
pa60g5soa_reg = geomAndNot(pa60g5soa_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- poly_nw ****
poly_nw = geomAnd(poly_term nxwell)  ;

; ***** Define connectivity/via layer -- bvargt ****
tngate1 = geomAnd(gate_lv NIMP)  ;
vargt1 = geomAnd(tngate1 nxwell)  ;
vargt2 = geomAnd(vargt1 VARDMY)  ;
vargt3 = geomAndNot(vargt2 RFDUMMY)  ;
vargt4 = geomAndNot(vargt3 RFDUMMY1)  ;

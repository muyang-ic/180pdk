if( avSwitch( "GP_PROCESS") then
extractCAP("M4" capm4_1p0_udc ctm("TOP") metal4("BOT")
	spiceModel( "mimcap" )
	cellView( "mimcap ivpcell" )
	flagMalformed )
	area_CAP = measureParameter(area (capm4_1p0_udc) 1e-12)
	pj_CAP = measureParameter(perimeter (capm4_1p0_udc) 1e-6)
	cap_CAP1  = calculateParameter( area_CAP * MIMCAP_CA )
	cap_CAP2  = calculateParameter( pj_CAP * MIMCAP_CF )
	cap_CAP  = calculateParameter( cap_CAP1+cap_CAP2 )
	A_CAP    = measureParameter(area (capm4_1p0_udc))
	P_CAP   = measureParameter(perimeter (capm4_1p0_udc))
	P_2_CAP = calculateParameter( P_CAP * P_CAP)
	AC4 = calculateParameter( A_CAP * 16)
	KKK = calculateParameter( P_2_CAP-AC4)
	SQ = calculateParameter(sqrt(KKK))
	W = calculateParameter( ((P_CAP + SQ)/4) * 1e-6)
	L = calculateParameter( ((P_CAP - SQ)/4) * 1e-6)
	M = calculateParameter( L/L )
	nameParameter( area_CAP "AREA" )
	nameParameter( cap_CAP "VALUE" )
	nameParameter( cap_CAP "c" )
	nameParameter( L "l" )
	nameParameter( W "w" )
	nameParameter( M "m" )  
	if( !avSwitch( "spice_extraction") then
  		saveProperty( capm4_1p0_udc "model" "mimcap")
	)
)
	rcxLayer(capm4_1p0_udc)


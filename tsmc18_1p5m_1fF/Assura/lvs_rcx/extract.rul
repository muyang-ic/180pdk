extractMOS("nch_sf3" nsfgate poly("G") tndiff("S" "D") psub("B")
  spiceModel( "nch_sf3" )
  cellView( "nch_sf3 ivpcell" )
  flagMalformed)
   w_NMOS    = measureParameter(length (nsfgate butting tndiff) 0.5e-6)

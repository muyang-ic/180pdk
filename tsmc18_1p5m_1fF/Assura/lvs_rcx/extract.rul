;#############################################
;# ERC CHECK                                 #
;#############################################
; I. The soft-connect checks already include in the "Soft-Connect_Checks" ivIf 
;    statement. Please turn on "Soft-Connect_Checks" switch to check the soft 
;    connect issues on Nwell or Substrate. 
ercSetPwr( "VDD" "AVDD" "VD33" "VDDSA" "VDDPST" "VDD5V" "VDDG" "AVD33" "AVDDR" "AVDDG" "AVDDB" "AVDDBG" "AVD33R" "AVD33G" "AVD33B" "AVDWELL" "VDWELL" "AVD33WELL" "VD33WELL" "TAVDD" "TAVD33" "TAVD33PST" "TAVDDPST" "DVDD" "VDDM" "VDDESD" "TVDD")
ercSetGnd( "GND" "AGND" "VSS" "AVSS" "VS33" "VSSPST" "VSSG" "AVS33" "AVSSR" "AVSSG" "AVSSB" "AVSSBG" "AVS33R" "AVS33G" "AVS33B" "AVSSUB" "VSSUB" "AVS33SUB" "VS33SUB" "TAVSS" "TAVSSPST" "DVSS" "VSSM" "VSSESD" "TACVSS" "TVSS")

; MOS  S/D connect to POWER&GROUND --mppg_ldd*/
 N1hvpdfs_mppg_lddA = geomGetNet( hvpdfs  "VDD" "AVDD" "VD33" "VDDSA" "VDDPST" "VDD5V" "VDDG" "AVD33" "AVDDR" "AVDDG" "AVDDB" "AVDDBG" "AVD33R" "AVD33G" "AVD33B" "AVDWELL" "VDWELL" "AVD33WELL" "VD33WELL" "TAVDD" "TAVD33" "TAVD33PST" "TAVDDPST" "DVDD" "VDDM" "VDDESD" "TVDD")
 T1hvpdfs_mppg_lddA = geomButtOrOver(erc_pmos_gates N1hvpdfs_mppg_lddA)
 N2hvpdfd_mppg_lddA = geomGetNet( hvpdfd  "GND" "AGND" "VSS" "AVSS" "VS33" "VSSPST" "VSSG" "AVS33" "AVSSR" "AVSSG" "AVSSB" "AVSSBG" "AVS33R" "AVS33G" "AVS33B" "AVSSUB" "VSSUB" "AVS33SUB" "VS33SUB" "TAVSS" "TAVSSPST" "DVSS" "VSSM" "VSSESD" "TACVSS" "TVSS")
 T2hvpdfd_mppg_lddA = geomButtOrOver(erc_pmos_gates N2hvpdfd_mppg_lddA)
 N1hvpdfd_mppg_lddB = geomGetNet( hvpdfd  "VDD" "AVDD" "VD33" "VDDSA" "VDDPST" "VDD5V" "VDDG" "AVD33" "AVDDR" "AVDDG" "AVDDB" "AVDDBG" "AVD33R" "AVD33G" "AVD33B" "AVDWELL" "VDWELL" "AVD33WELL" "VD33WELL" "TAVDD" "TAVD33" "TAVD33PST" "TAVDDPST" "DVDD" "VDDM" "VDDESD" "TVDD")
 T1hvpdfd_mppg_lddB = geomButtOrOver(erc_pmos_gates N1hvpdfd_mppg_lddB)
 N2hvpdfs_mppg_lddB = geomGetNet( hvpdfs  "GND" "AGND" "VSS" "AVSS" "VS33" "VSSPST" "VSSG" "AVS33" "AVSSR" "AVSSG" "AVSSB" "AVSSBG" "AVS33R" "AVS33G" "AVS33B" "AVSSUB" "VSSUB" "AVS33SUB" "VS33SUB" "TAVSS" "TAVSSPST" "DVSS" "VSSM" "VSSESD" "TACVSS" "TVSS")
 T2hvpdfs_mppg_lddB = geomButtOrOver(erc_pmos_gates N2hvpdfs_mppg_lddB)
if( avSwitch( "DS_TO_PG_CHECK") then
 mppg_ldd =  geomOr( geomAnd(T1hvpdfs_mppg_lddA T2hvpdfd_mppg_lddA ) geomAnd(T1hvpdfd_mppg_lddB T2hvpdfs_mppg_lddB ) )
 errorLayer( mppg_ldd "<mppg_ldd> MOS connected to both power and ground !")
)


if( avSwitch( "FLOATING_GATE_CHECK") then
; Floating gate no any CONT interact with the poly_erc
 poly_erc_no_CONT = geomAndNot(poly_erc geomButtOrOver(poly_erc CONT))
 gate_no_co = geomAnd(poly_erc_no_CONT diff)
 gate_no_co1 = geomAndNot(gate_no_co RFDUMMY1)
 floating = geomButtOrOver(poly_erc_no_CONT gate_no_co1)
 errorLayer( floating "<floating> Floating gate no any cont ")

)


if( avSwitch( "FLOATING_WELL_CHECK") then
geomStamp( HVNW_float tndiff by nplug multStamp )
;Floating.HVNW_float :  HVNW_float is not connected to POWER
  gpck_HVNW_float = geomPathCheck( layer(HVNW_float) noPwr)
  errorLayer( gpck_HVNW_float  "<floating.HVNW_float> Floating HVNW_float is not allowed." )
)

if( avSwitch( "FLOATING_WELL_CHECK") then
geomStamp( nxwell_float tndiff by nplug multStamp )
;Floating.nxwell_float :  nxwell_float is not connected to POWER
  gpck_nxwell_float = geomPathCheck( layer(nxwell_float) noPwr)
  errorLayer( gpck_nxwell_float  "<floating.nxwell_float> Floating nxwell_float is not allowed." )
)

if( avSwitch( "FLOATING_WELL_CHECK") then
geomStamp( psub_float tpdiff by pplug multStamp )
;Floating.psub_float :  psub_float is not connected to GROUND
  gpck_psub_float = geomPathCheck( layer(psub_float) noGnd)
  errorLayer( gpck_psub_float  "<floating.psub_float> Floating psub_float is not allowed." )
)

; MOS  S/D connect to POWER&GROUND --mnpg_hvs*/
 N1hvndfd = geomGetNet( hvndfd  "VDD" "AVDD" "VD33" "VDDSA" "VDDPST" "VDD5V" "VDDG" "AVD33" "AVDDR" "AVDDG" "AVDDB" "AVDDBG" "AVD33R" "AVD33G" "AVD33B" "AVDWELL" "VDWELL" "AVD33WELL" "VD33WELL" "TAVDD" "TAVD33" "TAVD33PST" "TAVDDPST" "DVDD" "VDDM" "VDDESD" "TVDD")
 T1hvndfd = geomButtOrOver(erc_nmos_gates N1hvndfd)
 N2hvndfd = geomGetNet( hvndfd  "GND" "AGND" "VSS" "AVSS" "VS33" "VSSPST" "VSSG" "AVS33" "AVSSR" "AVSSG" "AVSSB" "AVSSBG" "AVS33R" "AVS33G" "AVS33B" "AVSSUB" "VSSUB" "AVS33SUB" "VS33SUB" "TAVSS" "TAVSSPST" "DVSS" "VSSM" "VSSESD" "TACVSS" "TVSS")
 T2hvndfd = geomButtOrOver(erc_nmos_gates N2hvndfd)
if( avSwitch( "DS_TO_PG_CHECK") then
 mnpg_hvs = geomAnd(T1hvndfd T2hvndfd)
 errorLayer( mnpg_hvs "<mnpg_hvs> MOS connected to both power and ground !")
)


if( avSwitch( "GATE_TO_PG_CHECK") then

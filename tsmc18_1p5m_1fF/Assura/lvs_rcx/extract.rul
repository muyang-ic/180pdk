extractDevice("mimcap_shield" capm4_rf3t_shield_m3_1p0_ud ctm("PLUS") metal4("MINUS") metal3("BULK")
   spiceModel("mimcap_shield") 
   cellView( "mimcap_rf ivpcell" )
   flagMalformed 
)
   PJ = measureParameter(perimeter (capm4_rf3t_shield_m3_1p0_ud over ctm) 1e-6)
   A  = measureParameter(area (capm4_rf3t_shield_m3_1p0_ud) 1e-12)
   L1 = measureParameter(length (capm4_rf3t_shield_m3_1p0_ud coincident metal5) 1e-6)
   LT  = calculateParameter(PJ - L1)
   WT  = calculateParameter(A/LT)
   LAY = calculateParameter( LT/LT*5 )   
   nameParameter(LAY "lay")
   nameParameter(LT "lt")
   nameParameter(WT "wt")
   if( !avSwitch( "spice_extraction") then
   	saveProperty( capm4_rf3t_shield_m3_1p0_ud "model" "mimcap_shield" )
   )

extractDevice("mimcap_1p0_sin_hl_3t" capm4_1p0_hl_3t ctm("PLUS") metal4("MINUS") mim_term("BULK")
	spiceModel( "mimcap_1p0_sin_hl_3t" )
	cellView( "mimcap_1p0_sin_hl_3t ivpcell" )
	flagMalformed )
	area_CAP = measureParameter(area (capm4_1p0_hl_3t) 1e-12)
	pj_CAP = measureParameter(perimeter (capm4_1p0_hl_3t) 1e-6)
	A_CAP    = measureParameter(area (capm4_1p0_hl_3t))
	P_CAP   = measureParameter(perimeter (capm4_1p0_hl_3t))
	P_2_CAP = calculateParameter( P_CAP * P_CAP)
	AC4 = calculateParameter( A_CAP * 16)
	KKK = calculateParameter( P_2_CAP-AC4)
	SQ = calculateParameter(sqrt(KKK))
	wt = calculateParameter( ((P_CAP - SQ)/4) * 1e-6)
	lt = calculateParameter( ((P_CAP + SQ)/4) * 1e-6)
	M = calculateParameter( lt/lt )
	LAY = calculateParameter( lt/lt*5 )
	nameParameter( LAY "lay" )
	nameParameter( LAY "mLvl" )
	nameParameter( lt "lt")
	nameParameter( lt "l")
	nameParameter( wt "wt")
	nameParameter( wt "w")
	nameParameter( M "m" )
	if( !avSwitch( "spice_extraction") then  
		saveProperty( capm4_1p0_hl_3t "model" "mimcap_1p0_sin_hl_3t")
	)


nld12g2_reg = geomAndNot(nld12g2_r1 MACRODMY)  ;

; ***** Define connectivity/via layer -- nld32g5_ac ****
nld32g5_r2 = geomAndNot(nld32g5_r1 geomButtOrOver(nld32g5_r1 hvndfd_nld18g5))  ;
nld32g5_ac = geomAnd(nld32g5_r2 MACRODMY)  ;

; ***** Define connectivity/via layer -- ngthvis ****
ngthvs_hv27a = geomButtOnly(geomOutside(ngthv_hv27 NDD) NDD keep == 2 ) ;
ngthvis = geomAnd(ngthvs_hv27a DNW)  ;


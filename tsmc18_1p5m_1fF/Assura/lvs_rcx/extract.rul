extractLDD("nch_tg3" ntggate poly("G") pidiff("S") ntgdrain("D") psub("B")
   spiceModel( "nch_tg3" )
   cellView( "nch_tg3 ivpcell")
   flagMalformed)
   w_NMOS    = measureParameter(length (ntggate butting ntgdrain) 1e-6)
   area_NMOS = measureParameter(area (ntggate) 1e-12)
   l_NMOS    = calculateParameter(area_NMOS/w_NMOS)
   areaS     = measureParameter(area (pidiff) 1e-12)
   periS     = measureParameter(perimeter (pidiff) 1e-6)
   areaD     = measureParameter(area (ntgdrain) 1e-12)
   periD     = measureParameter(perimeter (ntgdrain) 1e-6)
   attachParameter( areaS  ("as" "S") ntggate sharedWeight( "w" ))
   attachParameter( periS  ("ps" "S") ntggate sharedWeight( "w" ))
   attachParameter( areaD  ("ad" "D") ntggate sharedWeight( "w" ))
   attachParameter( periD  ("pd" "D") ntggate sharedWeight( "w" ))
   if( avSwitch("ZERO_NRDS") then 
      nrSD = calculateParameter(l_NMOS - l_NMOS) 
      attachParameter( nrSD  ("nrd" "D") ("nrs" "S") ntggate shared) 
   else 
      nrS = calculateParameter(((areaS/w_NMOS)/w_NMOS)) 
      nrD = calculateParameter(((areaD/w_NMOS)/w_NMOS)) 
      attachParameter( nrS  ("nrs" "S") ntggate sharedWeight( "w" )) 
      attachParameter( nrD  ("nrd" "D") ntggate sharedWeight( "w" )) 
   )
   nameParameter( w_NMOS "w" )
   nameParameter( w_NMOS "wf" )
   nameParameter( l_NMOS "l" )
   if( !avSwitch( "spice_extraction") then
      saveProperty( ntggate "model" "nch_tg3") 
   ) ;if


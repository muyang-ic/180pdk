extractDevice("ndio_hia_rf" hia_ndio_rf_r psub("PLUS") tndiff("MINUS")
	spiceModel("ndio_hia_rf")
	cellView( "ndio_hia_rf ivpcell" )
	flagMalformed
)
	fn      = measureParameter(figCount (hia_ndio_rf_r enclosing hia_ndio_rf))
	A_DIO1  = measureParameter(area (hia_ndio_rf))
	A_DIO   = calculateParameter(A_DIO1/fn)
	P_DIO1  = measureParameter(perimeter (hia_ndio_rf))
	P_DIO   = calculateParameter(P_DIO1/fn)
	P_2_DIO = calculateParameter(P_DIO * P_DIO)
	AD4     = calculateParameter(A_DIO * 16)
	KKK     = calculateParameter(P_2_DIO - AD4)
	SQ      = calculateParameter(sqrt(KKK))
	al      = calculateParameter(((P_DIO + SQ)/4) * 1e-6)
	aw      = calculateParameter(((P_DIO - SQ)/4) * 1e-6)
	attachParameter(fn "fn" hia_ndio_rf_r)
	attachParameter(al "al" hia_ndio_rf_r)
	attachParameter(aw "aw" hia_ndio_rf_r)
	if( !avSwitch( "spice_extraction") then  
  		saveProperty( hia_ndio_rf_r "model" "ndio_hia_rf")
	)


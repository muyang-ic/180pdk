; MOS  S/D connect to POWER&GROUND --mnpg_ldd*/
 N1hvndfs_mnpg_lddA = geomGetNet( hvndfs  "VDD" "AVDD" "VD33" "VDDSA" "VDDPST" "VDD5V" "VDDG" "AVD33" "AVDDR" "AVDDG" "AVDDB" "AVDDBG" "AVD33R" "AVD33G" "AVD33B" "AVDWELL" "VDWELL" "AVD33WELL" "VD33WELL" "TAVDD" "TAVD33" "TAVD33PST" "TAVDDPST" "DVDD" "VDDM" "VDDESD" "TVDD")
 T1hvndfs_mnpg_lddA = geomButtOrOver(erc_nmos_gates N1hvndfs_mnpg_lddA)
 N2hvndfd_mnpg_lddA = geomGetNet( hvndfd  "GND" "AGND" "VSS" "AVSS" "VS33" "VSSPST" "VSSG" "AVS33" "AVSSR" "AVSSG" "AVSSB" "AVSSBG" "AVS33R" "AVS33G" "AVS33B" "AVSSUB" "VSSUB" "AVS33SUB" "VS33SUB" "TAVSS" "TAVSSPST" "DVSS" "VSSM" "VSSESD" "TACVSS" "TVSS")
 T2hvndfd_mnpg_lddA = geomButtOrOver(erc_nmos_gates N2hvndfd_mnpg_lddA)
 N1hvndfd_mnpg_lddB = geomGetNet( hvndfd  "VDD" "AVDD" "VD33" "VDDSA" "VDDPST" "VDD5V" "VDDG" "AVD33" "AVDDR" "AVDDG" "AVDDB" "AVDDBG" "AVD33R" "AVD33G" "AVD33B" "AVDWELL" "VDWELL" "AVD33WELL" "VD33WELL" "TAVDD" "TAVD33" "TAVD33PST" "TAVDDPST" "DVDD" "VDDM" "VDDESD" "TVDD")
 T1hvndfd_mnpg_lddB = geomButtOrOver(erc_nmos_gates N1hvndfd_mnpg_lddB)
 N2hvndfs_mnpg_lddB = geomGetNet( hvndfs  "GND" "AGND" "VSS" "AVSS" "VS33" "VSSPST" "VSSG" "AVS33" "AVSSR" "AVSSG" "AVSSB" "AVSSBG" "AVS33R" "AVS33G" "AVS33B" "AVSSUB" "VSSUB" "AVS33SUB" "VS33SUB" "TAVSS" "TAVSSPST" "DVSS" "VSSM" "VSSESD" "TACVSS" "TVSS")
 T2hvndfs_mnpg_lddB = geomButtOrOver(erc_nmos_gates N2hvndfs_mnpg_lddB)
if( avSwitch( "DS_TO_PG_CHECK") then
 mnpg_ldd =  geomOr( geomAnd(T1hvndfs_mnpg_lddA T2hvndfd_mnpg_lddA ) geomAnd(T1hvndfd_mnpg_lddB T2hvndfs_mnpg_lddB ) )
 errorLayer( mnpg_ldd "<mnpg_ldd> MOS connected to both power and ground !")
)



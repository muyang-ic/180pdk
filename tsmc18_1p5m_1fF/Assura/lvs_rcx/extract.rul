capdmy1p5b = geomAndNot(capdmy1p5a CTMDMY2p0)  ;
capdmy1p5 = geomAnd(capdmy1p5b CTMDMY1p5)  ;ctmdmy1p5
capm4_1p5_ud1 = geomButtOrOver(capm4_ud_2t capdmy1p5)  ;
capm4_1p5 = geomButtOrOver(capm4_2t capdmy1p5)  ;
capm4_1p5_udc = geomOr(capm4_1p5_ud1 capm4_1p5)  ;
;
;* Define device -- xdev mimcap_3t

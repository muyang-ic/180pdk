ioldnmos_reg = geomButtOrOver(ioldnmos_r2 H18NW)  ;  NCH_HV5_5VNW_AC reg layer

; ***** Define connectivity/via layer -- ldpwhvnwpsub_base ****
ldpwhvnwpsub_base = geomButtOrOver(HVNWi ldpwhvnwpsub_emit)  ;

; ***** Define connectivity/via layer -- ndld24g5_reg ****

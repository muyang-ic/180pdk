pidiff = geomAnd(pidiff1 PPS)  ;

; ***** Define connectivity/via layer -- n_pplug ****
n_pplug1 = geomButtOrOver(mdiff CONT)  ;
n_pplug2 = geomAnd(n_pplug1 PIMP)  ;
n_pplug3 = geomAndNot(n_pplug2 gate_all)  ;
n_pplug4 = geomAndNot(n_pplug3 nxwell)  ;
n_pplug5 = geomAndNot(n_pplug4 HVNW)  ;
n_pplug6 = geomAndNot(n_pplug5 rw)  ;
n_pplug7 = geomAnd(n_pplug6 n_psub)  ;
ldpw_inside_hvnwi = geomInside(LDPW HVNWi)  ;
n_pplug8 = geomAndNot(n_pplug7 ldpw_inside_hvnwi)  ;
pdd_bcd_inside_hvnwi = geomInside(PDD_BCD HVNWi)  ;
n_pplug9 = geomAndNot(n_pplug8 pdd_bcd_inside_hvnwi)  ;
hvpb_inside_hvnwi = geomInside(HVPB HVNWi)  ;
n_pplug10 = geomAndNot(n_pplug9 hvpb_inside_hvnwi)  ;
dpw_inside_hvnwi = geomInside(DPW HVNWi)  ;
n_pplug = geomAndNot(n_pplug10 dpw_inside_hvnwi)  ;

; ***** Define connectivity/via layer -- c2poly ****
rp2 = geomAndNot(rp1 geomButtOrOver(rp1 POLY1))  ;
p2rdum = geomButtOrOver(rp2 POLY2)  ;
resp2 = geomAnd(POLY2 p2rdum)  ; poly2 resistor layer
c2poly = geomAndNot(POLY2 resp2)  ; poly2 interconnect

; ***** Define connectivity/via layer -- ioldnmos_reg ****
tngate2 = geomAndNot(tngate1 MCEL)  ;
tngate3 = geomAndNot(tngate2 nxwell)  ;
tngate4 = geomAndNot(tngate3 CIRPO)  ;
tngate4a = geomAndNot(tngate4 OD3)  ;
tngate5 = geomAndNot(tngate4a lcesd1)  ;
tngate6 = geomAndNot(tngate5 lcesd2)  ;
tngate7 = geomAndNot(tngate6 LDPW)  ;

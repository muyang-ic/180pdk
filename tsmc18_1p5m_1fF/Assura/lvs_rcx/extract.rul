;
;* Define device -- nmos N
ngate1 = geomAndNot(tngate OD2)  ;
ngate3 = geomAndNot(ngate1 NTN)  ;
ngate4 = geomAndNot(ngate3 DNW)  ;
ngate5 = geomAndNot(ngate4 VTMN)  ;
ngate6 = geomAndNot(ngate5 RFDUMMY)  ;
if( avSwitch("MACRO") then;
MAC = geomCat(OD);
else;
od_1 = geomSize(OD 0.005);
MAC = geomAndNot(OD od_1);
) ;if 
ngate = geomAndNot(ngate6 MAC)  ; 1.8V Nominal VT NMOS
;
;* Define device -- nmos N1
nrgate1 = geomAnd(ngate3 DNW)  ;
nrgate2 = geomAndNot(nrgate1 VTMN)  ;
nrgate3 = geomAndNot(nrgate2 HVPW)  ;
nrgate4 = geomAndNot(nrgate3 RFDUMMY)  ;
nrgate = geomAndNot(nrgate4 MAC)  ; 1.8V nominal VT NMOS on DNW
;
;* Define device -- nmos ND
bngate1a = geomAndNot(bngate1 geomButtOrOver(bngate1 H18VNWDMY))  ;
bngate1b = geomAndNot(bngate1a NLVT)  ;
bngate2 = geomAndNot(bngate1b NTN)  ;
bngate3 = geomAndNot(bngate2 CAP_IMP)  ;
bngate4 = geomAndNot(bngate3 DNW)  ;
bngate5 = geomAndNot(bngate4 VTMN)  ;
bngate6 = geomAndNot(bngate5 RFDUMMY)  ;
bngate7 = geomAndNot(bngate6 VTDN)  ;
bngate8 = geomAndNot(bngate7 VTHVDN)  ;
bngate = geomAndNot(bngate8 MAC)  ; 3.3/5V Nominal VT NMOS
;
;* Define device -- nmos N2
bnrgate1 = geomAnd(bngate2 DNW)  ;
bnrgate2 = geomAndNot(bnrgate1 VTMN)  ; N2(nch3 or nch_5) should not have VTMN
bnrgate3 = geomAndNot(bnrgate2 RFDUMMY)  ;
bnrgate = geomAndNot(bnrgate3 MAC)  ; 3.3/5V nominal VT NMOS on DNW
;
;* Define device -- nmos NL
nlgate1 = geomAnd(ngate1 NTN)  ;
nlgate2 = geomAndNot(nlgate1 RFDUMMY)  ;
nlgate = geomAndNot(nlgate2 MAC)  ; 1.8V native NMOS
;
;* Define device -- nmos NN
bnlgate1 = geomAnd(bngate1b NTN)  ;
bnlgate2 = geomAndNot(bnlgate1 RFDUMMY)  ;
bnlgate = geomAndNot(bnlgate2 MAC)  ; 3.3/5V native NMOS
;
;* Define device -- nmos NA
mvt_ngate1 = geomAnd(ngate3 VTMN)  ;
mvt_ngate2 = geomAndNot(mvt_ngate1 RFDUMMY)  ;
mvt_ngate = geomAndNot(mvt_ngate2 MAC)  ; 1.8V medium VT NMOS
;
;* Define device -- nmos NB
bmvt_ngate1 = geomAnd(bngate3 VTMN)  ;
bmvt_ngate2 = geomAndNot(bmvt_ngate1 RFDUMMY)  ;
bmvt_ngate = geomAndNot(bmvt_ngate2 MAC)  ; 3.3/5V medium VT NMOS
;
;* Define device -- pmos P
tpgate1 = geomAnd(gate_lv PIMP)  ;
tpgate2 = geomAnd(tpgate1 nxwell)  ;
tpgate3 = geomAndNot(tpgate2 HVNWi)  ;
tpgate3a = geomAndNot(tpgate3 ULLNW)  ;
tpgate3b = geomAndNot(tpgate3a OD3)  ;
tpgate = geomAndNot(tpgate3b MTDUM)  ; 4t pmos
pgate1 = geomAndNot(tpgate OD2)  ;
pgate2 = geomAndNot(pgate1 VTMP)  ;
pgate3 = geomAndNot(pgate2 RFDUMMY)  ;
pgate = geomAndNot(pgate3 MAC)  ; 1.8V core normal pmos
;
;* Define device -- pmos PD
bpgate1 = geomAnd(tpgate OD2)  ;
bpgate2 = geomAndNot(bpgate1 VTMP)  ;
bpgate4 = geomAndNot(bpgate2 RFDUMMY)  ;
bpgate = geomAndNot(bpgate4 MAC)  ; 3.3V Nominal VT PMOS
;
;* Define device -- pmos PA
mvt_pgate1 = geomAnd(pgate1 VTMP)  ;
mvt_pgate2 = geomAndNot(mvt_pgate1 RFDUMMY)  ;
mvt_pgate = geomAndNot(mvt_pgate2 MAC)  ; 1.8V medium VT PMOS
;
;* Define device -- nmos nch_mac
ngate_mac = geomAnd(ngate6 MAC)  ; 1.8V Nominal VT NMOS macro model
;
;* Define device -- nmos nch_dnw_mac
nrgate_mac = geomAnd(nrgate4 MAC)  ; 1.8V nominal VT NMOS on DNW macro model
;
;* Define device -- nmos mench
mvt_ngate_mac1 = geomAnd(mvt_ngate2 MAC)  ; 1.8V medium VT NMOS macro model
if( avSwitch("PROCESS_WO_MVTMOS_MACRO") then;
MAC_MVT = geomCat(OD);
else;
OD_1 = geomSize(OD 0.005);
MAC_MVT = geomAndNot(OD OD_1);
) ;if 
mvt_ngate_nomac = geomAnd(mvt_ngate_mac1 MAC_MVT)  ;
;
;* Define device -- nmos mench_mac
mvt_ngate_mac = geomAndNot(mvt_ngate_mac1 MAC_MVT)  ;
;
;* Define device -- nmos nanch_mac
nlgate_mac = geomAnd(nlgate2 MAC)  ; 1.8V native NMOS macro model
;
;* Define device -- pmos pch_mac
pgate_mac = geomAnd(pgate3 MAC)  ; mismatch 1.8V core normal pmos
;
;* Define device -- pmos mepch
mvt_pgate_mac1 = geomAnd(mvt_pgate2 MAC)  ; 1.8V medium VT PMOS macro model
mvt_pgate_nomac = geomAnd(mvt_pgate_mac1 MAC_MVT)  ;
;
;* Define device -- pmos mepch_mac
mvt_pgate_mac = geomAndNot(mvt_pgate_mac1 MAC_MVT)  ;
;
;* Define device -- nmos nch3_mac
bngate_mac = geomAnd(bngate8 MAC)  ;
;
;* Define device -- nmos nch3_dnw_mac
bnrgate_mac = geomAnd(bnrgate3 MAC)  ; 3.3/5V nominal VT NMOS on DNW macro model
;
;* Define device -- nmos mench3
bmvt_ngate_mac1 = geomAnd(bmvt_ngate2 MAC)  ; 3.3/5V medium VT NMOS macro model
bmvt_ngate_nomac = geomAnd(bmvt_ngate_mac1 MAC_MVT)  ;
;
;* Define device -- nmos mench3_mac
bmvt_ngate_mac = geomAndNot(bmvt_ngate_mac1 MAC_MVT)  ;
;
;* Define device -- nmos nanch3_mac
bnlgate_mac = geomAnd(bnlgate2 MAC)  ; 3.3/5V native NMOS macro model
;
;* Define device -- pmos pch3_mac
bpgate_mac = geomAnd(bpgate4 MAC)  ; 3.3V Nominal VT PMOS macro model
;
;* Define device -- nmos UN
nulgate1 = geomAnd(tngate4 OD3)  ;
od2f1 = geomOr(MCEL NOPW)  ;
od2f = geomOr(HVNW od2f1)  ; thick oxide in flash
GOD2 = geomOr(od2f OD2)  ; thick and 3.3V oxide

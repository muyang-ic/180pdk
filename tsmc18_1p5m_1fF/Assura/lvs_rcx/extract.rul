; ***** Define connectivity/via layer -- psub_under_nbl_via ****
psub_under_nbl_via = geomAnd(psub_term psub_under_nbl)  ;

; ***** Define connectivity/via layer -- pa40g5ron_ac ****
pa40g5ron_r1 = geomAndNot(pa40g5_r3 HVDMY2)  ; PA40G5 LOW RON gate
pa40g5ron_ac = geomAnd(pa40g5ron_r1 MACRODMY)  ;


if( !avSwitch( "GP_PROCESS") then
extractDevice("mimcap_2p0_sin" capm4_2p0_ud ctm("TOP") metal4("BOT")
	spiceModel( "mimcap_2p0_sin" )
	cellView( "mimcap_2p0_sin ivpcell" )
	flagMalformed )
	area_CAP = measureParameter(area (capm4_2p0_ud) 1e-12)
	pj_CAP = measureParameter(perimeter (capm4_2p0_ud) 1e-6)
	A_CAP    = measureParameter(area (capm4_2p0_ud))
	P_CAP   = measureParameter(perimeter (capm4_2p0_ud))
	P_2_CAP = calculateParameter( P_CAP * P_CAP)
	AC4 = calculateParameter( A_CAP * 16)
	KKK = calculateParameter( P_2_CAP-AC4)
	SQ = calculateParameter(sqrt(KKK))
	wt = calculateParameter( ((P_CAP - SQ)/4) * 1e-6)
	lt = calculateParameter( ((P_CAP + SQ)/4) * 1e-6)
	M = calculateParameter( lt/lt )
	LAY = calculateParameter( lt/lt*5 )
	nameParameter( LAY "lay" )
	nameParameter( LAY "mLvl" )
	nameParameter( lt "lt")
	nameParameter( lt "l")
	nameParameter( wt "wt")
	nameParameter( wt "w")
	nameParameter( M "m" )
	if( !avSwitch( "spice_extraction") then  
		saveProperty( capm4_2p0_ud "model" "mimcap_2p0_sin")
	)
)
	rcxLayer(capm4_2p0_ud)

if( avSwitch( "GP_PROCESS") then
extractDevice("moscap_rf33" varnwmi_rf_nw1 poly("PLUS") tndiff("MINUS") psub("BULK")
   spiceModel("moscap_rf33") 
   cellView( "mos_var33 ivpcell" )
   flagMalformed
)
   fg  = measureParameter(figCount (varnwmi_rf_nw1 enclosing bvargt3_rf))
   a1  = measureParameter(area (bvargt3_rf) 1e-12)
   a   = calculateParameter(a1/fg)
   pj1 = measureParameter(perimeter (bvargt3_rf over varnwmi_rf_nw1) 1e-6)
   pj  = calculateParameter(pj1/fg)
   wf1 = measureParameter( length ( bvargt3_rf butting tndiff ) 0.5e-6 )
   wf  = calculateParameter( wf1 / fg )
   lf  = calculateParameter( a / wf )
   G   = measureParameter(figCount (varnwmi_rf_nw1 enclosing nthin))
   B  = calculateParameter(fg/G)
   m   = calculateParameter( fg/fg )
   attachParameter(m  "m"  varnwmi_rf_nw1)
   attachParameter(a  "a"  varnwmi_rf_nw1)
   attachParameter(pj "pj" varnwmi_rf_nw1)
   attachParameter(wf "wf" varnwmi_rf_nw1)
   attachParameter(lf "lf" varnwmi_rf_nw1)
   attachParameter(G  "g"  varnwmi_rf_nw1)
   attachParameter(B  "b"  varnwmi_rf_nw1)
   attachParameter(G  "group"  varnwmi_rf_nw1)
   attachParameter(B  "branch"  varnwmi_rf_nw1)
   if( !avSwitch( "spice_extraction") then
   	saveProperty(varnwmi_rf_nw1 "model" "moscap_rf33")
   )
)


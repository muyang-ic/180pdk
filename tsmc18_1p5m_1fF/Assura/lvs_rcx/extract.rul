extractDevice("pch_5t" pch_5t_reg tpdiff("D") poly("G") tpdiff("S") iso_hvnw("B") psub_under_hvnw("SUB") physical
  spiceModel( "pch_5t" )
  cellView( "pch_5t ivpcell"  )
  flagMalformed)
   w_PMOS   = measureParameter(length (pch_5t_reg butting tpdiff) 0.5e-6)
   area_PMOS    = measureParameter(area (pch_5t_reg) 1e-12)
   l_PMOS   = calculateParameter(area_PMOS/w_PMOS)
   areaS    = measureParameter( area (tpdiff) 1e-12 )
   periS    = measureParameter( perimeter (tpdiff) 1e-6 )
   attachParameter( areaS ("ad" "D") ("as" "S") pch_5t_reg shared)
   attachParameter( periS ("pd" "D") ("ps" "S") pch_5t_reg shared)
   if( avSwitch("ZERO_NRDS") then
   nrSD = calculateParameter(l_PMOS - l_PMOS)
   else
   nrSD = calculateParameter(((areaS/w_PMOS)/w_PMOS))
   )
   attachParameter( nrSD  ("nrd" "D") ("nrs" "S") pch_5t_reg shared)
   nameParameter( w_PMOS "w" )
   nameParameter( l_PMOS "l" )
   attachParameter( w_PMOS "wf" pch_5t_reg )
   hvnw_area    = measureParameter( area (iso_hvnw) 0 )
   hvnw_pj  = measureParameter( perimeter (iso_hvnw) 0 )
   attachParameter( hvnw_area "hvnw_area" pch_5t_reg )
   attachParameter( hvnw_pj "hvnw_pj" pch_5t_reg )
   if( !avSwitch( "spice_extraction") then
     saveProperty( pch_5t_reg "model" "pch_5t" )
   ) ; if

    gateL =  calculateParameter( l_PMOS * 1e6 )
    gateW =  calculateParameter( w_PMOS * 1e6 )
    measureSTI( pch_5t_reg
                OD
                60
                output( invSA invSB )
                calculateExp(  sw/gateW/(sa + gateL*0.5)
                   sw/gateW/(sb + gateL*0.5)
                ) )
    SA = calculateParameter( (1/invSA - 0.5*gateL) * 1e-6 )
    nameParameter( SA "sa")
    SB = calculateParameter( (1/invSB - 0.5*gateL) * 1e-6 )
    nameParameter( SB "sb")

;    nxwell_proximity is followed mask logic operation
WPE_predict( poly, tpdiff, pch_5t_reg, "p", c_pmcore )


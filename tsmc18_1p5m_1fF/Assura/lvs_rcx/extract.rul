;   Q[nldpwhvnw2]      N+/LDPW/HVNW BJT          (BJTDMY*OD*NIMP*LDPW*HVNW*) 
;   Q[ldpwhvnwpsub10]  LDPW/HVNW/psub BJT        (BJTDMY*OD*PIMP*LDPW*HVNW*) 
;   Q[ldpwhvnwpsub5]   LDPW/HVNW/psub BJT        (BJTDMY*OD*PIMP*LDPW*HVNW*) 
;   Q[ldpwhvnwpsub2]   LDPW/HVNW/psub BJT        (BJTDMY*OD*PIMP*LDPW*HVNW*) 
;    
;   Q[phvnwpsub2]      P+/HVNW/PSUB 2*2          (BJTDMY*OD*PIMP*HVNW*HVOX-PDD) 
;   Q[phvnwpsub5]      P+/HVNW/PSUB 5*5          (BJTDMY*OD*PIMP*HVNW*HVOX-PDD) 
;   Q[phvnwpsub10]     P+/HVNW/PSUB 10*10        (BJTDMY*OD*PIMP*HVNW*HVOX-PDD) 
;   Q[pddhvnwpsub2]    PDD/HVNW/PSUB 2*2         (BJTDMY*OD*PDD*PIMP*HVNW*HVOX) 
;   Q[pddhvnwpsub5]    PDD/HVNW/PSUB 5*5         (BJTDMY*OD*PDD*PIMP*HVNW*HVOX) 
;   Q[pddhvnwpsub10]   PDD/HVNW/PSUB 10*10       (BJTDMY*OD*PDD*PIMP*HVNW*HVOX) 
;    
;   rhvnwhvpw          HVNW_HVPW Resistor        (RWDMYX*HVNW*HVOX) 
;   rnddhvpw           NDD_HVPW  Resistor        (RPDMYX*NDD*OD*HVOX*NIMP*RPO) 
;   rpddhvnw           PDD_HVNW  Resistor        (RPDMYX*PDD*OD*HVNW*HVOX*PIMP*RPO) 
; 
;   rhvnw              HVNW_HVPW Resistor        (RWDMYX*HVNW*HV40DMY) 
;   rhvpw              HVPW_HVNW+NBL Resistor    (RWDMYX*HVNW*NBL*HV40DMY) 
;   rhvnw_60           HVNW_HVPW Resistor        (RWDMYX*HVNW*HV60DMY) 
;   rhvpw_60           HVPW_HVNW+NBL Resistor    (RWDMYX*NBL*HV60DMY*HVNW) 
; 
;   rpbody             PBODY Resistor            (RPDMYX*HVNW*HVOX*OD*RPO*HVPB*PIMP) 
;   rldpwod            LDPW Resistor under OD    (RWDMYX*HVNW*HVOX*OD*RPO*LDPW) 
;   rldpwsti           LDPW Resistor under STI   (RWDMYX*HVNW*HVOX-OD-RPO*LDPW) 
;    
;   rhim	              SiCr resistor		(MSi*M0) 
;   --------------------------------------------------------------------- 
;   Parasitic DEVICE 
;   --------------------------------------------------------------------- 
;    
;   D[PPDPWNBL_DIO]        HV parasitic DPW/NBL diode          (DPW*NBL*HV40DMY-DIODMY) 
;   D[PPNBLPEPI_DIO]       HV parasitic NBL/PEPI diode         (NBL*PSUB*HV40DMY-DIODMY) 
;   D[PWPEPINBL_DIO]       LV isolaiton CORE PW/NBL diode      (NBL*HVNW-OD2-HV40DMY-DIODMY) 
;   D[PWPEPINBL_DIO_5]     LV isolation IO PW/NBL diode        (NBL*HVNW*OD2-HV40DMY-DIODMY) 
;   D[NBLPEPI_ISO_DIO]     LV isolation NBL/PEPI diode         (NBL*PSUB*HVNW-HV40DMY-DIODMY) 
; 
;   D[PPDPWNBL_DIO_60]     HV parasitic DPW/NBL diode          (DPW*NBL*HV60DMY-DIODMY) 
;   D[PPNBLPEPI_DIO_60]    HV parasitic NBL/PEPI diode         (NBL*PSUB*HV60DMY-DIODMY) 
;   D[PWPEPINBL_DIO_60]    LV isolaiton CORE PW/NBL diode      (NBL*HVNW-OD2-HV60DMY-DIODMY) 
;   D[PWPEPINBL_DIO_5_60]  LV isolation IO PW/NBL diode        (NBL*HVNW*OD2-HV60DMY-DIODMY) 
;   D[NBLPEPI_ISO_DIO_60]  LV isolation NBL/PEPI diode         (NBL*PSUB*HVNW-HV60DMY-DIODMY) 
; 
;   D[ppldpwhvnw_dio] Parasitical diode for isolation LDPW/HVNW  (LDPW*HVNW*NIMP-DIODMY**OD*POLY1i*NWELL) 
;   D[pphvnwpsub_dio] Parasitical diode for isolation HVNW/psub  (HVNW-DIODMY*OD*POLY1i*NWELL) 
;    
;   D[pphvpwdio_hv_iso]    HV parasitic HVPW/HVNW/NBL diode    (HVOX*HVNW*NBL*OD*PIMP*NDD_BCD-DIODMY*NGATE*RPO) 
;   D[ppnbldio_hv_iso]     HV parasitic HVNW+NBL/HVPW diode    (HVNW*NBL*HVOX*NIMP*OD*NDD_BCD-DIODMY*NGATE*RPO) 
; 
;   D[pphvnwdnwpsubhvpw_dio_iso_ac]	HV parasitic HVNW+DNW/PSUB(HVPW) DIODE for 3T DIODE (HVOX*HVNW*DNW-DIODMY*DIO3TDMY) 
;   D[pphvnwdnwpsubhvpw_dio_iso]		HV parasitic HVNW+DNW/PSUB(HVPW) DIODE	(HVOX*HVNW*DNW-DIODMY-DIO3TDMY) 
;   D[pphvnwpsubhvpw_dio_iso_ac]		HV parasitic HVNW/HVPW DIODE		(HVOX*HVNW-DIODMY*DIO3TDMY-NBL-DNW) 
; 
;   D[dnwpsub]     DNW/PSUB diode	     	(DNW*PSUB*NWELL)  
;   D[pwdnw]       PSUB(R-WELL)/DNW diode	(DNW*PSUB-OD2-NWELL)  
;   D[pnwdio]	  CORE diode NW/PW          (NWELL-OD2-DIODMY)   
;   D[pnwdio_3]	  I/O  diode NW/PW          (NWELL*OD2-DIODMY)   
;   D[pnwdio_ull]  CORE diode ULLNW/PW       (ULLNW*OD3-OD2-DIODMY)   
;   D[pnwdio_ell]  CORE diode ULLNW/PW       (ULLNW*OD3-OD2-DIODMY*ELLDMY)   
;    
;   ----------------------------------------------------------------------------------------  
;   * POLY1 = POLY1i 
;   * NGATE = OD * POLY1i * NIMP - NWELL - MTDUM   
;   * PGATE = OD * POLY1i * PIMP * NWELL - MTDUM  
;   * HVPGATE = OD * POLY1i * PIMP * HVNWi 
;   * PSUB = BULK  
;   * VARDMY = VARDMYX -VARG3 -VARG6 -JVARD  
;   * VARGT = OD * POLY1i * NIMP * NWELL * VARDMYX 
;   * RFNGATE = OD * POLY1i * NIMP - NWELL  
;   * RFPGATE = OD * POLY1i * PIMP * NWELL  
;   * RFDUMMY = RFDUMMYX + RFDUMMY1  
;   * PDDi  = PDD + PDD_BCD 
;   * HVNW  = HVNWi 
;   * HVPB  = HVPBi 
;   * METAL1 = M1  
;   * RMDMY1 = RMDMY1i 
;   * METAL2 = M2  
;   * RMDMY2 = RMDMY2i 
;   * METAL3 = M3  
;   * RMDMY3 = RMDMY3i 
;   * METAL4 = M4  
;   * RMDMY4 = RMDMY4i 
;   * METAL5 = M5  
;   * RMDMY5 = RMDMY5i 
;   $ Q[PV] = Q(pnp2) + Q(pnp5) + Q(pnp10)  
;   $ Q[PV_mis] = Q(pnp2_mis) + Q(pnp5_mis) + Q(pnp10_mis)  
;   $ Q[P1] = Q(pnp2_3) + Q(pnp5_3) + Q(pnp10_3)  
;   $ Q[P1_mis] = Q(pnp2_5_mis) + Q(pnp5_5_mis) + Q(pnp10_5_mis)  
;   $ Q[NV] = Q(npn2) + Q(npn5) + Q(npn10)  
;   $ Q[NV_mis] = Q(npn2_mis) + Q(npn5_mis) + Q(npn10_mis)  
; 
;////////////////////////////////////////////////////////////////////////////// 
; 
;////////////////////////////////////////////////////////////////////////////// 
; USER NOTES :   
;   
; 1) This assura lvs command file is developed and QA on Assura AV41USR1_HF13  
;  
; 2) Default setting for property check is 0%. Users should check with   
;    IP/Designe providers for proper tolerance.   
;   
; 3) Thin oxide layers PDIFF (7;0) and NDIFF (8;0) are not recommended to be   
;    used as tape out layers. Please use OD (11:0, 3:0, 12:0) for thin oxide tape out 
;    layers. If PDIFF (7;0) and NDIFF (8;0) layers are used, be sure to check MT  
;    (tape out) form for correctness after modifying this LVS deck (to pass LVS check). 
;   
; 4) Switch for extracting PW/NBL, PW/DNW and NBL/PSUB, DNW/PSUB diodes:  
;    By default, the diodes, PW/NBL PW/DNW and NBL/PSUB DNW/PSUB, are not extracted in this  
;	command file. If you want to apply the extraction of these diodes, please turn on the  
;	switch "extract_parasitic_diodes".  
;  
; 5) This assura lvs command file distinguishs 3-terminal resistors from 2-terminal resistors. 
;    If the 3-terminal resistor is used in DFII mode, it will be recognized as 2-terminal  
;    resistor and the mismatch message of Layout and Schematic will be shown on the LVS report. 
;  
; 6) Switch for the geomStamp checking  
;    i.) Default checking: The default check psub/nwell/deep-nwell multStamp error.  
;   ii.) Skip_Soft_Connect_Checks: If turn on this option, the LVS will not check any soft-connect error  
;  iii.) check_well_floating: If turn on this option, it will check the floating well and multStamp error.  
; 
;  -------------------------	----------------------------------------------------------   
;  SWITCH NAME                  		DESCRIPTION                  
;  -------------------------	----------------------------------------------------------   
;  ZERO_NRDS                    Set nrd=0 and nrs=0 when run RCX extraction flow.  
; 
;  spice_extraction             Turn-on this switch during extracting RCX spice netlist.   
; 
;  Skip_Soft_Connect_Checks     The Soft-connect error will not be checked if this switch   
;                               is turned on.  
; 
;  				 
;  NW_RING                      If turn on this switch, the soft-connect check for nwell   
;                                ring and psub(rwell) inside will not be checked. 
;				 
;  WELL_TO_PG_CHECK             ERC_check for ntap connected to ground, default is turned on.  
;    
;  GATE_TO_PG_CHECK             ERC_check for gate connected to ground, default is turned off.  
;    
;  FLOATING_GATE_CHECK          Floating gate check, default is turned on.  
;    
;  FLOATING_WELL_CHECK          Floating well check, default is turned on.  
;    
;  DS_TO_PG_CHECK               ERC_check for MOS connected to both power and ground, default  
;                               turned on.  
; 
;  MACRO                        By default, macro models are not netlisted. Please turn on this   
;                               switch to enable "_mac" models. 
;   
;  extract_parasitic_diodes     By default, the parasitic diodes are not extracted in this  
;                                command file. Please turn on the this switch to apply the 
;								extraction of parasitic diodes.    
; 
;  compare_parasitic_diodes     By default, the parasitic diodes are not compared in this  
;                                command file. Please turn on the this switch to apply the 
;								comparision of parasitic diodes. 
; 
;			        
; 
;lvs_gen.pl version: 1.4 
;assura.pl  version: 1.2 
;#########################################################################
;# ENVIRONMENT SETTING                              
;#########################################################################
;LVS PRESERVE CELL
;#########################################################################
drcExtractRules( 

scale = 1.0
wped = 5.0


if( avSwitch( "STD_LIB") then 
   NMOS_BOTTOM_EXT = 0.86*1e-6
   PMOS_TOP_EXT = 1.09*1e-6
   MOS_LR_EXT =	100.0*1e-6
else 
   NMOS_BOTTOM_EXT = 0
   PMOS_TOP_EXT = 0
   MOS_LR_EXT =	0
)


; #############################################
; # MAPPING                                   #
; #############################################
layerDefs( "df2" 
    PWELLX     = layer( "PWELL" )     ; P-Well   for cis 
    DMP2V      = layer( "DMP2V" )     ; dummy layer to avoid P2V in P+ poly resistor
    DMN2V      = layer( "DMN2V" )     ; dummy layer to avoid N2V in N+ poly resistor
    VTMP       = layer( "VTM_P" )     ;  blocking region of PMOS VT implantation
    VTMN       = layer( "VTM_N" )     ;  blocking region of NMOS VT implantation
    DNW        = layer( "DNW" )     ; Deep N-Well
    NWELL      = layer( "NWELL" )     ; N-Well
    NTN        = layer( "NTN" )     ; Native Device Blocked Implant
    OD         = layer( "PDIFF" "NDIFF" ("DIFF" type("drawing")) )     ; thin oxide
    DOD        = layer( ("DIFF" type("dummy")) )     ; OD dummy fill
    OD2        = layer( "OD2" )     ; Thick Oxide Definition
    POLY1i     = layer( ("POLY1" type("drawing")) )     ; Poly Si
    POLY2      = layer( "POLY2" )     ; Poly2 for caps and res
    DPO        = layer( ("POLY1" type("dummy")) )     ; Poly Si dummy
    PIMP       = layer( "PIMP" )     ; P+ S/D Implantation
    NIMP       = layer( "NIMP" )     ; N+ S/D Implantation
    VTDN       = layer( ("VTDN" type("drawing")) )     ; VTD_N implant
    VTHVDN     = layer( ("VTDN" type("drawing1")) )     ; Define different depletion implant condition fo HV process 
    HRI        = layer( ("HRI" type("drawing")) )     ; High Resistor Implant
    HRI3KDMY   = layer( ("HRI" type("dummy1")) )     ; dummy layer for HRI 3K resistor
    CONT       = layer( "CONT" )     ; Contact
    M1         = layer( ("METAL1" type("drawing")) )     ; Metal-1
    VIA1       = layer( "VIA12" )     ; Via1 Hole
    M2         = layer( ("METAL2" type("drawing")) )     ; Metal-2
    VIA2i      = layer( "VIA23" )     ; Via2 Hole
    M3         = layer( ("METAL3" type("drawing")) )     ; Metal-3
    VIA3i      = layer( "VIA34" )     ; Via3 Hole
    M4         = layer( ("METAL4" type("drawing")) )     ; Metal-4
    VIA4i      = layer( "VIA45" )     ; Via4 Hole
    M5         = layer( ("METAL5" type("drawing")) )     ; Metal-5
    VIA5i      = layer( "VIA56" )     ; Via5 Hole
    M6         = layer( ("METAL6" type("drawing")) )     ; Metal-6
    VIA6i      = layer( "VIA67" )     ; Via6 Hole
    M7         = layer( ("METAL7" type("drawing")) )     ; Metal-7
    RPO        = layer( "RPO" )     ; Non-salicide OD Area Definition
    PSUB2      = layer( "PSUB2" )     ; apply for subtract2 ground
    RODMY      = layer( "RODUMMY" )     ; dummy layer to remove OD
    BJTDMY     = layer( ("BJTDUMMY" type("drawing")) )     ; BJT dummy layer to form BJT
    BJTDMY_4t  = layer( ("BJTDUMMY" type("dummy")) )     ; BJT dummy layer to form BJT_4t
    DIODMY     = layer( "PTDIODE" ("DIODUMMY" type("drawing")) )     ; dummy layer to form diode
    DIO3TDMY   = layer( ("DIODUMMY" type("dummy1")) )     ; dummy layer to form 3t diode
    DIO4TDMY   = layer( ("DIODUMMY" type("dummy2")) )     ; dummy layer to form 4t diode
    RWDMYX     = layer( ("RWDUMMY" type("drawing")) )     ; dummy layer to form N-Well resistor
    RPDMYX     = layer( "RHDUMMY" ("RPDUMMY" type("drawing")) )     ; dummy layer to form OD/POLY resistor
    RLPPDMY    = layer( "RLPPDUMMY" )     ; dummy layer to form High_Poly resistor
    RMDMY      = layer( ("RMDUMMY" type("drawing")) )     ; dummy layer to form METAL resistor
    RMDMY1i    = layer( ("RMDUMMY" type("drawing1")) )     ; dummy layer to form METAL1 resistor
    RMDMY2i    = layer( ("RMDUMMY" type("drawing2")) )     ; dummy layer to form METAL2 resistor
    RMDMY3i    = layer( ("RMDUMMY" type("drawing3")) )     ; dummy layer to form METAL3 resistor
    RMDMY4i    = layer( ("RMDUMMY" type("drawing4")) )     ; dummy layer to form METAL4 resistor
    RMDMY5i    = layer( ("RMDUMMY" type("drawing5")) )     ; dummy layer to form METAL5 resistor
    RMDMY6i    = layer( ("RMDUMMY" type("drawing6")) )     ; dummy layer to form METAL6 resistor
    RMDMY7i    = layer( ("RMDUMMY" type("drawing7")) )     ; dummy layer to form METAL7 resistor
    RMDMYh     = layer( ("RMDUMMY" type("drawing10")) )     ; dummy layer to form RDL resistor
    PV_P       = layer( "PV_P" )     ; pmos varactor P+ implant layer
    PV_N       = layer( "PV_N" )     ; pmos varactor N+ blocking layer
    INDDMY     = layer( ("INDDUMMY" type("drawing")) )     ; dummy layer to form spiral inductor
    IND_RAD    = layer( ("INDDUMMY" type("drawing2")) )     ; For RF Inductor devices radious
    IND_GDIS   = layer( ("INDDUMMY" type("drawing3")) )     ; For RF Inductor devices guardring distance
    IND_NR     = layer( ("INDDUMMY" type("drawing4")) )     ; For RF Inductor devices turns
    IND_MP     = layer( ("INDDUMMY" type("drawing5")) )     ; For RF Inductor devices mimus pin 
    IND_D4     = layer( ("INDDUMMY" type("drawing6")) )     ; For RF Inductor devices CTAP pin 
    IND_W      = layer( ("INDDUMMY" type("drawing7")) )     ; For RF Inductor devices width 
    IND_S      = layer( ("INDDUMMY" type("drawing8")) )     ; For RF Inductor devices space 
    RFPADDMY   = layer( ("RFDUMMY" type("drawing11")) )     ; For lowcpad_rf
    HIA_DUMMY  = layer( ("RFDUMMY" type("drawing10")) )     ; For HIA ESD diode dummy layer
    VARDMYX    = layer( ("VARDUMMY" type("drawing")) )     ; dummy layer to form Varactor
    ESD3DMY    = layer( "ESD3DUMMY" )     ; ESD3DMY
    RFDUMMYX   = layer( ("RFDUMMY" type("drawing")) )     ; FOR normal RF device dummy layer
    RFDUMMY1   = layer( ("RFDUMMY" type("drawing1")) )     ; FOR RF device additional terminal dummy layer
    RFDUMMY5T  = layer( ("RFDUMMY" type("drawing5")) )     ; For RF_5T Device using only
    RFDUMMY6T  = layer( ("RFDUMMY" type("drawing4")) )     ; For RF_6T Device using only
    RFDUMMYUD  = layer( ("RFDUMMY" type("drawing3")) )     ; Please change RFDMY to be RFDMYUD to allow putting devices under w/i shield RF mimcap Devices (mimcap use only)
    asym_rf    = layer( ("RFDUMMY" type("drawing2")) )     ; FOR RF device special recognition. 
    VARG3      = layer( ("VARDUMMY" type("drawing1")) )     ; dummy layer for RF mos varactor moscap_g3
    VARG6      = layer( ("VARDUMMY" type("drawing2")) )     ; dummy layer for RF mos varactor moscap_g6
    JVARD      = layer( ("VARDUMMY" type("drawing3")) )     ; dummy layer for RF junction varactor xjvar
    CTM2       = layer( ("CTM2" type("drawing")) )     ; Capacitor Top Metal-2
    CTM3       = layer( ("CTM3" type("drawing")) )     ; Capacitor Top Metal-3
    CTM4       = layer( ("CTM4" type("drawing")) )     ; Capacitor Top Metal-4
    CTM5       = layer( ("CTM5" type("drawing")) )     ; Capacitor Top Metal-5
    CTMDMY     = layer( ("CTMDUMMY" type("drawing")) )     ; dummy layer for MIMCAP
    CTMDMY1p0  = layer( ("CTMDUMMY" type("drawing2")) )     ; dummy layer for MIMCAP (1p0)
    CTMDMY1p5  = layer( ("CTMDUMMY" type("drawing3")) )     ; dummy layer for MIMCAP (1p5)
    CTMDMY2p0  = layer( ("CTMDUMMY" type("drawing4")) )     ; dummy layer for MIMCAP (2p0)
    CTMDMY_3t  = layer( ("CTMDUMMY" type("drawing1")) )     ; dummy layer for MIMCAP (3t)
    CTMDMYUD   = layer( ("CTMDUMMY" type("drawing5")) )     ; Please add CTMDMYUD to allow putting devices under 2T BB mimcap Devices (mimcap use only)
    PLMIDE     = layer( ("PLMIDE" type("drawing")) )     ; Polyimide
    VIAD       = layer( "VIAD" )     ; VIA between MD and Mtop
    MD         = layer( "MD" )     ; RDL layer (Cu)
    CBD        = layer( "CBD" )     ; 
    UBM        = layer( "UBM" )     ; Under bump metal
    CB         = layer( "PAD" )     ; passivation-1 via hole between Mu and AP-MD for wire bond
    RV         = layer( "RV" )     ; VIA between AP and Mtop
    AP         = layer( ("AP" type("drawing")) )     ; RDL layer (AL)
    AP_Cu      = layer( ("AP" type("drawing1")) )     ; PPI layer
    TSVI       = layer( ("TSV" type("drawing")) )     ; i-TSV (in-process through-silicon-via etching)
    DTSVI      = layer( ("TSV" type("pin")) )     ; dummy pattern of I-TSV
    DUM1       = layer( ("METAL1" type("dummy")) )     ; dummy metal M1
    DUM2       = layer( ("METAL2" type("dummy")) )     ; dummy metal M2
    DUM3       = layer( ("METAL3" type("dummy")) )     ; dummy metal M3
    DUM4       = layer( ("METAL4" type("dummy")) )     ; dummy metal M4
    DUM5       = layer( ("METAL5" type("dummy")) )     ; dummy metal M5
    DUM6       = layer( ("METAL6" type("dummy")) )     ; dummy metal M6
    DUM7       = layer( ("METAL7" type("dummy")) )     ; dummy metal M7
    M1SLOT     = layer( ("METAL1" type("slot")) )     ; M1 slot
    M2SLOT     = layer( ("METAL2" type("slot")) )     ; M2 slot
    M3SLOT     = layer( ("METAL3" type("slot")) )     ; M3 slot
    M4SLOT     = layer( ("METAL4" type("slot")) )     ; M4 slot
    M5SLOT     = layer( ("METAL5" type("slot")) )     ; M5 slot
    M6SLOT     = layer( ("METAL6" type("slot")) )     ; M6 slot
    M7SLOT     = layer( ("METAL7" type("slot")) )     ; M7 slot
    MB1        = layer( ("METAL1" type("BSL")) )     ; Cu back-side-M1(top thick layer) for iTSV project
    DMB1       = layer( ("METAL1" type("BSD")) )     ; Cu dummy back-side-M1(thick layer) for iTSV project
    DRAIN      = layer( ("DIFF" type("drain")) )     ; Drain layer for mos drain terminal
    RWDMY1     = layer( ("RWDUMMY" type("drawing1")) )     ; dummy layer to form N-Well resistor 3 terminals
    RWDMY5     = layer( ("RWDUMMY" type("drawing5")) )     ; dummy layer to form PURE 5V N-Well resistor
    RPDMY1     = layer( ("RPDUMMY" type("drawing1")) )     ; dummy layer to form OD/POLY resistor 3 terminals
    RPDMY5     = layer( ("RPDUMMY" type("drawing5")) )     ; dummy layer to form PURE 5V OD/POLY resistor
    SBDUMMY    = layer( ("SBDDMY" type("drawing")) )     ; dummy layer to form schottky diode
    MOMDMY0    = layer( ("MOMDMY" type("drawing")) )     ; MOM dummy for crtmom
    MOMDMY1    = layer( ("MOMDMY" type("drawing1")) )     ; MOM dummy for crtmom
    MOMDMY2    = layer( ("MOMDMY" type("drawing2")) )     ; MOM dummy for crtmom
    MOMDMY3    = layer( ("MOMDMY" type("drawing3")) )     ; MOM dummy for crtmom
    MOMDMY4    = layer( ("MOMDMY" type("drawing4")) )     ; MOM dummy for crtmom
    MOMDMY5    = layer( ("MOMDMY" type("drawing5")) )     ; MOM dummy for crtmom
    MOMDMY6    = layer( ("MOMDMY" type("drawing6")) )     ; MOM dummy for crtmom
    MOMDMY22   = layer( ("MOMDMY" type("dummy")) )     ; MOM dummy for MX mom
    MOMDMY23   = layer( ("MOMDMY" type("dummy1")) )     ; MOM dummy for MX mom plus1 & minus1
    MOMDMY24   = layer( ("MOMDMY" type("dummy2")) )     ; MOM dummy for MX mom plus2 & minus2
    MOMDMY25   = layer( ("MOMDMY" type("dummy3")) )     ; MOM dummy for MX mom plus1 & plus2
    MOMDMY100  = layer( ("MOMDMY" type("dummy4")) )     ; MOM dummy for fmom
    LVSDMY     = layer( ("LVSDMY" type("dummy1")) )     ; LVS dummy layer for mismatch device
    IP_MIG     = layer( ("IP_MIG" type("drawing")) )     ; Non-shrinkable dummy layer 
    PO1        = layer( ("PO1" type("drawing")) )     ; PO1 for floating gate contact
    FGT        = layer( ("FGT" type("drawing")) )     ; Floating gate (FLGT)
    HVII       = layer( ("HVII" type("drawing")) )     ; Common source for high voltage implant
    MCEL       = layer( ("MCEL" type("drawing")) )     ; define for memory cell rule checking
    HNVT       = layer( ("HNVT" type("drawing")) )     ; for HN not allowed with dnwell
    HVNWi      = layer( "HVNW" )     ; for HP
    NOPW       = layer( "PSUB" )     ; for HN, HZ "PSUB" in design rule manual
    ULLNW      = layer( ("ULLNW" type("drawing")) )     ; layer to form ull pmos 
    OD3        = layer( ("FLASH" type("ODLL")) )     ; layer to form ull devices
    ELLDMY     = layer( ("LVSDMY" type("dummy3")) )     ; layer to form ell devices to destinguish ull devices
    CELLM      = layer( ("IMSOR" type("CELLMV")) )     ; Define blocking region of Cell VT implantation for medium VT NMOS 
    CELLH      = layer( ("IMSOR" type("CELLH")) )     ; Define Cell High VT implantation (only for standard CIS)
    NPS        = layer( ("IMSOR" type("NPS")) )     ; Define N type photo sensor implantation
    PL         = layer( ("IMSOR" type("PL")) )     ; Planarization mask for 8" TCF5 color filter technology
    GM         = layer( ("IMSOR" type("GM")) )     ; Green mask for 8" TCF5 color filter technology
    RM         = layer( ("IMSOR" type("RM")) )     ; Red mask for 8" TCF5 color filter technology
    BM         = layer( ("IMSOR" type("BM")) )     ; Blue mask for for 8" TCF5 color filter technology
    ML         = layer( ("IMSOR" type("ML")) )     ; Microlens spacer mask for 8" TCF5 color filter technology
    PPS        = layer( ("IMSOR" type("PPS")) )     ; Define P type photo sensor implantation
    NMOS_VT    = layer( ("IMSOR" type("NMOS_VT")) )     ; For logic VT implant
    CI         = layer( ("IMSOR" type("CI")) )     ; Cell DDD implant for CMOS image sensor process
    CIRPO      = layer( ("IMSOR" type("CIRPO")) )     ; Define od salicide protection in pixel
    GM1        = layer( ("IMSOR" type("GM1")) )     ; Green1 mask for for 8" TCF5 color filter technology
    GM2        = layer( ("IMSOR" type("GM2")) )     ; Green2 mask for for 8" TCF5 color filter technology
    CELLD      = layer( ("IMSOR" type("CELLD")) )     ; TSMC internally used layer for CMOS image process
    BGP        = layer( ("IMSOR" type("BGP")) )     ; Buried gate P implant
    BGN        = layer( ("IMSOR" type("BGN")) )     ; Buried gate N implant
    CELL_TX    = layer( ("IMSOR" type("CELL_TX")) )     ; Cell_Tx implant
    CELL_RS    = layer( ("IMSOR" type("CELL_RS")) )     ; Rest implant
    CAP_IMP    = layer( ("IMSOR" type("CAP_IMP")) )     ; Capacitor implant
    CELL_SL    = layer( ("IMSOR" type("SEL")) )     ; Select implant
    BASE_N     = layer( ("BASE_N" type("drawing")) )     ; PNP base for an extra BJT N-type Base implant
    LDDMY      = layer( ("LDDMY" type("drawing")) )     ; dummy layer to cover HVMOS area 
    ESD2DUMMY  = layer( ("ESD2DUMMY" type("drawing")) )     ; for lcesd1_rf and lcesd2_rf devices
    lcesd1     = layer( ("RFDUMMY" type("drawing6")) )     ; dummy layer for lcesd1_rf device
    lcesd2     = layer( ("RFDUMMY" type("drawing7")) )     ; dummy layer for lcesd2_rf device
    lcesd_p    = layer( ("RFDUMMY" type("drawing8")) )     ; dummy layer for rf lcesd device's PLUS and MINUS pin
    lcesd_m    = layer( ("RFDUMMY" type("drawing9")) )     ; dummy layer for rf lcesd device's MINUS pin
    MTDUM      = layer( ("LVSDMY" type("dummy2")) )     ; dummy layer for bb 5/6t mos
    POFUSE     = layer( ("LVSDMY" type("drawing1")) )     ; dummy layer for poly fuse
    HVTN       = layer( "HVTN" )     ; FOR HV_40 NMOS
    HVTP       = layer( "HVTP" )     ; FOR HV_40 PMOS
    NBL        = layer( "NBL" )     ; Implant with arsenic form low resistive paths for the NPN collectors, for HV process
    HVOX       = layer( "HVOX" )     ; HVOX for HV process
    HVPBi      = layer( "HVPB" )     ; drawing layer for HV P-BODY layer
    MTP_2T2C   = layer( ("IP" type("drawing3")) )     ; layer to define MTP_2T2C IP region
    H18VNWDMY  = layer( ("IP" type("drawing4")) )     ; layer to define 18V NW region
    SH_P       = layer( ("HV" type("SH_P")) )     ; Shielding Pwell
    SH_N       = layer( ("HV" type("SH_N")) )     ; Shielding Nwell
    DMYLD      = layer( ("HV" type("DMYLD")) )     ; Dummy layer for logic operation, use DMYLD to cover LDMOS area
    LDPW       = layer( ("HV" type("LDPW")) )     ; P-Well region of LDNMOS
    NDD_BCD    = layer( ("HV" type("NDD")) )     ; HV32V: N-type drift region at drain side, for HV device to sustain the high breakdonw voltage
    PDD_BCD    = layer( ("HV" type("PDD")) )     ; HV32V: P-type drift region at drain side, for HV device to sustain the high breakdonw voltage
    NDD        = layer( ("HV" type("drawing1")) )     ; definition of HV device N deep drain (NDD) implantation of HV device
    PDD        = layer( ("HV" type("drawing2")) )     ; definition of HV device P deep drain (PDD) implantation of HV device
    DPW        = layer( ("HV" type("DPW")) )     ;  FOR HV_40 device
    HV40DMY    = layer( ("HVDMY" type("drawing")) )     ; layer to form all HV devices.
    HVDMY2     = layer( ("HVDMY" type("drawing2")) )     ; layer to separate different voltage device in the same process 
    PA24DMY    = layer( ("PA24DMY" type("drawing")) )     ; dummy layer to form pa24g5 device.
    NLD24DMY   = layer( ("NLD24DMY" type("drawing")) )     ; dummy layer to form nld24g5 device.
    NLVT       = layer( ("NLVT" type("drawing")) )     ; dummy layer to define low Vt 5V NMOS for 0.18um BCD process
    MHMDMY     = layer( ("HV" type("drawing3")) )     ; dummy layer for MHM device
    HV18DMY    = layer( ("HV" type("drawing5")) )     ; To define HV 18V device pattern.
    HV32DMY    = layer( ("HV" type("drawing6")) )     ; To define HV 32V device pattern
    HV60DMY    = layer( ("HV" type("drawing7")) )     ; To define HV 60V devices pattern.
    LHLDMY     = layer( ("HV" type("drawing8")) )     ; To define LHL devices.
    MACRODMY   = layer( ("MACRODMY" type("drawing")) )     ; dummy layer to form  macro model devices.
    LVGDMY     = layer( ("LVGDMY" type("drawing")) )     ; Low Vg model devices dummy layer
    VIA_MEMS   = layer( ("MEMS" type("VIA")) )     ; define MEMS VIA
    MEMS       = layer( ("MEMS" type("drawing")) )     ; define MEMS struture
    HLMIMCAP1P0 = layer( ("CTMDUMMY" type("drawing7")) )     ; dummy layer for 1p0 hlmim cap
    M0         = layer( ("HV" type("GM1")) )     ; landing pad for SiCr TFR
    MSi        = layer( ("HV" type("GM2")) )     ; resistor for SiCr TFR
    SICR_V1    = layer( ("HV" type("VIA")) )     ; Via1 belog to SiCr TFR
  ; text layer for recognition
    IND_TEXT     = text( "INDDUMMY" type("drawing9") idOnly)
  ; define no port text layer
  ; define text layer 
    UBM_text  = textToPin( "UBM" type("pin")) 
    metal1_text  = textToPin( "METAL1" type("pin")) 
    metal2_text  = textToPin( "METAL2" type("pin")) 
    metal3_text  = textToPin( "METAL3" type("pin")) 
    metal4_text  = textToPin( "METAL4" type("pin")) 
    metal5_text  = textToPin( "METAL5" type("pin")) 
    metal6_text_MD  = textToPin( "MD" type("pin")) 
    metal6_text_AP  = textToPin( "AP" type("BSD")) 
    UBM_ptext  = pinText( "UBM" )
    metal1_ptext  = pinText( "METAL1" )
    metal2_ptext  = pinText( "METAL2" )
    metal3_ptext  = pinText( "METAL3" )
    metal4_ptext  = pinText( "METAL4" )
    metal5_ptext  = pinText( "METAL5" )
    metal6_ptext_MD  = pinText( "MD" )
    metal6_ptext_AP  = pinText( "AP" )
    BULK2 = cellBoundary("*")
); end df2 layerDefs 


layerDefs( "gds2" 
    PWELLX     = layer(    1 )     ; P-Well   for cis 
    DMP2V      = layer(  149 )     ; dummy layer to avoid P2V in P+ poly resistor
    DMN2V      = layer(  184 )     ; dummy layer to avoid N2V in N+ poly resistor
    VTMP       = layer(   23 )     ;  blocking region of PMOS VT implantation
    VTMN       = layer(   24 )     ;  blocking region of NMOS VT implantation
    DNW        = layer(   82 )     ; Deep N-Well
    NWELL      = layer(    2 )     ; N-Well
    NTN        = layer(  129 )     ; Native Device Blocked Implant
    OD         = layer(   11   12 (    3 type(  0 2 4:255)) )     ; thin oxide
    DOD        = layer(    3 type(  1) )     ; OD dummy fill
    OD2        = layer(    4 )     ; Thick Oxide Definition
    POLY1i     = layer( (   13 type(  0 2:255)) )     ; Poly Si
    POLY2      = layer(   14 )     ; Poly2 for caps and res
    DPO        = layer(   13 type(  1) )     ; Poly Si dummy
    PIMP       = layer(    7 )     ; P+ S/D Implantation
    NIMP       = layer(    8 )     ; N+ S/D Implantation
    VTDN       = layer(   26 type(  0) )     ; VTD_N implant

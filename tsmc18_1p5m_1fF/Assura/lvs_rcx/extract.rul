  spiceModel( "pnp2_ell" )
  cellView( "pnp_ell ivpcell" )
  flagMalformed )
  area_BJT = measureParameter(area (ell_emit2 over ell_emit) 1e-12)
  M = calculateParameter(area_BJT/area_BJT)
  nameParameter( area_BJT "area" )

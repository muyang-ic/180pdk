procedure( parallelHIA( dev1 dev2 )
 prog( (parHIA)
   parHIA=ncons(nil) 
   W1 = L1 = FN1 = W2 = L2 = FN2 = float(0)
   M1 = M2 = float(1)
 
   if( dev1->aw then W1 = float( dev1->aw ) ) 
   if( dev1->AW then W1 = float( dev1->AW ) )
   if( dev1->al then L1 = float( dev1->al ) ) 
   if( dev1->AL then L1 = float( dev1->AL ) )
   if( dev1->m  then M1 = float( dev1->m ) )
   if( dev1->M  then M1 = float( dev1->M ) )
   if( dev1->fn then FN1 = float( dev1->fn ) )
   if( dev1->FN then FN1 = float( dev1->FN ) )

   if( dev2->aw then W2 = float( dev2->aw ) ) 
   if( dev2->AW then W2 = float( dev2->AW ) )
   if( dev2->al then L2 = float( dev2->al ) ) 
   if( dev2->AL then L2 = float( dev2->AL ) )
   if( dev2->m  then M2 = float( dev2->m ) )
   if( dev2->M  then M2 = float( dev2->M ) )
   if( dev2->fn then FN2 = float( dev2->fn ) )
   if( dev2->FN then FN2 = float( dev2->FN ) )

   unless( L1 == L2 && W1 == W2 && FN1 == FN2 
    printf( "\n** Unequal Parallel RF HIA Diode not combined: \n" )
    printf( "   1st device: m=%g aw=%g al=%g fn=%g \n" M1 W1 L1 FN1 )
    printf( "   2nd device: m=%g aw=%g al=%g fn=%g \n" M2 W2 L2 FN2 )
    return("doNotCombine")
   )
    newM = float( M1 + M2 )
    parHIA-> m = newM
    parHIA-> aw = float(W2)
    parHIA-> al = float(L2)
    parHIA-> fn = float(FN2)
    printf( "\n** Parallel RF HIA Diode combined \n" )
    printf( "   1st device: m=%g aw=%g al=%g fn=%g \n" M1 W1 L1 FN1 )
    printf( "   2nd device: m=%g aw=%g al=%g fn=%g \n" M2 W2 L2 FN2 )
    printf( "result device: m=%g aw=%g al=%g fn=%g \n" newM W2 L2 FN2 )
    return(parHIA)
 ) ; end prog
) ; end parallelHIA


procedure( compareBJT_4T( dev1 dev2 )
 prog( ( )
   N1 = N2 = W1 = W2 = L1 = L2 = diffL = diffW = diffN = float(0)
   M1 = M2 = float(1)
   if( dev1->m then M1 = float(dev1->m) )
   if( dev2->m then M2 = float(dev2->m) )

procedure( compareMIM3t_GPI( dev1 dev2 )
 prog( ()
  let( (layL schL layW schW layLAY schLAY layM schM Lerr Werr LAYerr diffL 
  	diffW diffLAY layTW schTW)
; Make parameters case insensitive

    printf( "\n** Unequal Parallel CAP NOT combined: \n" )
    printf( "   1st device: m= %g l= %g w= %g lay= %g \n" M1 L1 W1 LAY1)
    printf( "   2nd device: m= %g l= %g w= %g lay= %g \n" M2 L2 W2 LAY2)
    return("doNotCombine")
   )
   newM = float( M1 + M2 )
   parCap->m = newM

   parCap->l = float(L1)
   parCap->w = float(W1)

   parCap->lt = float(L1)
   parCap->wt = float(W1)

   parCap->lay = float(LAY1)
   
   printf( "\n** Parallel CAP combined: \n" )
   printf( "   1st device: m= %g l= %g w= %g lay= %g \n" M1 L1 W1 LAY1)
   printf( "   2nd device: m= %g l= %g w= %g lay= %g \n" M2 L2 W2 LAY2)
   printf( "result device: m= %g l= %g w= %g lay= %g \n" newM L1 W1 LAY1)

   return(parCap)
 ) ; end prog
) ; end parallelMIM3t_GPI


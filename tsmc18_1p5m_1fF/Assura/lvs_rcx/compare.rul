   if( dev2->LR then schL = float( dev2->LR ) )

   if( dev1->wr then layW = float( dev1->wr ) )
   if( dev2->wr then schW = float( dev2->wr ) )
   if( dev1->WR then layW = float( dev1->WR ) )
   if( dev2->WR then schW = float( dev2->WR ) )

   if( dev1->sumL then layL = float( dev1->sumL ) )
   if( dev2->sumL then schL = float( dev2->sumL ) )
   if( dev1->sumW then layW = float( dev1->sumW ) )
   if( dev2->sumW then schW = float( dev2->sumW ) )
   
   if( dev1->m then layM = float( dev1->m ) )
   if( dev2->m then schM = float( dev2->m ) )
   if( dev1->M then layM = float( dev1->M ) )
   if( dev2->M then schM = float( dev2->M ) )

; The PDK uses w,l  other sources use w,r or Value
; We've got to have something to work with.
   sprintf( msg1 "" ) sprintf( msg2 "" )
   parm_err1 = parm_err2 = nil
   if( ( layW==0 || schW==0 ) then
    sprintf( msg1 "Lay RES wr %g (0 stands for parameter missing)" layW )
    parm_err1 = t
   )
   if( ( layL==0 || schL==0 ) then
    sprintf( msg2 "Lay RES lr %g (0 stands for parameter missing)" layL )
    parm_err2 = t
   )
   if( ( layW==0 || schW==0 ) then 
    sprintf( msg3 "Sch RES wr %g (0 stands for parameter missing)" schW )
    parm_err1 = t
   )
   if( ( layL==0 || schL==0 ) then 
    sprintf( msg4 "Sch RES lr %g (0 stands for parameter missing)" schL )
    parm_err2 = t
   )
   when( parm_err1
    sprintf( msg "Err: %s \n %s \n" msg1 msg3 )
    return( msg )
   )
   when( parm_err2
    sprintf( msg "Err: %s \n %s \n" msg2 msg4 )
    return( msg )
   )

   Lerr = Werr = t
   diffL = diffW = float(0)
    
   if( ( layL > 0 && schL > 0 ) then
    diffL = 100 * (abs( layL - schL ) / schL )
    when( diffL <= RES_Lerr Lerr = nil )
   )
   layTW = float(layW * layM)
   schTW = float(schW * schM)
   if( ( layTW > 0 && schTW > 0 ) then
    diffW = 100 * (abs( layTW - schTW ) / schTW )
    when( diffW <= RES_Werr Werr = nil )
   )
; If netlist W/L are both available then don't fail R
; If only R is available then don't fail W/L
; If W/L/R not available then fail all
    
; if no errors return nil
    
   when( !Werr && !Lerr return(nil) )
    
; now we know there is a parameter error 
   if( Lerr then
    sprintf( msg1 "Err: RES lr %g(sch) vs %g(lay) differs by %g percent"	
    schL layL diffL ) else sprintf( msg1 "" )
   )
   if( Werr then
    sprintf( msg2 "Err: RES wr %g(sch) vs %g(lay) differs by %g percent"	
    schTW layTW diffW ) else sprintf( msg2 "" )
   )
   sprintf( msg " %s \n %s \n " msg1 msg2 )
   return( msg )
 ) ; end prog
) ; end compareRES

;-----------------------------------------------------------------------------------------

procedure( compareMACMOS( dev1 dev2 )
 prog( ()
  let( (layL schL layW schW layM schM Lerr Werr diffL
        diffW layTW schTW)
; Make parameters case insensitive
   layL = schL = layW = schW = float(0)
   layM = schM = float(1)
   if( dev1->l then layL = float( dev1->l ) )
   if( dev2->l then schL = float( dev2->l ) )
   if( dev1->L then layL = float( dev1->L ) )
   if( dev2->L then schL = float( dev2->L ) )

   if( dev1->w then layW = float( dev1->w ) )
   if( dev2->w then schW = float( dev2->w ) )
   if( dev1->W then layW = float( dev1->W ) )
   if( dev2->W then schW = float( dev2->W ) )

   if( dev1->m then layM = float( dev1->m ) )
   if( dev2->m then schM = float( dev2->m ) )
   if( dev1->M then layM = float( dev1->M ) )
   if( dev2->M then schM = float( dev2->M ) )

; The PDK uses w,l  other sources use w,r or Value
; We've got to have something to work with.
   sprintf( msg1 "" ) sprintf( msg2 "" )
   parm_err = nil
   parm_err1 = parm_err2 = nil
   if( ( layW==0 || schW==0 ) then
    sprintf( msg1 "Lay MACMOS missing params(0 stands for parameter missing): w %g" layW )
    parm_err1 = t
   )
   if( ( layL==0 || schL==0 ) then
    sprintf( msg2 "Lay MACMOS missing params(0 stands for parameter missing): l %g" layL )
    parm_err2 = t
   )
   if( ( layW==0 || schW==0 ) then
    sprintf( msg3 "Sch MACMOS missing params(0 stands for parameter missing): w %g" schW )
    parm_err1 = t
   )
   if( ( layL==0 || schL==0 ) then
    sprintf( msg4 "Sch MACMOS missing params(0 stands for parameter missing): l %g" schL )
    parm_err2 = t
   )
   when( parm_err1
    sprintf( msg "Err: %s \n     %s \n" msg1 msg3 )
    return( msg )
   )
   when( parm_err2
    sprintf( msg "Err: %s \n     %s \n" msg2 msg4 )
    return( msg )
   )

   Lerr = Werr = t
   diffL = diffW = float(1)

   if( ( layL > 0 && schL > 0 ) then
    diffL = 100 * (abs( layL - schL ) / schL )
    when( diffL <= MOS_Lerr Lerr = nil )
   )
   layTW = float(layW * layM)
   schTW = float(schW * schM)
   if( ( layTW > 0 && schTW > 0 ) then
    diffW = 100 * (abs( layTW - schTW ) / schTW )
    when( diffW <= MOS_Werr Werr = nil )
   )

; if no errors return nil

   when( !Werr && !Lerr return(nil) )

; now we know there is a parameter error
   if( Lerr then
    sprintf( msg1 "Err: MACMOS l %g vs %g differs by %g percent"
    schL layL diffL ) else sprintf( msg2 "" )
   )
   if( Werr then
    sprintf( msg2 "Err: MACMOS w %g vs %g differs by %g percent"
    schTW layTW diffW ) else sprintf( msg3 "" )
   )
   sprintf( msg " %s \n %s \n" msg1 msg2 )
   return( msg )

  ) ; end let
 ) ; end prog
) ; end compareMACMOS

;-----------------------------------------------------------------------------------------

procedure( compareMACMOS_nf( dev1 dev2 )
 prog( ()
  let( (layL schL layW schW layN schN layM schM Lerr Werr Nerr diffL 
  	diffW diffN layTW schTW)
; Make parameters case insensitive
   layL = schL = layW = schW = layN = schN = float(0)
   layM = schM = float(1)
   if( dev1->l then layL = float( dev1->l ) )
   if( dev2->l then schL = float( dev2->l ) )
   if( dev1->L then layL = float( dev1->L ) )
   if( dev2->L then schL = float( dev2->L ) )

   if( dev1->w then layW = float( dev1->w ) )
   if( dev2->w then schW = float( dev2->w ) )
   if( dev1->W then layW = float( dev1->W ) )
   if( dev2->W then schW = float( dev2->W ) )
   
   if( dev1->nf then layN = float( dev1->nf ) )
   if( dev2->nf then schN = float( dev2->nf ) )
   if( dev1->NF then layN = float( dev1->NF ) )
   if( dev2->NF then schN = float( dev2->NF ) )

   if( dev1->m then layM = float( dev1->m ) )
   if( dev2->m then schM = float( dev2->m ) )
   if( dev1->M then layM = float( dev1->M ) )
   if( dev2->M then schM = float( dev2->M ) )
   

; The PDK uses w,l  other sources use w,r or Value
; We've got to have something to work with.
   sprintf( msg1 "" ) sprintf( msg2 "" )
   parm_err = nil
   if( ( layW==0 || layL==0 || layN==0 ) then
    sprintf( msg2 "Lay MACMOS missing params(0 stands for parameter missing): l/w/nf %g/%g/%g" layL layW layN )
    parm_err = t
   )
   if( ( schW==0 || schL==0 || schN==0 ) then 
    sprintf( msg1 "Sch MACMOS missing params(0 stands for parameter missing): l/w/nf %g/%g/%g" schL schW schN )
    parm_err = t
   )
   when( parm_err
    sprintf( msg "Err: %s \n     %s \n" msg1 msg2 )
    return( msg )
   )
    
   Lerr = Werr = Nerr = t
;   Nerr = nil
   diffL = diffN = diffW = float(1)
    
   if( ( layL > 0 && schL > 0 ) then
    diffL = 100 * (abs( layL - schL ) / schL )
    when( diffL <= MOS_Lerr Lerr = nil )
   )
   if( ( layN > 0 && schN > 0 ) then
    diffN = 100 * (abs( layN - schN ) / schN )
    when( diffN <= 0 Nerr = nil )
   )
   layTW = float(layW * layN * layM)
   schTW = float(schW * schN * schM)
   if( ( layTW > 0 && schTW > 0 ) then
    diffW = 100 * (abs( layTW - schTW ) / schTW )
    when( diffW <= MOS_Werr Werr = nil )
   )
    
; if no errors return nil
    
   when( !Werr && !Lerr && !Nerr return(nil) )
    
; now we know there is a parameter error      
   if( Nerr then
    sprintf( msg1 "Err: MACMOS nf %g vs %g differs by %g percent" 
    schN layN diffN ) else sprintf( msg1 "" )
   )
   if( Lerr then
    sprintf( msg2 "Err: MACMOS l %g vs %g differs by %g percent" 
    schL layL diffL ) else sprintf( msg2 "" )
   )
   if( Werr then
    sprintf( msg3 "Err: MACMOS w %g vs %g differs by %g percent" 
    schTW layTW diffW ) else sprintf( msg3 "" )
   )
   sprintf( msg " %s \n %s \n %s \n" msg1 msg2 msg3 )
   return( msg )

  ) ; end let
 ) ; end prog
) ; end compareMACMOS_nf


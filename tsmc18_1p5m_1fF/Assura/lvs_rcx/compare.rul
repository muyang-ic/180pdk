procedure( parallelDIODE_3T( dev1 dev2 )
 prog( ( parSbd)
   parSbd = ncons(nil)
   N1 = N2 = W1 = W2 = A1 = A2 = float(0)
   M1 = M2 = float(1)
   if( dev1->m then M1 = float(dev1->m) )
   if( dev2->m then M2 = float(dev2->m) )
   if( dev1->M then M1 = float(dev1->M) )
   if( dev2->M then M2 = float(dev2->M) )
   if( dev1->AREA then A1 = float(dev1->AREA) )
   if( dev2->AREA then A2 = float(dev2->AREA) )
   if( dev1->area then A1 = float(dev1->area) )
   if( dev2->area then A2 = float(dev2->area) )

   newM = float(1)
   newArea = float(A1*M1+A2*M2)
   parSbd->m = newM
   parSbd->area = newArea
   printf( "\n** Parallel DIODE combined: \n" )
   printf( "   1st device: m= %g area=%g \n" M1 A1 )
   printf( "   2nd device: m= %g area=%g \n" M2 A2 )
   printf( "result device: m= %g area=%g \n" newM newArea )
   return(parSbd)
 ) ; end prog
) ; end parallelDIODE_3T

;-----------------------------------------------------------------------------------------

procedure( compareDIODE_3T( dev1 dev2 )
 prog( ( )
   N1 = N2 = W1 = W2 = A1 = A2 = diffL = diffW = diffN = diffA = float(0)
   M1 = M2 = float(1)
   if( dev1->m then M1 = float(dev1->m) )
   if( dev2->m then M2 = float(dev2->m) )
   if( dev1->M then M1 = float(dev1->M) )
   if( dev2->M then M2 = float(dev2->M) )
   if( dev1->AREA then A1 = float(dev1->AREA) )
   if( dev2->AREA then A2 = float(dev2->AREA) )
   if( dev1->area then A1 = float(dev1->area) )
   if( dev2->area then A2 = float(dev2->area) )

   Aerr = t

   if( ( M1 > 0 && M2 > 0 ) then
       if( ( A1 > 0 && A2 > 0 ) then
           diffA = abs( A1*M1 - A2*M2 ) / (A2*M2)
           when( diffA <= hvdio_lvsToA Aerr = nil )
       )
   )

   if( Aerr then
      sprintf( msg1 "Err: DIODE  Sch m= %g area= %g\n" M2 A2  )
      sprintf( msg2 "Err:        Lay m= %g area= %g\n" M1 A1  )
      sprintf( msg "%s \n%s" msg1 msg2 )
      return( msg )
   )

 ) ; end prog
) ; end compareDIODE_3T


   if( dev2->m  then schM = float( dev2->m ) )
   if( dev2->M  then schM = float( dev2->M ) )
   if( dev2->fn then schFN = float( dev2->fn ) )
   if( dev2->FN then schFN = float( dev2->FN ) )


   if( (layW==0 && schW==0) then
     sprintf( msg1 "Err: RF HIA Diode both schematic %g and layout %g missing aw(0 stands for parameter missing)\n" schW layW )
     return(msg1)
   )
   if( layW==0 then
     sprintf( msg2 "Err: RF HIA Diode layout missing aw %g (0 stands for parameter missing)\n" layW )
     return(msg2)
   )
   if( schW==0 then
     sprintf( msg3 "Err: RF HIA Diode schematic missing aw %g (0 stands for parameter missing)\n" schW )
     return(msg3)
   )
   if( (layL==0 && schL==0) then
     sprintf( msg4 "Err: RF HIA Diode both schematic %g and layout %g missing al (0 stands for parameter missing)\n" schL layL )
     return(msg4)
   )
   if( layL==0 then
     sprintf( msg5 "Err: RF HIA Diode layout missing al %g (0 stands for parameter missing)\n" layL )
     return(msg5)
   )
   if( schL==0 then
     sprintf( msg6 "Err: RF HIA Diode schematic missing al %g (0 stands for parameter missing)\n" schL )
     return(msg6)
   )
   if( (layFN==0 && schFN==0) then
     sprintf( msg7 "Err: RF HIA Diode both schematic %g and layout %g missing fn (0 stands for parameter missing)\n" schFN layFN )
     return(msg7)
   )
   if( layFN==0 then
     sprintf( msg8 "Err: RF HIA Diode layout missing fn %g (0 stands for parameter missing)\n" layFN )
     return(msg8)
   )
   if( schFN==0 then
     sprintf( msg9 "Err: RF HIA Diode schematic missing fn %g (0 stands for parameter missing)\n" schFN )
     return(msg9)
   )

      layL = layL*layM
      layW = layW*layM
      schL = schL*schM
      schW = schW*schM
   if((layL == schL) && (layW == schW) && (layFN == schFN) then 
     return(nil)
   )

   diffW = 100 * abs((layW-schW)/schW)
   diffL = 100 * abs((layL-schL)/schL)
   diffFN = 100 * abs((layFN-schFN)/schFN)
   if( ( diffFN > 0) then
      sprintf( msg10 "Err: RF HIA Diode fn %g(sch) vs fn %g(lay) differs by %g percent \n" layFN schFN diffFN )
      else sprintf( msg10 "")
   )
   if( ( diffW > 0 ) then
      sprintf( msg11 "Err: RF HIA Diode aw %g(sch) vs aw %g(layout) differs by %g percent \n" layW schW diffW )
      else sprintf( msg11 "" )
   )
   if( ( diffL > 0 ) then
      sprintf( msg12 "Err: RF HIA Diode al %g(sch) vs al %g(lay) differs by %g percent \n" layL schL diffL )
      else sprintf( msg12 "")
   )
   sprintf( msg13 " %s \n %s \n %s \n" msg10 msg11 msg12 )
   return(msg13)
 ) ; end prog
) ; end compareHIA


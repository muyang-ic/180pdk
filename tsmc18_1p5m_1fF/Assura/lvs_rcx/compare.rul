procedure( compareDIO_w( lay sch )
 prog( ()
 let( (layW schW layM schM Werr Merr diffW diffM)
; Make parameters case insensitive
   layW = schW = float(0)
   layM = schM = float(1)
   if( lay->m then layM = float(lay->m)  )
   if( sch->m then schM = float(sch->m)  )
   if( lay->M then layM = float(lay->M)  )
   if( sch->M then schM = float(sch->M)  )

   if( lay->W then layW = float(lay->W) )
   if( sch->W then schW = float(sch->W) )
   if( lay->w then layW = float(lay->w) )
   if( sch->w then schW = float(sch->w) )

  sprintf( msg1 "" ) sprintf( msg2 "" )
   parm_err = nil
   if( ( layW==0 ) then
    sprintf( msg2 "Lay DIO missing params(0 stands for parameter missing): w %g" layW )
    parm_err = t
   )
   if( ( schW==0 ) then
    sprintf( msg1 "Sch DIO missing params(0 stands for parameter missing): w %g" schW )
    parm_err = t
   )
   when( parm_err
    sprintf( msg "Err: %s \n  %s \n" msg1 msg2 )
    return( msg )
   )

   Werr = Merr = t
   diffW = diffM = float(1)

   if( ( layW > 0 && schW > 0 ) then
    diffW = 100 * (abs( layW - schW ) / schW )
    when( diffW <= DIO_Werr Werr = nil )
   )
   if( ( layM > 0 && schM > 0 ) then
    diffM = 100 * (abs( layM - schM ) / schM )
    when( diffM <= 0 Merr = nil )
   )

; if no errors return nil

   when( !Werr && !Merr return(nil) )

; now we know there is a parameter error
   if( Werr then
    sprintf( msg1 "Err: DIO w %g vs %g differs by %g percent"
    schM layW diffW ) else sprintf( msg1 "" )
   )
   if( Merr then
    sprintf( msg2 "Err: DIO m %g vs %g differs by %g percent"
    schM layM diffM ) else sprintf( msg2 "" )
   )
   sprintf( msg " %s \n %s \n " msg1 msg2 )
   return( msg )

  ) ; end let
 ) ; end prog
) ; end compareDIO_w


procedure( compareHIA( dev1 dev2 )
 prog( ()
   layW = schW = float(0)
   layL = schL = float(0)
   layM = schM = float(1)
   layFN = schFN = float(0)
 
   if( dev1->aw then layW = float( dev1->aw ) ) 
   if( dev1->AW then layW = float( dev1->AW ) )
   if( dev1->al then layL = float( dev1->al ) ) 
   if( dev1->AL then layL = float( dev1->AL ) )
   if( dev1->m  then layM = float( dev1->m ) )
   if( dev1->M  then layM = float( dev1->M ) )
   if( dev1->fn then layFN = float( dev1->fn ) )
   if( dev1->FN then layFN = float( dev1->FN ) )

   if( dev2->aw then schW = float( dev2->aw ) ) 

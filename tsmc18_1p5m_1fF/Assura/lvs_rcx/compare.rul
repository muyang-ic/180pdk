   printf( "   2nd device: m= %g lt= %g wt= %g \n" M2 L2 W2 )
   printf( "result device: m= %g lt= %g wt= %g \n" newM L1 W1 )
   printf( "generated device with model = %s" layModel )	;new added
   return(parCap)
 ) ; end prog
) ; end parallelMIM2t


procedure( compareSBD_l( dev1 dev2 )
 prog( ()
   layL = schL = float(0)
   layM = schM = float(1)
 
   if( dev1->l then layL = float( dev1->l ) ) 
   if( dev1->L then layL = float( dev1->L ) )
   if( dev1->m then layM = float( dev1->m ) )
   if( dev1->M then layM = float( dev1->M ) )

   if( dev2->l then schL = float( dev2->l ) ) 
   if( dev2->L then schL = float( dev2->L ) )
   if( dev2->m then schM = float( dev2->m ) )
   if( dev2->M then schM = float( dev2->M ) )


   if( (layL==0 && schL==0) then
     sprintf( msg4 "Err: Schottky Barrier Diode both schematic %g and layout %g missing l (0 stands for parameter missing)\n" schL layL )
     return(msg4)
   )
   if( layL==0 then
     sprintf( msg5 "Err: Schottky Barrier Diode layout missing l %g (0 stands for parameter missing)\n" layL )
     return(msg5)
   )
   if( schL==0 then
     sprintf( msg6 "Err: Schottky Barrier Diode schematic missing l %g (0 stands for parameter missing)\n" schL )
     return(msg6)
   )
      layL = layL*layM
      schL = schL*schM
   if((layL == schL)  then 
     return(nil)
   )

   diffL = 100 * abs((layL-schL)/schL)
   if( ( diffL > DIO_Lerr ) then
      sprintf( msg12 "Err: Schottky Barrier Diode l %g(sch) vs l %g(lay) differs by %g percent \n" layL schL diffL )
      else sprintf( msg12 "")
   )
   sprintf( msg13 "  %s \n"  msg12 )
   return(msg13)
 ) ; end prog
) ; end compareSBD_l


   printf( "result device: l=%g w=%g m=%g \n" L1 W1 newM )
   return(parMAC)
 ) ; end prog
) ; end parallelMACMOS

;-----------------------------------------------------------------------------------------

 procedure( parallelMACMOS_nf( dev1 dev2 )
 prog( ( parMAC)
   parMAC = ncons(nil)
   L1 = W1 = N1 = float(0)
   L2 = W2 = N2 = float(-1)
   M1 = M2 = float(1)
   if( dev1->m then M1 = float(dev1->m) )
   if( dev2->m then M2 = float(dev2->m) )
   if( dev1->M then M1 = float(dev1->M) )
   if( dev2->M then M2 = float(dev2->M) )

   if( dev1->L then L1 = float(dev1->L) )
   if( dev2->L then L2 = float(dev2->L) )
   if( dev1->l then L1 = float(dev1->l) )
   if( dev2->l then L2 = float(dev2->l) )

   if( dev1->W then W1 = float(dev1->W) )
   if( dev2->W then W2 = float(dev2->W) )
   if( dev1->w then W1 = float(dev1->w) )
   if( dev2->w then W2 = float(dev2->w) )

   if( dev1->NF then N1 = float(dev1->NF) )
   if( dev2->NF then N2 = float(dev2->NF) )
   if( dev1->nf then N1 = float(dev1->nf) )
   if( dev2->nf then N2 = float(dev2->nf) )

   unless( ((L1 == L2) && (W1 == W2) && (N1 == N2))
    printf( "\n** Unequal Parallel MACMOS NOT combined( 0 & -1 stand for parameter missing): \n" )
    printf( "   1st device: l=%g w=%g nf=%g m=%g \n" L1 W1 N1 M1 )
    printf( "   2nd device: l=%g w=%g nf=%g m=%g \n" L2 W2 N2 M2 )
    return("doNotCombine")
   )
   newM = float( M1 + M2 )
   parMAC->m = newM
   parMAC->l = float(L1)
   parMAC->w = float(W1)
   parMAC->nf = float(N1)
   printf( "\n** Parallel MACMOS combined: \n" )
   printf( "   1st device: l=%g w=%g nf=%g m=%g \n" L1 W1 N1 M1 )
   printf( "   2nd device: l=%g w=%g nf=%g m=%g \n" L2 W2 N2 M2 )
   printf( "result device: l=%g w=%g nf=%g m=%g \n" L1 W1 N1 newM )
   return(parMAC)
 ) ; end prog
) ; end parallelMACMOS_nf


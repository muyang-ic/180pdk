; LVS Error tolerance
  MOS_Werr = 0		;;  MOS width
  MOS_Lerr = 0		;;  MOS length
  DIO_Aerr = 0		;;  Diode area
  DIO_Werr = 0		;;  Diode width
  DIO_Lerr = 0		;;  Diode length
  BJT_Aerr = 0		;;  BJT area
  RES_Rerr = 1e-9	;;  Resistor value 
  RES_Werr = 1e-9	;;  Resistor width
  RES_Lerr = 1e-9	;;  Resistor length
  MIMCAP_Werr = 0	;;  MIM CAP width
  MIMCAP_Lerr = 0	;;  MIM CAP length
  MOSCAP_Werr = 0	;;  MOS CAP width
  MOSCAP_Lerr = 0	;;  MOS CAP length
  SPIRAL_Werr = 0	;;  Inductor width
  SPIRAL_Serr = 0	;;  Inductor space
  SPIRAL_Rerr = 0	;;  Inductor radius
  SPIRAL_Gerr = 0	;;  Inductor gdis
  MOM_Werr = 0		;;  MOM width
  MOM_Lerr = 0		;;  MOM length
  MOM_Serr = 0		;;  MOM space
  RFMOS_Werr = 0	;;  RF MOS width
  RFMOS_Lerr = 0	;;  RF MOS length

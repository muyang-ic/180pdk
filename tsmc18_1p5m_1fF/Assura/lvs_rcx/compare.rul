procedure( parallelEFU( dev1 dev2 )
 prog( ( parEFU)
   parEFU = ncons(nil)
   M1 = M2 = float(1)

   if( dev1->m then M1 = float(dev1->m) )
   if( dev2->m then M2 = float(dev2->m) )
   if( dev1->M then M1 = float(dev1->M) )
   if( dev2->M then M2 = float(dev2->M) )

   newM = float( M1 + M2 )
   parEFU->m = newM
   printf( "\n** Parallel RES combined: \n" )
   printf( "   1st device: m=%g \n" M1 )
   printf( "   2nd device: m=%g \n" M2 )
   printf( "result device: m=%g \n" newM )
   return(parEFU)
 ) ; end prog
) ; end parallelEFU


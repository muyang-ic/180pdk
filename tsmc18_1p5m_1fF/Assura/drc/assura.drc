;;  *          (CL018G/LV/LP, CM018G, CR018G, CL016G, CM016G, CL0152G, CM0152)  * 
;;  * (DESIGN RULE DOCUMENT: T-018-LO-DR-001 Rev 2.10)                           * 
;;  * (DRC COMMAND FILE DOCUMENT: T-018-LO-DR-001-U1 Rev 2.10a)          	       * 
;;  ***************************************************************************** 

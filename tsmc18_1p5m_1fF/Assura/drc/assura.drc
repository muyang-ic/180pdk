PWR_M3u_TEXT=geomGetTexted(geomTextShape(LAYER_42, 1.0) LAYER_42 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  
PWR_M4u_BY_TEXT=geomGetTexted(M4u LAYER_43 "AVDDBG" "AVDDR" "AVDWELL" "VDWELL" "VD33APST" "VDD5V" "TAVD33" "VD33PST" "AVDD" "TAVDD" "TAVD33PST" "TAVDDPST" "AVD33B" "VDD" "AVD33G" "DVDD" "AVDDG" "AVDDB" "VDDG" "VDDPST" "VD33REF" "VD33" "AVD33R" "VDDSA")  
GND_M4u_BY_TEXT=geomGetTexted(M4u LAYER_43 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  
PAD_M4u_BY_TEXT=geomGetTexted(M4u LAYER_43 "*")  
GND_M4u_TEXT=geomGetTexted(geomTextShape(LAYER_43, 1.0) LAYER_43 "AVDDBG" "AVDDR" "AVDWELL" "VDWELL" "VD33APST" "VDD5V" "TAVD33" "VD33PST" "AVDD" "TAVDD" "TAVD33PST" "TAVDDPST" "AVD33B" "VDD" "AVD33G" "DVDD" "AVDDG" "AVDDB" "VDDG" "VDDPST" "VD33REF" "VD33" "AVD33R" "VDDSA")  
PWR_M4u_TEXT=geomGetTexted(geomTextShape(LAYER_43, 1.0) LAYER_43 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  
PWR_M5u_BY_TEXT=geomGetTexted(M5u LAYER_44 "AVDDBG" "AVDDR" "AVDWELL" "VDWELL" "VD33APST" "VDD5V" "TAVD33" "VD33PST" "AVDD" "TAVDD" "TAVD33PST" "TAVDDPST" "AVD33B" "VDD" "AVD33G" "DVDD" "AVDDG" "AVDDB" "VDDG" "VDDPST" "VD33REF" "VD33" "AVD33R" "VDDSA")  
GND_M5u_BY_TEXT=geomGetTexted(M5u LAYER_44 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  
PAD_M5u_BY_TEXT=geomGetTexted(M5u LAYER_44 "*")  
GND_M5u_TEXT=geomGetTexted(geomTextShape(LAYER_44, 1.0) LAYER_44 "AVDDBG" "AVDDR" "AVDWELL" "VDWELL" "VD33APST" "VDD5V" "TAVD33" "VD33PST" "AVDD" "TAVDD" "TAVD33PST" "TAVDDPST" "AVD33B" "VDD" "AVD33G" "DVDD" "AVDDG" "AVDDB" "VDDG" "VDDPST" "VD33REF" "VD33" "AVD33R" "VDDSA")  
PWR_M5u_TEXT=geomGetTexted(geomTextShape(LAYER_44, 1.0) LAYER_44 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  

processAntenna(
gate((CBu CBu)(UBMnu UBMnu)(UBMdu UBMdu))
    antenna(NWT)
    ratio = (plusp(CBu.area)+plusp(UBMnu.area))+plusp(UBMdu.area)
    NWT_IOPAD=drcAntenna(NWT (NWT) ratio keep>0 suppressErrorMessage)
)
NWT_IOPAD=geomOr(NWT_IOPAD_NWT)
processAntenna(
    gate((NWT_CB_DUMMY NWT_CB_DUMMY) (NWT_UBMn_DUMMY NWT_UBMn_DUMMY) (NWT_UBMd_DUMMY NWT_UBMd_DUMMY))
    antenna(NWT)
    ratio = NWT.area/(NWT_CB_DUMMY.area+NWT_UBMn_DUMMY.area+NWT_UBMd_DUMMY.area)
    NWT_VDD_VSS_PAD_DUMMY=drcAntenna(NWT (NWT) ratio keep>0 suppressErrorMessage)
)
NWT_VDD_VSS_PAD_DUMMY=geomOr(NWT_VDD_VSS_PAD_DUMMY_NWT)
processAntenna(
    gate((PAD_M1u_BY_TEXT PAD_M1u_BY_TEXT) (PAD_M2u_BY_TEXT PAD_M2u_BY_TEXT) (PAD_M3u_BY_TEXT PAD_M3u_BY_TEXT) (PAD_M4u_BY_TEXT PAD_M4u_BY_TEXT) (PAD_M5u_BY_TEXT PAD_M5u_BY_TEXT))
    antenna(NWT)
    ratio = NWT.area/(PAD_M1u_BY_TEXT.area+PAD_M2u_BY_TEXT.area+PAD_M3u_BY_TEXT.area+PAD_M4u_BY_TEXT.area+PAD_M5u_BY_TEXT.area)
    NWT_PAD_TEXT=drcAntenna(NWT (NWT) ratio keep>0 suppressErrorMessage)
)
NWT_PAD_TEXT=geomOr(NWT_PAD_TEXT_NWT)
processAntenna(
    gate((PWR_M1u_BY_TEXT PWR_M1u_BY_TEXT) (PWR_M2u_BY_TEXT PWR_M2u_BY_TEXT) (PWR_M3u_BY_TEXT PWR_M3u_BY_TEXT) (PWR_M4u_BY_TEXT PWR_M4u_BY_TEXT) (PWR_M5u_BY_TEXT PWR_M5u_BY_TEXT) (GND_M1u_BY_TEXT GND_M1u_BY_TEXT) (GND_M2u_BY_TEXT GND_M2u_BY_TEXT) (GND_M3u_BY_TEXT GND_M3u_BY_TEXT) (GND_M4u_BY_TEXT GND_M4u_BY_TEXT) (GND_M5u_BY_TEXT GND_M5u_BY_TEXT))
    antenna(NWT)
    ratio = NWT.area/(PWR_M1u_BY_TEXT.area+PWR_M2u_BY_TEXT.area+PWR_M3u_BY_TEXT.area+PWR_M4u_BY_TEXT.area+PWR_M5u_BY_TEXT.area+GND_M1u_BY_TEXT.area+GND_M2u_BY_TEXT.area+GND_M3u_BY_TEXT.area+GND_M4u_BY_TEXT.area+GND_M5u_BY_TEXT.area)
    NWT_VDD_VSS_PAD_TEXT=drcAntenna(NWT (NWT) ratio keep>0 suppressErrorMessage)
)
NWT_VDD_VSS_PAD_TEXT=geomOr(NWT_VDD_VSS_PAD_TEXT_NWT)

if(CHECK_LATCHUP_BY_TEXT==1 then
    NWT_IO=geomAndNot(NWT_IOPAD geomOr(NWT_VDD_VSS_PAD_TEXT NWT_VDD_VSS_PAD_DUMMY))  
    NWT_IO_TEXT=geomAndNot(NWT_PAD_TEXT geomOr(NWT_VDD_VSS_PAD_TEXT NWT_VDD_VSS_PAD_DUMMY))  

else
    NWT_IO=geomAndNot(NWT_IOPAD NWT_VDD_VSS_PAD_DUMMY)  
)

if(Recommend==1 then
    let( /* NWR.R.7 */ (RULE_COMMENT NTAP_OD2 PTAP_OD2 NSD_OD2 PSD_OD2 ILP1_OD2 ERR__1 ERR__2)
        sprintf(RULE_COMMENT "NWR.R.7  Its recommended not to connect any terminal of NWROD(N-well under OD resistor) to IO voltage for the leakage current concern." )    
        NTAP_OD2=geomAnd(NTAPu OD2)  
        PTAP_OD2=geomAnd(PTAPu OD2)  
        NSD_OD2=geomAnd(NSDu OD2)  
        PSD_OD2=geomAnd(PSDu OD2)  
        ILP1_OD2=geomAnd(ILP1u OD2)  
        if(CHECK_LATCHUP_BY_TEXT==1 then
            if(CHECK_LATCHUP_BY_TEXT==1 then
                geomStamp(NWT_IO NWT_IOPAD)

            else
                geomStamp(NWT_IO NWT_IOPAD)
            )
            cond(
                (CHECK_LATCHUP_BY_TEXT==1 geomStamp(NWT_IO_TEXT NWT_PAD_TEXT))
            )
            processAntenna(
                gate((NTAP_OD2 NTAP_OD2) (PTAP_OD2 PTAP_OD2) (NSD_OD2 NSD_OD2) (PSD_OD2 PSD_OD2) (NWT_IO NWT_IO) (ILP1_OD2 ILP1_OD2) (NWT_IO_TEXT NWT_IO_TEXT))
                antenna(NWT)
                ratio = (((((plusp(NTAP_OD2.area)+plusp(PTAP_OD2.area))+plusp(NSD_OD2.area))+plusp(PSD_OD2.area))+plusp(ILP1_OD2.area))+plusp(NWT_IO.area))+plusp(NWT_IO_TEXT.area)
                ERR__1=drcAntenna(NWT (NWT) ratio keep>0 suppressErrorMessage)
            )
            ERR__1=geomOr(ERR__1_NWT)
            errorLayer(ERR__1 RULE_COMMENT)

        else
            processAntenna(
                gate((NTAP_OD2 NTAP_OD2) (PTAP_OD2 PTAP_OD2) (NSD_OD2 NSD_OD2) (PSD_OD2 PSD_OD2) (NWT_IO NWT_IO) (ILP1_OD2 ILP1_OD2))
                antenna(NWT)
                ratio = ((((plusp(NTAP_OD2.area)+plusp(PTAP_OD2.area))+plusp(NSD_OD2.area))+plusp(PSD_OD2.area))+plusp(ILP1_OD2.area))+plusp(NWT_IO.area)
                ERR__2=drcAntenna(NWT (NWT) ratio keep>0 suppressErrorMessage)

            )
            ERR__2=geomOr(ERR__2_NWT)
            errorLayer(ERR__2 RULE_COMMENT)
        )
    )

)

;; NWEL under STI 
NWRES_STI=geomAndNot(RNWEL geomButtOrOver(RNWEL RPO)) ;;  NWEL resistor (UNDER STI)  
ODWR_STI=geomButtOrOver(OD NWRES_STI)  
NPWR_STI=geomButtOrOver(NP NWRES_STI)  
let( /* NWR.E.3 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NWR.E.3  Min. extension of NP to OD (NWEL resistor under STI) 0.18 um" )    
    drc(NPWR_STI ODWR_STI enc<0.18 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAndNot(ODWR_STI NPWR_STI) RULE_COMMENT)
)

let( /* NWR.R.3 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT "NWR.R.3  Only one NW inside NWROD is allowed in one OD." )    
    A=geomButtOrOver(ODWR geomAnd(NWRES ODWR) keep>1)  
    errorLayer(geomButtOrOver(NWRES A) RULE_COMMENT)
)

let( /* NWR.R.4 */ (RULE_COMMENT C)
    sprintf(RULE_COMMENT "NWR.R.4  Only two NPS in NWROD is allowed in one od." )    
    C=geomButtOrOver(ODWR geomButtOrOver(NP NWRES) ignore==2)  
    errorLayer(geomButtOrOver(NP C) RULE_COMMENT)
    errorLayer(geomAndNot(ODWR geomButtOrOver(ODWR geomButtOrOver(NP NWRES))) RULE_COMMENT)
)

let( /* NWR.R.5 */ (RULE_COMMENT A D)
    sprintf(RULE_COMMENT "NWR.R.5  ONLY TWO RPO HOLES IN NWROD ARE ALLOWED." )    
    A=geomButtOrOver(ODWR RPONWR_H ignore==2)  
    D=geomAndNot(ODWR geomButtOrOver(ODWR RPONWR_H))  
    errorLayer(geomButtOrOver(RPONWR_H geomOr(A D)) RULE_COMMENT)
)

let( /* NWR.R.6 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT strcat(
        "NWR.R.6  For U-shape or S-shape NWROD, both OD and NW must be U-shape or S-shape and the OD edge must be"
        "parallel to the NW edge. DRC can only flag the pattern without OD space while 2 edges of NW"
        "[NW space or notch <= 5 um] parallel length > 0 um"
    )   )    
    A=geomAndNot(drc(NWRES 0<notch<5 opposite shielded) NWRES)  
    errorLayer(geomInside(A ODWR) RULE_COMMENT)
)

if(VOLTAGE_5V==0 then
    NTN_OD=geomAndNot(OD geomOutside(OD NTN))  
    NTN_PO=geomAnd(POLY NTN)  
    NTN_GATE=geomAnd(NTN_PO NTN_OD)  
    NTN_GATE_W=geomGetEdge(NTN_PO inside NTN_OD)  
    NTN_GATE_L=geomGetEdge(NTN_OD inside NTN_PO)  
    NTN_PO_W=geomGetEdge(geomButtOrOver(NTN_PO geomOr(CO OD)) coincident POLY)  

    let( /* NT_N.I.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "NT_N.I.1  NT_N interact DNW is not allowed. (Butted is allowed)" )    
        errorLayer(geomAnd(NTN DNW) RULE_COMMENT)
    )

    let( /* NT_N.I.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "NT_N.I.2  only one OD region allowed to be put in an NT_N region" )    
        errorLayer(geomEnclose(NTN OD keep>1)   RULE_COMMENT)
    )

    let( /* NT_N.I.3 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "NT_N.I.3  A P+GATE is not allowed to be put in an NT_N region" )    
        errorLayer(geomAnd(NTN GATE_PP) RULE_COMMENT)
    )
ntn_po_w_ang451= geomGetAngledEdge(NTN_PO_W keep == 45)
ntn_po_w_ang02= geomGetAngledEdge(NTN_PO_W keep == 0)
ntn_po_w_ang021= geomGetAdjacentEdge(NTN_PO_W ntn_po_w_ang02 )
ntn_po_w_ang01= geomGetAngledEdge(NTN_PO_W keep == 0)
ntn_po_w_ang011= geomGetAdjacentEdge(NTN_PO_W ntn_po_w_ang01 )
ntn_po_w_ang901= geomGetAngledEdge(NTN_PO_W keep == 90)
 errorLayer( geomAndNot(ntn_po_w_ang011 ntn_po_w_ang451) 
	"NT_N.I.4  A bent poly region is not allowed to put in an NT_N region ") 
 errorLayer( geomAndNot(ntn_po_w_ang021 ntn_po_w_ang901) 
	"NT_N.I.4 3  A bent poly region is not allowed to put in an NT_N region ") 

    let( /* NT_N.W.1 */ (RULE_COMMENT)

        sprintf(RULE_COMMENT "NT_N.W.1  For CL018LV 1.5V/2.5V, CL018G 1.8V/3.3V minimum dimension of a NT_N region < %f" NT_N_W_1)    
        drc(NTN width<NT_N_W_1 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
    )

    if(VOLTAGE_1_5V==1 then
        if(VOLTAGE_3_3V==1 then
            let( /* NT_N.W.1_1.5_3.3V */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "NT_N.W.1_1.5_3.3V  For CL018LV 1.5V/3.3V, minimum dimension of a NT_N region.<0.86" )    
                drc(NTN width<0.86 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
            )

        )

    )

    if(VOLTAGE_1_8V==1 then
        if(C016==1 then
            let( /* NTN.W.2 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "NTN.W.2  Minimum poly gate dimension(channel length) of a 1.8V blocked NT_N device < 0.55" )    
                drc(NTN_GATE_W width<0.55 shielded RULE_COMMENT)
            )

        )
        if(C016==0 then
            let( /* NT_N.W.2_LV */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "NT_N.W.2_LV  Minimum Poly gate dimension of a 1.8V blocked NT_N device < 0.5" )    
                drc(NTN_GATE_W width<0.5 shielded RULE_COMMENT)
            )

        )

    )

    if(VOLTAGE_1_5V==1 then
        let( /* NT_N.W.2.LV */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "NT_N.W.2.LV  For CL018LV 1.5/2.5V & 1.5/3.3V, minimum Poly gate dimension of a 1.5V blocked NT_N device < 0.37" )    
            drc(NTN_GATE_W width<0.37 shielded RULE_COMMENT)
        )

        let( /* NT_N.W.2_HV */ (RULE_COMMENT Z)
            sprintf(RULE_COMMENT "NT_N.W.2_HV  CL018LV 1.5V/3.3V, CL018LV 1.5V/2.5V, CL018G 1.8V/3.3, minimum Poly gate dimension of a {2.5V or 3.3V} blocked NT_N device < 1.2" )    
            Z=geomGetEdge(NTN_GATE_W inside OD2)  
            drc(Z width<1.2 shielded RULE_COMMENT)
        )

    )

    if(C016==0 then
        if(VOLTAGE_3_3V==1 then
            let( /* NT_N.W.2_3.3V */ (RULE_COMMENT Z)
                sprintf(RULE_COMMENT "NT_N.W.2_3.3V  For CL018LV 1.5V/3.3V, CL018LV 1.5V/2.5V, CL018G 1.8V/3.3V, minimum Poly gate dimension of a {2.5V or 3.3V} blocked NT_N device < 1.2" )    
                Z=geomGetEdge(NTN_GATE_W inside OD2)  
                drc(Z width<1.2 shielded RULE_COMMENT)
            )

        )

    )

    if(C016==1 then
        let( /* NTN.W.2B */ (RULE_COMMENT Z)
            sprintf(RULE_COMMENT "NTN.W.2B  Minimum poly gate dimension (channel length) of a 3.3V blocked NT_N device < 1.32" )    
            Z=geomGetEdge(NTN_GATE_W inside OD2)  
            drc(Z width<1.32 shielded RULE_COMMENT)
        )

        let( /* NTN.W.3 */ (RULE_COMMENT A)
            sprintf(RULE_COMMENT "NTN.W.3  Minimum OD width of 1.8V/3.3V blocked NT_N device < 0.245" )    
            A=geomButtOrOver(NTN_OD NTN_PO)  
            drc(A width<0.245 shielded RULE_COMMENT)
        )

    )

    let( /* NT_N.S.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "NT_N.S.1  Minimum space between two NT_N regions < %f" NT_N_S_1)    
        drc(NTN 0<sepNotch<NT_N_S_1 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* NT_N.E.1 */ (RULE_COMMENT A B C D)
        sprintf(RULE_COMMENT "NT_N.E.1  Maximum and Minimum extension from NT_N region beyond an NP OD region %f" NT_N_E_1)    
        A=geomButtOrOver(NTN NPOD)  
        B=geomButtOrOver(NPOD NTN)  
        C=geomSize(B NT_N_E_1 noClipAcute)  
        D=geomSize(A (-NT_N_E_1) noClipAcute)  
        errorLayer(geomXor(A C) RULE_COMMENT)
        errorLayer(geomXor(B D) RULE_COMMENT)
    )

    if(VOLTAGE_1_5V==1 then
        let( /* NT_N.E.2.LV */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "NT_N.E.2.LV  For CL018LV 1.5V/2.5V & 1.5V/3.3V, minimum extension from OD2 edge to {2.5V or 3.3V}"
                "NT_N region inside OD2 < 0.86um"
            )  )    
            drc(OD2 NTN enc<0.86 shielded withIntersection withSingularPoint RULE_COMMENT)
            errorLayer(geomStraddle(NTN OD2) RULE_COMMENT)
        )

    )

    let( /* NT_N.C.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "NT_N.C.1  MInimum clearance from NT_N to OD < %f" NT_N_C_1)    
        drc(OD NTN sep<NT_N_C_1 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomStraddle(OD NTN) RULE_COMMENT)
    )

    let( /* NT_N.C.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "NT_N.C.2  Minimum clearance frome a NT_N region to NWEL edge < 1.66" )    
        drc(NTN NWEL sep<1.66 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomAnd(NTN NWEL) RULE_COMMENT)
    )

    if(VOLTAGE_1_5V==1 then
        let( /* NT_N.C.3.LV */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "NT_N.C.3.LV  For CL018LV 1.5/2.5V & 1.5/3.3V, minimum clearance from 1.5V"
                "NT_N region to OD2 edge < 0.86um"
            )  )    
            drc(NTN OD2 sep<0.86 shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )
    let( /* NT_N.PO.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "NT_N.PO.1  Minimum overlap of a PO region extended into field oxide(endcap) < 0.35" )    
        drc(POLY NTN_OD enc<0.35 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

)

;;  OD CHECKS 
;; ============== 
let( /* OD.W.1_OD.W.2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "OD.W.1_OD.W.2  Min. OD width for MOS and interconnect < 0.22" )    
    drc(OD width<0.22 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
)

let( /* OD.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "OD.S.1  Min. OD space < 0.28" )    
    drc(OD 0<sepNotch<0.28 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* OD.C.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "OD.C.1  Min. NWEL olap NPOD tie down < 0.12" )    
    drc(NONWR NPOD enc<0.12 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomStraddle(NPOD NONWR) RULE_COMMENT)
)

let( /* OD.C.2_OD.C.3 */ (RULE_COMMENT A X)
    sprintf(RULE_COMMENT "OD.C.2_OD.C.3  Min. NWEL to NPOD space < 0.43" )    
    A=geomAndNot(NPOD geomInside(NPOD NWEL))  
    X=geomAndNot(A ODWR)  
    drc(X NWEL sep<0.43 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomStraddle(X NWEL) RULE_COMMENT)
)

let( /* OD.C.4 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "OD.C.4  NWEL overlap PPOD < 0.43" )    
    drc(NWEL PPOD enc<0.43 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomStraddle(PPOD NWEL) RULE_COMMENT)
)

let( /* OD.C.5 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "OD.C.5  NWEL space PPOD outside NW < 0.12" )    
    drc(PTAP NWEL sep<0.12 shielded withIntersection withSingularPoint RULE_COMMENT)
)

;;  OD.S.2 is not necessary to check 
let( /* OD.W.3 */ (RULE_COMMENT SD NP_PP_BTE BUTTED_EDGE CHECK_SD NARROW_SD CHECK_OD)
    sprintf(RULE_COMMENT "OD.W.3  Length of active with width < %f um, connected to butted strap > %f um" OD_W_3_J OD_W_3_T)    
    SD=geomAndNot(geomButtOrOver(DACT ALL_GATE) ALL_GATE)  
    NP_PP_BTE=geomGetEdge(NPOD butting PPOD)  
    BUTTED_EDGE=geomGetLength(NP_PP_BTE keep<OD_W_3_J)  
    CHECK_SD=geomButtOrCoin(SD geomSize(BUTTED_EDGE 0.005))  
    NARROW_SD=geomOr(drc(geomGetEdge(CHECK_SD coincident OD) width<OD_W_3_J opposite shielded) geomStretchCorner(geomGetCorner(geomSize(geomGetEdge(CHECK_SD coincident OD) 0.005) keep<90) OD_W_3_J angleAll))  
    CHECK_OD=geomOr(geomButtOrCoin(NARROW_SD geomSize(BUTTED_EDGE 0.005)) geomButtOrCoin(NARROW_SD geomSize(GATE_W 0.005)))  
    errorLayer(geomGetLength(geomGetEdge(OD coincident CHECK_OD) keep>OD_W_3_T contiguous) RULE_COMMENT)
)

let( /* OD.A.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "OD.A.1  Min. area of stand-alone OD region < 0.202" )    
    drc(OD area<0.202 RULE_COMMENT) 
)

if(VOLTAGE_5V==1 then
    let( /* OD.C.2.1_OD.C.3.1 */ (RULE_COMMENT X Y)
        sprintf(RULE_COMMENT "OD.C.2.1_OD.C.3.1  Minimum clearance from NWEL edge to N+OD which interacts OD2 < 0.6" )    
        X=geomAndNot(geomAndNot(NPOD geomInside(NPOD NWEL)) ODWR)  
        Y=geomButtOrOver(X OD2)  
        drc(Y NWEL sep<0.6 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* OD.C.4.1 */ (RULE_COMMENT X)
        sprintf(RULE_COMMENT "OD.C.4.1  Minimum clearance from NWEL edge to P+OD which interacts OD2 < %f" OD_C_4_1)    
        X=geomButtOrOver(PPOD OD2)  
        drc(NWEL X enc<OD_C_4_1 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

)

;;  OD2 CHECKS 
;; =============== 
DACTG=geomOr(DACT ALL_GATE)  

let( /* OD2.E.1 */ (RULE_COMMENT CHECK_EDGE)
    sprintf(RULE_COMMENT "OD2.E.1  Minimum extension of an OD2 region beyond an {active OD OR Gate} region>=0.32um" )    
    CHECK_EDGE=drc(OD2 DACTG enc<0.32 edgeb shielded withIntersection)  
    errorLayer(geomAndNot(CHECK_EDGE geomGetEdge(CHECK_EDGE butting DSTP) edges) RULE_COMMENT)
    errorLayer(geomInside(OD2 DACTG) RULE_COMMENT)
)

if(VOLTAGE_5V==0 then
    if(VOLTAGE_1_8V==1 then
        let( /* OD2.S.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "OD2.S.1  For two well process (1.8V/3.3V C018G), minimum space between two OD2"
                "regions. Merge if the space is less than 0.45um.>=0.45um"
            )  )    
            drc(OD2 0<sepNotch<0.45 shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )

)
if(VOLTAGE_1_5V==1 then
    let( /* OD2.S.1.LV */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "OD2.S.1.LV  For four well process 1.5V/3.3V C018LV, 1.5V/2.5V C018LV, 1.8V/3.3V"
            "C018LP, 1.8V/5.0V C018G/LP, minimum space between two OD2 regions."
            "Merge if the space is less than 0.86um."
        )   )    
        drc(OD2 0<sepNotch<0.86 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

)
if(VOLTAGE_5V==1 then
    let( /* OD2.S.1.5V */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "OD2.S.1.5V  For four well process 1.5V/3.3V C018LV, 1.5V/2.5V C018LV, 1.8V/3.3V"
            "C018LP, 1.8V/5.0V C018G/LP, minimum space between two OD2 regions."
            "Merge if the space is less than 0.86um."
        )   )    
        drc(OD2 0<sepNotch<0.86 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

)
if(LP==1 then
    let( /* OD2.S.1.LP */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "OD2.S.1.LP  For four well process 1.5V/3.3V C018LV, 1.5V/2.5V C018LV, 1.8V/3.3V"
            "C018LP, 1.8V/5.0V C018G/LP, minimum space between two OD2 regions."
            "Merge if the space is less than 0.86um."
        )   )    
        drc(OD2 0<sepNotch<0.86 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

)
let( /* OD2.C.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "OD2.C.1  Minimum clearance between OD region and an OD2 region>=0.32um" )    
    drc(OD2 NACT sep<0.32 shielded withIntersection withSingularPoint RULE_COMMENT)
    drc(OD2 PACT sep<0.32 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* OD2.C.2 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT strcat(
        "OD2.C.2  Minimum clearance between OD2 region and {1.5V or 1.8V} transistor gate"
        "poly>= 0.4um"
    )  )    
    A=geomGetEdge(OD2 inside DACT)  
    drc(A GATE_W sep<0.40 shielded withIntersection RULE_COMMENT)
)

let( /* OD2.E.2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT strcat(
        "OD2.E.2  Minimum extension of OD2 region beyond {2.5V or 3.3V or 5V} transistor"
        "gate poly in the source/drain OD direction OD2 cut poly GATE is not"
        "allowed. >=0.4um"
    )   )    
    drc(OD2_BEDGE GATE_W enc<0.40 shielded withIntersection RULE_COMMENT)
    errorLayer(geomStraddle(ALL_GATE OD2) RULE_COMMENT)
)

if(VOLTAGE_1_5V==1 then
    let( /* OD2.E.4.LV */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "OD2.E.4.LV  For four well process 1.5V/3.3V C018LV, 1.5V/2.5V C018LV, 1.8V/3.3V"
            "C018LP, 1.8V/5.0V C018G/LP, minimum extension of an OD2 region"
            "beyond an NW region>=0.86um. Align if space is less than 0.86um"
        )   )    
        drc(OD2 NWEL enc<0.86 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    )

    let( /* OD2.C.4.LV */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "OD2.C.4.LV  For four well process 1.5V/3.3V C018LV, 1.5V/2.5V C018LV, 1.8V/3.3V"
            "C018LP, 1.8V/5.0V C018G/LP>=0.86um, minimum clearance between an OD2 region"
            "and an NW region. Align if space is less than 0.86um"
        )   )    
        drc(NWEL OD2 sep<0.86 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
        drc(NWEL OD2 enc<0.86 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    )

    let( /* OD2.O.1.LV */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "OD2.O.1.LV  For four well process 1.5V/3.3V C018LV, 1.5V/2.5V C018LV, 1.8V/3.3V"
            "C018LP, 1.8V/5.0V C018G/LP>=0.86um minimum overlap between OD2 and NWEL >= 0.86um"
        )  )    
        drc(NWEL OD2 ovlp<0.86 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    )

)

if(VOLTAGE_5V==1 then
    let( /* OD2.E.4.5V */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "OD2.E.4.5V  For four well process 1.5V/3.3V C018LV, 1.5V/2.5V C018LV, 1.8V/3.3V"
            "C018LP, 1.8V/5.0V C018G/LP, minimum extension of an OD2 region"
            "beyond an NW region>=0.86um. Align if space is less than 0.86um"
        )   )    
        drc(OD2 NWEL enc<0.86 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    )

    let( /* OD2.C.4.5V */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "OD2.C.4.5V  For four well process 1.5V/3.3V C018LV, 1.5V/2.5V C018LV, 1.8V/3.3V"
            "C018LP, 1.8V/5.0V C018G/LP>=0.86um, minimum clearance between an OD2 region"
            "and an NW region. Align if space is less than 0.86um"
        )   )    
        drc(NWEL OD2 sep<0.86 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
        drc(NWEL OD2 enc<0.86 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    )

    let( /* OD2.O.1.5V */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "OD2.O.1.5V  For four well process 1.5V/3.3V C018LV, 1.5V/2.5V C018LV, 1.8V/3.3V"
            "C018LP, 1.8V/5.0V C018G/LP>=0.86um minimum overlap between OD2 and NWEL >= 0.86um"
        )  )    
        drc(NWEL OD2 ovlp<0.86 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    )

)

if(LP==1 then
    let( /* OD2.E.4.LP */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "OD2.E.4.LP  For four well process 1.5V/3.3V C018LV, 1.5V/2.5V C018LV, 1.8V/3.3V"
            "C018LP, 1.8V/5.0V C018G/LP, minimum extension of an OD2 region"
            "beyond an NW region>=0.86um. Align if space is less than 0.86um"
        )   )    
        drc(OD2 NWEL enc<0.86 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    )

    let( /* OD2.C.4.LP */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "OD2.C.4.LP  For four well process 1.5V/3.3V C018LV, 1.5V/2.5V C018LV, 1.8V/3.3V"
            "C018LP, 1.8V/5.0V C018G/LP>=0.86um, minimum clearance between an OD2 region"
            "and an NW region. Align if space is less than 0.86um"
        )   )    
        drc(NWEL OD2 sep<0.86 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
        drc(NWEL OD2 enc<0.86 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    )

    let( /* OD2.O.1.LP */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "OD2.O.1.LP  For four well process 1.5V/3.3V C018LV, 1.5V/2.5V C018LV, 1.8V/3.3V"
            "C018LP, 1.8V/5.0V C018G/LP>=0.86um minimum overlap between OD2 and NWEL >= 0.86um"
        )  )    
        drc(NWEL OD2 ovlp<0.86 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    )

)

;;  POLY checks 
;; ============= 
;; PO.W.1A is checked by PO.W.3 
;; PO.W.2A is checked by PO.W.3 
let( /* PO.W.3 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PO.W.3  Min. POLY width for interconnect, 1.8V NMOS, 1.8V PMOS < 0.18" )    
    drc(POLY width<0.18 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
)

if(VOLTAGE_3_3V==1 then
    let( /* PO.W.1_3.3V */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "PO.W.1_3.3V  Min. POLY gate length 3.3V pmos < 0.30" )    
        drc(HV_PGATE_W width<0.30 shielded RULE_COMMENT)
    )

    let( /* PO.W.2_3.3V */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "PO.W.2_3.3V  Min. POLY gate length 3.3v nmos < 0.35" )    
        drc(HV_NGATE_W width<0.35 shielded RULE_COMMENT)
    )

)
if(VOLTAGE_2_5V==1 then
    let( /* PO.W.1_2.5V */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "PO.W.1_2.5V  Min. POLY gate length 2.5V pmos < 0.26" )    
        drc(HV_PGATE_W width<0.26 shielded RULE_COMMENT)
    )

    let( /* PO.W.2_2.5V */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "PO.W.2_2.5V  Min. POLY gate length 2.5v nmos < 0.26" )    
        drc(HV_NGATE_W width<0.26 shielded RULE_COMMENT)
    )

)
if(VOLTAGE_5V==1 then
    let( /* PO.W.1_5V */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "PO.W.1_5V  Min. POLY gate length 5.0V pmos < 0.5" )    
        drc(HV_PGATE_W width<0.5 shielded RULE_COMMENT)
    )

    let( /* PO.W.2_5V */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "PO.W.2_5V  Min. POLY gate length 5.0v nmos < 0.6" )    
        drc(HV_NGATE_W width<0.6 shielded RULE_COMMENT)
    )

)

let( /* PO.S.1 */ (RULE_COMMENT Y)
    sprintf(RULE_COMMENT "PO.S.1  Min. POLY space on OD with contact < 0.375" )    
    Y=geomGetEdge(ALL_GATE butting ASD1)  
    drc(Y 0<sepNotch<0.375 shielded withIntersection RULE_COMMENT)
)

let( /* PO.S.2_PO.S.3 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PO.S.2_PO.S.3  Min. POLY space: on OD w/o contact and interconnect < 0.25" )    
    drc(POLY 0<sepNotch<0.25 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* PO.C.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PO.C.1  Min. POLY on field space to active < 0.1" )    
    drc(POLY OD sep<0.1 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* PO.C.2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PO.C.2  Min. OD overhang gate < %f" PO_C_2)    
    drc(OD POLY enc<PO_C_2 shielded withIntersection withSingularPoint RULE_COMMENT)
)

GATE_5V=geomAnd(ALL_GATE OD2)  
PO_5V=geomButtOrOver(POLY GATE_5V)  
OD_5V=geomOr(geomAnd(NW_5V OD) geomAndNot(geomButtOrOver(OD GATE_5V) NWEL))  
if(VOLTAGE_5V==1 then
    let( /* PO.C.3 */ (RULE_COMMENT A B)
        sprintf(RULE_COMMENT "PO.C.3  Min. clearance for an (OD not OD2) region to an 5V PO on field oxide < %f" PO_C_3)    
        A=geomAndNot(OD OD2)  
        B=geomAndNot(PO_5V OD)  
        drc(A B sep<PO_C_3 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* PO.C.4 */ (RULE_COMMENT A B C)
        sprintf(RULE_COMMENT "PO.C.4  Min. clearance from an (5V OD not OD2) region to an PO on field oxide < %f" PO_C_4)    
        A=geomAndNot(OD_5V OD2)  
        drc(A POLY_ISO sep<PO_C_4 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
        B=drc(A POLY_ISO sep<0.001 withIntersection==0 edgea shielded)  
        C=geomSize(B -0.001 edges)  
        errorLayer(geomAndNot(C geomButtOrOver(C ALL_GATE)) RULE_COMMENT)
    )

)

let( /* PO.O.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PO.O.1  Min. POLY overhang active < 0.22" )    
    drc(POLY OD enc<0.22 shielded withIntersection withSingularPoint RULE_COMMENT)
)

if(MIX_MODE==0 then
 por1a_gate_w1  = geomGetAngledEdge( GATE_W keep == 0 mode1)
  por1a_gate_w10 = geomGetAngledEdge( GATE_W keep == 90 mode1)
  por1a_gate_w1_sz  = geomSize( por1a_gate_w1  0.005 )
  por1a_gate_w10_sz = geomSize( por1a_gate_w10 0.005 )
  por1a_gate_w1_un  = geomSize( por1a_gate_w1  -0.005 )
  por1a_gate_w10_un = geomSize( por1a_gate_w10 -0.005 )
  por1a_1           = geomButtOrOver( por1a_gate_w1_sz por1a_gate_w10_sz )
  por1a_2           = geomButtOrOver( por1a_gate_w1_un por1a_gate_w10_un )
  por1a             = geomButtOrOver( POLY geomOr( por1a_1 por1a_2 ) )
  errorLayer( por1a  "PO.R.1A 90 degree L shape and U shape bent gates are not allowed")

)
lvgt_ang1 = geomGetAngledEdge( LVGT keep == 45 )
drc( lvgt_ang1 width < 0.21 opposite "PO.R.1B 45 degree 1.8V gate min. length < 0.21 ")  

let( /* PO.R.2 */ (RULE_COMMENT LONG_PO CHECK_PO CHECK_CO CO_A PO_A PO_B CO_B CO_C BAD BAD_EDGE ERROR)

    sprintf(RULE_COMMENT "PO.R.2  Max. POLY length between contacts when PO width less than 0.24um > %f" PO_R_2)    
    LONG_PO=drc(ILP1 area>0.18*PO_R_2)   
    CHECK_PO=geomButtOrOver(LONG_PO CO)  
    CHECK_CO=geomButtOrOver(CO CHECK_PO)  
    CO_A=geomSizeAnd(CHECK_CO CHECK_PO 0.25 (PO_R_2/2) noClipAcute)  
    PO_A=geomButtOrOver(CHECK_PO CO_A keep==1)  
    PO_B=geomButtOrOver(CHECK_PO CO_A keep>1)  
    CO_B=geomButtOrOver(CO_A PO_A)  
    CO_C=geomSizeAnd(CO_B PO_A 0.25 (PO_R_2/2) noClipAcute)  
    BAD=geomOr(geomAndNot(PO_A CO_C) geomAndNot(PO_B CO_A))  
    BAD_EDGE=geomGetEdge(BAD coincident POLY)  
    ERROR=drc(BAD_EDGE width<=0.24 shielded)  
    errorLayer(geomButtOrOver(CHECK_PO ERROR) RULE_COMMENT)
)

GATEu=geomCat(ALL_GATE)
geomStamp(GATEu ILP1u)
PSDu_g=geomButtOrOver(PSDu POLYi)  
NSDu_g=geomButtOrOver(NSDu POLYi) ;; get all floating gates  
processAntenna(
    gate((GATEu GATEu) (PTAPu PTAPu) (NTAPu NTAPu) (PSDu PSDu) (NSDu NSDu) (CBu CBu) (UBMnu UBMnu) (UBMdu UBMdu) (COu COu))
    antenna(GATEu)
    ratio = (((((zerop(PTAPu.area)*zerop(NTAPu.area))*zerop(PSDu_g.area))*zerop(NSDu_g.area))*zerop(CBu.area))*zerop(UBMnu.area))*zerop(UBMdu.area)+zerop(COu.area)
    Float_GATE=drcAntenna(GATEu (GATEu) ratio keep>0 suppressErrorMessage)
)
Float_GATE=geomOr(Float_GATE_GATEu)
processAntenna(
    gate((PSDu_g PSDu_g) (NSDu_g NSDu_g) (GATEu GATEu) (PTAPu PTAPu) (NTAPu NTAPu) (CBu CBu) (UBMnu UBMnu) (UBMdu UBMdu))
    antenna(NSDu_g)
    ratio = ((((((zerop(plusp(NSDu_g.shapeCount-1))*zerop(PSDu_g.area))*zerop(GATEu.area))*zerop(PTAPu.area))*zerop(NTAPu.area))*zerop(CBu.area))*zerop(UBMnu.area))*zerop(UBMdu.area)
    Float_NSD=drcAntenna(NSDu_g (NSDu_g) ratio keep>0 suppressErrorMessage)
)
Float_NSD=geomOr(Float_NSD_NSDu_g)
processAntenna(
    gate((NSDu_g NSDu_g) (PSDu_g PSDu_g) (GATEu GATEu) (PTAPu PTAPu) (NTAPu NTAPu) (CBu CBu) (UBMnu UBMnu) (UBMdu UBMdu))
    antenna(PSDu_g)
    ratio = ((((((zerop(plusp(PSDu_g.shapeCount-1))*zerop(NSDu_g.area))*zerop(GATEu.area))*zerop(PTAPu.area))*zerop(NTAPu.area))*zerop(CBu.area))*zerop(UBMnu.area))*zerop(UBMdu.area)
    Float_PSD=drcAntenna(PSDu_g (PSDu_g) ratio keep>0 suppressErrorMessage)
)
Float_PSD=geomOr(Float_PSD_PSDu_g)

;; not floating source/drain 
effective_NSD=geomAndNot(NSDu_g Float_NSD)  
effective_PSD=geomAndNot(PSDu_g Float_PSD)  

FloatNSD_AllGate=geomOr(Float_NSD ALL_GATE)  
FloatNSD_AllGate_effective_NSD=geomCat(FloatNSD_AllGate)
geomStamp(FloatNSD_AllGate_effective_NSD effective_NSD buttOrOver)
FloatNSD_AllGate_multi = geomButtOrOver(FloatNSD_AllGate_effective_NSD effective_NSD diffNet)
Float_NSD_a=geomAndNot(Float_NSD FloatNSD_AllGate_multi)  
FloatPSD_AllGate=geomOr(Float_PSD ALL_GATE)  
FloatPSD_AllGate_effective_PSD=geomCat(FloatPSD_AllGate)
geomStamp(FloatPSD_AllGate_effective_PSD effective_PSD buttOrOver)
FloatPSD_AllGate_multi = geomButtOrOver(FloatPSD_AllGate_effective_PSD effective_PSD diffNet)
Float_PSD_a=geomAndNot(Float_PSD FloatPSD_AllGate_multi)  

Float_GATE_check=geomAndNot(Float_GATE geomButtOrOver(Float_GATE geomOr(Float_NSD_a Float_PSD_a)))  

if(FULL_CHIP==1 then
    let( /* PO.R.4 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "PO.R.4  It is prohibited for Floating Gate if the effective source/drain is not connected together" )    
Float_GATE_check_NSDu=geomCat(Float_GATE_check)
geomStamp(Float_GATE_check_NSDu NSDu buttOrOver)
errorLayer(geomButtOrOver(Float_GATE_check_NSDu NSDu diffNet) RULE_COMMENT)

Float_GATE_check_PSDu=geomCat(Float_GATE_check)
geomStamp(Float_GATE_check_PSDu PSDu buttOrOver)
errorLayer(geomButtOrOver(Float_GATE_check_PSDu PSDu diffNet) RULE_COMMENT)


    )

)

;;  Poly/OD Resistor CHECK 
;; ========== 
PORESC=geomAndNot(geomAndNot(PORES geomButtOrOver(PORES RLPPDMY)) geomButtOrOver(geomAndNot(PORES geomButtOrOver(PORES RLPPDMY)) SDI))  
if(Recommend==1 then
    PORESC_L=geomOr(geomSize(geomAndNot(PORESC geomGetEdge(PORESC inside POLY) edges) 0.001 chainEdges) geomSize(geomAndNot(PORESC geomGetEdge(PORESC inside POLY) edges) -0.001 chainEdges))  
    PORESC_W=geomOr(geomSize(geomGetEdge(PORESC inside POLY) 0.001 edges) geomSize(geomGetEdge(PORESC inside POLY) -0.001 edges))  
    geomConnect(incremental buttOrOver(PORESC_L PORESC_W))
    let( /* RES.2 */ (RULE_COMMENT ERR__1)
        sprintf(RULE_COMMENT strcat(
            "RES.2  For poly resistor, it is strongly recommended that the poly resistor width >= %f um,"
            "length >= 5.0um, and the resistor square number Nsq >= %f,"
            "DRC will check the width and Nsq 1um and 5 for poly resistor & 2um and 5 for OD resistor"
        ) RES_2_W RES_2_Nsq )    
        drc(PORESC width<RES_2_W shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
        processAntenna(
            gate((PORESC_W PORESC_W))
            antenna(PORESC_L)
            ratio = PORESC_L.area/PORESC_W.area
            ERR__1=drcAntenna(PORESC_L (PORESC_L) ratio keep<RES_2_Nsq suppressErrorMessage)
        )
        ERR__1=geomOr(geomOr(ERR__1_PORESC_L) geomNodeRelate(PORESC_L PORESC_W disc))
        errorLayer(ERR__1 RULE_COMMENT)
    )

    DMPN2V=geomOr(DMP2V DMN2V)  
    let( /* RES.3_PO */ (RULE_COMMENT PORES_PO X Y)
        sprintf(RULE_COMMENT strcat(
            "RES.3_PO  The sheet resistance in SPICE model of non-salicided N+/P+ PO/OD resistors is"
            "resulted from N2V/NP and P2V/PP combinations, respectively. To obtain precise resistance,"
            "dummy layers (DMN2V & DMP2V) are required.N2V/P2V/N3V/P3V/N5V/P5V are derived from logical operation,"
            "please ensure correct implants in caes the rsistor traverses NW/PW,1.8V/3.3V,1.8V/5V, 1.5V/3.3V or 1.5V/2.5V."
            "Min. and Max. Extension of DMN2V/DMP2V to Poly resistor on field oxide should be == 0.22um."
        )     )    
        errorLayer(geomAndNot(geomAndNot(geomButtOrOver(PORES PP) geomButtOrOver(geomButtOrOver(PORES PP) HRIi)) DMP2V) RULE_COMMENT)
        errorLayer(geomAndNot(geomButtOrOver(PORES NP) DMN2V) RULE_COMMENT)
        errorLayer(geomAnd(geomAnd(DMP2V DMN2V) PORES) RULE_COMMENT)
        PORES_PO=geomButtOrOver(POLY PORES)  
        drc(DMP2V PORES_PO enc<0.22 shielded withIntersection withSingularPoint RULE_COMMENT)
        drc(DMN2V PORES_PO enc<0.22 shielded withIntersection withSingularPoint RULE_COMMENT)
        X=geomSize(geomStretch(geomButtOrOver(DMPN2V PORES) -0.005) -0.005 edges)  
        Y=geomSize(geomOr(geomGetEdge(DMPN2V coincident geomAndNot(X geomButtOrOver(X PORES_PO)) wholeEdge) geomGetEdge(DMPN2V butting geomAndNot(X geomButtOrOver(X PORES_PO))  wholeEdge)) -0.22 edges)  
        errorLayer(geomAndNot(Y geomButtOnly(geomOutside(Y PORES) PORES)) RULE_COMMENT)
    )

    let( /* RES.3_OD */ (RULE_COMMENT ODRES_OD X Y)
        sprintf(RULE_COMMENT strcat(
            "RES.3_OD  The sheet resistance in SPICE model of non-salicided N+/P+ PO/OD resistors is"
            "resulted from N2V/NP and P2V/PP combinations, respectively. To obtain precise resistance,"
            "dummy layers (DMN2V & DMP2V) are required.N2V/P2V/N3V/P3V/N5V/P5V are derived from logical operation,"
            "please ensure correct implants in caes the rsistor traverses NW/PW,1.8V/3.3V,1.8V/5V, 1.5V/3.3V or 1.5V/2.5V."
            "Min. and Max. Extension of DMN2V/DMP2V to Poly resistor on field oxide should be == 0.22um."
        )     )    
        errorLayer(geomAndNot(geomButtOrOver(ODRES PP) DMP2V) RULE_COMMENT)
        errorLayer(geomAndNot(geomButtOrOver(ODRES NP) DMN2V) RULE_COMMENT)
        errorLayer(geomAnd(geomAnd(DMP2V DMN2V) ODRES) RULE_COMMENT)
        ODRES_OD=geomButtOrOver(OD ODRES)  
        drc(DMP2V ODRES_OD enc<0.22 shielded withIntersection withSingularPoint RULE_COMMENT)
        drc(DMN2V ODRES_OD enc<0.22 shielded withIntersection withSingularPoint RULE_COMMENT)
        X=geomSize(geomStretch(geomButtOrOver(DMPN2V ODRES) -0.005) -0.005 edges)  
        Y=geomSize(geomOr(geomGetEdge(DMPN2V coincident geomAndNot(X geomButtOrOver(X ODRES_OD)) wholeEdge) geomGetEdge(DMPN2V butting geomAndNot(X geomButtOrOver(X ODRES_OD))  wholeEdge)) -0.22 edges)  
        errorLayer(geomAndNot(Y geomButtOnly(geomOutside(Y ODRES) ODRES)) RULE_COMMENT)
    )

    let( /* RES.4_PO */ (RULE_COMMENT PO_RES CO_RES RPO_E RPO_EX)
        sprintf(RULE_COMMENT "RES.4_PO  Min. and Max. clearance from RPO to a contact on the poly resistor and OD resistor = 0.22um" )    
        PO_RES=geomButtOrOver(POLY PORES)  
        CO_RES=geomButtOrOver(CO PO_RES)  
        RPO_E=geomGetEdge(RPO inside PO_RES)  
        RPO_EX=geomSize(RPO_E 0.22 edges)  
        errorLayer(geomAnd(RPO_EX CO_RES) RULE_COMMENT)
        errorLayer(geomAndNot(RPO_EX geomButtOrOver(RPO_EX CO_RES)) RULE_COMMENT)
        errorLayer(geomAndNot(CO_RES geomButtOrOver(CO_RES RPO_EX)) RULE_COMMENT)
    )

    let( /* RES.4_OD */ (RULE_COMMENT OD_RES CO_RES RPO_E RPO_EX)
        sprintf(RULE_COMMENT "RES.4_OD  Min. and Max. clearance from RPO to a contact on the poly resistor and OD resistor ==0.22um" )    
        OD_RES=geomButtOrOver(OD ODRES)  
        CO_RES=geomButtOrOver(CO OD_RES)  
        RPO_E=geomGetEdge(RPO inside OD_RES)  
        RPO_EX=geomSize(RPO_E 0.22 edges)  
        errorLayer(geomAnd(RPO_EX CO_RES) RULE_COMMENT)
        errorLayer(geomAndNot(RPO_EX geomButtOrOver(RPO_EX CO_RES)) RULE_COMMENT)
        errorLayer(geomAndNot(CO_RES geomButtOrOver(CO_RES RPO_EX)) RULE_COMMENT)
    )

    let( /* RES.5_PO */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "RES.5_PO  Min. clearance from poly resistor and OD resistor to un-related NP, PP regions >= 0.26um" )    
        drc(PORES IMP sep<0.26 withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* RES.5_OD */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "RES.5_OD  Min. clearance from poly resistor and OD resistor to un-related NP, PP regions >= 0.26um" )    
        drc(ODRES IMP sep<0.26 withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* RES.6_PO */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "RES.6_PO  Minimum clearance from an un-related RPO to the POLY and OD  resistor>= 0.3um" )    
        drc(PORES RPO sep<0.3 withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* RES.6_OD */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "RES.6_OD  Minimum clearance from an un-related RPO to the POLY and OD resistor>= 0.3um" )    
        drc(ODRES RPO sep<0.3 withIntersection withSingularPoint RULE_COMMENT)
    )

    ;;  RES.7 is checked by RES.4 
    let( /* RES.8 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "RES.8  To use rectangle shape resistor for SPICE simulation accuracy." )    
        errorLayer(geomAndNot(PORESC geomGetRectangle(PORESC allWithTolerance=1.0 swap)) RULE_COMMENT)
        errorLayer(geomAndNot(geomAndNot(ODRES geomGetRectangle(ODRES allWithTolerance=1.0 swap)) SEALRING) RULE_COMMENT)
    )

)
let( /* RES.9 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "RES.9  DMN2V overlap DMP2V not allowed" )    
    errorLayer(geomAnd(DMP2V DMN2V) RULE_COMMENT)
)

let( /* RES.10 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "RES.10  Minimum clearence from DMN2V to GATE(overlap is not allowed) >=0.35um" )    
    drc(DMN2V ALL_GATE sep<0.35 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DMN2V ALL_GATE) RULE_COMMENT)
)

let( /* RES.11 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "RES.11  Minimum clearence from DMP2V to GATE(overlap is not allowed) >=0.35um" )    
    drc(DMP2V ALL_GATE sep<0.35 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DMP2V ALL_GATE) RULE_COMMENT)
)

if(Recommend==1 then
    ODRESC=geomAndNot(geomAndNot(ODRES geomButtOrOver(ODRES RLPPDMY)) SEALRING)  
    ODRESC_L=geomOr(geomSize(geomAndNot(ODRESC geomGetEdge(ODRESC inside OD) edges) 0.001 chainEdges) geomSize(geomAndNot(ODRESC geomGetEdge(ODRESC inside OD) edges) -0.001 chainEdges))  
    ODRESC_W=geomOr(geomSize(geomGetEdge(ODRESC inside OD) 0.001 edges) geomSize(geomGetEdge(ODRESC inside OD) -0.001 edges))  
    geomConnect(incremental buttOrOver(ODRESC_L ODRESC_W))
    let( /* RES.12 */ (RULE_COMMENT ERR__1)
        sprintf(RULE_COMMENT strcat(
            "RES.12  For OD resistor, it is strongly recommended that the resistor width>= %f um and the resistor square number Nsq >= %f."
            "DRC will check the width and Nsq 1um and 5 for poly resistor & 2um and 5 for OD resistor"
        ) RES_12_W RES_12_Nsq )    
        drc(ODRESC width<RES_12_W shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
        processAntenna(
            gate((ODRESC_W ODRESC_W))
            antenna(ODRESC_L)
            ratio = ODRESC_L.area/ODRESC_W.area
            ERR__1=drcAntenna(ODRESC_L (ODRESC_L) ratio keep<RES_12_Nsq suppressErrorMessage)
        )
        ERR__1=geomOr(geomOr(ERR__1_ODRESC_L) geomNodeRelate(ODRESC_L ODRESC_W disc))
        errorLayer(ERR__1 RULE_COMMENT)
    )

    if(VOLTAGE_5V==1 then
        let( /* RES.14 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "RES.14  Minimum clearance from poly resistor to od edge >= %f" RES_14)    
            drc(PORESC OD sep<RES_14 shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )

)

let( /* RES.13 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "RES.13  Minimum clearance from poly resistor to OD edge >= %f" RES_13)    
    drc(PORESC OD sep<RES_13 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* RES.15 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "RES.15  Poly resistor cuts NW is not allowed." )    
    errorLayer(geomStraddle(PORESC NWEL) RULE_COMMENT)
)

if(MIX_MODE==1 then
    HREPC=geomButtOrOver(HREP RLPPDMY)  
    if(Recommend==1 then
        HREP_L=geomOr(geomSize(geomAndNot(HREPC geomGetEdge(HREPC inside POLY) edges) 0.001 chainEdges) geomSize(geomAndNot(HREPC geomGetEdge(HREPC inside POLY) edges) -0.001 chainEdges))  
        HREP_W=geomOr(geomSize(geomGetEdge(HREPC inside POLY) 0.001 edges) geomSize(geomGetEdge(HREPC inside POLY) -0.001 edges))  
        geomConnect(incremental buttOrOver(HREP_L HREP_W))
        let( /* RES.HRI.1 */ (RULE_COMMENT ERR__1)
            sprintf(RULE_COMMENT "RES.HRI.1  It is strongly recommended that the HRI poly resistor width e 1.0 um and resistor number of square Nsq e 2." )    
            drc(HREPC width<1.0 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
            processAntenna(
                gate((HREP_W HREP_W))
                antenna(HREP_L)
                ratio = HREP_L.area/HREP_W.area
                ERR__1=drcAntenna(HREP_L (HREP_L) ratio keep<2.0 suppressErrorMessage)
            )
            ERR__1=geomOr(geomOr(ERR__1_HREP_L) geomNodeRelate(HREP_L HREP_W disc))
            errorLayer(ERR__1 RULE_COMMENT)
        )

        ;; RES.HRI.3 is checked by RES.5_PO 
        ;; RES.HRI.4 is checked by RES.6_PO 
        ;; RES.HRI.5 is checked by RES.4_PO 
        ;; RES.HRI.6 un-checkable by DRC 

        let( /* RES.HRI.7 */ (RULE_COMMENT PO_HREP)
            sprintf(RULE_COMMENT "RES.HRI.7  Min. clearance from RLPPDMY to the HRI poly resistor >= 0.26um" )    
            PO_HREP=geomButtOrOver(POLY HREP)  
            drc(RLPPDMY PO_HREP enc<0.26 shielded withIntersection withSingularPoint RULE_COMMENT)
        )

        let( /* RES.HRI.8 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "RES.HRI.8  To use rectangle shape HRI resistor for the SPICE simulation accuracy." )    
            errorLayer(geomAndNot(HREPC geomGetRectangle(HREPC allWithTolerance=1.0 swap)) RULE_COMMENT)
        )

        let( /* RES.HRI.9 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "RES.HRI.9  Min. clearance from HRI resistor to OD edge >= %f" RES_HRI_9)    
            drc(HREPC OD sep<RES_HRI_9 shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )
    let( /* RES.HRI.10 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "RES.HRI.10  HRI resistor cuts NW is not allowed." )    
        errorLayer(geomStraddle(HREPC NWEL) RULE_COMMENT)
    )

)

;;  PP CHECKS 
;; ============ 
PPE4_NWELC=geomSize(NWELi 0.43 noClipAcute)  
PPE4_NWELS=geomSize(PPE4_NWELC 0.18 noClipAcute)  
PPE4_OD=geomAnd(PTAP PPE4_NWELS)  
PPE4_C1=drc(PP PPE4_OD enc<0.18 0<withIntersection<90 opposite shielded)  
PPE4_C2=drc(PP PPE4_OD enc<0.18 0<withIntersection<90 corner shielded)  
PPE4_C3=drc(PP PPE4_OD 0 < enc < 0.18 shielded  app == 0 parallel withIntersection )
PPE4_C4=geomAndNot(geomSize(PPE4_C2 0.005 noClipAcute) PPE4_OD)  

PPE4_ALL=geomOr(geomOr(PPE4_C1 PPE4_C3) PPE4_C4)  
PPE4_CHECKOD=geomGetEdge(PPE4_ALL butting PPE4_OD)  

NPC3_C1=drc(PPE4_OD NP sep<0.18 0<withIntersection<90 opposite shielded)  
NPC3_C2=drc(PPE4_OD NP sep<0.18 0<withIntersection<90 corner shielded)  
NPC3_C3=drc(PPE4_OD NP sep<0.18 0<withIntersection<90 app==0 shielded)  
NPC3_C4=geomAndNot(geomSize(NPC3_C2 0.005 noClipAcute) PPE4_OD)  
NPC3_ALL=geomOr(geomOr(NPC3_C1 NPC3_C3) NPC3_C4)  
NPC3_CHECKOD=geomGetEdge(NPC3_ALL butting PPE4_OD)  

NPE4_NWELC=geomSize(NWELi (-0.43) noClipAcute)  
NPE4_NWELS=geomSize(NPE4_NWELC (-0.18) noClipAcute)  
NPE4_OD=geomAndNot(NTAP NPE4_NWELS)  
NPE4_C1=drc(NP NPE4_OD enc<0.18 0<withIntersection<90 opposite shielded)  
NPE4_C2=drc(NP NPE4_OD enc<0.18 0<withIntersection<90 corner shielded)  
NPE4_C3=drc(NP NPE4_OD 0 < enc < 0.18  shielded  app == 0 parallel withIntersection )
NPE4_C4=geomAndNot(geomSize(NPE4_C2 0.005 noClipAcute) NPE4_OD)  

NPE4_ALL=geomOr(geomOr(NPE4_C1 NPE4_C3) NPE4_C4)  
NPE4_CHECKOD=geomGetEdge(NPE4_ALL butting NPE4_OD)  

PPC3_C1=drc(NPE4_OD PP sep<0.18 0<withIntersection<90 opposite shielded)  
PPC3_C2=drc(NPE4_OD PP sep<0.18 0<withIntersection<90 corner shielded)  
PPC3_C3=drc(NPE4_OD PP sep<0.18 0<withIntersection<90 app==0 shielded)  
PPC3_C4=geomAndNot(geomSize(PPC3_C2 0.005 noClipAcute) NPE4_OD)  
PPC3_ALL=geomOr(geomOr(PPC3_C1 PPC3_C3) PPC3_C4)  
PPC3_CHECKOD=geomGetEdge(PPC3_ALL butting NPE4_OD)  

let( /* PP.W.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PP.W.1  PP width < %f" PP_W_1)    
    drc(PP width<PP_W_1 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
)

let( /* PP.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PP.S.1  PP space < %f" PP_S_1)    
    drc(PP 0<sepNotch<PP_S_1 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* PP.C.1 */ (RULE_COMMENT X Y)
    sprintf(RULE_COMMENT "PP.C.1  PP space to n active in pwell < %f" PP_C_1)    
    drc(PP NACT sep<PP_C_1 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    X=drc(PP NACT sep<0.001 withIntersection==0 edgeb shielded)  
    Y=geomSize(X 0.001 edges)  
    errorLayer(geomAndNot(Y geomButtOrOver(Y PPOD)) RULE_COMMENT)
)

let( /* PP.C.2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PP.C.2  PP space to non-butting NTAP < 0.1 with PWEL space >= 0.43" )    
    drc(PP NTAP sep<0.1 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
)

let( /* PP.C.3 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PP.C.3  PP space to non-butting NTAP < 0.18 with PWEL space < 0.43" )    
    errorLayer(geomGetEdge(PPC3_CHECKOD outside NPE4_NWELC) RULE_COMMENT)
)

let( /* PP.C.5 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PP.C.5  PP extension over (P gate) + (field poly within 0.35um) < %f um" PP_C_5)    
    errorLayer(geomAndNot(EXGATE_PP PP) RULE_COMMENT)
)

let( /* PP.O.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PP.O.1  Minimum overlap from a PP edge to an OD region must >= 0.230um except SBD region" )    
    drc(OD PP_NSBD ovlp<0.230 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
)

let( /* PP.E.1 */ (RULE_COMMENT Y Z)
    sprintf(RULE_COMMENT strcat(
        "PP.E.1  Minimum extension of a PP region beyond a P+ active OD region must >= %f um"
        "except SBD and SEALRING region"
    ) PP_E_1 )    
    errorLayer(geomAndNot(drc(PP_NSBD PACT enc<PP_E_1 0<withIntersection<90 shielded withSingularPoint) geomButtOrOver(drc(PP_NSBD PACT enc<PP_E_1 0<withIntersection<90 shielded withSingularPoint) SEALRING)) RULE_COMMENT)
    Y=drc(PP_NSBD PACT enc<0.001 withIntersection==0 edgeb shielded)  
    Z=geomSize(Y 0.001 edges)  
    errorLayer(geomAndNot(geomAndNot(Z geomButtOrOver(Z NPOD)) geomButtOrOver(geomAndNot(Z geomButtOrOver(Z NPOD)) SEALRING)) RULE_COMMENT)
)

let( /* PP.E.1_NP.E.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PP.E.1_NP.E.1  Implant can not coincident OD edge except butted diffusion" )    
    errorLayer(geomGetEdge(IMP coincident OD) RULE_COMMENT)
)

let( /* PP.E.3 */ (RULE_COMMENT X Y)
    sprintf(RULE_COMMENT "PP.E.3  Minimum enclosure of PTAP by PP < 0.02 with NWEL space >= 0.43 except SEALRING region" )    
    errorLayer(geomAndNot(drc(PP PTAP enc<0.02 0<withIntersection<90 shielded withSingularPoint) geomButtOrOver(drc(PP PTAP enc<0.02 0<withIntersection<90 shielded withSingularPoint) SEALRING)) RULE_COMMENT)
    X=drc(PP PTAP enc<0.001 withIntersection==0 edgeb shielded)  
    Y=geomSize(X 0.001 edges)  
    errorLayer(geomAndNot(geomAndNot(Y geomButtOrOver(Y NPOD)) geomButtOrOver(geomAndNot(Y geomButtOrOver(Y NPOD)) SEALRING)) RULE_COMMENT)
)

let( /* PP.E.4 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PP.E.4  Min. enc. of PTAP by PP < 0.18 with NWEL space < 0.43" )    
    errorLayer(geomGetEdge(PPE4_CHECKOD inside PPE4_NWELC) RULE_COMMENT)
)

;;  PP.E.5 is not necessary to check 
let( /* PP.A.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PP.A.1  Minimum area of PP < 0.3844" )    
    drc(PP area<0.3844 RULE_COMMENT) 
)

if(MIX_MODE==0 then
    let( /* PP.E.6 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "PP.E.6  Min enc of POLY resistor by PP < %f" PP_E_6)    
        drc(PP PORES enc<PP_E_6 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomAndNot(geomAndNot(geomAnd(RPO POLY) IMP) HRI) RULE_COMMENT)
    )

)

let( /* PP.R.1_NP.R.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PP.R.1_NP.R.1  PP and NP not allowed to overlap" )    
    errorLayer(geomAnd(PP NP) RULE_COMMENT)
)

;;  PP.R.2 is not necessary to check 
let( /* PP.R.3_NP.R.3 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "PP.R.3_NP.R.3  OD must be fully covered by PP and NP ,except OD without interacting CO OR PO" )    
    errorLayer(geomAndNot(geomAndNot(geomAndNot(geomButtOrOver(OD POLYi) ODWR) SBDDMY) IMP) RULE_COMMENT)
    errorLayer(geomAndNot(geomAndNot(geomAndNot(geomButtOrOver(OD COi) ODWR) SBDDMY) IMP) RULE_COMMENT)
)

;;  NP CHECKS 
;; ============ 
let( /* NP.W.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NP.W.1  NP width < %f" NP_W_1)    
    drc(NP width<NP_W_1 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
)

let( /* NP.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NP.S.1  NP space < %f" NP_S_1)    
    drc(NP 0<sepNotch<NP_S_1 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* NP.C.1 */ (RULE_COMMENT X Y)
    sprintf(RULE_COMMENT "NP.C.1  NP space to p active in NWEL < %f" NP_C_1)    
    drc(NP PACT sep<NP_C_1 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    X=drc(NP PACT sep<0.001 withIntersection==0 edgeb shielded)  
    Y=geomSize(X 0.001 edges)  
    errorLayer(geomAndNot(Y geomButtOrOver(Y NPOD)) RULE_COMMENT)
)

let( /* NP.C.2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NP.C.2  NP space to non-butting ptap < 0.1 with NWEL space >= 0.43" )    
    drc(NP PTAP sep<0.1 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
)

let( /* NP.C.3 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NP.C.3  NP space to non-butting ptap < 0.18 with NWEL space < 0.43" )    
    errorLayer(geomGetEdge(NPC3_CHECKOD inside PPE4_NWELC) RULE_COMMENT)
)

let( /* NP.C.5 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NP.C.5  NP extension over (N gate) + (field poly within 0.35um) < %f um" NP_C_5)    
    errorLayer(geomAndNot(EXGATE_NP NP) RULE_COMMENT)
)

let( /* NP.O.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NP.O.1  NP extends into n active < 0.230" )    
    drc(OD NP ovlp<0.230 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
)

let( /* NP.E.1 */ (RULE_COMMENT X Y Z)
    sprintf(RULE_COMMENT "NP.E.1  NP olap OD < %f except SEALRING region" NP_E_1)    
    X=geomAndNot(NACT ODWR)  
    errorLayer(geomAndNot(drc(NP X enc<NP_E_1 0<withIntersection<90 shielded withSingularPoint) geomButtOrOver(drc(NP X enc<NP_E_1 0<withIntersection<90 shielded withSingularPoint) SEALRING)) RULE_COMMENT)
    Y=drc(NP X enc<0.001 withIntersection==0 edgeb shielded)  
    Z=geomSize(Y 0.001 edges)  
    errorLayer(geomAndNot(geomAndNot(Z geomButtOrOver(Z PPOD)) geomButtOrOver(geomAndNot(Z geomButtOrOver(Z PPOD)) SEALRING)) RULE_COMMENT)
)

let( /* NP.E.3 */ (RULE_COMMENT X Y)
    sprintf(RULE_COMMENT "NP.E.3  Minimum enclosure of NTAP by NP < 0.02 with PWEL space >= 0.43" )    
    drc(NP NTAP enc<0.02 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    X=drc(NP NTAP enc<0.001 withIntersection==0 edgeb shielded)  
    Y=geomSize(X 0.001 edges)  
    errorLayer(geomAndNot(Y geomButtOrOver(Y PPOD)) RULE_COMMENT)
)

let( /* NP.E.4 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NP.E.4  Min. enc. of NTAP by NP < 0.18 with PWEL space < 0.43" )    
    errorLayer(geomGetEdge(NPE4_CHECKOD outside NPE4_NWELC) RULE_COMMENT)
)

;;  NP.E.5 is not checked by drc 
let( /* NP.A.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NP.A.1  Minimum area of NP < 0.3844" )    
    drc(NP area<0.3844 RULE_COMMENT) 
)

let( /* NP.E.6 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NP.E.6  Min enc of POLY resistor by NP < 0.18" )    
    drc(NP PORES enc<0.18 shielded withIntersection withSingularPoint RULE_COMMENT)
)

;;  RPO checks 
;; =========== 
CB_HOLE=geomHoles(CB)  

CB_SR=geomButtOnly(geomOutside(CB CB_HOLE) CB_HOLE keep==1)  
RPO_NOT_SR=geomAndNot(RPO geomButtOrOver(RPO CB_SR))  

let( /* RPO.W.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "RPO.W.1  Minimum RPO width < 0.43" )    
    drc(RPO width<0.43 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
)

let( /* RPO.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "RPO.S.1  Minimum RPO space < %f" RPO_S_1)    
    drc(RPO 0<sepNotch<RPO_S_1 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* RPO.C.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "RPO.C.1  Minimum RPO space to OD < 0.22" )    
    drc(RPO OD sep<0.22 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* RPO.C.2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "RPO.C.2  Minimum RPO space to CO < %f" RPO_C_2)    
    drc(RPO CO sep<RPO_C_2 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(CO RPO) RULE_COMMENT)
)

let( /* RPO.C.3 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT strcat(
        "RPO.C.3  Minimum RPO space to gate < 0.45"
        "exclude ESD part"
    )  )    
    A=geomAndNot(geomAndNot(geomAndNot(geomAndNot(geomAndNot(ALL_GATE DRCDMY) ESD1DMY) ESD2DMY) ESD3DMY) SDI)  
    drc(RPO A sep<0.45 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(RPO A) RULE_COMMENT)
)

let( /* RPO.C.4 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "RPO.C.4  Minimum RPO overhang OD < 0.22" )    
    errorLayer(geomAndNot(drc(RPO OD enc<0.22 shielded withIntersection withSingularPoint) geomButtOrOver(drc(RPO OD enc<0.22 shielded withIntersection withSingularPoint) SEALRING)) RULE_COMMENT)
    errorLayer(geomInside(RPO_NOT_SR OD) RULE_COMMENT)
)

let( /* RPO.E.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "RPO.E.1  Minimum OD overhang RPO < 0.22" )    
    errorLayer(geomAndNot(drc(OD RPO enc<0.22 shielded withIntersection withSingularPoint) geomButtOrOver(drc(OD RPO enc<0.22 shielded withIntersection withSingularPoint) SEALRING)) RULE_COMMENT)
)

let( /* RPO.C.5 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "RPO.C.5  Minimum RPO overhang POLY < 0.22" )    
    drc(RPO POLY enc<0.22 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomInside(RPO_NOT_SR POLY) RULE_COMMENT)
)

let( /* RPO.C.6 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "RPO.C.6  Minimum clearance RPO to unrelated poly < 0.3um" )    
    drc(RPO POLY_ISO sep<0.30 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* RPO.A.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "RPO.A.1  RPO min. area < 2 um*um" )    
    drc(RPO area<2 RULE_COMMENT) 
)

;;  CO checks 
;; =============== 
let( /* CO.W.1 */ (RULE_COMMENT X)
    sprintf(RULE_COMMENT "CO.W.1  contact width != 0.22" )    
    X=geomAndNot(CO SR_CO)  
    errorLayer(geomAndNot(X geomGetRectangle(X length==0.22 width==0.22 swap)) RULE_COMMENT)
)

let( /* CO.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "CO.S.1  contact spacing < 0.25" )    
    drc(CO 0<sepNotch<0.25 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* CO.S.2 */ (RULE_COMMENT A B C D)
    sprintf(RULE_COMMENT "CO.S.2  Min space between two contacts in larger than 4x4 array." )    
    A=geomSize(geomSize(CO (0.30/2) noClipAcute) -(0.30/2) noClipAcute)  
    B=geomSize(geomSize(A -0.7 noClipAcute) 0.7 noClipAcute)  
    C=geomButtOrOver(B CO keep>=16)  
    D=geomButtOrOver(CO C)  
    drc(D sepNotch<0.28 edge shielded RULE_COMMENT)
)

let( /* CO.C.1_CO.R.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "CO.C.1_CO.R.1  diff contact to gate space < 0.16, or contact on gate" )    
    drc(CO_DIFF ALL_GATE sep<0.16 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(CO_DIFF ALL_GATE) RULE_COMMENT)
)

let( /* CO.C.2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "CO.C.2  poly contact space to OD < 0.20" )    
    drc(CO_POLY OD sep<0.20 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* CO.E.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "CO.E.1  active olap contact < 0.10, also floating contacts" )    
    drc(OD CO_DIFF enc<0.10 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomGetEdge(CO_DIFF outside OD) RULE_COMMENT)
)

let( /* CO.E.2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "CO.E.2  poly olap contact < 0.10" )    
    drc(POLY_ISO CO_POLY enc<0.10 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomStraddle(CO_POLY POLY_ISO) RULE_COMMENT)
)

let( /* CO.E.3 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "CO.E.3  Minimum extension of a PP region beyond a OD CO region must >= %f um except SBD region" CO_E_3)    
    drc(PP_NSBD CO_DIFF enc<CO_E_3 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomGetEdge(PP_NSBD inside CO_DIFF) RULE_COMMENT)
)

let( /* CO.E.4 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "CO.E.4  implant olap contact < %f" CO_E_4)    
    drc(NP CO_DIFF enc<CO_E_4 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomGetEdge(NP inside CO_DIFF) RULE_COMMENT)
)

;;  CO.R.3 is checked by RPO.C.2 

;;  M1 checks 
;; ============= 
let( /* M1.W.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M1.W.1  Min. M1 width < 0.23" )    
    drc(M1 width<0.23 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
)

let( /* M1.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M1.S.1  Min. M1 space < 0.23" )    
    drc(M1 0<sepNotch<0.23 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* M1.S.2 */ (RULE_COMMENT M1_S5 M1_G5 M1_Wide M1_Exp M1_Branch M1_Branch_edge M1_Check M1_Branch_Check)
    sprintf(RULE_COMMENT "M1.S.2  Min. space to wide M1 (>10um) < %f" M1_S_2)    
    M1_S5=geomGrow(M1 (-5) (-5) (-5) (-5))     
    M1_G5=geomGrow(M1_S5 5 5 5 5)     
    M1_Wide=geomAnd(M1_G5 M1)  
    M1_Exp=geomSizeAnd(M1_Wide M1 0.161 1 noClipAcute)  
    M1_Branch=geomAndNot(M1_Exp M1_Wide)  
    M1_Branch_edge=geomGetEdge(M1_Branch coincident M1)  
    M1_Check=geomAnd(M1 geomSize(M1_Exp M1_S_2 noClipAcute))  
    M1_Branch_Check=geomAnd(M1 geomSize(M1_Branch_edge M1_S_2 chainEdges))  
    M1_WideC=geomCat(M1_Wide)
    geomStamp(M1_WideC M1xd)
    M1_CheckC=geomCat(M1_Check)
    geomStamp(M1_CheckC M1xd)
    M1_BranchC=geomCat(M1_Branch)
    geomStamp(M1_BranchC M1xd)
    M1_Branch_CheckC=geomCat(M1_Branch_Check)
    geomStamp(M1_Branch_CheckC M1xd)
    drc(M1_WideC M1_CheckC sep<M1_S_2 0<withIntersection<90 diffNet shielded RULE_COMMENT)
    drc(M1_BranchC M1_Branch_CheckC sep<M1_S_2 0<withIntersection<90 diffNet shielded RULE_COMMENT)
)

let( /* M1.E.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M1.E.1  Min. extension of a M1 region beyond a CO region < 0.005" )    
    drc(M1 CO enc<0.005 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAndNot(CO M1) RULE_COMMENT)
)

let( /* M1.E.2 */ (RULE_COMMENT X)
    sprintf(RULE_COMMENT "M1.E.2  Min. extension of M1 end-of-line region beyond CO region < 0.06" )    
    X=drc(M1 CO enc<0.06 edgeb oppositeB shielded withIntersection)  
    drc(geomGetEdge(X coincident geomGetVertex(geomSize(X -0.001 edges) keep >4)) width<0.22  edge only_perp shielded RULE_COMMENT)  
)

let( /* M1.A.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M1.A.1  Min. M1 area < %f" M1_A_1)    
    drc(M1_A area<M1_A_1 RULE_COMMENT) 
)

;;  Density check M1.R.1 included at the end of this file 

;;  VIA1 checks 
;; ============= 
VIA1_CORE=geomAndNot(VIA1 SR_VIA1)  
let( /* VIA1.W.1 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT "VIA1.W.1  VIA1 must be 0.26 x 0.26" )    
    A=geomAndNot(VIA1_CORE geomGetRectangle(VIA1_CORE length==0.26 width==0.26 swap))  
    errorLayer(geomOutside(A RNGX) RULE_COMMENT)
)

let( /* VIA1.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "VIA1.S.1  Min. VIA1 space < 0.26" )    
    drc(VIA1 0<sepNotch<0.26 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* VIA1.E.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "VIA1.E.1  Min. extension of a M1 region beyond a VIA1 region < 0.01" )    
    drc(M1 VIA1 enc<0.01 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAndNot(VIA1 M1) RULE_COMMENT)
)

let( /* VIA1.E.2 */ (RULE_COMMENT X)
    sprintf(RULE_COMMENT "VIA1.E.2  Min. extension of M1 end-of-line region beyond VIA1 region < 0.06" )    
    X=drc(M1 VIA1 enc<0.06 edgeb oppositeB shielded withIntersection)  
    drc(geomGetEdge(X coincident geomGetVertex(geomSize(X -0.001 edges) keep >4)) width<0.26  edge only_perp shielded RULE_COMMENT)  
)

;;  M2 checks 
;; ============= 
let( /* M2.W.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M2.W.1  Min. M2 width < 0.28" )    
    drc(M2 width<0.28 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
)

let( /* M2.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M2.S.1  Min. M2 space < 0.28" )    
    drc(M2 0<sepNotch<0.28 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* M2.S.2 */ (RULE_COMMENT M2_S5 M2_G5 M2_Wide M2_Exp M2_Branch M2_Branch_edge M2_Check M2_Branch_Check)
    sprintf(RULE_COMMENT "M2.S.2  Min. space to wide M2 (>10um) < 0.6" )    
    M2_S5=geomGrow(M2 (-5) (-5) (-5) (-5))     
    M2_G5=geomGrow(M2_S5 5 5 5 5)     
    M2_Wide=geomAnd(M2_G5 M2)  
    M2_Exp=geomSizeAnd(M2_Wide M2 0.196 1 noClipAcute)  
    M2_Branch=geomAndNot(M2_Exp M2_Wide)  
    M2_Branch_edge=geomGetEdge(M2_Branch coincident M2)  
    M2_Check=geomAnd(M2 geomSize(M2_Exp 0.6 noClipAcute))  
    M2_Branch_Check=geomAnd(M2 geomSize(M2_Branch_edge 0.6 chainEdges))  
    M2_WideC=geomCat(M2_Wide)
    geomStamp(M2_WideC M2xd)
    M2_CheckC=geomCat(M2_Check)
    geomStamp(M2_CheckC M2xd)
    M2_BranchC=geomCat(M2_Branch)
    geomStamp(M2_BranchC M2xd)
    M2_Branch_CheckC=geomCat(M2_Branch_Check)
    geomStamp(M2_Branch_CheckC M2xd)
    drc(M2_WideC M2_CheckC sep<0.6 0<withIntersection<90 diffNet shielded RULE_COMMENT)
    drc(M2_BranchC M2_Branch_CheckC sep<0.6 0<withIntersection<90 diffNet shielded RULE_COMMENT)
)

let( /* M2.E.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M2.E.1  Min. extension of a M2 region beyond a VIA1 region < 0.01" )    
    drc(M2 VIA1 enc<0.01 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAndNot(VIA1 M2) RULE_COMMENT)
)

let( /* M2.E.2 */ (RULE_COMMENT X)
    sprintf(RULE_COMMENT "M2.E.2  Min. extension of M2 end-of-line region beyond VIA1 region < 0.06" )    
    X=drc(M2 VIA1 enc<0.06 edgeb oppositeB shielded withIntersection)  
    drc(geomGetEdge(X coincident geomGetVertex(geomSize(X -0.001 edges) keep >4)) width<0.26  edge only_perp shielded RULE_COMMENT)  
)

let( /* M2.A.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M2.A.1  Min M2 area region < %f" Mx_A_1)    
    drc(M2 area<Mx_A_1 RULE_COMMENT) 
)

;;  Density check M2.R.1 included at the end of this file 

;;  VIA2 checks 
;; ============= 
VIA2_CORE=geomAndNot(VIA2 SR_VIA2)  
let( /* VIA2.W.1 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT "VIA2.W.1  VIA2 must be 0.26 x 0.26" )    
    A=geomAndNot(VIA2_CORE geomGetRectangle(VIA2_CORE length==0.26 width==0.26 swap))  
    errorLayer(geomOutside(A RNGX) RULE_COMMENT)
)

let( /* VIA2.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "VIA2.S.1  Min. VIA2 space < 0.26" )    
    drc(VIA2 0<sepNotch<0.26 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* VIA2.E.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "VIA2.E.1  Min. extension of a M2 region beyond a VIA2 region < 0.01" )    
    drc(M2 VIA2 enc<0.01 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAndNot(VIA2 M2) RULE_COMMENT)
)

let( /* VIA2.E.2 */ (RULE_COMMENT X)
    sprintf(RULE_COMMENT "VIA2.E.2  Min. extension of M2 end-of-line region beyond VIA2 region < 0.06" )    
    X=drc(M2 VIA2 enc<0.06 edgeb oppositeB shielded withIntersection)  
    drc(geomGetEdge(X coincident geomGetVertex(geomSize(X -0.001 edges) keep >4)) width<0.26  edge only_perp shielded RULE_COMMENT)  
)

if(Recommend==1 then
    let( /* VIA2.E.3 */ (RULE_COMMENT X)
        sprintf(RULE_COMMENT "VIA2.E.3  Minimum extension of M2 beyond the overlap area that VIA2 and VIA1 are fully or partially touching < %f" VIA2_E_3)    
        X=geomAnd(VIA2 VIA1)  
        drc(M2 X enc<VIA2_E_3 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

)

;;  M3 checks 
;; ============= 
let( /* M3.W.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M3.W.1  Min. M3 width < 0.28" )    
    drc(M3 width<0.28 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
)

let( /* M3.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M3.S.1  Min. M3 space < 0.28" )    
    drc(M3 0<sepNotch<0.28 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* M3.S.2 */ (RULE_COMMENT M3_S5 M3_G5 M3_Wide M3_Exp M3_Branch M3_Branch_edge M3_Check M3_Branch_Check)
    sprintf(RULE_COMMENT "M3.S.2  Min. space to wide M3 (>10um) < 0.6" )    

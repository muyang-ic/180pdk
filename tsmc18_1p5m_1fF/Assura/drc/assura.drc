  LUPWDMY =layer(255 type(1))	;;  DRC dummy layer to waive Latch-Up rules for verified IP.  
  SBDDMY  =layer(144 type(0))	;; A layer for DRC,LVS and creating mask logic operation Use "SBDDMY" to fully cover schottky barrier diode.  
  RFDUMMY =layer(160 type(1))	;;  recognize RF dummy layer for LVS purpose.  
  RES200  =layer(255 type(9))	;;  dummy layer to recognize 200 ohm or above resistor  
  MATCHING=layer(182 type(11))	;;  dummy layer to enable pair check  
  VDDDMY  =layer(255 type(4))	 
  VSSDMY  =layer(255 type(5))	 
  TSVi    =layer(251)	;;  TSV region define layer.  
  DM1EXCL =layer(150 type(1))	 
  DM2EXCL =layer(150 type(2))	 
  DM3EXCL =layer(150 type(3))	 
  DM4EXCL =layer(150 type(4))	 
  DM5EXCL =layer(150 type(5))	 
  DMDEXCL =layer(150 type(15))	 
  LAYER_40=text(40)	 
  LAYER_41=text(41)	 
  LAYER_42=text(42)	 
  LAYER_43=text(43)	 
  LAYER_44=text(44)	 
  CHIP    =cellBoundary(root)   
)

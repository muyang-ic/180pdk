VIA3_CORE=geomAndNot(VIA3 SR_VIA3)  
let( /* VIA3.W.1 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT "VIA3.W.1  VIA3 must be 0.26 x 0.26" )    
    A=geomAndNot(VIA3_CORE geomGetRectangle(VIA3_CORE length==0.26 width==0.26 swap))  

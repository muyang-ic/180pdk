        A2=drcAntenna(VIA2_Violate_S_3_A2 (VIA2_Violate_S_3_A2) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A2=geomOr(A2_VIA2_Violate_S_3_A2)
    processAntenna(
        gate((VIA2_3stack_Final VIA2_3stack_Final))
        antenna(VIA3_Violate_S_3_A2)
        ratio = VIA3_Violate_S_3_A2.area/VIA2_3stack_Final.area
        A3=drcAntenna(VIA3_Violate_S_3_A2 (VIA3_Violate_S_3_A2) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A3=geomOr(A3_VIA3_Violate_S_3_A2)
    processAntenna(
        gate((VIA2_3stack_Final VIA2_3stack_Final))
        antenna(VIA4_Violate_S_3_A2)
        ratio = VIA4_Violate_S_3_A2.area/VIA2_3stack_Final.area
        A4=drcAntenna(VIA4_Violate_S_3_A2 (VIA4_Violate_S_3_A2) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A4=geomOr(A4_VIA4_Violate_S_3_A2)
    B2=geomOr(geomOr(A2 A3) A4)  
    errorLayer(geomSize(geomSize(B2 VIA_Merge noClipAcute) -VIA_Merge noClipAcute) RULE_COMMENT)
)

;; ********************** 
;;  Small 2 stack array 
;; ********************** 
;;  Processing for SAME Array Size Check 
;; ************************************** 

;;  Rule Check 
;; ************************************** 

let( /* VIA1.S.5_Array1_2_M */ (RULE_COMMENT B1)
    sprintf(RULE_COMMENT strcat(
        "VIA1.S.5_Array1_2_M  Minimum space between two VIAs in 2-level continuous stacking VIA arrays with below condition >=0.49um"
        "Via1 violate VIA_S_3 spacing in Via1/Via2 array & density large or equal %f"
    )  VIA_D_1)    
    processAntenna(
        gate((VIA1_2stack_Final VIA1_2stack_Final))
        antenna(VIA1_Violate_S_2_A1)
        ratio = VIA1_Violate_S_2_A1.area/VIA1_2stack_Final.area
        A1=drcAntenna(VIA1_Violate_S_2_A1 (VIA1_Violate_S_2_A1) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A1=geomOr(A1_VIA1_Violate_S_2_A1)
    processAntenna(
        gate((VIA1_2stack_Final VIA1_2stack_Final))
        antenna(VIA2_Violate_S_2_A1)
        ratio = VIA2_Violate_S_2_A1.area/VIA1_2stack_Final.area
        A2=drcAntenna(VIA2_Violate_S_2_A1 (VIA2_Violate_S_2_A1) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A2=geomOr(A2_VIA2_Violate_S_2_A1)
    B1=geomOr(A1 A2)  
    errorLayer(geomSize(geomSize(B1 VIA_Merge noClipAcute) -VIA_Merge noClipAcute) RULE_COMMENT)
)

let( /* VIA2.S.5_Array2_3_M */ (RULE_COMMENT B2)
    sprintf(RULE_COMMENT strcat(
        "VIA2.S.5_Array2_3_M  Minimum space between two VIAs in 2-level continuous stacking VIA arrays with below condition >=0.49um"
        "Via2 violate VIA_S_3 spacing in Via2/Via3 array & density large or equal %f"
    )  VIA_D_1)    
    processAntenna(
        gate((VIA2_2stack_Final VIA2_2stack_Final))
        antenna(VIA2_Violate_S_2_A2)
        ratio = VIA2_Violate_S_2_A2.area/VIA2_2stack_Final.area
        A2=drcAntenna(VIA2_Violate_S_2_A2 (VIA2_Violate_S_2_A2) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A2=geomOr(A2_VIA2_Violate_S_2_A2)
    processAntenna(
        gate((VIA2_2stack_Final VIA2_2stack_Final))

if(DISCONNECT_ALL_RESISTOR==1 then
    NTAPiu=geomAndNot(NTAPk EMPTYi)  
    PTAPiu=geomAndNot(PTAPk EMPTYi)  

    NSDiu=geomAndNot(NSDk EMPTYi)  
    PSDiu=geomAndNot(PSDk EMPTYi)  
    CBiu=geomAndNot(CBk EMPTYi)  

    UBMniu=geomAndNot(UBMnk EMPTYi)  
    UBMdiu=geomAndNot(UBMdk EMPTYi)  

    PWR_M1iu_BY_TEXT=geomGetTexted(M1k LAYER_40 "AVDDBG" "AVDDR" "AVDWELL" "VDWELL" "VD33APST" "VDD5V" "TAVD33" "VD33PST" "AVDD" "TAVDD" "TAVD33PST" "TAVDDPST" "AVD33B" "VDD" "AVD33G" "DVDD" "AVDDG" "AVDDB" "VDDG" "VDDPST" "VD33REF" "VD33" "AVD33R" "VDDSA")  
    GND_M1iu_BY_TEXT=geomGetTexted(M1k LAYER_40 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  
    PAD_M1iu_BY_TEXT=geomGetTexted(M1k LAYER_40 "*")  
    GND_M1iu_TEXT=geomGetTexted(geomTextShape(LAYER_40, 1.0) LAYER_40 "AVDDBG" "AVDDR" "AVDWELL" "VDWELL" "VD33APST" "VDD5V" "TAVD33" "VD33PST" "AVDD" "TAVDD" "TAVD33PST" "TAVDDPST" "AVD33B" "VDD" "AVD33G" "DVDD" "AVDDG" "AVDDB" "VDDG" "VDDPST" "VD33REF" "VD33" "AVD33R" "VDDSA")  
    PWR_M1iu_TEXT=geomGetTexted(geomTextShape(LAYER_40, 1.0) LAYER_40 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  

    PWR_M2iu_BY_TEXT=geomGetTexted(M2k LAYER_41 "AVDDBG" "AVDDR" "AVDWELL" "VDWELL" "VD33APST" "VDD5V" "TAVD33" "VD33PST" "AVDD" "TAVDD" "TAVD33PST" "TAVDDPST" "AVD33B" "VDD" "AVD33G" "DVDD" "AVDDG" "AVDDB" "VDDG" "VDDPST" "VD33REF" "VD33" "AVD33R" "VDDSA")  
    GND_M2iu_BY_TEXT=geomGetTexted(M2k LAYER_41 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  
    PAD_M2iu_BY_TEXT=geomGetTexted(M2k LAYER_41 "*")  

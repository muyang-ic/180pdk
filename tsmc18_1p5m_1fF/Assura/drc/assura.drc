    M3_Branch=geomAndNot(M3_Exp M3_Wide)  
    M3_Branch_edge=geomGetEdge(M3_Branch coincident M3)  
    M3_Check=geomAnd(M3 geomSize(M3_Exp 0.6 noClipAcute))  
    M3_Branch_Check=geomAnd(M3 geomSize(M3_Branch_edge 0.6 chainEdges))  
    M3_WideC=geomCat(M3_Wide)
    geomStamp(M3_WideC M3xd)
    M3_CheckC=geomCat(M3_Check)
    geomStamp(M3_CheckC M3xd)
    M3_BranchC=geomCat(M3_Branch)
    geomStamp(M3_BranchC M3xd)
    M3_Branch_CheckC=geomCat(M3_Branch_Check)
    geomStamp(M3_Branch_CheckC M3xd)
    drc(M3_WideC M3_CheckC sep<0.6 0<withIntersection<90 diffNet shielded RULE_COMMENT)
    drc(M3_BranchC M3_Branch_CheckC sep<0.6 0<withIntersection<90 diffNet shielded RULE_COMMENT)
)

let( /* M3.E.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M3.E.1  Min. extension of a M3 region beyond a VIA2 region < 0.01" )    
    drc(M3 VIA2 enc<0.01 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAndNot(VIA2 M3) RULE_COMMENT)
)

let( /* M3.E.2 */ (RULE_COMMENT X)
    sprintf(RULE_COMMENT "M3.E.2  Min. extension of M3 end-of-line region beyond VIA2 region < 0.06" )    
    X=drc(M3 VIA2 enc<0.06 edgeb oppositeB shielded withIntersection)  
    drc(geomGetEdge(X coincident geomGetVertex(geomSize(X -0.001 edges) keep >4)) width<0.26  edge only_perp shielded RULE_COMMENT)  
)

let( /* M3.A.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M3.A.1  Min M3 area region < %f" Mx_A_1)    
    drc(M3 area<Mx_A_1 RULE_COMMENT) 
)


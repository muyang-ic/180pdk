;;  NTN warning 
;; ====================================================================================== 

if(VOLTAGE_5V==1 then
    let( /* WARN.NTN_1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "WARN.NTN_1  NTN devices don't provide for 0.18um 1.8V/5V General purpose,Low Power and"
            "1.8V/3.3V Low Power process"
        )  )    
        errorLayer(geomCat(NTNi) RULE_COMMENT)
    )

)

if(LP==1 then
    if(VOLTAGE_3_3V==1 then
        let( /* WARN.NTN_2 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "WARN.NTN_2  NTN devices don't provide for 0.18um 1.8V/5V General purpose,Low Power and"
                "1.8V/3.3V Low Power process"
            )  )    
            errorLayer(geomCat(NTNi) RULE_COMMENT)
        )

    )

)

;;  NWEL CHECKS 
;; ============= 
HOT_NWEL=geomOr(geomAnd(NWEL HOTWL) RNWEL)  
NW_5V=geomAndNot(NWEL geomOutside(NWEL OD2))  
NW_1_8V=geomOutside(NWEL OD2)  

let( /* NW.W.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NW.W.1  Min. NWEL width < 0.86" )    
    drc(NWEL width<0.86 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
)

let( /* NW.W.2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NW.W.2  Min. HOT_NWEL width < 2.10" )    
    drc(HOT_NWEL width<2.10 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
)

let( /* NW.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NW.S.1  Min. different potential NWEL space < 1.40" )    
    NWEL_NODAL=geomCat(NWEL)
    geomStamp(NWEL_NODAL NWELi)
    drc(NWEL_NODAL 0<sep<1.40 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
    drc(RNWEL NWEL sep<1.40 shielded withIntersection withSingularPoint RULE_COMMENT)
    drc(RNWEL 0<sepNotch<1.40 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* NW.S.2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NW.S.2  Min. same potential NWEL space < 0.6" )    
    drc(NWEL 0<sepNotch<0.60 shielded withIntersection withSingularPoint RULE_COMMENT)
)

if(VOLTAGE_5V==1 then
    let( /* NW.S.3 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "NW.S.3  Min. space between 1.8V & 5V NW < %f" NW_S_3)    
        NW_1_8V_NODAL=geomCat(NW_1_8V)
        geomStamp(NW_1_8V_NODAL NWELi)
        NW_5V_NODAL=geomCat(NW_5V)
        geomStamp(NW_5V_NODAL NWELi)
        drc(NW_5V_NODAL NW_1_8V_NODAL sep<NW_S_3 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* NW.S.4 */ (RULE_COMMENT NW2V NW3V)
        sprintf(RULE_COMMENT "NW.S.4  Min. space between 5V NW with different potential, except two NW region fully covered with OD2 < %f" NW_S_4)    
        NW2V=geomAndNot(NW_5V OD2)  
        NW3V=geomAnd(NW_5V OD2)  
        NW2V_NODAL=geomCat(NW2V)
        geomStamp(NW2V_NODAL NWELi)
        NW3V_NODAL=geomCat(NW3V)
        geomStamp(NW3V_NODAL NWELi)
        drc(NW2V_NODAL 0<sep<NW_S_4 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
        drc(NW2V_NODAL NW3V_NODAL sep<NW_S_4 0<withIntersection<90 diffNet shielded withSingularPoint RULE_COMMENT)
    )

)

;;  NWEL (within OD) RESISTOR CHECKS 
;; ==================================== 

NWRES=geomButtOrOver(RNWEL RPO) ;;  NWEL resistor (UNDER OD)  
ODWR=geomButtOrOver(OD NWRES) ;;  OD area of NW resistor  
NPWR=geomButtOrOver(NP NWRES) ;;  N+ implant on NW resistor terminals  
COWR=geomButtOrOver(CO_DIFF NWRES) ;;  Contact on NW resistor terminals  
RHWR=geomAndNot(ODWR RPO) ;;  Non-Salicided area of NW resistor  
RPONWR_H=geomHoles(RPO innermost)  

let( /* NWR.E.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NWR.E.1  Min. OD enclose NWEL resistor < 1.0" )    
    drc(ODWR NWRES enc<1.0 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomStraddle(NWRES ODWR) RULE_COMMENT)
)

let( /* NWR.E.2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NWR.E.2  Min. NWEL resistor enclose CO < 0.3" )    
    drc(NWRES COWR enc<0.3 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomStraddle(COWR NWRES) RULE_COMMENT)
)

let( /* NWR.C.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NWR.C.1  Min. RPO hole enclose NWEL < 0.3" )    
    drc(RHWR NWRES enc<0.3 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* NWR.C.2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NWR.C.2  Min. RPO enclose OD (with NWEL resistor) < 0.22" )    
    drc(RPO ODWR enc<0.22 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* NWR.C.3 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NWR.C.3  Min. RPO hole enclose NWEL resistor CO < 0.3" )    
    drc(RHWR COWR enc<0.3 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomStraddle(COWR RHWR) RULE_COMMENT)
)

let( /* NWR.O.1 */ (RULE_COMMENT X H)
    sprintf(RULE_COMMENT "NWR.O.1  Min. RPO overlap NP < 0.4" )    
    drc(NPWR RPO ovlp<0.4 shielded withIntersection withSingularPoint RULE_COMMENT)
    X=geomButtOrOver(RPO NWRES)  
    H=geomHoles(X innermost)  
    errorLayer(geomAndNot(H NPWR) RULE_COMMENT)
)

let( /* NWR.R.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "NWR.R.1  NW resistor doped by implants not allowed." )    
    errorLayer(geomAnd(RWDMY NPOD) RULE_COMMENT)
    errorLayer(geomAnd(RWDMY PPOD) RULE_COMMENT)
)

NWT=geomButtOrOver(NTAPu NWRES)  
VDD_VSS_DUMMY=geomOr(VDDDMY VSSDMY)  
NWT_CB_DUMMY=geomButtOrOver(CBu VDD_VSS_DUMMY)  
NWT_UBMn_DUMMY=geomButtOrOver(UBMnu VDD_VSS_DUMMY)  
NWT_UBMd_DUMMY=geomButtOrOver(UBMdu VDD_VSS_DUMMY)  

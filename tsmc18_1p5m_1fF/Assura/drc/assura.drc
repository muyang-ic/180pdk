NTAPux=geomAndNot(NTAPiu geomButtOrOver(NTAPiu RNWEL))  

;;  Power PAD 
cond(
    (CONNECT_ALL_RESISTOR==0 && DISCONNECT_ALL_RESISTOR==0 geomStamp(CBiu CBj))
    (DISCONNECT_ALL_RESISTOR==1 geomStamp(CBiu CBk))
    (CONNECT_ALL_RESISTOR==1 && DISCONNECT_ALL_RESISTOR==0 geomStamp(CBiu CBu))
)
cond(
    (CONNECT_ALL_RESISTOR==1 && DISCONNECT_ALL_RESISTOR==0 geomStamp(NTAPux NTAPu))
    (DISCONNECT_ALL_RESISTOR==1 geomStamp(NTAPux NTAPk))
    (CONNECT_ALL_RESISTOR==0 && DISCONNECT_ALL_RESISTOR==0 geomStamp(NTAPux NTAPj))
)
VDD_CB=geomNodeRelate(CBiu NTAPux conn)  
cond(
    (CONNECT_ALL_RESISTOR==0 && DISCONNECT_ALL_RESISTOR==0 geomStamp(PTAPiu PTAPj))
    (DISCONNECT_ALL_RESISTOR==1 geomStamp(PTAPiu PTAPk))
    (CONNECT_ALL_RESISTOR==1 && DISCONNECT_ALL_RESISTOR==0 geomStamp(PTAPiu PTAPu))
)
VSS_CB=geomNodeRelate(CBiu PTAPiu conn)  
cond(
    (CONNECT_ALL_RESISTOR==0 && DISCONNECT_ALL_RESISTOR==0 geomStamp(UBMniu UBMnj))
    (DISCONNECT_ALL_RESISTOR==1 geomStamp(UBMniu UBMnk))
    (CONNECT_ALL_RESISTOR==1 && DISCONNECT_ALL_RESISTOR==0 geomStamp(UBMniu UBMnu))
)
VDD_UBMn=geomNodeRelate(UBMniu NTAPux conn) ;;  VDD_UMBn connect to N+ OD pickup  
VSS_UBMn=geomNodeRelate(UBMniu PTAPiu conn) ;;  VSS_UMBn connect to P+ OD pickup  
cond(
    (CONNECT_ALL_RESISTOR==0 && DISCONNECT_ALL_RESISTOR==0 geomStamp(UBMdiu UBMdj))
    (DISCONNECT_ALL_RESISTOR==1 geomStamp(UBMdiu UBMdk))
    (CONNECT_ALL_RESISTOR==1 && DISCONNECT_ALL_RESISTOR==0 geomStamp(UBMdiu UBMdu))
)
VDD_UBMd=geomNodeRelate(UBMdiu NTAPux conn) ;;  VDD_UMBd connect to N+ OD pickup  
VSS_UBMd=geomNodeRelate(UBMdiu PTAPiu conn) ;;  VSS_UMBd connect to P+ OD pickup  
;;  Signal PAD 
IO_CB=geomAndNot(geomAndNot(CBiu VDD_CB) VSS_CB)  

IO_UBMn=geomAndNot(geomAndNot(UBMniu VDD_UBMn) VSS_UBMn)  
IO_UBMd=geomAndNot(geomAndNot(UBMdiu VDD_UBMd) VSS_UBMd)  

cond(
    (CONNECT_ALL_RESISTOR==0 && DISCONNECT_ALL_RESISTOR==0 geomStamp(PSDiu PSDj))
    (DISCONNECT_ALL_RESISTOR==1 geomStamp(PSDiu PSDk))
    (CONNECT_ALL_RESISTOR==1 && DISCONNECT_ALL_RESISTOR==0 geomStamp(PSDiu PSDu))
)
processAntenna(
    gate((CBiu CBiu) (UBMniu UBMniu) (UBMdiu UBMdiu))
    antenna(PSDiu)
    ratio = (plusp(CBiu.area)+plusp(UBMniu.area))+plusp(UBMdiu.area)
    PSD_PAD=drcAntenna(PSDiu (PSDiu) ratio keep>0 suppressErrorMessage)
)
PSD_PAD=geomOr(PSD_PAD_PSDiu)

cond(
    (CONNECT_ALL_RESISTOR==0 && DISCONNECT_ALL_RESISTOR==0 geomStamp(NSDiu NSDj))
    (DISCONNECT_ALL_RESISTOR==1 geomStamp(NSDiu NSDk))
    (CONNECT_ALL_RESISTOR==1 && DISCONNECT_ALL_RESISTOR==0 geomStamp(NSDiu NSDu))
)
processAntenna(
    gate((CBiu CBiu) (UBMniu UBMniu) (UBMdiu UBMdiu))
    antenna(NSDiu)
    ratio = (plusp(CBiu.area)+plusp(UBMniu.area))+plusp(UBMdiu.area)
    NSD_PAD=drcAntenna(NSDiu (NSDiu) ratio keep>0 suppressErrorMessage)

)
NSD_PAD=geomOr(NSD_PAD_NSDiu)

geomStamp(IO_CB CBiu)
geomStamp(IO_UBMn UBMniu)
geomStamp(IO_UBMd UBMdiu)
processAntenna(
gate((IO_CB IO_CB)(IO_UBMn IO_UBMn)(IO_UBMd IO_UBMd))
    antenna(PSDiu)
    ratio = (plusp(IO_CB.area)+plusp(IO_UBMn.area))+plusp(IO_UBMd.area)
    PSD_IOPAD=drcAntenna(PSDiu (PSDiu) ratio keep>0 suppressErrorMessage)
)
PSD_IOPAD=geomOr(PSD_IOPAD_PSDiu)

processAntenna(
gate((IO_CB IO_CB)(IO_UBMn IO_UBMn)(IO_UBMd IO_UBMd))
    antenna(NSDiu)
    ratio = (plusp(IO_CB.area)+plusp(IO_UBMn.area))+plusp(IO_UBMd.area)
    NSD_IOPAD=drcAntenna(NSDiu (NSDiu) ratio keep>0 suppressErrorMessage)
)
NSD_IOPAD=geomOr(NSD_IOPAD_NSDiu)

CB_DUMMY=geomButtOrOver(CBiu VDD_VSS_DUMMY)  
UBMn_DUMMY=geomButtOrOver(UBMniu VDD_VSS_DUMMY)  
UBMd_DUMMY=geomButtOrOver(UBMdiu VDD_VSS_DUMMY)  
processAntenna(
    gate((CB_DUMMY CB_DUMMY) (UBMn_DUMMY UBMn_DUMMY) (UBMd_DUMMY UBMd_DUMMY))
    antenna(PSDiu)
    ratio = PSDiu.area/(CB_DUMMY.area+UBMn_DUMMY.area+UBMd_DUMMY.area)
    PSD_VDD_VSS_PAD_DUMMY=drcAntenna(PSDiu (PSDiu) ratio keep>0 suppressErrorMessage)
)
PSD_VDD_VSS_PAD_DUMMY=geomOr(PSD_VDD_VSS_PAD_DUMMY_PSDiu)
processAntenna(
    gate((CB_DUMMY CB_DUMMY) (UBMn_DUMMY UBMn_DUMMY) (UBMd_DUMMY UBMd_DUMMY))
    antenna(NSDiu)
    ratio = NSDiu.area/(CB_DUMMY.area+UBMn_DUMMY.area+UBMd_DUMMY.area)
    NSD_VDD_VSS_PAD_DUMMY=drcAntenna(NSDiu (NSDiu) ratio keep>0 suppressErrorMessage)
)
NSD_VDD_VSS_PAD_DUMMY=geomOr(NSD_VDD_VSS_PAD_DUMMY_NSDiu)

processAntenna(
    gate((PAD_M1iu_BY_TEXT PAD_M1iu_BY_TEXT) (PAD_M2iu_BY_TEXT PAD_M2iu_BY_TEXT) (PAD_M3iu_BY_TEXT PAD_M3iu_BY_TEXT) (PAD_M4iu_BY_TEXT PAD_M4iu_BY_TEXT) (PAD_M5iu_BY_TEXT PAD_M5iu_BY_TEXT))
    antenna(PSDiu)
    ratio = PSDiu.area/(PAD_M1iu_BY_TEXT.area+PAD_M2iu_BY_TEXT.area+PAD_M3iu_BY_TEXT.area+PAD_M4iu_BY_TEXT.area+PAD_M5iu_BY_TEXT.area)
    PSD_PAD_TEXT=drcAntenna(PSDiu (PSDiu) ratio keep>0 suppressErrorMessage)
)
PSD_PAD_TEXT=geomOr(PSD_PAD_TEXT_PSDiu)
processAntenna(
    gate((PAD_M1iu_BY_TEXT PAD_M1iu_BY_TEXT) (PAD_M2iu_BY_TEXT PAD_M2iu_BY_TEXT) (PAD_M3iu_BY_TEXT PAD_M3iu_BY_TEXT) (PAD_M4iu_BY_TEXT PAD_M4iu_BY_TEXT) (PAD_M5iu_BY_TEXT PAD_M5iu_BY_TEXT))
    antenna(NSDiu)
    ratio = NSDiu.area/(PAD_M1iu_BY_TEXT.area+PAD_M2iu_BY_TEXT.area+PAD_M3iu_BY_TEXT.area+PAD_M4iu_BY_TEXT.area+PAD_M5iu_BY_TEXT.area)
    NSD_PAD_TEXT=drcAntenna(NSDiu (NSDiu) ratio keep>0 suppressErrorMessage)
)
NSD_PAD_TEXT=geomOr(NSD_PAD_TEXT_NSDiu)
processAntenna(
    gate((PWR_M1iu_BY_TEXT PWR_M1iu_BY_TEXT) (PWR_M2iu_BY_TEXT PWR_M2iu_BY_TEXT) (PWR_M3iu_BY_TEXT PWR_M3iu_BY_TEXT) (PWR_M4iu_BY_TEXT PWR_M4iu_BY_TEXT) (PWR_M5iu_BY_TEXT PWR_M5iu_BY_TEXT) (GND_M1iu_BY_TEXT GND_M1iu_BY_TEXT) (GND_M2iu_BY_TEXT GND_M2iu_BY_TEXT) (GND_M3iu_BY_TEXT GND_M3iu_BY_TEXT) (GND_M4iu_BY_TEXT GND_M4iu_BY_TEXT) (GND_M5iu_BY_TEXT GND_M5iu_BY_TEXT))
    antenna(PSDiu)
    ratio = PSDiu.area/(PWR_M1iu_BY_TEXT.area+PWR_M2iu_BY_TEXT.area+PWR_M3iu_BY_TEXT.area+PWR_M4iu_BY_TEXT.area+PWR_M5iu_BY_TEXT.area+GND_M1iu_BY_TEXT.area+GND_M2iu_BY_TEXT.area+GND_M3iu_BY_TEXT.area+GND_M4iu_BY_TEXT.area+GND_M5iu_BY_TEXT.area)
    PSD_VDD_VSS_PAD_TEXT=drcAntenna(PSDiu (PSDiu) ratio keep>0 suppressErrorMessage)
)
PSD_VDD_VSS_PAD_TEXT=geomOr(PSD_VDD_VSS_PAD_TEXT_PSDiu)
processAntenna(
    gate((PWR_M1iu_BY_TEXT PWR_M1iu_BY_TEXT) (PWR_M2iu_BY_TEXT PWR_M2iu_BY_TEXT) (PWR_M3iu_BY_TEXT PWR_M3iu_BY_TEXT) (PWR_M4iu_BY_TEXT PWR_M4iu_BY_TEXT) (PWR_M5iu_BY_TEXT PWR_M5iu_BY_TEXT) (GND_M1iu_BY_TEXT GND_M1iu_BY_TEXT) (GND_M2iu_BY_TEXT GND_M2iu_BY_TEXT) (GND_M3iu_BY_TEXT GND_M3iu_BY_TEXT) (GND_M4iu_BY_TEXT GND_M4iu_BY_TEXT) (GND_M5iu_BY_TEXT GND_M5iu_BY_TEXT))
    antenna(NSDiu)
    ratio = NSDiu.area/(PWR_M1iu_BY_TEXT.area+PWR_M2iu_BY_TEXT.area+PWR_M3iu_BY_TEXT.area+PWR_M4iu_BY_TEXT.area+PWR_M5iu_BY_TEXT.area+GND_M1iu_BY_TEXT.area+GND_M2iu_BY_TEXT.area+GND_M3iu_BY_TEXT.area+GND_M4iu_BY_TEXT.area+GND_M5iu_BY_TEXT.area)
    NSD_VDD_VSS_PAD_TEXT=drcAntenna(NSDiu (NSDiu) ratio keep>0 suppressErrorMessage)
)
NSD_VDD_VSS_PAD_TEXT=geomOr(NSD_VDD_VSS_PAD_TEXT_NSDiu)

PWR_TEXT=geomOr(geomOr(geomOr(geomOr(PWR_M1iu_TEXT PWR_M2iu_TEXT) PWR_M3iu_TEXT) PWR_M4iu_TEXT) PWR_M5iu_TEXT)  
GND_TEXT=geomOr(geomOr(geomOr(geomOr(GND_M1iu_TEXT GND_M2iu_TEXT) GND_M3iu_TEXT) GND_M4iu_TEXT) GND_M5iu_TEXT)  

if(CHECK_LATCHUP_BY_TEXT==1 then
    PSD_IOPAD_ALL=geomAndNot(geomOr(PSD_IOPAD PSD_PAD_TEXT) geomOr(PSD_VDD_VSS_PAD_TEXT PSD_VDD_VSS_PAD_DUMMY))  
    NSD_IOPAD_ALL=geomAndNot(geomOr(NSD_IOPAD NSD_PAD_TEXT) geomOr(NSD_VDD_VSS_PAD_TEXT NSD_VDD_VSS_PAD_DUMMY))  
    SD_IOPAD=geomOr(PSD_IOPAD_ALL NSD_IOPAD_ALL)  
    MOS=geomButtOrOver(DACT ALL_GATE)  
    PMOS_filter=geomCat(EMPTYi)  
    NMOS_filter=geomCat(EMPTYi)  

)

if(CHECK_LATCHUP_BY_TEXT==0 then
    PSD_IOPAD_ALL=geomAndNot(PSD_IOPAD PSD_VDD_VSS_PAD_DUMMY)  
    NSD_IOPAD_ALL=geomAndNot(NSD_IOPAD NSD_VDD_VSS_PAD_DUMMY)  
    SD_IOPAD=geomOr(PSD_IOPAD_ALL NSD_IOPAD_ALL)  
    MOS=geomButtOrOver(DACT ALL_GATE)  
    PMOS_FILTER_1 = geomButtOrOver( MOS PSD_PAD )
    geomStamp( PSD_PAD PSDiu )
    geomStamp( PMOS_FILTER_1 PSD_PAD buttOrOver )
    PMOS_FILTER_2 = geomButtOrOver( PMOS_FILTER_1 PSD_PAD diffNet )
    PMOS_filter = geomAndNot( PMOS_FILTER_1 PMOS_FILTER_2 )
    NMOS_FILTER_1 = geomButtOrOver( MOS NSD_PAD )
    geomStamp( NSD_PAD NSDiu )
    geomStamp( NMOS_FILTER_1 NSD_PAD buttOrOver )
    NMOS_FILTER_2 = geomButtOrOver( NMOS_FILTER_1 NSD_PAD diffNet )
    NMOS_filter = geomAndNot( NMOS_FILTER_1 NMOS_FILTER_2 )
)

DUMMY_MOS=geomAndNot(geomAndNot(MOS geomButtOrOver(MOS CO)) geomButtOrOver(geomAndNot(MOS geomButtOrOver(MOS CO)) geomButtOrOver(POLY CO)))  
DACT_real=geomAndNot(DACT DUMMY_MOS)  

PACT_real=geomAndNot(PACT DUMMY_MOS)  
NACT_real=geomAndNot(NACT DUMMY_MOS)  
POST_DRIVER_ACT=geomButtOrOver(geomAndNot(geomAndNot(DACT_real PMOS_filter) NMOS_filter) SD_IOPAD)  

;;  For LUP.1/LUP.2/LUP.4 - GuardRing 
;; ==================================== 
NW_inside_guard_ring_pre1=geomAndNot(NWELi NTAPi)  
NW_inside_guard_ring_pre2=geomAndNot(NW_inside_guard_ring_pre1 geomGetEdge(NW_inside_guard_ring_pre1 butting NTAPi) edges)  
NW_inside_guard_ring=geomAndNot(NW_inside_guard_ring_pre1 geomButtOrCoin(NW_inside_guard_ring_pre1 geomSize(NW_inside_guard_ring_pre2 0.005)))  
PW_inside_guard_ring_pre1=geomAndNot(PWELi PTAPi)  
PW_inside_guard_ring_pre2=geomAndNot(PW_inside_guard_ring_pre1 geomGetEdge(PW_inside_guard_ring_pre1 butting PTAPi) edges)  
PW_inside_guard_ring=geomAndNot(PW_inside_guard_ring_pre1 geomButtOrCoin(PW_inside_guard_ring_pre1 geomSize(PW_inside_guard_ring_pre2 0.005)))  
NTAP_guard_ring_hole=geomOr(geomInside(geomHoles(NTAPi innermost) NWELi) NW_inside_guard_ring)  
PTAP_guard_ring_hole=geomOr(geomInside(geomHoles(PTAPi innermost) PWELi) PW_inside_guard_ring)  

;;  For LUP.1 - I/O PAD N/P ACTIVE 
;; ================================= 
POST_DRIVER_PACT=geomAndNot(geomButtOrOver(POST_DRIVER_ACT PSDiu) geomInside(geomButtOrOver(POST_DRIVER_ACT PSDiu) LUPWDMY))  
POST_DRIVER_NACT=geomAndNot(geomButtOrOver(POST_DRIVER_ACT NSDiu) geomInside(geomButtOrOver(POST_DRIVER_ACT NSDiu) LUPWDMY))  

;;  For LUP.3 
;; ================== 
POST_DRIVER_PMOS=geomButtOrOver(POST_DRIVER_PACT ALL_GATE)  
POST_DRIVER_PMOS_NW=geomCat(POST_DRIVER_PMOS)
geomStamp(POST_DRIVER_PMOS_NW NWEL)
POST_DRIVER_PMOS_NW_HV=geomButtOrOver(POST_DRIVER_PMOS_NW HVGT)  
POST_DRIVER_PMOS_NW_33V=geomButtOrOver(POST_DRIVER_PMOS_NW_HV OD2i)  
POST_DRIVER_PMOS_NW_25V=geomButtOrOver(POST_DRIVER_PMOS_NW_HV OD2i)  
POST_DRIVER_PMOS_NW_50V=geomButtOrOver(POST_DRIVER_PMOS_NW_HV OD2i)  
POST_DRIVER_PMOS_NW_LV=geomAndNot(POST_DRIVER_PMOS_NW POST_DRIVER_PMOS_NW_HV)  
POST_DRIVER_PMOS_NWi=geomCat(POST_DRIVER_PMOS)
geomStamp(POST_DRIVER_PMOS_NWi NWELi)
POST_DRIVER_PMOS_NWi_HV=geomButtOrOver(POST_DRIVER_PMOS_NWi HVGT)  
POST_DRIVER_PMOS_NWi_33V=geomButtOrOver(POST_DRIVER_PMOS_NWi_HV OD2i)  
POST_DRIVER_PMOS_NWi_25V=geomButtOrOver(POST_DRIVER_PMOS_NWi_HV OD2i)  
POST_DRIVER_PMOS_NWi_50V=geomButtOrOver(POST_DRIVER_PMOS_NWi_HV OD2i)  
POST_DRIVER_PMOS_NWi_LV=geomAndNot(POST_DRIVER_PMOS_NWi POST_DRIVER_PMOS_NWi_HV)  
POST_DRIVER_NMOS=geomButtOrOver(POST_DRIVER_NACT ALL_GATE)  
POST_DRIVER_NMOS_RW=geomCat(geomInside(POST_DRIVER_NMOS DNW))
geomStamp(POST_DRIVER_NMOS_RW DNW)
POST_DRIVER_NMOS_PW=geomAndNot(POST_DRIVER_NMOS POST_DRIVER_NMOS_RW)  
POST_DRIVER_NMOS_RW_HV=geomButtOrOver(POST_DRIVER_NMOS_RW HVGT)  
POST_DRIVER_NMOS_RW_33V=geomButtOrOver(POST_DRIVER_NMOS_RW_HV OD2i)  
POST_DRIVER_NMOS_RW_25V=geomButtOrOver(POST_DRIVER_NMOS_RW_HV OD2i)  
POST_DRIVER_NMOS_RW_50V=geomButtOrOver(POST_DRIVER_NMOS_RW_HV OD2i)  
POST_DRIVER_NMOS_RW_LV=geomAndNot(POST_DRIVER_NMOS_RW POST_DRIVER_NMOS_RW_HV)  
POST_DRIVER_NMOS_PW_HV=geomButtOrOver(POST_DRIVER_NMOS_PW HVGT)  
POST_DRIVER_NMOS_PW_33V=geomButtOrOver(POST_DRIVER_NMOS_PW_HV OD2i)  
POST_DRIVER_NMOS_PW_25V=geomButtOrOver(POST_DRIVER_NMOS_PW_HV OD2i)  
POST_DRIVER_NMOS_PW_50V=geomButtOrOver(POST_DRIVER_NMOS_PW_HV OD2i)  
POST_DRIVER_NMOS_PW_LV=geomAndNot(POST_DRIVER_NMOS_PW POST_DRIVER_NMOS_PW_HV)  
DNWc=geomCat(DNW)
geomStamp(DNWc NWELi)
POST_DRIVER_NMOS_RWi=geomCat(geomInside(POST_DRIVER_NMOS DNWc))
geomStamp(POST_DRIVER_NMOS_RWi DNWc)
POST_DRIVER_NMOS_RWi_HV=geomButtOrOver(POST_DRIVER_NMOS_RWi HVGT)  
POST_DRIVER_NMOS_RWi_33V=geomButtOrOver(POST_DRIVER_NMOS_RWi_HV OD2i)  
POST_DRIVER_NMOS_RWi_25V=geomButtOrOver(POST_DRIVER_NMOS_RWi_HV OD2i)  
POST_DRIVER_NMOS_RWi_50V=geomButtOrOver(POST_DRIVER_NMOS_RWi_HV OD2i)  
POST_DRIVER_NMOS_RWi_LV=geomAndNot(POST_DRIVER_NMOS_RWi POST_DRIVER_NMOS_RWi_HV)  

POST_DRIVER_MOS=geomOr(POST_DRIVER_NMOS POST_DRIVER_PMOS)  
BESIDE_POST_DRIVER=geomSize(POST_DRIVER_MOS LUP_2 noClipAcute)  
BESIDE_POST_DRIVER_NMOS=geomAndNot(geomAndNot(geomAndNot(geomButtOrOver(NACT_real ALL_GATE) geomOutside(geomButtOrOver(NACT_real ALL_GATE) BESIDE_POST_DRIVER)) POST_DRIVER_NACT) DUMMY_MOS)  
BESIDE_POST_DRIVER_PMOS=geomAndNot(geomAndNot(geomAndNot(geomButtOrOver(PACT_real ALL_GATE) geomOutside(geomButtOrOver(PACT_real ALL_GATE) BESIDE_POST_DRIVER)) POST_DRIVER_PACT) DUMMY_MOS)  

;;  for LUP.5.4 
BESIDE_POST_DRIVER_1=geomSize(POST_DRIVER_MOS LUP_5_4_1 noClipAcute)  
BESIDE_POST_DRIVER_NMOS_1=geomAndNot(geomAndNot(geomAndNot(geomButtOrOver(NACT_real ALL_GATE) geomOutside(geomButtOrOver(NACT_real ALL_GATE) BESIDE_POST_DRIVER_1)) POST_DRIVER_NACT) DUMMY_MOS)  
BESIDE_POST_DRIVER_PMOS_1=geomAndNot(geomAndNot(geomAndNot(geomButtOrOver(PACT_real ALL_GATE) geomOutside(geomButtOrOver(PACT_real ALL_GATE) BESIDE_POST_DRIVER_1)) POST_DRIVER_PACT) DUMMY_MOS)  

BESIDE_POST_DRIVER_PMOS_NW=geomCat(BESIDE_POST_DRIVER_PMOS)
geomStamp(BESIDE_POST_DRIVER_PMOS_NW NWEL)
BESIDE_POST_DRIVER_PMOS_NW_HV=geomButtOrOver(BESIDE_POST_DRIVER_PMOS_NW HVGT)  
BESIDE_POST_DRIVER_PMOS_NW_33V=geomButtOrOver(BESIDE_POST_DRIVER_PMOS_NW_HV OD2i)  
BESIDE_POST_DRIVER_PMOS_NW_25V=geomButtOrOver(BESIDE_POST_DRIVER_PMOS_NW_HV OD2i)  
BESIDE_POST_DRIVER_PMOS_NW_50V=geomButtOrOver(BESIDE_POST_DRIVER_PMOS_NW_HV OD2i)  
BESIDE_POST_DRIVER_PMOS_NW_LV=geomAndNot(BESIDE_POST_DRIVER_PMOS_NW BESIDE_POST_DRIVER_PMOS_NW_HV)  
BESIDE_POST_DRIVER_PMOS_NWi=geomCat(BESIDE_POST_DRIVER_PMOS)
geomStamp(BESIDE_POST_DRIVER_PMOS_NWi NWELi)
BESIDE_POST_DRIVER_PMOS_NWi_HV=geomButtOrOver(BESIDE_POST_DRIVER_PMOS_NWi HVGT)  
BESIDE_POST_DRIVER_PMOS_NWi_33V=geomButtOrOver(BESIDE_POST_DRIVER_PMOS_NWi_HV OD2i)  
BESIDE_POST_DRIVER_PMOS_NWi_25V=geomButtOrOver(BESIDE_POST_DRIVER_PMOS_NWi_HV OD2i)  
BESIDE_POST_DRIVER_PMOS_NWi_50V=geomButtOrOver(BESIDE_POST_DRIVER_PMOS_NWi_HV OD2i)  
BESIDE_POST_DRIVER_PMOS_NWi_LV=geomAndNot(BESIDE_POST_DRIVER_PMOS_NWi BESIDE_POST_DRIVER_PMOS_NWi_HV)  
BESIDE_POST_DRIVER_NMOS_RW=geomCat(geomInside(BESIDE_POST_DRIVER_NMOS DNW))
geomStamp(BESIDE_POST_DRIVER_NMOS_RW DNW)
BESIDE_POST_DRIVER_NMOS_PW=geomAndNot(BESIDE_POST_DRIVER_NMOS BESIDE_POST_DRIVER_NMOS_RW)  
BESIDE_POST_DRIVER_NMOS_RW_HV=geomButtOrOver(BESIDE_POST_DRIVER_NMOS_RW HVGT)  
BESIDE_POST_DRIVER_NMOS_RW_33V=geomButtOrOver(BESIDE_POST_DRIVER_NMOS_RW_HV OD2i)  
BESIDE_POST_DRIVER_NMOS_RW_25V=geomButtOrOver(BESIDE_POST_DRIVER_NMOS_RW_HV OD2i)  
BESIDE_POST_DRIVER_NMOS_RW_50V=geomButtOrOver(BESIDE_POST_DRIVER_NMOS_RW_HV OD2i)  
BESIDE_POST_DRIVER_NMOS_RW_LV=geomAndNot(BESIDE_POST_DRIVER_NMOS_RW BESIDE_POST_DRIVER_NMOS_RW_HV)  
BESIDE_POST_DRIVER_NMOS_PW_HV=geomButtOrOver(BESIDE_POST_DRIVER_NMOS_PW HVGT)  
BESIDE_POST_DRIVER_NMOS_PW_33V=geomButtOrOver(BESIDE_POST_DRIVER_NMOS_PW_HV OD2i)  
BESIDE_POST_DRIVER_NMOS_PW_25V=geomButtOrOver(BESIDE_POST_DRIVER_NMOS_PW_HV OD2i)  
BESIDE_POST_DRIVER_NMOS_PW_50V=geomButtOrOver(BESIDE_POST_DRIVER_NMOS_PW_HV OD2i)  
BESIDE_POST_DRIVER_NMOS_PW_LV=geomAndNot(BESIDE_POST_DRIVER_NMOS_PW BESIDE_POST_DRIVER_NMOS_PW_HV)  
BESIDE_POST_DRIVER_NMOS_RWi=geomCat(geomInside(BESIDE_POST_DRIVER_NMOS DNWc))
geomStamp(BESIDE_POST_DRIVER_NMOS_RWi DNWc)
BESIDE_POST_DRIVER_NMOS_RWi_HV=geomButtOrOver(BESIDE_POST_DRIVER_NMOS_RWi HVGT)  
BESIDE_POST_DRIVER_NMOS_RWi_33V=geomButtOrOver(BESIDE_POST_DRIVER_NMOS_RWi_HV OD2i)  
BESIDE_POST_DRIVER_NMOS_RWi_25V=geomButtOrOver(BESIDE_POST_DRIVER_NMOS_RWi_HV OD2i)  
BESIDE_POST_DRIVER_NMOS_RWi_50V=geomButtOrOver(BESIDE_POST_DRIVER_NMOS_RWi_HV OD2i)  
BESIDE_POST_DRIVER_NMOS_RWi_LV=geomAndNot(BESIDE_POST_DRIVER_NMOS_RWi BESIDE_POST_DRIVER_NMOS_RWi_HV)  

;;  for LUP.5.4 
BESIDE_POST_DRIVER_PMOS_NW_1=geomCat(BESIDE_POST_DRIVER_PMOS_1)
geomStamp(BESIDE_POST_DRIVER_PMOS_NW_1 NWEL)
BESIDE_POST_DRIVER_PMOS_NWi_1=geomCat(BESIDE_POST_DRIVER_PMOS_1)
geomStamp(BESIDE_POST_DRIVER_PMOS_NWi_1 NWELi)
BESIDE_POST_DRIVER_NMOS_RW_1=geomCat(geomInside(BESIDE_POST_DRIVER_NMOS_1 DNW))
geomStamp(BESIDE_POST_DRIVER_NMOS_RW_1 DNW)
BESIDE_POST_DRIVER_NMOS_PW_1=geomAndNot(BESIDE_POST_DRIVER_NMOS_1 BESIDE_POST_DRIVER_NMOS_RW_1)  
BESIDE_POST_DRIVER_NMOS_RWi_1=geomCat(geomInside(BESIDE_POST_DRIVER_NMOS_1 DNWc))
geomStamp(BESIDE_POST_DRIVER_NMOS_RWi_1 DNWc)

if(GUIDELINE_LUP==1 then
    let( /* LUP.1g */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "LUP.1g  Any N+Active or an N+Active cluster connected to an I/O pad must be surrounded by a P+ guard-ring."
            "Any P+Active or a P+Active cluster connected to an I/O pad must be surrounded by a N+ guard-ring"
        )  )    
        errorLayer(geomAndNot(POST_DRIVER_NACT geomInside(POST_DRIVER_NACT PTAP_guard_ring_hole)) RULE_COMMENT)
        errorLayer(geomAndNot(POST_DRIVER_PACT geomInside(POST_DRIVER_PACT NTAP_guard_ring_hole)) RULE_COMMENT)
    )

    let( /* LUP.2g */ (RULE_COMMENT X Y BESIDE_POST_DRIVER_NMOS_waive)
        sprintf(RULE_COMMENT "LUP.2g  Within %f um space from the MOS connected to an I/O pad, a P+ guard-ring is required to surround an NMOS or an NMOS cluster. And an N+ guard-ring is required to surround a PMOS or a PMOS cluster." LUP_2)    
        X=drc(POST_DRIVER_PMOS_NW BESIDE_POST_DRIVER_NMOS_RW sep<LUP_2_S sameNet shielded withIntersection withSingularPoint)  
        Y=drc(POST_DRIVER_PMOS_NWi BESIDE_POST_DRIVER_NMOS_RWi sep<LUP_2_S diffNet shielded withIntersection withSingularPoint)  
        BESIDE_POST_DRIVER_NMOS_waive=geomAndNot(geomAndNot(BESIDE_POST_DRIVER_NMOS_RWi geomButtOrOver(BESIDE_POST_DRIVER_NMOS_RWi X)) geomButtOrOver(geomAndNot(BESIDE_POST_DRIVER_NMOS_RWi geomButtOrOver(BESIDE_POST_DRIVER_NMOS_RWi X)) Y))  
        errorLayer(geomAndNot(geomAndNot(BESIDE_POST_DRIVER_NMOS BESIDE_POST_DRIVER_NMOS_waive) geomInside(geomAndNot(BESIDE_POST_DRIVER_NMOS BESIDE_POST_DRIVER_NMOS_waive) PTAP_guard_ring_hole)) RULE_COMMENT)
        errorLayer(geomAndNot(BESIDE_POST_DRIVER_PMOS geomInside(BESIDE_POST_DRIVER_PMOS NTAP_guard_ring_hole)) RULE_COMMENT)
    )

    if(VOLTAGE_1_8V==1 then
        let( /* LUP.3.1g_1.8V */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "LUP.3.1g_1.8V  For the 1.8V or 1.5V N/PMOS which connects to an I/O pad, space between the NMOS and the PMOS.Except the NMOS is enclosed by a DNW and the NW of the checked PMOS is not interacted to the DNW. >= %f um" LUP_3_1)    
            drc(POST_DRIVER_NMOS_PW_LV POST_DRIVER_PMOS_NW_LV sep<LUP_3_1 shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_NMOS_RW_LV POST_DRIVER_NMOS_RW)
;            geomStamp(POST_DRIVER_PMOS_NW_LV POST_DRIVER_PMOS_NW)
            drc(POST_DRIVER_NMOS_RW_LV POST_DRIVER_PMOS_NW_LV sep<LUP_3_1 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_NMOS_RWi_LV POST_DRIVER_NMOS_RWi)
;            geomStamp(POST_DRIVER_PMOS_NWi_LV POST_DRIVER_PMOS_NWi)
            drc(POST_DRIVER_NMOS_RWi_LV POST_DRIVER_PMOS_NWi_LV sep<LUP_3_1 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )

    if(VOLTAGE_1_5V==1 then
        let( /* LUP.3.1g_1.5V */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "LUP.3.1g_1.5V  For the 1.8V or 1.5V N/PMOS which connects to an I/O pad, space between the NMOS and the PMOS.Except the NMOS is enclosed by a DNW and the NW of the checked PMOS is not interacted to the DNW. >= %f um" LUP_3_1)    
            drc(POST_DRIVER_NMOS_PW_LV POST_DRIVER_PMOS_NW_LV sep<LUP_3_1 shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_NMOS_RW_LV POST_DRIVER_NMOS_RW)
;            geomStamp(POST_DRIVER_PMOS_NW_LV POST_DRIVER_PMOS_NW)
            drc(POST_DRIVER_NMOS_RW_LV POST_DRIVER_PMOS_NW_LV sep<LUP_3_1 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_NMOS_RWi_LV POST_DRIVER_NMOS_RWi)
;            geomStamp(POST_DRIVER_PMOS_NWi_LV POST_DRIVER_PMOS_NWi)
            drc(POST_DRIVER_NMOS_RWi_LV POST_DRIVER_PMOS_NWi_LV sep<LUP_3_1 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )

    if(VOLTAGE_2_5V==1 then
        let( /* LUP.3.2g_2.5V */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "LUP.3.2g_2.5V  For the 2.5V N/PMOS which connects to an I/O pad directly, space between the 2.5V NMOS and the 2.5V/1.5V PMOS, space between the 2.5V PMOS and the 2.5V/1.5V NMOS, Except the NMOS is enclosed by a DNW and the NW of the checked PMOS is not interacted to the DNW.>= %f um" LUP_3_2)    
            drc(POST_DRIVER_NMOS_PW_25V POST_DRIVER_PMOS_NW_25V sep<LUP_3_2 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_PW_25V POST_DRIVER_PMOS_NW_LV sep<LUP_3_2 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_PW_LV POST_DRIVER_PMOS_NW_25V sep<LUP_3_2 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RW_25V POST_DRIVER_PMOS_NW_25V sep<LUP_3_2 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_PMOS_NW_LV POST_DRIVER_PMOS_NW)
            drc(POST_DRIVER_NMOS_RW_25V POST_DRIVER_PMOS_NW_LV sep<LUP_3_2 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_NMOS_RW_LV POST_DRIVER_NMOS_RW)
            drc(POST_DRIVER_NMOS_RW_LV POST_DRIVER_PMOS_NW_25V sep<LUP_3_2 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RWi_25V POST_DRIVER_PMOS_NWi_25V sep<LUP_3_2 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_PMOS_NWi_LV POST_DRIVER_PMOS_NWi)
            drc(POST_DRIVER_NMOS_RWi_25V POST_DRIVER_PMOS_NWi_LV sep<LUP_3_2 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_NMOS_RWi_LV POST_DRIVER_NMOS_RWi)
            drc(POST_DRIVER_NMOS_RWi_LV POST_DRIVER_PMOS_NWi_25V sep<LUP_3_2 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )

    if(VOLTAGE_3_3V==1 then
        let( /* LUP.3.3g_3.3V */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "LUP.3.3g_3.3V  For the 3.3V N/PMOS which connects to an I/O pad directly, space between the 3.3V NMOS and the 3.3V/1.8V/1.5V PMOS, space between the 3.3V PMOS and the 3.3V/1.8V/1.5V NMOS, Except the NMOS is enclosed by a DNW and the NW of the checked PMOS is not interacted to the DNW. >= %f um" LUP_3_3)    
            drc(POST_DRIVER_NMOS_PW_33V POST_DRIVER_PMOS_NW_33V sep<LUP_3_3 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_PW_33V POST_DRIVER_PMOS_NW_LV sep<LUP_3_3 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_PW_LV POST_DRIVER_PMOS_NW_33V sep<LUP_3_3 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RW_33V POST_DRIVER_PMOS_NW_33V sep<LUP_3_3 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_PMOS_NW_LV POST_DRIVER_PMOS_NW)
            drc(POST_DRIVER_NMOS_RW_33V POST_DRIVER_PMOS_NW_LV sep<LUP_3_3 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_NMOS_RW_LV POST_DRIVER_NMOS_RW)
            drc(POST_DRIVER_NMOS_RW_LV POST_DRIVER_PMOS_NW_33V sep<LUP_3_3 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RWi_33V POST_DRIVER_PMOS_NWi_33V sep<LUP_3_3 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_PMOS_NWi_LV POST_DRIVER_PMOS_NWi)
            drc(POST_DRIVER_NMOS_RWi_33V POST_DRIVER_PMOS_NWi_LV sep<LUP_3_3 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_NMOS_RWi_LV POST_DRIVER_NMOS_RWi)
            drc(POST_DRIVER_NMOS_RWi_LV POST_DRIVER_PMOS_NWi_33V sep<LUP_3_3 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )

    if(VOLTAGE_5V==1 then
        let( /* LUP.3.4g_5V */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "LUP.3.4g_5V  For the 5V N/PMOS which connects to an I/O pad directly, space between the 1.8V NMOS and the 5V/1.8V PMOS, space between the 1.8V PMOS and the 5V/1.8V NMOS, Except the NMOS is enclosed by a DNW and the NW of the checked PMOS is not interacted to the DNW.  >= %f um" LUP_3_4)    
            drc(POST_DRIVER_NMOS_PW_50V POST_DRIVER_PMOS_NW_50V sep<LUP_3_4 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_PW_50V POST_DRIVER_PMOS_NW_LV sep<LUP_3_4 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_PW_LV POST_DRIVER_PMOS_NW_50V sep<LUP_3_4 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RW_50V POST_DRIVER_PMOS_NW_50V sep<LUP_3_4 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_PMOS_NW_LV POST_DRIVER_PMOS_NW)
            drc(POST_DRIVER_NMOS_RW_50V POST_DRIVER_PMOS_NW_LV sep<LUP_3_4 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_NMOS_RW_LV POST_DRIVER_NMOS_RW)
            drc(POST_DRIVER_NMOS_RW_LV POST_DRIVER_PMOS_NW_50V sep<LUP_3_4 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RWi_50V POST_DRIVER_PMOS_NWi_50V sep<LUP_3_4 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_PMOS_NWi_LV POST_DRIVER_PMOS_NWi)
            drc(POST_DRIVER_NMOS_RWi_50V POST_DRIVER_PMOS_NWi_LV sep<LUP_3_4 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
;            geomStamp(POST_DRIVER_NMOS_RWi_LV POST_DRIVER_NMOS_RWi)
            drc(POST_DRIVER_NMOS_RWi_LV POST_DRIVER_PMOS_NWi_50V sep<LUP_3_4 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )

    let( /* LUP.4g */ (RULE_COMMENT PTAP_guard_ring_holex NTAP_guard_ring_holex PTAP_guard_ring_wide NTAP_guard_ring_wide PTAP_guard_ring_wide_hole NTAP_guard_ring_wide_hole PTAP_guard_ring_hole_check NTAP_guard_ring_hole_check PTAP_guard_ring_check NTAP_guard_ring_check)
        sprintf(RULE_COMMENT "LUP.4g  Width of the N+ guard-ring, P+ guard-ring, N+ STRAP and P+ STRAP for the Active connected to an I/O pad, and also MOS within 20um space from the MOS connected to an I/O pad. >= %f um" LUP_4)    
        PTAP_guard_ring_holex=geomEnclose(PTAP_guard_ring_hole geomOr(POST_DRIVER_NACT BESIDE_POST_DRIVER_NMOS))    
        NTAP_guard_ring_holex=geomEnclose(NTAP_guard_ring_hole geomOr(POST_DRIVER_PACT BESIDE_POST_DRIVER_PMOS))    
        PTAP_guard_ring_wide=geomWidth(geomButtOnly(geomOutside(PTAPi PTAP_guard_ring_holex) PTAP_guard_ring_holex) keep>=LUP_4)  
        NTAP_guard_ring_wide=geomWidth(geomButtOnly(geomOutside(NTAPi NTAP_guard_ring_holex) NTAP_guard_ring_holex) keep>=LUP_4)  
        PTAP_guard_ring_wide_hole=geomInside(geomHoles(PTAP_guard_ring_wide innermost) PWELi)  
        NTAP_guard_ring_wide_hole=geomInside(geomHoles(NTAP_guard_ring_wide innermost) NWELi)  
        PTAP_guard_ring_hole_check=geomAndNot(PTAP_guard_ring_holex geomInside(PTAP_guard_ring_holex PTAP_guard_ring_wide_hole))  
        NTAP_guard_ring_hole_check=geomAndNot(NTAP_guard_ring_holex geomInside(NTAP_guard_ring_holex NTAP_guard_ring_wide_hole))  
        PTAP_guard_ring_check=geomGetEdge(PTAPi butting PTAP_guard_ring_hole_check)  
        NTAP_guard_ring_check=geomGetEdge(NTAPi butting NTAP_guard_ring_hole_check)  
        drc(PTAP_guard_ring_check PTAPi ovlp<LUP_4 shielded withIntersection RULE_COMMENT)
        drc(NTAP_guard_ring_check NTAPi ovlp<LUP_4 shielded withIntersection RULE_COMMENT)
    )

    if(VOLTAGE_1_8V==1 then
        let( /* LUP.5.1g_1.8V */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "LUP.5.1g_1.8V  Minimum space >= %f um"
                "1. between 1.8V-1.5V NMOS which connects to the IO pad and the the PMOS in the internal circuit"
                "2. between 1.8V-1.5V PMOS which connects to the IO pad and the the NMOS in the internal circuit"
            ) LUP_5_1  )    
            drc(POST_DRIVER_PMOS_NW_LV BESIDE_POST_DRIVER_NMOS_PW sep<LUP_5_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_PMOS_NW_LV BESIDE_POST_DRIVER_NMOS_RW sep<LUP_5_1 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_PMOS_NWi_LV BESIDE_POST_DRIVER_NMOS_RWi sep<LUP_5_1 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_PW_LV BESIDE_POST_DRIVER_PMOS_NW sep<LUP_5_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RW_LV BESIDE_POST_DRIVER_PMOS_NW sep<LUP_5_1 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RWi_LV BESIDE_POST_DRIVER_PMOS_NWi sep<LUP_5_1 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )

    if(VOLTAGE_1_5V==1 then
        let( /* LUP.5.1g_1.5V */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "LUP.5.1g_1.5V  Minimum space >= %f um"
                "1. between 1.8V-1.5V NMOS which connects to the IO pad and the the PMOS in the internal circuit"
                "2. between 1.8V-1.5V PMOS which connects to the IO pad and the the NMOS in the internal circuit"
            ) LUP_5_1  )    
            drc(POST_DRIVER_PMOS_NW_LV BESIDE_POST_DRIVER_NMOS_PW sep<LUP_5_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_PMOS_NW_LV BESIDE_POST_DRIVER_NMOS_RW sep<LUP_5_1 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_PMOS_NWi_LV BESIDE_POST_DRIVER_NMOS_RWi sep<LUP_5_1 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_PW_LV BESIDE_POST_DRIVER_PMOS_NW sep<LUP_5_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RW_LV BESIDE_POST_DRIVER_PMOS_NW sep<LUP_5_1 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RWi_LV BESIDE_POST_DRIVER_PMOS_NWi sep<LUP_5_1 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )

    if(VOLTAGE_2_5V==1 then
        let( /* LUP.5.2g_2.5V */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "LUP.5.2g_2.5V  Minimum space >= %f um"
                "1. between 2.5V NMOS which connects to the IO pad and the the PMOS in the internal circuit"
                "2. between 2.5V PMOS which connects to the IO pad and the the NMOS in the internal circuit"
            ) LUP_5_2  )    
            drc(POST_DRIVER_PMOS_NW_25V BESIDE_POST_DRIVER_NMOS_PW sep<LUP_5_2 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_PMOS_NW_25V BESIDE_POST_DRIVER_NMOS_RW sep<LUP_5_2 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_PMOS_NWi_25V BESIDE_POST_DRIVER_NMOS_RWi sep<LUP_5_2 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_PW_25V BESIDE_POST_DRIVER_PMOS_NW sep<LUP_5_2 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RW_25V BESIDE_POST_DRIVER_PMOS_NW sep<LUP_5_2 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RWi_25V BESIDE_POST_DRIVER_PMOS_NWi sep<LUP_5_2 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )

    if(VOLTAGE_3_3V==1 then
        let( /* LUP.5.3g_3.3V */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "LUP.5.3g_3.3V  Minimum space >= %f um"
                "1. between 3.3V NMOS which connects to the IO pad and the the PMOS in the internal circuit"
                "2. between 3.3V PMOS which connects to the IO pad and the the NMOS in the internal circuit"
            ) LUP_5_3  )    
            drc(POST_DRIVER_PMOS_NW_33V BESIDE_POST_DRIVER_NMOS_PW sep<LUP_5_3 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_PMOS_NW_33V BESIDE_POST_DRIVER_NMOS_RW sep<LUP_5_3 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_PMOS_NWi_33V BESIDE_POST_DRIVER_NMOS_RWi sep<LUP_5_3 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_PW_33V BESIDE_POST_DRIVER_PMOS_NW sep<LUP_5_3 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RW_33V BESIDE_POST_DRIVER_PMOS_NW sep<LUP_5_3 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RWi_33V BESIDE_POST_DRIVER_PMOS_NWi sep<LUP_5_3 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )

    if(VOLTAGE_5V==1 then
        let( /* LUP.5.4g_5V */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "LUP.5.4g_5V  Minimum space >= %f um"
                "1. between 5V NMOS which connects to the IO pad and the the PMOS in the internal circuit"
                "2. between 5V PMOS which connects to the IO pad and the the NMOS in the internal circuit"
            ) LUP_5_4  )    
            drc(POST_DRIVER_PMOS_NW_50V BESIDE_POST_DRIVER_NMOS_PW_1 sep<LUP_5_4 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_PMOS_NW_50V BESIDE_POST_DRIVER_NMOS_RW_1 sep<LUP_5_4 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_PMOS_NWi_50V BESIDE_POST_DRIVER_NMOS_RWi_1 sep<LUP_5_4 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_PW_50V BESIDE_POST_DRIVER_PMOS_NW_1 sep<LUP_5_4 shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RW_50V BESIDE_POST_DRIVER_PMOS_NW_1 sep<LUP_5_4 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
            drc(POST_DRIVER_NMOS_RWi_50V BESIDE_POST_DRIVER_PMOS_NWi_1 sep<LUP_5_4 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )

)

CO_PACT=geomOr(COi geomAndNot(PSDc geomOutside(PSDc COi)))  
NPUi=geomButtOrOver(NTAPi CO_PACT)  
NPUi_SRAM=geomInside(NPUi SRM)  

NSTP_OS=geomSizeAnd(NPUi NWELi NW_S_1*0.7 LUP_6 truncate NW_S_1*0.7)  
NSTP_OS_SRAM=geomSizeAnd(NPUi_SRAM NWELi NW_S_1*0.7 LUP_6_SRAM truncate NW_S_1*0.7)  

PACT_CHECK=geomAndNot(geomButtOrOver(geomButtOrOver(PACTi COi) POLYi) POLYi)  
PACT_CHECK_NON_SRAM=geomAndNot(PACT_CHECK geomInside(PACT_CHECK SRM))  

PACT_CHECK_SRAM=geomInside(PACT_CHECK SRM)  

CO_NACT=geomOr(COi geomAndNot(NSDc geomOutside(NSDc COi)))  
PPUi=geomButtOrOver(PTAPi CO_NACT)  
PPUi_SRAM=geomInside(PPUi SRM)  

PSTP_OS=geomSizeAnd(PPUi PWELi NW_S_1*0.7 LUP_6 truncate NW_S_1*0.7)  
PSTP_OS_SRAM=geomSizeAnd(PPUi_SRAM PWELi NW_S_1*0.7 LUP_6_SRAM truncate NW_S_1*0.7)  

NACT_CHECK=geomAndNot(geomButtOrOver(geomButtOrOver(NACTi COi) POLYi) POLYi)  
NACT_CHECK_NON_SRAM=geomAndNot(NACT_CHECK geomInside(NACT_CHECK SRM))  

NACT_CHECK_SRAM=geomInside(NACT_CHECK SRM)  

let( /* LUP.6 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT strcat(
        "LUP.6  Any point inside NMOS source/drain space to the nearest PW STRAP in the same PW <= %f um"
        "Any point inside PMOS source/drain space to the nearest NW STRAP in the same NW <= %f um"
        "In SRAM bit cell region, the rule is relaxed to %f um"
    ) LUP_6 LUP_6 LUP_6_SRAM)    
    errorLayer(geomAndNot(PACT_CHECK_NON_SRAM NSTP_OS) RULE_COMMENT)
    errorLayer(geomAndNot(PACT_CHECK_SRAM geomOr(NSTP_OS NSTP_OS_SRAM)) RULE_COMMENT)
    errorLayer(geomAndNot(NACT_CHECK_NON_SRAM PSTP_OS) RULE_COMMENT)
    errorLayer(geomAndNot(NACT_CHECK_SRAM geomOr(PSTP_OS PSTP_OS_SRAM)) RULE_COMMENT)
)

;;  LOGO CHECKS 
;; ============ 

let( /* LOGO.S.1 */ (RULE_COMMENT LOGO_EXT)
    sprintf(RULE_COMMENT "LOGO.S.1  Min. LOGO space to NW, OD, PO, or Metals >= 3um" )    
    LOGO_EXT=geomAndNot(geomSize(LOGO 3 noClipAcute) LOGO)  
    errorLayer(geomAnd(LOGO_EXT NWELi) RULE_COMMENT)
    errorLayer(geomAnd(LOGO_EXT ALL_OD) RULE_COMMENT)
    errorLayer(geomAnd(LOGO_EXT ALL_PO) RULE_COMMENT)
    errorLayer(geomAnd(LOGO_EXT geomOr(M1i M1DMY)) RULE_COMMENT)
    errorLayer(geomAnd(LOGO_EXT geomOr(M2i M2DMY)) RULE_COMMENT)
    errorLayer(geomAnd(LOGO_EXT geomOr(M3i M3DMY)) RULE_COMMENT)
    errorLayer(geomAnd(LOGO_EXT geomOr(M4i M4DMY)) RULE_COMMENT)
    errorLayer(geomAnd(LOGO_EXT geomOr(M5i M5DMY)) RULE_COMMENT)
    errorLayer(geomAnd(LOGO_EXT geomOr(MD MDDMY)) RULE_COMMENT)
)

let( /* LOGO.O.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "LOGO.O.1  LOGO overlap of CB, CBD, FW, PM, UBM, DOD, DPO, or DMx is not allowed." )    
    errorLayer(geomAnd(LOGO CBi) RULE_COMMENT)
    errorLayer(geomAnd(LOGO CBDi) RULE_COMMENT)
    errorLayer(geomAnd(LOGO PPIi) RULE_COMMENT)
    errorLayer(geomAnd(LOGO FWi) RULE_COMMENT)
    errorLayer(geomAnd(LOGO PLMIDEi) RULE_COMMENT)
    errorLayer(geomAnd(LOGO UBMi) RULE_COMMENT)
    errorLayer(geomAnd(LOGO DOD) RULE_COMMENT)
    errorLayer(geomAnd(LOGO DPO) RULE_COMMENT)
    errorLayer(geomAnd(LOGO M1DMY) RULE_COMMENT)
    errorLayer(geomAnd(LOGO M2DMY) RULE_COMMENT)
    errorLayer(geomAnd(LOGO M3DMY) RULE_COMMENT)
    errorLayer(geomAnd(LOGO M4DMY) RULE_COMMENT)
    errorLayer(geomAnd(LOGO M5DMY) RULE_COMMENT)
    errorLayer(geomAnd(LOGO MDDMY) RULE_COMMENT)
)

let( /* LOGO.R.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "LOGO.R.1  A circuit in LOGO is not allowed." )    
    errorLayer(geomAnd(LOGO ALL_GATE) RULE_COMMENT)
    errorLayer(geomAnd(LOGO PORES) RULE_COMMENT)
    errorLayer(geomAnd(LOGO ODRES) RULE_COMMENT)
    errorLayer(geomAnd(LOGO RNWEL) RULE_COMMENT)
    errorLayer(geomAnd(LOGO BJTDUMMY) RULE_COMMENT)
    errorLayer(geomAnd(LOGO DIODUMMY) RULE_COMMENT)
    errorLayer(geomAnd(LOGO VARDMY) RULE_COMMENT)
    errorLayer(geomAnd(LOGO CTM4i) RULE_COMMENT)
)

;; LOGO.R.2 has been check by other DRC rules 

if(FULL_CHIP==1 then
    if(WITH_SEALRING==1 then
        let( /* SR.S.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "SR.S.1  Minimum width of Assembly isolation >= %f um" SR_S_1)    
            errorLayer(geomAnd(ASS_REGION COi) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION DNWi) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION NWELi) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION POLYi) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION DPO) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION ODi) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION DOD) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION VIA1i) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION VIA2i) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION VIA3i) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION VIA4i) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION M1i) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION M2i) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION M3i) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION M4i) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION M5i) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION VIADi) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION MDi) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION UBMi) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION CBDi) RULE_COMMENT)
            errorLayer(geomAnd(ASS_REGION CBi) RULE_COMMENT)
        )

        let( /* SR.R.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "SR.R.1  sealring layer (126;0) is a must if customer adds sealring by thenmselves." )    
            errorLayer(geomAndNot(CHIPx geomButtOrOver(CHIPx SEALRING)) RULE_COMMENT)
        )

        let( /* SR.E.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "SR.E.1  Minimum extension of metal to CO/VIA in guard ring. >= %f um" SR_E_1)    
            drc(M1 SR_CO enc<SR_E_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            errorLayer(geomAndNot(SR_CO M1) RULE_COMMENT)
            drc(M1 SR_VIA1 enc<SR_E_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            errorLayer(geomAndNot(SR_VIA1 M1) RULE_COMMENT)
            drc(M2 SR_VIA1 enc<SR_E_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            errorLayer(geomAndNot(SR_VIA1 M2) RULE_COMMENT)
            drc(M2 SR_VIA2 enc<SR_E_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            errorLayer(geomAndNot(SR_VIA2 M2) RULE_COMMENT)
            drc(M3 SR_VIA2 enc<SR_E_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            errorLayer(geomAndNot(SR_VIA2 M3) RULE_COMMENT)
            drc(M3 SR_VIA3 enc<SR_E_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            errorLayer(geomAndNot(SR_VIA3 M3) RULE_COMMENT)
            drc(M4 SR_VIA3 enc<SR_E_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            errorLayer(geomAndNot(SR_VIA3 M4) RULE_COMMENT)
            drc(M4 SR_VIA4 enc<SR_E_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            errorLayer(geomAndNot(SR_VIA4 M4) RULE_COMMENT)
            drc(M5 SR_VIA4 enc<SR_E_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            errorLayer(geomAndNot(SR_VIA4 M5) RULE_COMMENT)
        )

        let( /* SR.E.2 */ (RULE_COMMENT SR_OD SR_OD_HOLES SR_OD_FULL SR_OD_FULL_SIZE)
            sprintf(RULE_COMMENT "SR.E.2  (OD interact sealring) enclosure of metal with the outer edge of sealring == %f um" SR_E_2)    
            SR_OD=geomButtOrOver(OD SEALRING)  
            SR_OD_HOLES=geomHoles(SR_OD)  
            SR_OD_FULL=geomOr(SR_OD SR_OD_HOLES)  
            drc(SR_OD_FULL SR_M1 enc<SR_E_2 shielded RULE_COMMENT)
            drc(SR_OD_FULL SR_M2 enc<SR_E_2 shielded RULE_COMMENT)
            drc(SR_OD_FULL SR_M3 enc<SR_E_2 shielded RULE_COMMENT)
            drc(SR_OD_FULL SR_M4 enc<SR_E_2 shielded RULE_COMMENT)
            drc(SR_OD_FULL SR_M5 enc<SR_E_2 shielded RULE_COMMENT)
            SR_OD_FULL_SIZE=geomSize(SR_OD_FULL (-SR_E_2) noClipAcute)  
            errorLayer(geomAndNot(SR_OD_FULL_SIZE geomGetEdge(SR_OD_FULL_SIZE coincident SR_M1) edges) RULE_COMMENT)
            errorLayer(geomAndNot(SR_OD_FULL_SIZE geomGetEdge(SR_OD_FULL_SIZE coincident SR_M2) edges) RULE_COMMENT)
            errorLayer(geomAndNot(SR_OD_FULL_SIZE geomGetEdge(SR_OD_FULL_SIZE coincident SR_M3) edges) RULE_COMMENT)
            errorLayer(geomAndNot(SR_OD_FULL_SIZE geomGetEdge(SR_OD_FULL_SIZE coincident SR_M4) edges) RULE_COMMENT)
            errorLayer(geomAndNot(SR_OD_FULL_SIZE geomGetEdge(SR_OD_FULL_SIZE coincident SR_M5) edges) RULE_COMMENT)
        )

        let( /* SR.R.2 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "SR.R.2  It's not allowed that odd VIA bar(VIA1,3,5) overlap even VIA bar(VIA2,4)" )    
            errorLayer(geomAnd(SR_VIA1 SR_VIA2) RULE_COMMENT)
            errorLayer(geomAnd(SR_VIA2 SR_VIA3) RULE_COMMENT)
            errorLayer(geomAnd(SR_VIA3 SR_VIA4) RULE_COMMENT)
        )

        let( /* CO.W.2 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "CO.W.2  Minimum and maximum width of CO bar. CO bar is only allowed in seal ring. == %f um" CO_W_2)    
            drc(SR_CO width<CO_W_2 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
            errorLayer(geomWidth(SR_CO keep>CO_W_2) RULE_COMMENT)
        )

        let( /* VIA1.W.2 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "VIA1.W.2  Minimum and maximum width of VIAx bar. VIAx bar is only allowed in seal ring. == %f um" VIA1_W_2)    
            drc(SR_VIA1 width<VIA1_W_2 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
            errorLayer(geomWidth(SR_VIA1 keep>VIA1_W_2) RULE_COMMENT)
        )

        let( /* VIA2.W.2 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "VIA2.W.2  Minimum and maximum width of VIAx bar. VIAx bar is only allowed in seal ring. == %f um" VIA2_W_2)    
            drc(SR_VIA2 width<VIA2_W_2 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
            errorLayer(geomWidth(SR_VIA2 keep>VIA2_W_2) RULE_COMMENT)
        )

        let( /* VIA3.W.2 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "VIA3.W.2  Minimum and maximum width of VIAx bar. VIAx bar is only allowed in seal ring. == %f um" VIA3_W_2)    
            drc(SR_VIA3 width<VIA3_W_2 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
            errorLayer(geomWidth(SR_VIA3 keep>VIA3_W_2) RULE_COMMENT)
        )

        let( /* VIAn.W.2 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "VIAn.W.2  Minimum and maximum width of VIAn bar. VIAn bar is only allowed in seal ring. == %f um" VIAn_W_2)    
            drc(SR_VIA4 width<VIAn_W_2 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
            errorLayer(geomWidth(SR_VIA4 keep>VIAn_W_2) RULE_COMMENT)
        )

    )

)

if(MIX_MODE==1 then
    let( /* PO.W.1_HRI */ (RULE_COMMENT HREPC)
        sprintf(RULE_COMMENT "PO.W.1_HRI  Min. width of PO region for HRI poly resistor >= 1.0um" )    
        HREPC=geomButtOrOver(HREP RLPPDMY)  
        drc(HREPC width<1.0 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
    )
	
_por1amm_norm_gate_w = geomGetEdge(GATE_W outside VARDMY)
_por1amm_norm_gate_w1 = geomGetAngledEdge(_por1amm_norm_gate_w keep == 0)
_por1amm_norm_gate_w11 = geomGetAdjacentEdge(_por1amm_norm_gate_w _por1amm_norm_gate_w1 )
_por1amm_norm_gate_w2 = geomGetAngledEdge(_por1amm_norm_gate_w keep == 45)
 errorLayer( geomAndNot(_por1amm_norm_gate_w11 _por1amm_norm_gate_w2) 
	"_PO.R.1A.MM  90 degree L shape and U shape bent gates are not allowed ") 
    ;;  PP CHECKS 
    ;; ============ 

    let( /* _PP.E.6.MM */ (RULE_COMMENT)

        sprintf(RULE_COMMENT "_PP.E.6.MM  Min. extension of a PP region beyond a PO as resistor >= %f um" PP_E_6_2)    
        drc(PP PORES enc<PP_E_6_2 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomAndNot(geomAndNot(geomAnd(RPO POLY) IMP) HRI) RULE_COMMENT)
    )

    ;;  RPO CHECKS 
    ;; ============= 
    let( /* RPO.O.1_HRI */ (RULE_COMMENT X Y Z PPPO A B)
        sprintf(RULE_COMMENT "RPO.O.1_HRI  Min. and Max. overlap of a PP region to RPO region for HRI == 0.3um" )    
        X=geomButtOrOver(POLY_ISO HRI)  
        Y=geomGetEdge(RPO inside X)  
        drc(PP Y ovlp<0.3 edge shielded withIntersection RULE_COMMENT)
        errorLayer(geomGetEdge(Y outside PP) RULE_COMMENT)
        Z=geomSize(Y -0.30 edges)  
        PPPO=geomAnd(PP POLY)  
        A=geomAnd(PPPO PORES)  
        B=geomButtOrOver(A HRI)  
        errorLayer(geomAndNot(B Z) RULE_COMMENT)
    )

    if(C0152==0 then
        geomConnect(incremental 
            buttOrOver(NTAPi NWELi)
            buttOrOver(NTAPi PSDi)
            buttOrOver(PTAPi NSDi)
            via(COi M1xd ILP1i NTAPi PTAPi PSDi NSDi)
            via(VIA1i M1xd M2xd)
            via(VIA2i M2xd M3xd)
            via(VIA3i M3xd M4xd)
            via(VIAt M4xd M5xd)
            via(VIAc CTM4i M5xd)
            via(VIADi M5xd MDxd)
        )

        ;;  M5 checks 
        ;; ============= 

        M5T_NIND=geomAndNot(M5xd INDDMY)  

        INDDMYI=geomSize(INDDMY (-7) noClipAcute) ;; exclude M1 substrate pick up node  
        INDM=geomAnd(INDDMY M3)  
        INDME=geomGetEdge(INDM coincident INDDMY)  
        INDDMYA=geomButtOrCoin(INDDMY geomSize(INDME 0.005) keep<2)  
        INDDMY3=geomEnclose(INDDMYA M4)   ;; for 3 terminals inductor(central tap)  
        INDDMY2=geomAndNot(INDDMY INDDMY3) ;; for 2 terminals inductor  

        if(THICK_20K==1 then
            let( /* UTM20K.W.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "UTM20K.W.1  Min. M5 width >= %f um" UTM20K_W_1)    
                drc(M5 width<UTM20K_W_1 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
            )

            let( /* UTM20K.S.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "UTM20K.S.1  Min. M5 spacing >= %f um" UTM20K_S_1)    
                drc(M5 0<sepNotch<UTM20K_S_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            )

            let( /* UTM20K.E.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "UTM20K.E.1  Min. extension of a M5 region beyond a VIA4 region >= 0.3 um" )    
                drc(M5 VIA4 enc<0.3 shielded withIntersection withSingularPoint RULE_COMMENT)
                errorLayer(geomAndNot(VIA4 M5) RULE_COMMENT)
            )

            let( /* UTM20K.E.2 */ (RULE_COMMENT X)
                sprintf(RULE_COMMENT "UTM20K.E.2  Min. extension of M5 end-of-line region beyond VIA4 region >= 0.45 um" )    
                X=drc(M5 VIA4 enc<0.45 edgeb oppositeB shielded withIntersection)  
                drc(geomGetEdge(X coincident geomGetVertex(geomSize(X -0.001 edges) keep >4)) width<0.36  edge only_perp shielded RULE_COMMENT)  
            )

            let( /* UTM20K.S.2 */ (RULE_COMMENT M5T_NIND_S8 M5T_NIND_G8 M5T_NIND_Wide M5T_NIND_Exp M5T_NIND_Branch M5T_NIND_Branch_edge M5T_NIND_Check M5T_NIND_Branch_Check)
                sprintf(RULE_COMMENT "UTM20K.S.2  Min. space of Wide M5 (>16um) and M5 >= 3.0 um (exclude application for inductor)" )    
                M5T_NIND_S8=geomGrow(M5T_NIND (-8) (-8) (-8) (-8))     
                M5T_NIND_G8=geomGrow(M5T_NIND_S8 8 8 8 8)     
                M5T_NIND_Wide=geomAnd(M5T_NIND_G8 M5T_NIND)  
                M5T_NIND_Exp=geomSizeAnd(M5T_NIND_Wide M5T_NIND 1 1 noClipAcute)  
                M5T_NIND_Branch=geomAndNot(M5T_NIND_Exp M5T_NIND_Wide)  
                M5T_NIND_Branch_edge=geomGetEdge(M5T_NIND_Branch coincident M5T_NIND)  
                M5T_NIND_Check=geomAnd(M5T_NIND geomSize(M5T_NIND_Exp 3.0 noClipAcute))  
                M5T_NIND_Branch_Check=geomAnd(M5T_NIND geomSize(M5T_NIND_Branch_edge 3.0 chainEdges))  
                M5T_NIND_WideC=geomCat(M5T_NIND_Wide)
                geomStamp(M5T_NIND_WideC M5xd)
                M5T_NIND_CheckC=geomCat(M5T_NIND_Check)
                geomStamp(M5T_NIND_CheckC M5xd)
                M5T_NIND_BranchC=geomCat(M5T_NIND_Branch)
                geomStamp(M5T_NIND_BranchC M5xd)
                M5T_NIND_Branch_CheckC=geomCat(M5T_NIND_Branch_Check)
                geomStamp(M5T_NIND_Branch_CheckC M5xd)
                drc(M5T_NIND_WideC M5T_NIND_CheckC sep<3.0 0<withIntersection<90 diffNet shielded RULE_COMMENT)
                drc(M5T_NIND_BranchC M5T_NIND_Branch_CheckC sep<3.0 0<withIntersection<90 diffNet shielded RULE_COMMENT)
            )

            let( /* UTM20K.A.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "UTM20K.A.1  Min. area of M5 region >= %f um2" UTM20K_A_1)    
                drc(M5 area<UTM20K_A_1 RULE_COMMENT) 
            )

            let( /* UTM20K.R.1 */ (RULE_COMMENT CHIP_NIND)
                sprintf(RULE_COMMENT "UTM20K.R.1  Min. density of M5 area >= 30%% (exclude application for inductor)" )    
                CHIP_NIND=geomAndNot(CHIP INDDMY)  
                processCoverage(measure(DENSITY_OUT_8=calculate(area(M5T_NIND)/area(CHIP_NIND))))
                errorLayer(geomGetCoverage(DENSITY_OUT_8 0<=keep<0.3) RULE_COMMENT)
            )

            if(Recommend==1 then
                let( /* UTM20K.C.1 */ (RULE_COMMENT IND_M5 IND_M5V4 IND_M4 IND_M4V4 IND_M5_CONN IND_M5_ALL IM5 RM5 OM5)
                    sprintf(RULE_COMMENT "UTM20K.C.1  Min. clearance from M5 as inductor to M5 >= %f um" UTM20K_C_1)    
                    IND_M5=geomButtOrOver(M5 geomSize(INDDMY (-(UTM20K_C_1+0.5)) noClipAcute))  
                    IND_M5V4=geomButtOrOver(VIA4 IND_M5)  
                    IND_M4=geomButtOrOver(M4 IND_M5V4)  
                    IND_M4V4=geomButtOrOver(VIA4 IND_M4)  
                    IND_M5_CONN=geomButtOrOver(M5 IND_M4V4)  
                    IND_M5_ALL=geomOr(IND_M5 IND_M5_CONN)  
                    IM5=geomAnd(IND_M5_ALL INDDMY)  
                    RM5=geomAndNot(M5 IND_M5_ALL)  
                    OM5=geomAndNot(IND_M5_ALL IM5)  
                    drc(RM5 IM5 sep<UTM20K_C_1 shielded withIntersection withSingularPoint RULE_COMMENT)
                    drc(IM5 OM5 sep<UTM20K_C_1 0<withIntersection<90 app>0 shielded RULE_COMMENT)
                )

            )
            let( /* UTM20K.E.3 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "UTM20K.E.3  Min. extension of INDDMY beyond M5 >= %f um" UTM20K_E_3)    
                drc(INDDMY M5 enc<UTM20K_E_3 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
            )

            let( /* UTM20K.I.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT strcat(
                    "UTM20K.I.1  No via and metal inside INDDMY are allowed, except underpass vias and metal interconnect,"
                    "and the M1 substrate pick up node of inductor"
                )  )    
                errorLayer(geomAnd(INDDMYI M1) RULE_COMMENT)
                errorLayer(geomAnd(INDDMY VIA1) RULE_COMMENT)
                errorLayer(geomAnd(INDDMY M2) RULE_COMMENT)
                errorLayer(geomAnd(INDDMY VIA2) RULE_COMMENT)
                errorLayer(geomAnd(INDDMY2 M3) RULE_COMMENT)
                errorLayer(geomAnd(INDDMY2 VIA3) RULE_COMMENT)
            )

            let( /* UTM20K.I.2 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "UTM20K.I.2  Both active and passive devices not allow inside INDDMY besides guard ring" )    
                errorLayer(geomAnd(INDDMY NWEL) RULE_COMMENT)
                errorLayer(geomAnd(INDDMY POLY) RULE_COMMENT)
                errorLayer(geomAnd(INDDMYI OD) RULE_COMMENT)
            )

            if(Recommend==1 then
                let( /* UTM20K.I.3 */ (RULE_COMMENT)
                    sprintf(RULE_COMMENT "UTM20K.I.3  It is recommended that NT_N fully overlap the region of inductor to achieve the high quality factor." )    
                    errorLayer(geomAndNot(INDDMY NTN) RULE_COMMENT)
                )

            )

        )
        if(C016==0 then
            if(THICK_40K==1 then
                let( /* UTM40K.W.1 */ (RULE_COMMENT)
                    sprintf(RULE_COMMENT "UTM40K.W.1  Min. M5 width >= %f um" UTM40K_W_1)    
                    drc(M5 width<UTM40K_W_1 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
                )

                let( /* UTM40K.S.1 */ (RULE_COMMENT)
                    sprintf(RULE_COMMENT "UTM40K.S.1  Min. M5 space >= %f um" UTM40K_S_1)    
                    drc(M5 0<sepNotch<UTM40K_S_1 shielded withIntersection withSingularPoint RULE_COMMENT)
                )

                let( /* UTM40K.E.1 */ (RULE_COMMENT)
                    sprintf(RULE_COMMENT "UTM40K.E.1  Min. extension of a M5 region beyond a VIA4 region >= 0.4 um" )    
                    drc(M5 VIA4 enc<0.4 shielded withIntersection withSingularPoint RULE_COMMENT)
                    errorLayer(geomAndNot(VIA4 M5) RULE_COMMENT)
                )

                let( /* UTM40K.E.2 */ (RULE_COMMENT X)
                    sprintf(RULE_COMMENT "UTM40K.E.2  Min. extension of M5 end-of-line region beyond VIA4 region >= 0.45 um" )    
                    X=drc(M5 VIA4 enc<0.45 edgeb oppositeB shielded withIntersection)  
                    drc(geomGetEdge(X coincident geomGetVertex(geomSize(X -0.001 edges) keep >4)) width<0.36  edge only_perp shielded RULE_COMMENT)  
                )

                let( /* UTM40K.S.2 */ (RULE_COMMENT M5T_NIND_S8 M5T_NIND_G8 M5T_NIND_Wide M5T_NIND_Exp M5T_NIND_Branch M5T_NIND_Branch_edge M5T_NIND_Check M5T_NIND_Branch_Check)
                    sprintf(RULE_COMMENT "UTM40K.S.2  Min. space of Wide M5 (>16um) and M5 >= 4.0 um (exclude application for inductor)" )    
                    M5T_NIND_S8=geomGrow(M5T_NIND (-8) (-8) (-8) (-8))     
                    M5T_NIND_G8=geomGrow(M5T_NIND_S8 8 8 8 8)     
                    M5T_NIND_Wide=geomAnd(M5T_NIND_G8 M5T_NIND)  
                    M5T_NIND_Exp=geomSizeAnd(M5T_NIND_Wide M5T_NIND 1 1 noClipAcute)  
                    M5T_NIND_Branch=geomAndNot(M5T_NIND_Exp M5T_NIND_Wide)  
                    M5T_NIND_Branch_edge=geomGetEdge(M5T_NIND_Branch coincident M5T_NIND)  
                    M5T_NIND_Check=geomAnd(M5T_NIND geomSize(M5T_NIND_Exp 4.0 noClipAcute))  
                    M5T_NIND_Branch_Check=geomAnd(M5T_NIND geomSize(M5T_NIND_Branch_edge 4.0 chainEdges))  
                    M5T_NIND_WideC=geomCat(M5T_NIND_Wide)
                    geomStamp(M5T_NIND_WideC M5xd)
                    M5T_NIND_CheckC=geomCat(M5T_NIND_Check)
                    geomStamp(M5T_NIND_CheckC M5xd)
                    M5T_NIND_BranchC=geomCat(M5T_NIND_Branch)
                    geomStamp(M5T_NIND_BranchC M5xd)
                    M5T_NIND_Branch_CheckC=geomCat(M5T_NIND_Branch_Check)
                    geomStamp(M5T_NIND_Branch_CheckC M5xd)
                    drc(M5T_NIND_WideC M5T_NIND_CheckC sep<4.0 0<withIntersection<90 diffNet shielded RULE_COMMENT)
                    drc(M5T_NIND_BranchC M5T_NIND_Branch_CheckC sep<4.0 0<withIntersection<90 diffNet shielded RULE_COMMENT)
                )

                let( /* UTM40K.A.1 */ (RULE_COMMENT)
                    sprintf(RULE_COMMENT "UTM40K.A.1  Min. area of M5 region >= %f um2" UTM40K_A_1)    
                    drc(M5 area<UTM40K_A_1 RULE_COMMENT) 
                )

                let( /* UTM40K.R.1 */ (RULE_COMMENT CHIP_NIND)
                    sprintf(RULE_COMMENT "UTM40K.R.1  Min. density of M5 area >= 30%% (exclude application for inductor)" )    
                    CHIP_NIND=geomAndNot(CHIP INDDMY)  
                    processCoverage(measure(DENSITY_OUT_9=calculate(area(M5T_NIND)/area(CHIP_NIND))))
                    errorLayer(geomGetCoverage(DENSITY_OUT_9 0<=keep<0.3) RULE_COMMENT)
                )

                if(Recommend==1 then
                    let( /* UTM40K.C.1 */ (RULE_COMMENT IND_M5 IND_M5V4 IND_M4 IND_M4V4 IND_M5_CONN IND_M5_ALL IM5 RM5 OM5)
                        sprintf(RULE_COMMENT "UTM40K.C.1  Min. clearance from M5 as inductor to M5 >= %f um" UTM40K_C_1)    
                        IND_M5=geomButtOrOver(M5 geomSize(INDDMY (-(UTM40K_C_1+0.5)) noClipAcute))  
                        IND_M5V4=geomButtOrOver(VIA4 IND_M5)  
                        IND_M4=geomButtOrOver(M4 IND_M5V4)  
                        IND_M4V4=geomButtOrOver(VIA4 IND_M4)  
                        IND_M5_CONN=geomButtOrOver(M5 IND_M4V4)  
                        IND_M5_ALL=geomOr(IND_M5 IND_M5_CONN)  
                        IM5=geomAnd(IND_M5_ALL INDDMY)  
                        RM5=geomAndNot(M5 IND_M5_ALL)  
                        OM5=geomAndNot(IND_M5_ALL IM5)  
                        drc(RM5 IM5 sep<UTM40K_C_1 shielded withIntersection withSingularPoint RULE_COMMENT)
                        drc(IM5 OM5 sep<UTM40K_C_1 0<withIntersection<90 app>0 shielded RULE_COMMENT)
                    )

                )
                let( /* UTM40K.E.3 */ (RULE_COMMENT)
                    sprintf(RULE_COMMENT "UTM40K.E.3  Min. extension of INDDMY beyond M5 >= %f um" UTM40K_E_3)    
                    drc(INDDMY M5 enc<UTM40K_E_3 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
                )

                let( /* UTM40K.I.1 */ (RULE_COMMENT)
                    sprintf(RULE_COMMENT strcat(
                        "UTM40K.I.1  No via and metal inside INDDMY are allowed, except underpass vias and metal interconnect,"
                        "and the M1 substrate pick up node of inductor"
                    )  )    
                    errorLayer(geomAnd(INDDMYI M1) RULE_COMMENT)
                    errorLayer(geomAnd(INDDMY VIA1) RULE_COMMENT)
                    errorLayer(geomAnd(INDDMY M2) RULE_COMMENT)
                    errorLayer(geomAnd(INDDMY VIA2) RULE_COMMENT)
                    errorLayer(geomAnd(INDDMY2 M3) RULE_COMMENT)
                    errorLayer(geomAnd(INDDMY2 VIA3) RULE_COMMENT)
                )

                let( /* UTM40K.I.2 */ (RULE_COMMENT)
                    sprintf(RULE_COMMENT "UTM40K.I.2  Both active and passive devices not allow inside INDDMY besides guard ring" )    
                    errorLayer(geomAnd(INDDMY NWEL) RULE_COMMENT)
                    errorLayer(geomAnd(INDDMY POLY) RULE_COMMENT)
                    errorLayer(geomAnd(INDDMYI OD) RULE_COMMENT)
                )

                if(Recommend==1 then
                    let( /* UTM40K.I.3 */ (RULE_COMMENT)
                        sprintf(RULE_COMMENT "UTM40K.I.3  It is recommended that NT_N fully overlap the region of inductor to achieve the high quality factor." )    
                        errorLayer(geomAndNot(INDDMY NTN) RULE_COMMENT)
                    )

                )

            )

        )

    )

    ;;  DNW CHECKS 
    ;; ============== 

    TCTM=geomButtOrOver(CTM4 VIA4) ;;  True CTM  
    BPM4=geomSizeAnd(TCTM M4 0.28*0.7 2 truncate 0.28*0.7) ;;  CBM = TCTM SIZE 2  
    CTMV4=geomAnd(VIA4 CTM4) ;;  VIA4 locate on CTM  
    CBMV4=geomAndNot(geomAnd(VIA4 BPM4) CTM4) ;;  VIA4 locate on CBM  
    geomConnect(incremental 
        buttOrOver(NWEL DNW)
        buttOrOver(CTMV4 TCTM)
        buttOrOver(CBMV4 BPM4)
    )
    RW=geomAndNot(DNW NWEL) ;;  RW is PW in DNW  

    if(C016==0 then
        if(C0152==0 then
            let( /* DNW.W.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "DNW.W.1  Min. width of a DNW region >= 3um" )    
                drc(DNW width<3.0 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
            )

            let( /* DNW.S.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "DNW.S.1  Min. space between two DNW regions >= 5um" )    
                drc(DNW 0<sepNotch<5.0 shielded withIntersection withSingularPoint RULE_COMMENT)
            )

        )

    )

    if(Recommend==1 then
        geomConnect(incremental buttOrOver(PTAPi PWELi))
        let( /* DNW.S.2 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "DNW.S.2  Min. space between RW and {RW OR PW} with different potential >= 1.4um" )    
            RW_NODAL=geomCat(RW)
            geomStamp(RW_NODAL PWELi)
            PWEL_NODAL=geomCat(PWEL)
            geomStamp(PWEL_NODAL PWELi)
            drc(RW_NODAL PWEL_NODAL sep<1.4 diffNet shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )

    let( /* DNW.O.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "DNW.O.1  Min. overlap from a NW edge to a DNW region >= 2.0um" )    
        drc(DNW NWEL ovlp<2.0 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* DNW.C.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "DNW.C.1  Min. clearance from DNW to NW >= 3.5um" )    
        drc(NWEL DNW sep<3.5 diffNet withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* DNW.C.4 */ (RULE_COMMENT A B)
        sprintf(RULE_COMMENT "DNW.C.4  Min. clearance from DNW to N+OD outside NW >= 3.0um" )    
        A=geomAndNot(PWEL DNW)  
        B=geomButtOrOver(NPOD A)  
        drc(B DNW sep<3.0 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomStraddle(B DNW) RULE_COMMENT)
    )

    if(Recommend==1 then
        let( /* DNW.E.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "DNW.E.1  Min. extension of NW beyond DNW for a better noise isolation >= 1.5um" )    
            drc(NWEL DNW enc<1.5 shielded withIntersection withSingularPoint RULE_COMMENT)
            errorLayer(geomGetEdge(geomAndNot(DNW geomButtOrOver(DNW SBDDMY)) outside NWEL) RULE_COMMENT)
        )

    )

    let( /* DNW.E.2 */ (RULE_COMMENT A B)
        sprintf(RULE_COMMENT "DNW.E.2  Min. extension of DNW beyond N+OD outside NW >= 1.5um" )    
        A=geomAnd(PWEL DNW)  
        B=geomButtOrOver(NPOD A)  
        drc(DNW B enc<1.5 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomStraddle(B DNW) RULE_COMMENT)
    )

    let( /* DNW.R.4 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "DNW.R.4  It is not allowed to use DNW as a resistor" )    
        errorLayer(geomAnd(DNW RWDMY) RULE_COMMENT)
    )

    let( /* DNW.R.5 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "DNW.R.5  It is not allowed to use {NW interact DNW} as a resistor" )    
        errorLayer(geomButtOrOver(RNWEL DNW) RULE_COMMENT)
        errorLayer(geomButtOrOver(NWRES DNW) RULE_COMMENT)
    )

    if(C016==1 then
        let( /* DNW.W.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "DNW.W.1  Min. DNW width < 3.3" )    
            drc(DNW width<3.3 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
        )

        let( /* DNW.S.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "DNW.S.1  Min. DNW space < 5.5" )    
            drc(DNW 0<sepNotch<5.5 shielded withIntersection withSingularPoint RULE_COMMENT)
        )

    )
    if(C016==0 then
        if(C0152==1 then
            let( /* DNW.W.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "DNW.W.1  Min. width of a DNW region >= %f" DNW_W_1_0152)    
                drc(DNW width<DNW_W_1_0152 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
            )

            let( /* DNW.S.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "DNW.S.1  Min. space between two DNW regions >= %f" DNW_S_1_0152)    
                drc(DNW 0<sepNotch<DNW_S_1_0152 shielded withIntersection withSingularPoint RULE_COMMENT)
            )

        )

    )

    ;; VTM_N 
    ;; ===== 

    let( /* VTM_N.W.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_N.W.1  Min. dimension of a VTM_N region >= 0.74um" )    
        drc(VTMN width<0.74 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
    )

    let( /* VTM_N.W.2 */ (RULE_COMMENT Z)
        sprintf(RULE_COMMENT "VTM_N.W.2  Min. PO gate dimension of a 1.8V medium Vt NMOS >= 0.3um" )    
        Z=geomGetEdge(GATE_W inside VTMN)  
        drc(Z width<0.3 shielded RULE_COMMENT)
    )

    let( /* VTM_N.W.3 */ (RULE_COMMENT Z)
        sprintf(RULE_COMMENT "VTM_N.W.3  Min. PO gate dimension of a 3.3V medium Vt NMOS >= 0.6um" )    
        Z=geomGetEdge(HV_NGATE_W inside VTMN)  
        drc(Z width<0.6 shielded RULE_COMMENT)
    )

    let( /* VTM_N.S.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_N.S.1  Min. space between two VTM_N regions >= 0.44um" )    
        drc(VTMN 0<sepNotch<0.44 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* VTM_N.E.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_N.E.1  Min. extension from a VTM_N region beyond an N+OD region >= 0.26um" )    
        drc(VTMN NACT enc<0.26 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomStraddle(NACT VTMN) RULE_COMMENT)
    )

    let( /* VTM_N.C.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_N.C.1  Min. clearance from a VTM_N region to an N+OD region >= 0.7um" )    
        drc(NACT VTMN sep<0.7 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* VTM_N.C.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_N.C.2  Min. clearance from a VTM_N region to an NW edge >= 0.43um" )    
        drc(VTMN NWEL sep<0.43 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomAnd(VTMN NWEL) RULE_COMMENT)
    )

    let( /* VTM_N.R.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_N.R.2  VTM_N interact NT_N is not allowed" )    
        errorLayer(geomAnd(VTMN NTN) RULE_COMMENT)
    )

    let( /* VTM_N.R.3 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_N.R.3  A P+ Gate is not allowed in VTM_N region" )    
        errorLayer(geomAnd(VTMN GATE_PP) RULE_COMMENT)
    )

    let( /* VTM_N.R.4 */ (RULE_COMMENT VTMN_PO)
        sprintf(RULE_COMMENT "VTM_N.R.4  A bent PO region is not allowed in VTM_N region" )    
        VTMN_PO=geomAnd(POLY VTMN)  
        errorLayer(geomGetVertex(VTMN_PO ignore==4) RULE_COMMENT)
    )

    let( /* VTM_N.R.5 */ (RULE_COMMENT VTMN_OD)
        sprintf(RULE_COMMENT "VTM_N.R.5  Min. clearance from an OD region in VTM_N region to a PO on field oxide >= 0.26um" )    
        VTMN_OD=geomAnd(VTMN OD)  
        drc(VTMN_OD POLY_ISO sep<0.26 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    )

    ;;  VTM_P 
    ;; ====== 

    let( /* VTM_P.W.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_P.W.1  Min. dimension of a VTM_P region >= 0.74um" )    
        drc(VTMP width<0.74 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
    )

    let( /* VTM_P.W.2 */ (RULE_COMMENT Z)
        sprintf(RULE_COMMENT "VTM_P.W.2  Min. PO gate dimension of a 1.8V medium Vt PMOS >= 0.25um" )    
        Z=geomGetEdge(GATE_W inside VTMP)  
        drc(Z width<0.25 shielded RULE_COMMENT)
    )

    let( /* VTM_P.S.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_P.S.1  Min. space between two VTM_P regions >= 0.44um" )    
        drc(VTMP 0<sepNotch<0.44 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* VTM_P.E.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_P.E.1  Min. extension from a VTM_P region beyond a P+OD region >= 0.26um" )    
        drc(VTMP PACT enc<0.26 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomStraddle(PACT VTMP) RULE_COMMENT)
    )

    let( /* VTM_P.C.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_P.C.1  Min. clearance from a VTM_P region to a P+OD region >= 0.7um" )    
        drc(PACT VTMP sep<0.7 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* VTM_P.C.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_P.C.2  Min. clearance from a VTM_P region to a PW edge >= 0.43um" )    
        drc(NWEL VTMP enc<0.43 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomAndNot(VTMP NWEL) RULE_COMMENT)
    )

    let( /* VTM_P.R.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_P.R.2  VTM_P interact NT_N is not allowed" )    
        errorLayer(geomAnd(VTMP NTN) RULE_COMMENT)
    )

    let( /* VTM_P.R.3 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_P.R.3  VTM_P interact OD2 is not allowed." )    
        errorLayer(geomAnd(VTMP OD2) RULE_COMMENT)
    )

    let( /* VTM_P.R.4 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "VTM_P.R.4  A N+ Gate is not allowed in VTM_P region" )    
        errorLayer(geomAnd(VTMP GATE_NP) RULE_COMMENT)
    )

    let( /* VTM_P.R.5 */ (RULE_COMMENT VTMP_PO)
        sprintf(RULE_COMMENT "VTM_P.R.5  A bent PO region is not allowed in VTM_P region" )    
        VTMP_PO=geomAnd(POLY VTMP)  
        errorLayer(geomGetVertex(VTMP_PO ignore==4) RULE_COMMENT)
    )

    let( /* VTM_P.R.6 */ (RULE_COMMENT VTMP_OD)
        sprintf(RULE_COMMENT "VTM_P.R.6  Min. clearance from an OD region in VTM_P region to a PO on field oxide >= 0.26um" )    
        VTMP_OD=geomAnd(VTMP OD)  
        drc(VTMP_OD POLY_ISO sep<0.26 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    )

    ;; HRI 
    ;; === 

    let( /* HRI.W.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "HRI.W.1  Min. width of a HRI region >= 0.44um" )    
        drc(HRI width<0.44 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
    )

    let( /* HRI.S.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "HRI.S.1  Min. space between two HRI regions >= 0.44um" )    
        drc(HRI 0<sepNotch<0.44 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* HRI.C.1 */ (RULE_COMMENT X Y Z)
        sprintf(RULE_COMMENT "HRI.C.1  Min. clearance from an HRI region to an NP region >= 0.26um" )    
        X=drc(HRI NP sep<0.26 shielded withIntersection withSingularPoint)  
        errorLayer(geomAndNot(X geomButtOrOver(X BUTT_PTAP)) RULE_COMMENT)
        Y=geomGetEdge(NP butting HRI)  
        Z=geomOr(geomSize(Y 0.001 edges) geomSize(Y -0.001 edges))  
        errorLayer(geomAndNot(Z geomButtOrOver(Z BUTT_PTAP)) RULE_COMMENT)
    )

    let( /* HRI.C.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "HRI.C.2  Min. clearance from an HRI region to a PP region >= 0.26um" )    
        drc(HRI PP sep<0.26 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* HRI.C.3_C.4 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "HRI.C.3_C.4  Min. clearance from an HRI edge to Poly gate >= 0.32um" )    
        drc(HRI ALL_GATE sep<0.32 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* HRI.E.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "HRI.E.1  Min. enclosure from an HRI region beyond a PO resistor region >= 0.26um" )    
        drc(HRI PORES enc<0.26 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomAndNot(geomAndNot(PORES geomOutside(PORES HRI)) HRI) RULE_COMMENT)
    )

    let( /* HRI.R.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "HRI.R.1  Overlap of NP and HRI is not allowed" )    
        errorLayer(geomAnd(HRI NP) RULE_COMMENT)
    )

    let( /* HRI.R.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "HRI.R.2  Overlap of OD and HRI is not allowed" )    
        errorLayer(geomAnd(HRI OD) RULE_COMMENT)
    )

    let( /* HRI.A.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "HRI.A.1  Min. area of a HRI region >= 0.3844um2" )    
        drc(HRI area<0.3844 RULE_COMMENT) 
    )

    ;;  CTM CHECK 
    ;; ============ 
    DCTM=geomAndNot(CTM4 geomButtOrOver(CTM4 VIA4)) ;;  Dummy CTM  
    DPM4=geomButtOrOver(M4 DCTM) ;;  M4 as a dummy CBM  
    BPM4C=geomOr(geomGetEdge(BPM4 coincident M4) geomGetEdge(BPM4 butting M4))  
    let( /* CTM.W.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "CTM.W.1  Min. width of a CTM region >= 4.0um" )    
        drc(TCTM width<4.0 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
    )

    let( /* CTM.W.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "CTM.W.2  Min. width of a dummy CTM region >= 0.4um" )    
        drc(DCTM width<0.4 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
    )

    let( /* CTM.S.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "CTM.S.1  Min. space between two CTM regions >= 1.2um" )    
        drc(TCTM 0<sepNotch<1.2 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* CTM.S.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "CTM.S.2  Min. space between a dummy CTM and a CTM region or two dummy CTM regions >= 0.8um" )    
        drc(DCTM TCTM sep<0.8 shielded withIntersection withSingularPoint RULE_COMMENT)
        drc(DCTM 0<sepNotch<0.8 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* CTM.R.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "CTM.R.2  Min. density of all CTM area >= 3%%" )    
        processCoverage(measure(DENSITY_OUT_10=layerList(CTM4i)))
        errorLayer(geomGetCoverage(DENSITY_OUT_10 0<keep<0.03) RULE_COMMENT)
    )

    let( /* CTM.W.4 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "CTM.W.4  Max. dimension (one side) of a CTM region <= 30um" )    
        errorLayer(geomEncloseRect(TCTM 30.005 4 manhattanOnly) RULE_COMMENT)
        errorLayer(geomEncloseRect(DCTM 30.005 0.4 manhattanOnly) RULE_COMMENT)
    )

    let( /* CTM.A.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "CTM.A.1  Min. area of CTM region >= 0.202 um2" )    
        drc(CTM4 area<0.202 RULE_COMMENT) 
    )

    let( /* CTM.R.5 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "CTM.R.5  The MIM capacitor must be placed between M5 amd M4" )    
        errorLayer(geomCat(CTM2) RULE_COMMENT)
        errorLayer(geomCat(CTM3) RULE_COMMENT)
        errorLayer(geomCat(CTM5) RULE_COMMENT)
    )

    ;;  MIM_M4 CHECK 
    ;; ============== 
    let( /* MIM_M4.W.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "MIM_M4.W.1  Max. dimension (both width and length) of M4 as MIM capacitor bottom metal <= 35um" )    
        errorLayer(geomSize(geomSize(BPM4 -17.5 noClipAcute) 17.5 noClipAcute) RULE_COMMENT)
    )

    let( /* MIM_M4.S.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "MIM_M4.S.1  Min. space between two M4 regions as MIM capacitor bottom metal >= 0.8um" )    
        drc(BPM4C 0<sepNotch<0.8 shielded withIntersection RULE_COMMENT)
    )

    let( /* MIM_M4.S.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "MIM_M4.S.2  Min. space between one M4 region as a dummy MIM capacitor bottom metal and"
            "the other M4 region as MIM capacitor bottom metal >= 0.8um"
        )  )    
        drc(BPM4C DPM4 sep<0.8 shielded withIntersection RULE_COMMENT)
    )

    let( /* MIM_M4.E.3 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "MIM_M4.E.3  Minimum extension of an M4 resgion as MIM capacitor bottom metal beyound"
            "a CTM resgion and dummy CTM region >=0.40um"
        )  )    
        drc(M4 CTM4 enc<0.4 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomAndNot(CTM4 M4) RULE_COMMENT)
    )

    ;;  MIMVIA CHECK 
    ;; =============== 

    let( /* MIMVIA.S.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "MIMVIA.S.1  Min. space between two VIA4 on the same CTM >= 2.0um" )    
        drc(CTMV4 0<sep<2.0 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* MIMVIA.S.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "MIMVIA.S.2  Min. space between two VIA4 on the same M4 as MIM capacitor bottom metal >= 4.0um" )    
        drc(CBMV4 0<sep<4.0 sameNet shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* MIMVIA.E.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "MIMVIA.E.1  Min. extension of a CTM region beyond a VIA4 region >= 0.24um" )    
        drc(CTM4 VIA4 enc<0.24 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomStraddle(VIA4 CTM4) RULE_COMMENT)
    )

    let( /* MIMVIA.E.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "MIMVIA.E.2  Min. extension of an M4 region as MIM capacitor bottom metal beyond a VIA3 or a VIA4 region >= 0.12um" )    
        drc(BPM4C VIA3 enc<0.12 shielded withIntersection RULE_COMMENT)
        drc(BPM4C VIA4 enc<0.12 shielded withIntersection RULE_COMMENT)
    )

    let( /* MIMVIA.C.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "MIMVIA.C.1  Min. clearance of a VIA3 or a VIA4 to a CTM region >= 0.4um" )    
        drc(VIA3 CTM4 sep<0.4 shielded withIntersection withSingularPoint RULE_COMMENT)
        drc(VIA4 CTM4 sep<0.4 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* MIMVIA.R.1 */ (RULE_COMMENT ERR__1)
        sprintf(RULE_COMMENT "MIMVIA.R.1  Min. density of VIA4 on CTM >= 1%%" )    
        processAntenna(
            gate((TCTM TCTM))
            antenna(CTMV4)
            ratio = CTMV4.area/TCTM.area
            ERR__1=drcAntenna(CTMV4 (CTMV4) ratio keep<0.01 suppressErrorMessage)
        )
        ERR__1=geomOr(geomOr(ERR__1_CTMV4) geomNodeRelate(CTMV4 TCTM disc))
        errorLayer(ERR__1 RULE_COMMENT)
    )

    let( /* MIMVIA.R.3 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "MIMVIA.R.3  VIA3 under CTM region is not allowed" )    
        errorLayer(geomAnd(VIA3 CTM4) RULE_COMMENT)
    )

    ;; ================SBD rules Check================================ 

    PPOD_SBD_H=geomEnclose(geomHoles(geomAndNot(geomAnd(geomAnd(PPOD PWEL) RFDUMMY) DNW) innermost) SBDOD)    

    let( /* SBD.W.1_SBD.W.1.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "SBD.W.1_SBD.W.1.1  Minimum width of an OD region to define the width of the"
            "P+ active OD region of the SBD. >=1.0um <= 16.0um"
        )  )    
        errorLayer(geomGetLength(PPOD_SBD_W 0<keep<1) RULE_COMMENT)
        errorLayer(geomGetLength(PPOD_SBD_W 16<keep<999 contiguous) RULE_COMMENT)
    )

    let( /* SBD.W.2_SBD.W.2.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "SBD.W.2_SBD.W.2.1  Minimum length of an OD region to define the length of the"
            "P+ active OD region of the SBD. >=1.0um <=4.0um"
        )  )    
        errorLayer(geomGetLength(PPOD_SBD_L 0<keep<1) RULE_COMMENT)
        errorLayer(geomGetLength(PPOD_SBD_L 4<keep<999 contiguous) RULE_COMMENT)
    )

    let( /* SBD.W.3 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "SBD.W.3  Minimum and Maximum length of an OD region to define"
            "the length of the NP OD region of the SBD.==0.42um"
        )  )    
        errorLayer(geomAndNot(NPOD_SBD geomGetRectangle(NPOD_SBD allWithTolerance=1.0 swap)) RULE_COMMENT)
        drc(NPOD_SBD width<0.42 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
        errorLayer(geomSize(geomSize(NPOD_SBD -(0.42/2) noClipAcute) (0.42/2) noClipAcute) RULE_COMMENT)
    )

    let( /* SBD.W.4 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "SBD.W.4  The width of NP OD region of the SBD must be equal to P+"
            "active OD region of the SBD."
        )  )    
        errorLayer(geomAndNot(NPOD_SBD_W geomGetEdge(NPOD_SBD_W butting PPOD_SBD_G) edges) RULE_COMMENT)
        errorLayer(geomAndNot(PPOD_SBD_W geomGetEdge(PPOD_SBD_W butting NPOD_SBD_G) edges) RULE_COMMENT)
    )

    let( /* SBD.S.1 */ (RULE_COMMENT A B C)
        sprintf(RULE_COMMENT "SBD.S.1  Space between P+ active OD region and NP OD region of the SBD ==0.48um" )    
        drc(PPOD_SBD NPOD_SBD sep<0.48 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomButtOrOver(PPOD_SBD NPOD) RULE_COMMENT)
        errorLayer(geomAndNot(PPOD_SBD geomButtOnly(geomOutside(PPOD_SBD PPOD_SBD_G) PPOD_SBD_G keep==2)) RULE_COMMENT)
        A=geomButtOnly(geomOutside(PPOD_SBD PPOD_SBD_G) PPOD_SBD_G keep==2)  
        B=geomGetEdge(A butting PPOD_SBD_G  wholeEdge)  
        C=drc(geomGetEdge(B coincident geomGetVertex(geomSize(B -0.001 edges) keep >4)) width<0.48  only_perp shielded)    
        errorLayer(geomButtOrOver(PPOD_SBD C) RULE_COMMENT)
    )

    let( /* SBD.E.1 */ (RULE_COMMENT X Y)
        sprintf(RULE_COMMENT strcat(
            "SBD.E.1  Minimum and maximum extension from NW edge to an OD"
            "region used for the SBD. ==0.80um"
        )  )    
        X=geomOr(PPOD_SBD NPOD_SBD)  
        Y=geomSize(X 0.8 noClipAcute)  
        errorLayer(geomXor(Y NW_SBD) RULE_COMMENT)
    )

    let( /* SBD.E.2 */ (RULE_COMMENT X)
        sprintf(RULE_COMMENT strcat(
            "SBD.E.2  Minimum and maximum extension of a PP region beyond"
            "an enclosed P+ active OD region of the SBD.==0.22um"
        )  )    
        X=geomSize(PPOD_SBD 0.22 noClipAcute)  
        errorLayer(geomXor(X PP_SBD_ALL) RULE_COMMENT)
    )

    let( /* SBD.O.1 */ (RULE_COMMENT X)
        sprintf(RULE_COMMENT strcat(
            "SBD.O.1  Minimum and maximum overlap from a PP edge to a P+"
            "active OD region of the SBD.==0.22um"
        )  )    
        X=geomSize(PPOD_SBD (-0.22) noClipAcute)  
        errorLayer(geomXor(X PP_SBD_HOLE) RULE_COMMENT)
    )

    let( /* SBD.E.1.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "SBD.E.1.1  Minimum extension of DNW beyond NW for a better noise isolation.>=0.60um" )    
        drc(DNW_SBD NW_SBD enc<0.6 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomStraddle(NW_SBD DNW_SBD) RULE_COMMENT)
    )

    let( /* SBD.E.3 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "SBD.E.3  Maximum and Minimum extension of SBDDMY beyond NW==0.00um" )    
        errorLayer(geomXor(SBDDMY NW_SBD) RULE_COMMENT)
    )

    ;;           The NP OD region must be located parallel with the width of the P+ active OD region at left and right sides. 

    let( /* SBD.R.2 */ (RULE_COMMENT X Y)
        sprintf(RULE_COMMENT "SBD.R.2  Maximum Finger Number of the P+ active OD region of the SBD should be <=16um" )    
        X=geomButtOrOver(SBDDMY PPOD_SBD keep<17)  
        Y=geomAndNot(SBDDMY X)  
        errorLayer(geomButtOrOver(PPOD_SBD Y) RULE_COMMENT)
    )

    let( /* SBD.R.3 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "SBD.R.3  The each NW of SBD should be surrounded by the P+ Guard Ring (P+ pickup ring)." )    
        errorLayer(geomAndNot(NW_SBD PPOD_SBD_H) RULE_COMMENT)
        errorLayer(geomButtOrOver(PPOD_SBD_H SBDOD_ALL keep>1) RULE_COMMENT)
        errorLayer(geomButtOrOver(PPOD_SBD_H NW_SBD keep>1) RULE_COMMENT)
    )

    let( /* SBD.R.4 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "SBD.R.4  Use RFDUMMY to fully cover SBD and P+ Guard Ring for LVS to recognize RF Device."
            "// for P+ guard Ring part is checked by SBD.R.3"
        )  )    
        errorLayer(geomAndNot(SBDDMY RFDUMMY) RULE_COMMENT)
        errorLayer(geomAndNot(NW_SBD RFDUMMY) RULE_COMMENT)
    )

    let( /* SBD.R.5 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "SBD.R.5  PP for SBD must be a rectangle ring. PP rectangle ring must surround OD. Other shape is not allowed." )    
        errorLayer(geomAndNot(PP_SBD_HOLE geomGetRectangle(PP_SBD_HOLE allWithTolerance=1.0 swap)) RULE_COMMENT)
        errorLayer(geomAndNot(PP_SBD_ALL geomGetRectangle(PP_SBD_ALL allWithTolerance=1.0 swap)) RULE_COMMENT)
    )

)

;; DUMMY OD RULE 
;; ================ 
;; DOD VARIABLE 

if(FULL_CHIP==1 then
    OD_DEN_EXC=geomOr(geomOr(geomOr(geomOr(geomOr(RWDMY FWi) LMARK) LOGO) INDDMY) EMPTY_AREA) ;;  exclude check  

else
    OD_DEN_EXC=geomOr(geomOr(geomOr(geomOr(RWDMY FWi) LMARK) LOGO) INDDMY) ;;  exclude check  
)

if(DENSITY_IN_BLOCKAGE==1 then
    OD_EXC=geomCat(OD_DEN_EXC)  

else
    OD_EXC=geomOr(OD_DEN_EXC ODBLK)  
)

let( /* DOD.W.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DOD.W.1  Minimum width >= %f um" DOD_W_1)    
    drc(DOD width<DOD_W_1 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
)

let( /* DOD.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DOD.S.1  Minimum space between two DOD >= %f um" DOD_S_1)    
    drc(DOD 0<sepNotch<DOD_S_1 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* DOD.C.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DOD.C.1  Minimum clearance from DOD to OD (overlap is not allowed) >= %f um" DOD_C_1)    
    drc(DOD ODi sep<DOD_C_1 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DOD ODi) RULE_COMMENT)
)

let( /* DOD.C.2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DOD.C.2  Minimum clearance from DOD to PO (overlap is not allowed) >= %f um" DOD_C_2)    
    drc(DOD POLYi sep<DOD_C_2 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DOD POLYi) RULE_COMMENT)
)

let( /* DOD.C.4 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DOD.C.4  Minimum clearance from DOD to NW (cut is not allowed) >= %f um" DOD_C_4)    
    drc(DOD NWELi sep<DOD_C_4 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomStraddle(DOD NWELi) RULE_COMMENT)
)

let( /* DOD.C.5 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DOD.C.5  Minimum clearance from DOD to FW (overlap is not allowed) >= %f um" DOD_C_5)    
    drc(DOD FWi sep<DOD_C_5 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DOD FWi) RULE_COMMENT)
)

let( /* DOD.C.6 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DOD.C.6  Minimum clearance from DOD to LMARK (overlap is not allowed) >= %f um" DOD_C_6)    
    drc(DOD LMARK sep<DOD_C_6 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DOD LMARK) RULE_COMMENT)
)

let( /* DOD.C.7 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DOD.C.7  Minimum clearance from DOD to RWDMY (overlap is not allowed) >= %f um" DOD_C_7)    
    drc(DOD RWDMY sep<DOD_C_7 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DOD RWDMY) RULE_COMMENT)
)

let( /* DOD.C.8 */ (RULE_COMMENT)

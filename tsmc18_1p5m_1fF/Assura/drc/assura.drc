;;  M4 checks 
;; ============= 
let( /* M4.W.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M4.W.1  Min. M4 width < 0.28" )    
    drc(M4 width<0.28 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
)

let( /* M4.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M4.S.1  Min. M4 space < 0.28" )    
    drc(M4 0<sepNotch<0.28 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* M4.S.2 */ (RULE_COMMENT M4_S5 M4_G5 M4_Wide M4_Exp M4_Branch M4_Branch_edge M4_Check M4_Branch_Check)
    sprintf(RULE_COMMENT "M4.S.2  Min. space to wide M4 (>10um) < 0.6" )    
    M4_S5=geomGrow(M4 (-5) (-5) (-5) (-5))     
    M4_G5=geomGrow(M4_S5 5 5 5 5)     
    M4_Wide=geomAnd(M4_G5 M4)  
    M4_Exp=geomSizeAnd(M4_Wide M4 0.196 1 noClipAcute)  
    M4_Branch=geomAndNot(M4_Exp M4_Wide)  
    M4_Branch_edge=geomGetEdge(M4_Branch coincident M4)  
    M4_Check=geomAnd(M4 geomSize(M4_Exp 0.6 noClipAcute))  
    M4_Branch_Check=geomAnd(M4 geomSize(M4_Branch_edge 0.6 chainEdges))  
    M4_WideC=geomCat(M4_Wide)
    geomStamp(M4_WideC M4xd)
    M4_CheckC=geomCat(M4_Check)
    geomStamp(M4_CheckC M4xd)
    M4_BranchC=geomCat(M4_Branch)
    geomStamp(M4_BranchC M4xd)
    M4_Branch_CheckC=geomCat(M4_Branch_Check)
    geomStamp(M4_Branch_CheckC M4xd)
    drc(M4_WideC M4_CheckC sep<0.6 0<withIntersection<90 diffNet shielded RULE_COMMENT)
    drc(M4_BranchC M4_Branch_CheckC sep<0.6 0<withIntersection<90 diffNet shielded RULE_COMMENT)
)

let( /* M4.E.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M4.E.1  Min. extension of a M4 region beyond a VIA3 region < 0.01" )    
    drc(M4 VIA3 enc<0.01 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAndNot(VIA3 M4) RULE_COMMENT)
)

let( /* M4.E.2 */ (RULE_COMMENT X)
    sprintf(RULE_COMMENT "M4.E.2  Min. extension of M4 end-of-line region beyond VIA3 region < 0.06" )    
    X=drc(M4 VIA3 enc<0.06 edgeb oppositeB shielded withIntersection)  
    drc(geomGetEdge(X coincident geomGetVertex(geomSize(X -0.001 edges) keep >4)) width<0.26  edge only_perp shielded RULE_COMMENT)  
)

let( /* M4.A.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M4.A.1  Min M4 area region < %f" Mx_A_1)    
    drc(M4 area<Mx_A_1 RULE_COMMENT) 
)

;;  Density check M4.R.1 included at the end of this file 

/*****  Variables for IMD crack check *****/

;; ******************************************** 
;; ***** Pre-processing for IMD crack check **** 
;; ******************************************** 
;;  
;;  Processing for SAME Array Merged 
;; ********************************* 

;;  Processing for 4 ~ 2 Stack Array 
;; ********************************** 

;; ********************** 
;;  Small 4 stack array 
;; ********************** 
;;  Processing for SAME Array Size Check 
;; ************************************** 

;;  Rule Check 
;; ************************************** 

let( /* VIA1.S.3_Array1_2_3_4_M */ (RULE_COMMENT B1)
    sprintf(RULE_COMMENT strcat(
        "VIA1.S.3_Array1_2_3_4_M  Minimum space between two VIAs in 4-level continuous stacking VIA arrays with below condition >=0.49um"
        "Via1 violate VIA_S_3 spacing in Via1/Via2/Via3/Via4 array & density large or equal %f"
    )  VIA_D_1)    
    processAntenna(
        gate((VIA1_4stack_Final VIA1_4stack_Final))
        antenna(VIA1_Violate_S_4_A1)
        ratio = VIA1_Violate_S_4_A1.area/VIA1_4stack_Final.area
        A1=drcAntenna(VIA1_Violate_S_4_A1 (VIA1_Violate_S_4_A1) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A1=geomOr(A1_VIA1_Violate_S_4_A1)
    processAntenna(
        gate((VIA1_4stack_Final VIA1_4stack_Final))
        antenna(VIA2_Violate_S_4_A1)
        ratio = VIA2_Violate_S_4_A1.area/VIA1_4stack_Final.area
        A2=drcAntenna(VIA2_Violate_S_4_A1 (VIA2_Violate_S_4_A1) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A2=geomOr(A2_VIA2_Violate_S_4_A1)
    processAntenna(
        gate((VIA1_4stack_Final VIA1_4stack_Final))
        antenna(VIA3_Violate_S_4_A1)
        ratio = VIA3_Violate_S_4_A1.area/VIA1_4stack_Final.area
        A3=drcAntenna(VIA3_Violate_S_4_A1 (VIA3_Violate_S_4_A1) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A3=geomOr(A3_VIA3_Violate_S_4_A1)
    processAntenna(
        gate((VIA1_4stack_Final VIA1_4stack_Final))
        antenna(VIA4_Violate_S_4_A1)
        ratio = VIA4_Violate_S_4_A1.area/VIA1_4stack_Final.area
        A4=drcAntenna(VIA4_Violate_S_4_A1 (VIA4_Violate_S_4_A1) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A4=geomOr(A4_VIA4_Violate_S_4_A1)
    B1=geomOr(geomOr(geomOr(A1 A2) A3) A4)  
    errorLayer(geomSize(geomSize(B1 VIA_Merge noClipAcute) -VIA_Merge noClipAcute) RULE_COMMENT)
)

;; ********************** 
;;  Small 3 stack array 
;; ********************** 
;;  Processing for SAME Array Size Check 
;; ************************************** 

;;  Rule Check 
;; ************************************** 

let( /* VIA1.S.4_Array1_2_3_M */ (RULE_COMMENT B1)
    sprintf(RULE_COMMENT strcat(
        "VIA1.S.4_Array1_2_3_M  Minimum space between two VIAs in 3-level continuous stacking VIA arrays with below condition >=0.49um"
        "Via1 violate VIA_S_3 spacing in Via1/Via2/Via3 array & density large or equal %f"
    )  VIA_D_1)    
    processAntenna(
        gate((VIA1_3stack_Final VIA1_3stack_Final))
        antenna(VIA1_Violate_S_3_A1)
        ratio = VIA1_Violate_S_3_A1.area/VIA1_3stack_Final.area
        A1=drcAntenna(VIA1_Violate_S_3_A1 (VIA1_Violate_S_3_A1) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A1=geomOr(A1_VIA1_Violate_S_3_A1)
    processAntenna(
        gate((VIA1_3stack_Final VIA1_3stack_Final))
        antenna(VIA2_Violate_S_3_A1)
        ratio = VIA2_Violate_S_3_A1.area/VIA1_3stack_Final.area
        A2=drcAntenna(VIA2_Violate_S_3_A1 (VIA2_Violate_S_3_A1) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A2=geomOr(A2_VIA2_Violate_S_3_A1)
    processAntenna(
        gate((VIA1_3stack_Final VIA1_3stack_Final))
        antenna(VIA3_Violate_S_3_A1)
        ratio = VIA3_Violate_S_3_A1.area/VIA1_3stack_Final.area
        A3=drcAntenna(VIA3_Violate_S_3_A1 (VIA3_Violate_S_3_A1) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A3=geomOr(A3_VIA3_Violate_S_3_A1)
    B1=geomOr(geomOr(A1 A2) A3)  
    errorLayer(geomSize(geomSize(B1 VIA_Merge noClipAcute) -VIA_Merge noClipAcute) RULE_COMMENT)
)

let( /* VIA2.S.4_Array2_3_4_M */ (RULE_COMMENT B2)
    sprintf(RULE_COMMENT strcat(
        "VIA2.S.4_Array2_3_4_M  Minimum space between two VIAs in 3-level continuous stacking VIA arrays with below condition >=0.49um"
        "Via2 violate VIA_S_3 spacing in Via2/Via3/Via4 array & density large or equal %f"

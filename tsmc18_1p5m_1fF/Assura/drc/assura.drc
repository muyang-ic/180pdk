    sprintf(RULE_COMMENT "ADP.C.1_V1_V2  Vias spacing (different level) < 0.23um." )    
    drc(DP_V1 DP_V2 sep<0.23 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* ADP.C.1_V2_V3 */ (RULE_COMMENT)

;; METAL SLOT CHECKS 
;; ================ 
;; Bonding pad ,chip corner dummy pad ,and inductor need not put slot 

;; M1 SLOT CHECKS 
;; ============== 

let( /* AMS.1.M1 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT "AMS.1.M1  Wide Metal (>35um) must have slot." )    
    A=geomAnd(geomSize(geomSize(geomSize(geomSize(M1EXD -1.0 noClipAcute) 1.0 noClipAcute) -17.5 truncate 17.5) 17.5 truncate 17.5) M1EXD)  
    errorLayer(geomEncloseRect(A 35.005 35.005) RULE_COMMENT)
)

let( /* AMS.DN.M1 */ (RULE_COMMENT ERR__1)
    sprintf(RULE_COMMENT "AMS.DN.M1  Min. Hole density for metal lines that need to apply slot  1.5%%" )    
    processAntenna(
        gate((M1HoleD M1HoleD))
        antenna(LM1X)
        ratio = M1HoleD.area/LM1X.area
        ERR__1=drcAntenna(LM1X (LM1X) ratio keep<0.015 suppressErrorMessage)
    )
    ERR__1=geomOr(geomOr(ERR__1_LM1X) geomNodeRelate(LM1X M1HoleD disc))
    errorLayer(ERR__1 RULE_COMMENT)
)

;; M2 SLOT CHECKS 
;; ============== 

let( /* AMS.1.M2 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT "AMS.1.M2  Wide Metal (>35um) must have slot." )    
    A=geomAnd(geomSize(geomSize(geomSize(geomSize(M2EXD -1.0 noClipAcute) 1.0 noClipAcute) -17.5 truncate 17.5) 17.5 truncate 17.5) M2EXD)  
    errorLayer(geomEncloseRect(A 35.005 35.005) RULE_COMMENT)
)

let( /* AMS.DN.M2 */ (RULE_COMMENT ERR__1)
    sprintf(RULE_COMMENT "AMS.DN.M2  Min. Hole density for metal lines that need to apply slot  1.5%%" )    
    processAntenna(
        gate((M2HoleD M2HoleD))
        antenna(LM2X)
        ratio = M2HoleD.area/LM2X.area
        ERR__1=drcAntenna(LM2X (LM2X) ratio keep<0.015 suppressErrorMessage)
    )
    ERR__1=geomOr(geomOr(ERR__1_LM2X) geomNodeRelate(LM2X M2HoleD disc))
    errorLayer(ERR__1 RULE_COMMENT)
)


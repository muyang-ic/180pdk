    let( /* VIA3.E.3 */ (RULE_COMMENT X)
        sprintf(RULE_COMMENT "VIA3.E.3  Minimum extension of M3 beyond the overlap area that VIA3 and VIA2 are fully or partially touching < %f" VIA3_E_3)    

let( /* AMS.1.MD */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT "AMS.1.MD  Wide Metal (>35um) must have slot" )    
    A=geomAnd(geomSize(geomSize(geomSize(geomSize(MDEXD -1.0 noClipAcute) 1.0 noClipAcute) -17.5 truncate 17.5) 17.5 truncate 17.5) MDEXD)  
    errorLayer(geomEncloseRect(A 35.005 35.005) RULE_COMMENT)
)

let( /* AMS.DN.MD */ (RULE_COMMENT ERR__1)
    sprintf(RULE_COMMENT "AMS.DN.MD  Min. Hole density for metal lines that need to apply slot  1.5%%" )    
    processAntenna(
        gate((MDHoleD MDHoleD))
        antenna(LMDX)
        ratio = MDHoleD.area/LMDX.area
        ERR__1=drcAntenna(LMDX (LMDX) ratio keep<0.015 suppressErrorMessage)
    )
    ERR__1=geomOr(geomOr(ERR__1_LMDX) geomNodeRelate(LMDX MDHoleD disc))
    errorLayer(ERR__1 RULE_COMMENT)
)

;; I/O ESD Guidance 
;; ================ 

ECO=geomAndNot(geomAnd(geomAnd(SDI CO) OD) DIODUMMY)  
EGTE_W=geomGetEdge(EGTE inside OD)  
ENSD_NCO=geomAndNot(geomAndNot(ENSD geomButtOrOver(ENSD ECO)) geomButtOrOver(geomAndNot(ENSD geomButtOrOver(ENSD ECO)) PTAP))  
EPSD_NCO=geomAndNot(geomAndNot(EPSD geomButtOrOver(EPSD ECO)) geomButtOrOver(geomAndNot(EPSD geomButtOrOver(EPSD ECO)) NTAP))  
ENSD_WCO=geomAndNot(ENSD ENSD_NCO)  
EPSD_WCO=geomAndNot(EPSD EPSD_NCO)  
ENSD_SRC=geomOutside(ENSD_WCO RPO)  
PCL_ENMOS=geomAndNot(ENMOS geomButtOrOver(ENMOS RPO))  

PTAP_real=geomAndNot(PTAPi DIODUMMY)  
NTAP_real=geomAndNot(NTAPi DIODUMMY)  
geomStamp(PTAP_real PTAPi)
processAntenna(
    gate((PTAP_real PTAP_real))
    antenna(ENSD)
    ratio = plusp(ENSD.area)*plusp(PTAP_real.area)
    ENSD_SOURCE_pre=drcAntenna(ENSD (ENSD) ratio keep>0 suppressErrorMessage)
)
ENSD_SOURCE_pre=geomOr(ENSD_SOURCE_pre_ENSD)
geomStamp(NTAP_real NTAPi)
processAntenna(
    gate((NTAP_real NTAP_real))
    antenna(EPSD)
    ratio = plusp(EPSD.area)*plusp(NTAP_real.area)
    EPSD_SOURCE_pre=drcAntenna(EPSD (EPSD) ratio keep>0 suppressErrorMessage)
)
EPSD_SOURCE_pre=geomOr(EPSD_SOURCE_pre_EPSD)
ENSD_SOURCE=geomOr(ENSD_SOURCE_pre geomOutside(geomAndNot(ENSD PCL_ENMOS) RPO))  
EPSD_SOURCE=geomOr(EPSD_SOURCE_pre geomOutside(EPSD RPO))  
ENSD_DRAIN=geomAndNot(ENSD ENSD_SOURCE)  
EPSD_DRAIN=geomAndNot(EPSD EPSD_SOURCE)  
ENSD_DRAINc=geomButtOrOver(ENSD_DRAIN ECO)  
EPSD_DRAINc=geomButtOrOver(EPSD_DRAIN ECO)  
ENMOSc=geomCat(ENMOS)
geomStamp(ENMOSc ENSD_DRAINc)
EPMOSc=geomCat(EPMOS)
geomStamp(EPMOSc EPSD_DRAINc)

ESD_PMOS_GATE_W=geomGetEdge(EGTE_W inside PP)  
ESD_NMOS_GATE_W=geomGetEdge(geomGetEdge(geomAndNot(EGTE geomButtOrOver(EGTE PCL_ENMOS)) inside OD) inside NP)  
ESD_PCL_GATE_W=geomGetEdge(geomAndNot(geomGetEdge(geomButtOrOver(EGTE PCL_ENMOS) inside OD) geomGetEdge(geomGetEdge(geomButtOrOver(EGTE PCL_ENMOS) inside OD) inside OD2) edges) inside NP)  
ESD_PMOS_GATE_W_EXP=geomSize(ESD_PMOS_GATE_W GRID edges)  
ESD_NMOS_GATE_W_EXP=geomSize(ESD_NMOS_GATE_W GRID edges)  
ESD_PCL_GATE_W_EXP=geomSize(ESD_PCL_GATE_W GRID edges)  
ESD_PMOS_GATE_W_EXPc=geomCat(ESD_PMOS_GATE_W_EXP)
geomStamp(ESD_PMOS_GATE_W_EXPc EPSD_DRAINc)
ESD_NMOS_GATE_W_EXPc=geomCat(ESD_NMOS_GATE_W_EXP)
geomStamp(ESD_NMOS_GATE_W_EXPc ENSD_DRAINc)
ESD_PCL_GATE_W_EXPc=geomCat(ESD_PCL_GATE_W_EXP)
geomStamp(ESD_PCL_GATE_W_EXPc ENSD_DRAINc)

ESD1_GATE=geomAnd(EGTE ESD1DMY)  
ESD1_NCS_GATE=geomAndNot(ESD1_GATE geomButtOrOver(ESD1_GATE ENSD_NCO))  
ESD1_TOL=geomButtOrOver(geomAnd(ENMOS ESD1DMY) ENSD_NCO)  
ESD1_NCS=geomAndNot(geomAnd(ENMOS ESD1DMY) geomButtOrOver(geomAnd(ENMOS ESD1DMY) ENSD_NCO))  
ENSD_NCO_ESD1DMY=geomButtOrOver(ENSD_NCO ESD1DMY)  
ESD1_TOL_GATE=geomButtOrOver(EGTE ENSD_NCO_ESD1DMY)  
ESD1_TOL_GATE1=geomAndNot(ESD1_TOL_GATE geomButtOrOver(ESD1_TOL_GATE ENSD_SRC))  
ESD1_TOL_GATE2=geomButtOrOver(ESD1_TOL_GATE ENSD_SRC)  
ESD1_NCS_GATE_W=geomGetEdge(ESD1_NCS_GATE inside OD)  
ESD1_TOL_GATE1_W=geomGetEdge(ESD1_TOL_GATE1 inside OD)  
ESD1_TOL_GATE2_W=geomGetEdge(ESD1_TOL_GATE2 inside OD)  

ESD2_GATE=geomAnd(EGTE ESD2DMY)  
ESD2_REG_GATE=geomAndNot(ESD2_GATE geomButtOrOver(ESD2_GATE ENSD_NCO))  
ESD2_TOL_GATE=geomButtOrOver(ESD2_GATE ENSD_NCO)  
ESD2_TOL_GATE1=geomAndNot(ESD2_TOL_GATE geomButtOrOver(ESD2_TOL_GATE ENSD_SRC))  
ESD2_TOL_GATE2=geomButtOrOver(ESD2_TOL_GATE ENSD_SRC)  
ESD2_TOL=geomButtOrOver(geomAnd(ENMOS ESD2DMY) ENSD_NCO)  
ESD2_REG=geomAndNot(geomAnd(ENMOS ESD2DMY) geomButtOrOver(geomAnd(ENMOS ESD2DMY) ENSD_NCO))  
ESD2_REG_GATE_W=geomGetEdge(ESD2_REG_GATE inside OD)  
ESD2_TOL_GATE1_W=geomGetEdge(ESD2_TOL_GATE1 inside OD)  
ESD2_TOL_GATE2_W=geomGetEdge(ESD2_TOL_GATE2 inside OD)  

RPO1=geomOutside(geomOutside(geomAnd(RPO SDI) ESD1DMY) ESD2DMY)  
EGTE1=geomAndNot(geomOutside(geomOutside(EGTE ESD1DMY) ESD2DMY) geomButtOrOver(geomOutside(geomOutside(EGTE ESD1DMY) ESD2DMY) ENSD_NCO))  
EGTE1_W=geomGetEdge(EGTE1 inside OD)  

ERPO=geomAnd(RPO SDI)  
ERPOH=geomHoles(ERPO)  
ERPOA=geomOr(ERPOH ERPO)  
ECOS=geomOutside(ECO ERPOA)  
HEGT=geomAnd(EGTE OD2)  
LEGT=geomAndNot(EGTE OD2)  
HEGN=geomAnd(HEGT NP)  
HEGP=geomAnd(HEGT PP)  

if(GUIDELINE_ESD==1 then
    let( /* ESD.3g */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESD.3g  Total finger width for 5.0V, 3.3V, 2.5V, 1.8V and 1.5V N/PMOS I/O buffer in same connection of drain < %f" ESD_3g)    
        processAntenna(
            gate((ESD_PMOS_GATE_W_EXPc ESD_PMOS_GATE_W_EXPc))
            antenna(ESD_PMOS_GATE_W_EXPc)
            ratio = ESD_PMOS_GATE_W_EXPc.area/GRID
            A=drcAntenna(ESD_PMOS_GATE_W_EXPc (ESD_PMOS_GATE_W_EXPc) ratio keep>=ESD_3g suppressErrorMessage)
        )
        A=geomOr(A_ESD_PMOS_GATE_W_EXPc)
        errorLayer(geomAndNot(EPMOS geomButtOrOver(EPMOS A)) RULE_COMMENT)
        processAntenna(
            gate((ESD_NMOS_GATE_W_EXPc ESD_NMOS_GATE_W_EXPc))
            antenna(ESD_NMOS_GATE_W_EXPc)
            ratio = ESD_NMOS_GATE_W_EXPc.area/GRID
            B=drcAntenna(ESD_NMOS_GATE_W_EXPc (ESD_NMOS_GATE_W_EXPc) ratio keep>=ESD_3g suppressErrorMessage)
        )
        B=geomOr(B_ESD_NMOS_GATE_W_EXPc)
        errorLayer(geomAndNot(geomAndNot(ENMOS geomButtOrOver(ENMOS PCL_ENMOS)) geomButtOrOver(geomAndNot(ENMOS geomButtOrOver(ENMOS PCL_ENMOS)) B)) RULE_COMMENT)
    )

    let( /* ESD.5g */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESD.5g  Total finger width for 1.8V and 1.5V NMOS power clamp in same connection of drain < %f" ESD_5g)    
        processAntenna(
            gate((ESD_PCL_GATE_W_EXPc ESD_PCL_GATE_W_EXPc))
            antenna(ESD_PCL_GATE_W_EXPc)
            ratio = ESD_PCL_GATE_W_EXPc.area/GRID
            A=drcAntenna(ESD_PCL_GATE_W_EXPc (ESD_PCL_GATE_W_EXPc) ratio keep>=ESD_5g suppressErrorMessage)
        )
        A=geomOr(A_ESD_PCL_GATE_W_EXPc)
        errorLayer(geomAndNot(PCL_ENMOS geomButtOrOver(PCL_ENMOS A)) RULE_COMMENT)
    )

    let( /* ESD.6g */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESD.6g  Unit finger width of NMOS and PMOS for I/O buffer and power clamp device 15um <= width <= 60um." )    
        errorLayer(geomGetLength(EGTE_W 0<keep<15 contiguous) RULE_COMMENT)
        errorLayer(geomGetLength(EGTE_W 60<keep<999 contiguous) RULE_COMMENT)
    )

    let( /* ESD.8g */ (RULE_COMMENT EAct DTap EActUp3 D1 D1R1 D1R2 D1R3 D1R4 D1R5 D1L D1L1 D1L2 D1L3 D1L4 D1L5 D1X D1T1 D1T2 D1T3 D1T4 D1T5 D1B D1B1 D1B2 D1B3 D1B4 D1B5 D1Y DTap2Check DTapHole DTapSuspect)
        sprintf(RULE_COMMENT "ESD.8g  It is strictly prohitibied to butting or inserted substrat/well pickups for ESD N/PMOS." )    
        EAct=geomOr(EPACT ENACT)  
        DTap=geomOr(NTAP PTAP)  
        EActUp3=geomSizeAndNot(EAct DTap 0.22*0.7 3 noClipAcute)  
        D1=geomButtOrOver(DTap EActUp3)  
        D1R1=geomGrow(D1 0 0 (-0.001) 0)     
        D1R2=geomAndNot(D1 D1R1)  
        D1R3=geomOr(geomGetEdge(D1 coincident D1R2) geomGetEdge(D1 butting D1R2))  
        D1R4=geomGetLength(D1R3 keep>0.001)  
        D1R5=drc(D1R4 EAct sep<3 edgea oppositeA shielded withIntersection)  
        D1L=geomButtOrCoin(D1 geomSize(D1R5 0.005))  
        D1L1=geomGrow(D1L (-0.001) 0 0 0)     
        D1L2=geomAndNot(D1L D1L1)  
        D1L3=geomOr(geomGetEdge(D1L coincident D1L2) geomGetEdge(D1L butting D1L2))  
        D1L4=geomGetLength(D1L3 keep>0.001)  
        D1L5=drc(D1L4 EAct sep<3 edgea oppositeA shielded withIntersection)  
        D1X=geomButtOrCoin(D1L geomSize(D1L5 0.005))  
        D1T1=geomGrow(D1 0 0 0 (-0.001))     
        D1T2=geomAndNot(D1 D1T1)  
        D1T3=geomOr(geomGetEdge(D1 coincident D1T2) geomGetEdge(D1 butting D1T2))  
        D1T4=geomGetLength(D1T3 keep>0.001)  
        D1T5=drc(D1T4 EAct sep<3 edgea oppositeA shielded withIntersection)  
        D1B=geomButtOrCoin(D1 geomSize(D1T5 0.005))  
        D1B1=geomGrow(D1B 0 (-0.001) 0 0)     
        D1B2=geomAndNot(D1B D1B1)  
        D1B3=geomOr(geomGetEdge(D1B coincident D1B2) geomGetEdge(D1B butting D1B2))  
        D1B4=geomGetLength(D1B3 keep>0.001)  
        D1B5=drc(D1B4 EAct sep<3 edgea oppositeA shielded withIntersection)  
        D1Y=geomButtOrCoin(D1B geomSize(D1B5 0.005))  
        DTap2Check=geomOr(D1X D1Y)  
        DTapHole=geomHoles(DTap2Check innermost)  
        DTapSuspect=geomAndNot(DTap2Check geomButtOnly(geomOutside(DTap2Check DTapHole) DTapHole))  
        errorLayer(geomEncloseRect(DTapSuspect 20 0.22) RULE_COMMENT)
    )

    if(VOLTAGE_1_5V==1 then
        let( /* ESD.18g_1.5V */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "ESD.18g_1.5V  Minimum 1.5V IO ESD NMOS/PMOS gate length >=0.2um" )    
            drc(LEGT width<0.2 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
        )

    )
    if(VOLTAGE_1_8V==1 then
        let( /* ESD.18g_1.8V */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "ESD.18g_1.8V  Minimum 1.8V IO ESD NMOS/PMOS gate length >=0.25um" )    
            drc(LEGT width<0.25 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
        )

    )
    if(VOLTAGE_2_5V==1 then
        let( /* ESD.18g_2.5V_N */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "ESD.18g_2.5V_N  Minimum 2.5V IO ESD NMOS gate length < 0.3um" )    
            drc(HEGN width<0.3 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
        )

        let( /* ESD.18g_2.5V_P */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "ESD.18g_2.5V_P  Minimum 2.5V IO ESD PMOS gate length < 0.25um" )    
            drc(HEGP width<0.25 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
        )

    )
    if(VOLTAGE_3_3V==1 then
        let( /* ESD.18g_3.3V_N */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "ESD.18g_3.3V_N  Minimum 3.3V IO ESD NMOS gate length < 0.4um" )    
            drc(HEGN width<0.4 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
        )

        let( /* ESD.18g_3.3V_P */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "ESD.18g_3.3V_P  Minimum 3.3V IO ESD PMOS gate length < 0.3um" )    
            drc(HEGP width<0.3 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
        )

    )

    if(VOLTAGE_5V==1 then
        HEGN1=geomButtOrOver(HEGN ESD)  
        HEGN2=geomAndNot(HEGN HEGN1)  
        let( /* ESD.18g_5V_NESD */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "ESD.18g_5V_NESD  Minimum 5.0V IO ESD NMOS(without ESD implant)/PMOS gate length >= 0.6um" )    
            drc(HEGN2 width<0.6 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
        )

        let( /* ESD.18g_5V_P */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "ESD.18g_5V_P  Minimum 5.0V IO ESD NMOS(without ESD implant)/PMOS gate length >= 0.6um" )    
            drc(HEGP width<0.6 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
        )

        let( /* ESD.18g_5V_WESD */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "ESD.18g_5V_WESD  Minimum 5.0V IO ESD NMOS (with ESD implant) gate length >=0.9um" )    
            drc(HEGN1 width<0.9 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
        )

    )

    let( /* ESD.19g */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "ESD.19g  NMOS and PMOS of I/O buffer should have a nonsalicide area on drain side, that is, RPO mask should"
            "block drain side of device (except contact region should keep silicided)."
        )  )    
        errorLayer(geomAndNot(geomInside(EGTE EPMOS) geomButtOrOver(geomInside(EGTE EPMOS) geomButtOrOver(EPSD RPO))) RULE_COMMENT)
        errorLayer(geomAndNot(geomInside(EGTE geomButtOrOver(ENMOS RPO)) geomButtOrOver(geomInside(EGTE geomButtOrOver(ENMOS RPO)) geomButtOrOver(ENSD RPO))) RULE_COMMENT)
    )

    let( /* ESD.20g */ (RULE_COMMENT X ESD2_TOL_GATE_RPO ESD2_TOL_GATE_RPO_CH A)
        sprintf(RULE_COMMENT strcat(
            "ESD.20g  For high voltage tolerant I/O designed by 3.3V/2.5V/1.8V/1.5V NMOS (see N1 and N2 in Fig.5b)"
            "RPO should cover all inactive poly gates and extend to active region (Poly spacing==0.25um)."
            "Minimum and maximum overlap from RPO to the active poly gate 0.05um or 0.06um"
        )   )    
        X=geomAndNot(ESD2_TOL_GATE RPO)  
        errorLayer(geomAndNot(ESD2_TOL geomButtOrOver(ESD2_TOL X)) RULE_COMMENT)
        errorLayer(geomOutside(ESD2_TOL_GATE2 RPO) RULE_COMMENT)
        errorLayer(geomAndNot(ESD2_TOL_GATE1 RPO) RULE_COMMENT)
        drc(ESD2_TOL_GATE2 RPO ovlp<0.05 opposite shielded withIntersection RULE_COMMENT)
        ESD2_TOL_GATE_RPO=geomStraddle(ESD2_TOL_GATE RPO)  
        ESD2_TOL_GATE_RPO_CH=geomAnd(ESD2_TOL_GATE_RPO RPO)  
        A=geomSize(geomSize(ESD2_TOL_GATE_RPO_CH -0.025 noClipAcute) 0.025 noClipAcute)  
        errorLayer(geomOr(drc(A width<0.06 opposite shielded) geomStretchCorner(geomGetCorner(A keep<90) 0.06 angleAll)) RULE_COMMENT)
        errorLayer(geomSize(geomSize(A -0.03 noClipAcute) 0.03 noClipAcute) RULE_COMMENT)
    )

    let( /* ESD.20g_A */ (RULE_COMMENT X)
        sprintf(RULE_COMMENT strcat(
            "ESD.20g_A  For high voltage tolerant I/O designed by 3.3V/2.5V/1.8V/1.5V NMOS (see N1 and N2 in Fig.5b)"
            "RPO should cover all inactive poly gates and extend to active region (Poly spacing==0.25um)."
            "Minimum and maximum overlap from RPO to the active poly gate by 0.05um"
        )   )    
        X=geomButtOrOver(ENSD_NCO ESD2DMY)  
        drc(X width<0.25 shielded RULE_COMMENT)
        errorLayer(geomSize(geomSize(X -(0.25/2) noClipAcute) (0.25/2) noClipAcute) RULE_COMMENT)
    )

    let( /* ESD.21g */ (RULE_COMMENT X ESD2_REG_GATE_RPO ESD2_REG_GATE_RPO_CH A)
        sprintf(RULE_COMMENT strcat(
            "ESD.21g  For regular I/O designed by 5V, 3.3V, 2.5V, 1.8V and 1.5V NMOS (see N3 in Fig.6a)"
            "Minimum and maximum overlap from RPO on the drain side to the active poly gate 0.05um or 0.06um"
        )  )    
        X=geomAndNot(ESD2_REG_GATE RPO)  
        errorLayer(geomAndNot(ESD2_REG geomButtOrOver(ESD2_REG X)) RULE_COMMENT)
        errorLayer(geomOutside(ESD2_REG_GATE RPO) RULE_COMMENT)
        drc(ESD2_REG_GATE RPO ovlp<0.05 opposite shielded withIntersection RULE_COMMENT)
        ESD2_REG_GATE_RPO=geomStraddle(ESD2_REG_GATE RPO)  
        ESD2_REG_GATE_RPO_CH=geomAnd(ESD2_REG_GATE_RPO RPO)  
        A=geomSize(geomSize(ESD2_REG_GATE_RPO_CH -0.025 noClipAcute) 0.025 noClipAcute)  
        errorLayer(geomOr(drc(A width<0.06 opposite shielded) geomStretchCorner(geomGetCorner(A keep<90) 0.06 angleAll)) RULE_COMMENT)
        errorLayer(geomSize(geomSize(A -0.03 noClipAcute) 0.03 noClipAcute) RULE_COMMENT)
    )

    ;;  ESD.23g is checked by ESD.21g 
    let( /* ESD.24g */ (RULE_COMMENT X Y Z)
        sprintf(RULE_COMMENT strcat(
            "ESD.24g  The minimum width of RPO on drain side (X) for 5V,3.3V, 2.5V, 1.8V and 1.5V NMOS and PMOS."
            "exclude 1.8V and 1.5V NMOS when used as power clamp device>=1.95um"
        )  )    
        X=geomAnd(geomAnd(geomOr(ENSD_WCO EPSD_WCO) ESD2DMY) RPO)  
        Y=geomGetEdge(EGTE butting X)  
        Z=geomGetEdge(RPO coincident X)  
        drc(Z Y enc<1.95 shielded withIntersection RULE_COMMENT)
    )

    let( /* ESD.25g */ (RULE_COMMENT X Y)
        sprintf(RULE_COMMENT "ESD.25g  The minimum clearance from poly edge to CO edge on source side for NMOS and PMOS (Except ESD.26g)>=0.5um" )    
        X=geomAnd(ECOS geomButtOrOver(geomOr(ENMOS EPMOS) RPO))  
        drc(X EGTE_W sep<0.5 opposite shielded withIntersection RULE_COMMENT)
        Y=geomAnd(ECO ESD1_NCS)  
        drc(Y EGTE_W sep<0.5 opposite shielded withIntersection RULE_COMMENT)
    )

    let( /* ESD.26g */ (RULE_COMMENT X)
        sprintf(RULE_COMMENT "ESD.26g  The minimum clearance of poly edge to CO edge on D/S side for 1.8V and 1.5V power clamp device>=0.25um" )    
        X=geomAnd(ECO geomAndNot(ENMOS geomButtOrOver(ENMOS RPO)))  
        drc(X EGTE_W sep<0.25 opposite shielded withIntersection RULE_COMMENT)
    )

    let( /* ESD.27g */ (RULE_COMMENT X)
        sprintf(RULE_COMMENT strcat(
            "ESD.27g  For RPO DRC purpose,we need a dummy layers in ESD protection device.layers should cover all ESD protection devices."
            "ESD2DMY is for the cascade NMOS in high voltage tolerant I/O designed by 3.3V/2.5V NMOS (see Fig.5b), regular IO designed by"
            "5V/3.3V/2.5V/1.8V/1.5V NMOS and PMOS (see Fig.6b), power clmap designed by 5V/3.3V/2.5V NMOS."
        )   )    
        X=geomStraddle(EGTE RPO)  
        errorLayer(geomAndNot(geomInside(EGTE geomEnclose(ENMOS X)  ) ESD2DMY) RULE_COMMENT)
        errorLayer(geomAndNot(geomInside(EGTE geomEnclose(EPMOS X)  ) ESD2DMY) RULE_COMMENT)
    )

    if(VOLTAGE_5V==0 then
        let( /* ESD.28g */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "ESD.28g  ESD implant is required for High Voltage Tolerant I/O designed by 3.3V NMOS device for 5V signal"
                "input or 2.5V NMOS device for 3.3V signal input at I/O pad. ESD mask (No. 111) can be generated by"
                "logical operation. It is not allowed to use ESD mask (No. 111) for 5V NMOS device."
                "ESD3DMY or ESDIMP is for the cascade NMOS in high voltage tolerant I/O designed by 3.3V/2.5V NMOS (see Fig.5b)."
            )    )    
            errorLayer(geomButtOrOver(geomButtOrOver(geomEnclose(ENMOS LEGT)   ESD2DMY) geomOr(ESD3DMY ESDIMP)) RULE_COMMENT)
            errorLayer(geomAndNot(geomAndNot(geomEnclose(ENMOS geomAnd(ESD2_TOL_GATE OD2))   ESD3DMY) geomButtOrOver(geomAndNot(geomEnclose(ENMOS geomAnd(ESD2_TOL_GATE OD2))   ESD3DMY) ESDIMP)) RULE_COMMENT)
            errorLayer(geomAnd(ESD3DMY GATE_PP) RULE_COMMENT)
            errorLayer(geomButtOrOver(ESDIMP EPMOS) RULE_COMMENT)
        )

    )
    let( /* ESD.30g */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESD.30g  For regular 1.8V I/O in NMOS region : Minumum clearance from RPO to poly spacing >=0.45um." )    
        drc(RPO1 EGTE1_W sep<0.45 opposite shielded withIntersection RULE_COMMENT)
        errorLayer(geomAnd(EGTE1 RPO1) RULE_COMMENT)
    )

    let( /* ESD.32g */ (RULE_COMMENT Y)
        sprintf(RULE_COMMENT "ESD.32g  The minimum width of RPO on drain side (X) for 1.8V NMOS and 5V/3.3V/1.8V/1.5V PMOS.>=1.5um" )    
        Y=geomGetEdge(RPO1 inside OD)  
        drc(Y width<1.5 shielded RULE_COMMENT)
    )

    let( /* ESD.34g */ (RULE_COMMENT)
        sprintf(RULE_COMMENT strcat(
            "ESD.34g  5V, 3.3V and 2.5V NMOS devices when used as power clamp devices, the RPO can fully cover the"
            "uncontacted poly gate, source/drain (except contact region should keep silicided)."
        )  )    
        errorLayer(geomAndNot(geomButtOrOver(ENMOS ESD1DMY) ERPOA) RULE_COMMENT)
    )

    geomConnect(incremental 
        buttOrOver(NTAPi NWELi)
        buttOrOver(NTAPi PSDi)
        buttOrOver(PTAPi NSDi)
        via(COi M1xd ILP1i NTAPi PTAPi PSDi NSDi)
        via(VIA1i M1xd M2xd)
        via(VIA2i M2xd M3xd)
        via(VIA3i M3xd M4xd)
        via(VIAt M4xd M5xd)
        via(VIAc CTM4i M5xd)
        via(VIADi M5xd MDxd)
    )

    NCS_SD_1=geomAnd(geomAndNot(geomButtOrOver(OD EGTE) POLY) ESD1DMY)  
    NCS_SD=geomCat(NCS_SD_1)
    geomStamp(NCS_SD NSDi)
    NCS_S=geomNodeRelate(NCS_SD PTAPi conn)  
    NCS_D=geomAndNot(NCS_SD NCS_S)  
    let( /* ESD.35g */ (RULE_COMMENT X Y Z)
        sprintf(RULE_COMMENT strcat(
            "ESD.35g  Minimum width of RPO on drain side (X) for 5V, 3.3V and 2.5V NMOS devices when used as power clamp"
            "devices. Ncs Drain is defined as (((OD INTERACT GATE) NOT PO) AND ESD1DMY)"
            "which not connect to PW Pickup.>=1.95um"
        )   )    
        X=geomAnd(NCS_D RPO)  
        Y=geomGetEdge(EGTE butting NCS_D)  
        Z=geomGetEdge(RPO coincident X)  
        drc(Z Y enc<1.95 shielded withIntersection RULE_COMMENT)
    )

    let( /* ESD.37g */ (RULE_COMMENT X Y)
        sprintf(RULE_COMMENT strcat(
            "ESD.37g  For RPO DRC purpose, we need a dummy layers for 5V, 3.3Vand 2.5V NMOS devices when used as power"
            "clamp devices. The layers should cover all ESD protection devices."
        )  )    
        X=geomAndNot(EGTE geomInside(EGTE RPO))  
        Y=geomAndNot(ENMOS geomEnclose(ENMOS X)  )  
        errorLayer(geomAndNot(Y geomButtOrOver(Y ESD1DMY)) RULE_COMMENT)
        errorLayer(geomAnd(ESD1DMY GATE_PP) RULE_COMMENT)
        errorLayer(geomAndNot(geomInside(EGTE geomEnclose(ENMOS ESD1_GATE)  ) ESD1DMY) RULE_COMMENT)
    )

    ;; ESD.39g IS checked by ESD.3g 

    let( /* ESD.WARN.1 */ (RULE_COMMENT RED XRPO XRPG)
        sprintf(RULE_COMMENT "ESD.WARN.1  CO can't inserted between gate and RPO for 1.8V NMOS and all PMOS I/O pattern." )    
        RED=geomButtOrOver(geomOr(EPSD ENSD) RPO1)  
        XRPO=geomAndNot(RED RPO1)  
        XRPG=geomButtOnly(geomOutside(XRPO EGTE1) EGTE1)  
        errorLayer(geomButtOrOver(XRPG ECO) RULE_COMMENT)
    )

    if(VOLTAGE_5V==1 then
        let( /* ESD.WARN.2 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "ESD.WARN.2  ESD3DMY is not allowed in 5V process." )    
            errorLayer(geomCat(ESD3DMY) RULE_COMMENT)
        )

    )
    if(VOLTAGE_5V==0 then
        let( /* ESD.WARN.3 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "ESD.WARN.3  ESD is not allowed in processes except 5V." )    
            errorLayer(geomCat(ESD) RULE_COMMENT)
        )

    )

)

if(VOLTAGE_5V==1 then
    let( /* ESD.W.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESD.W.1  Minimum esd width < 0.6" )    
        drc(ESD width<0.6 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
    )

    let( /* ESD.S.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESD.S.1  Minimum esd space < 0.6" )    
        drc(ESD 0<sepNotch<0.6 shielded withIntersection RULE_COMMENT)
    )

    let( /* ESD.S.2 */ (RULE_COMMENT X Y)
        sprintf(RULE_COMMENT "ESD.S.2  Minimum space between ESD and NP or PP < 0.3" )    
        drc(ESD PP sep<0.3 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
        drc(ESD NP sep<0.3 shielded withIntersection withSingularPoint RULE_COMMENT)
        X=drc(ESD PP sep<0.001 withIntersection==0 edgeb shielded)  
        Y=geomSize(X 0.001 edges)  
        errorLayer(geomAndNot(Y geomButtOrOver(Y NPOD)) RULE_COMMENT)
    )

    let( /* ESD.C.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESD.C.1  Minimum clearance from an ESD to an NP OD < 0.6" )    
        drc(ESD NPOD sep<0.6 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* ESD.C.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESD.C.2  Minimum clearance from an ESD to a N-ch PO gate < 0.45" )    
        drc(ESD GATE_W enc<0.45 shielded withIntersection with_perp RULE_COMMENT)
        errorLayer(geomStraddle(ALL_GATE ESD) RULE_COMMENT)
    )

    let( /* ESD.O.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESD.O.1  Minimum overlap from an ESD edge to an OD region < 0.45" )    
        drc(ESD OD ovlp<0.45 0<withIntersection<90 shielded withSingularPoint RULE_COMMENT)
    )

    let( /* ESD.C.4 */ (RULE_COMMENT X)
        sprintf(RULE_COMMENT "ESD.C.4  Min. space from ESD to ESD OD < 0.6" )    
        X=geomButtOrOver(NPOD ESD)  
        drc(ESD X sep<0.6 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* ESD.E.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESD.E.1  Minimum extension of an ESD region beyond an ESD OD < 0.25" )    
        drc(ESD OD enc<0.25 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomInside(ESD OD) RULE_COMMENT)
    )

    let( /* ESD.R.1 */ (RULE_COMMENT A)
        sprintf(RULE_COMMENT "ESD.R.1  ESD and PP not allowed on same POLY region" )    
        A=geomAnd(ESD POLY)  
        errorLayer(geomAnd(A PP) RULE_COMMENT)
    )

    let( /* ESD.R.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESD.R.2  ESD is for 5.0V NMOS only" )    
        errorLayer(geomAnd(ESD geomAnd(ALL_GATE PP)) RULE_COMMENT)
        errorLayer(geomAnd(ESD geomAndNot(geomAnd(ALL_GATE NP) OD2)) RULE_COMMENT)
    )

)

if(VOLTAGE_3_3V==1 then
    let( /* ESDIMP.W.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESDIMP.W.1  Minimum esdimp width >= %f" ESDIMP_W_1)    
        drc(ESDIMP width<ESDIMP_W_1 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
    )

    let( /* ESDIMP.S.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESDIMP.S.1  Minimum esdimp space >= %f" ESDIMP_S_1)    
        drc(ESDIMP 0<sepNotch<ESDIMP_S_1 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

    let( /* ESDIMP.S.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESDIMP.S.2  Minimum space to esd3dmy (Overlap is prohibited) >= %f" ESDIMP_S_2)    
        drc(ESDIMP ESD3DMY sep<ESDIMP_S_1 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomAnd(ESDIMP ESD3DMY) RULE_COMMENT)
    )

    let( /* ESDIMP.EN.1 */ (RULE_COMMENT A)
        sprintf(RULE_COMMENT "ESDIMP.EN.1  (OD not POLY) enclosure of esdimp (esdimp must be fully inside (OD not POLY)) >= %f" ESDIMP_EN_1)    
        A=geomAndNot(OD POLY)  
        drc(A ESDIMP enc<ESDIMP_EN_1 shielded withIntersection withSingularPoint RULE_COMMENT)
        errorLayer(geomAndNot(ESDIMP A) RULE_COMMENT)
    )

    if(Recommend==1 then
        let( /* ESDIMP.EN.1_R */ (RULE_COMMENT A B C)
            sprintf(RULE_COMMENT "ESDIMP.EN.1_R  (OD not POLY) enclosure of esdimp (esdimp must be fully inside (OD not POLY)) = %f" ESDIMP_EN_1)    
            A=geomAndNot(OD POLY)  
            drc(A ESDIMP enc<ESDIMP_EN_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            B=geomOr(geomHoles(ESDIMP innermost) ESDIMP)  
            C=geomSize(B ESDIMP_EN_1 noClipAcute)  
            errorLayer(geomAndNot(C geomOr(geomGetEdge(C coincident A wholeEdge) geomGetEdge(C butting A  wholeEdge)) edges) RULE_COMMENT)
        )

    )

    let( /* ESDIMP.A.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESDIMP.A.1  Minimum esdimp area >= %f" ESDIMP_A_1)    
        drc(ESDIMP area<ESDIMP_A_1 RULE_COMMENT) 
    )

    let( /* ESDIMP.A.2 */ (RULE_COMMENT A)
        sprintf(RULE_COMMENT "ESDIMP.A.2  Minimum esdimp enclosed area >= %f" ESDIMP_A_2)    
        A=geomAndNot(geomHoles(ESDIMP innermost) ESDIMP)  
        drc(A area<ESDIMP_A_2 RULE_COMMENT) 
    )

    let( /* ESDIMP.R.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "ESDIMP.R.1  esdimp must be fully inside N+ active" )    
        errorLayer(geomAndNot(ESDIMP NACT) RULE_COMMENT)
    )

)

;;  Latch-Up CHECKS 
;; ================ 
RWi=geomInside(PWELi DNWi)  
NWRiT=geomAndNot(geomButtOrOver(NWELi RWDMY) RWDMY) ;;  NWR terminal  
SRM=geomCat(EXCL)  
;;  1_Ground up 

;;  2_RDL (before passivation) 
;; CONNECT M6xd MDxd BY VIADi 

NSDd=geomAndNot(NSDc RPO_RPDMY) ;;  NMOS source/drain for connection  
PSDd=geomAndNot(PSDc RPO_RPDMY) ;;  PMOS source/drain for connection  

;; Build connection for RES200 

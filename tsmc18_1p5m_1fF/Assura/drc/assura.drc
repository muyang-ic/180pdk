LM4XA=geomAnd(geomSize(geomSize(geomSize(geomSize(FIM4c -1.0 noClipAcute) 1.0 noClipAcute) -17.5 truncate 17.5) 17.5 truncate 17.5) FIM4c)  
LM4X=geomEncloseRect(LM4XA 35.005 35.005)  
M4HoleD=geomAnd(M4HoleSpace LM4X)  
PAD_EXD=geomAndNot(UBMi geomButtOrOver(UBMi MDxd))  
PAD_EXD5=geomSizeAnd(PAD_EXD M5xd 0.32 2 noClipAcute)  
M5EXD=geomAndNot(M5xd geomOr(SLT_EXDT PAD_EXD5))  
M5InnerHole=geomHoles(M5EXD innermost)  
M5BigHole=geomSize(M5InnerHole (-5) noClipAcute)  
M5Hole=geomOutside(M5InnerHole M5BigHole)  
M5HoleSpace=geomAndNot(M5Hole M5EXD)  
FIM5c=geomOr(M5EXD M5HoleSpace)  
LM5XA=geomAnd(geomSize(geomSize(geomSize(geomSize(FIM5c -1.0 noClipAcute) 1.0 noClipAcute) -17.5 truncate 17.5) 17.5 truncate 17.5) FIM5c)  
LM5X=geomEncloseRect(LM5XA 35.005 35.005)  
M5HoleD=geomAnd(M5HoleSpace LM5X)  
UBM_EXDD=geomSizeAnd(UBMi MDxd 0.32 2 noClipAcute) ;;  For RDL  
MDEXD=geomAndNot(MDxd geomOr(DPDMY UBM_EXDD))  
MDInnerHole=geomHoles(MDEXD innermost)  
MDBigHole=geomSize(MDInnerHole (-5) noClipAcute) ;;  Holes with width less than 10um will be filled back  
MDHole=geomOutside(MDInnerHole MDBigHole)  
MDHoleSpace=geomAndNot(MDHole MDEXD)  
FIMDc=geomOr(MDEXD MDHoleSpace)  
LMDXA=geomAnd(geomSize(geomSize(geomSize(geomSize(FIMDc -1.0 noClipAcute) 1.0 noClipAcute) -17.5 truncate 17.5) 17.5 truncate 17.5) FIMDc)  
LMDX=geomEncloseRect(LMDXA 35.005 35.005)  
MDHoleD=geomAnd(MDHoleSpace LMDX)  
if(CHECK_DUMMY_ODPO==1 then
    OD=geomAndNot(geomOr(ODi DOD) EXCL)  
    POLY=geomAndNot(geomOr(POLYi DPO) EXCL)  

else
    OD=geomAndNot(ODi EXCL)  
    POLY=geomAndNot(POLYi EXCL)  
)
ALL_GATE=geomAnd(POLY OD) ;;  Gate regions for NMOS and PMOS  
PP=geomAndNot(PPi geomInside(PPi EXCL))  
PPOD=geomAnd(PP OD) ;;  P+ OD region  
PACT=geomAnd(PPOD NWEL) ;;  PMOS Device  
EPACT=geomAndNot(geomAnd(SDI PACT) DIODUMMY)  
EPMOS=geomEnclose(EPACT ALL_GATE)    
EGTE=geomAndNot(geomAnd(SDI ALL_GATE) DIODUMMY)  
EPSD=geomAndNot(EPMOS EGTE)  
NP=geomAndNot(NPi geomInside(NPi EXCL))  
NPOD=geomAnd(NP OD) ;;  N+ OD region  
NACT=geomAndNot(NPOD NWEL) ;;  NMOS Device  
ENACT=geomAndNot(geomAnd(SDI NACT) DIODUMMY)  
ENMOS=geomEnclose(ENACT ALL_GATE)    
ENSD=geomAndNot(ENMOS EGTE)  
UBMn=geomAndNot(geomAndNot(UBMi geomButtOrOver(UBMi PPIi)) geomButtOrOver(geomAndNot(UBMi geomButtOrOver(UBMi PPIi)) MDi)) ;;  UBM lie on Top Metal  
UBMd=geomAndNot(UBMi UBMn) ;;  UBM lie on PPI or MD  
NW_RES_200ohm=geomAnd(geomAnd(NWELi RWDMY) RES200)  
NWELj=geomAndNot(NWELi NW_RES_200ohm)  
PO_RES_200ohm=geomAnd(geomAnd(POLY RPDUMMY) RES200)  
ILP1j=geomAndNot(POLYi PO_RES_200ohm)  
NPODc=geomAnd(NPi ODi)  
NACTc=geomAndNot(NPODc NWELi)  
NSDc=geomAndNot(NACTc POLYi) ;;  NMOS source/drain  
OD_RES_200ohm=geomAnd(geomAnd(OD RPDUMMY) RES200)  
NSDj=geomAndNot(NSDc OD_RES_200ohm)  
PPODc=geomAnd(PPi ODi)  
PACTc=geomAnd(PPODc NWELi)  
PSDc=geomAndNot(PACTc POLYi) ;;  PMOS source/drain  
PSDj=geomAndNot(PSDc OD_RES_200ohm)  
EMPTYi=geomAndNot(CHIP BULK)  
NTAPj=geomOr(EMPTYi geomAnd(NPODc NWELi))  
PTAPc=geomAndNot(PPODc NWELi)  
PTAPj=geomOr(EMPTYi PTAPc)  
COj=geomOr(EMPTYi COi)  
M1j=geomOr(EMPTYi M1i)  
VIA1j=geomOr(EMPTYi VIA1i)  
M2j=geomOr(EMPTYi M2i)  
VIA2j=geomOr(EMPTYi VIA2i)  
M3j=geomOr(EMPTYi M3i)  
VIA3j=geomOr(EMPTYi VIA3i)  
M4j=geomOr(EMPTYi M4i)  
M5j=geomOr(EMPTYi M5i)  
VIADj=geomOr(EMPTYi VIADi)  
MDj=geomOr(EMPTYi MDi)  
CTM4j=geomOr(EMPTYi CTM4i)  
CBj=geomOr(EMPTYi CBi)  
CBDj=geomOr(EMPTYi CBDi)  
PPIj=geomOr(EMPTYi PPIi)  
UBMnj=geomOr(EMPTYi UBMn)  
UBMdj=geomOr(EMPTYi UBMd)  
NWELu=geomCat(NWELi)  
ILP1u=geomCat(POLYi)  
NSDu=geomCat(NSDc)  
PSDu=geomCat(PSDc)  
NTAPu=geomAnd(NPODc NWELi)  
PTAPu=geomCat(PTAPc)  
COu=geomCat(COi)  
M1u=geomCat(M1i)  
VIA1u=geomCat(VIA1i)  
M2u=geomCat(M2i)  
VIA2u=geomCat(VIA2i)  
M3u=geomCat(M3i)  
VIA3u=geomCat(VIA3i)  
M4u=geomCat(M4i)  
M5u=geomCat(M5i)  
VIADu=geomCat(VIADi)  
MDu=geomCat(MDi)  
CTM4u=geomCat(CTM4i)  
CBu=geomCat(CBi)  
CBDu=geomCat(CBDi)  
PPIu=geomCat(PPIi)  
UBMnu=geomCat(UBMn)  
UBMdu=geomCat(UBMd) ;; Build connection for DISCONNECT_ALL_RESISTOR  
NWELk=geomAndNot(NWELi EMPTYi)  
RPO_RPDMY=geomOr(RPOi RPDUMMY)  
ILP1k=geomAndNot(POLYi RPO_RPDMY)  
NSDk=geomAndNot(NSDc RPO_RPDMY)  
PSDk=geomAndNot(PSDc RPO_RPDMY)  
NTAPc=geomAnd(NPODc NONWRi)  
NTAPk=geomAndNot(NTAPc EMPTYi)  
PTAPk=geomAndNot(PTAPc EMPTYi)  
COk=geomAndNot(COi EMPTYi)  
M1k=geomAndNot(M1i EMPTYi)  
VIA1k=geomAndNot(VIA1i EMPTYi)  
M2k=geomAndNot(M2i EMPTYi)  
VIA2k=geomAndNot(VIA2i EMPTYi)  
M3k=geomAndNot(M3i EMPTYi)  
VIA3k=geomAndNot(VIA3i EMPTYi)  
M4k=geomAndNot(M4i EMPTYi)  
M5k=geomAndNot(M5i EMPTYi)  
VIADk=geomAndNot(VIADi EMPTYi)  
MDk=geomAndNot(MDi EMPTYi)  
CTM4k=geomAndNot(CTM4i EMPTYi)  
CBk=geomAndNot(CBi EMPTYi)  
CBDk=geomAndNot(CBDi EMPTYi)  
PPIk=geomAndNot(PPIi EMPTYi)  
UBMnk=geomAndNot(UBMn EMPTYi)  
UBMdk=geomAndNot(UBMd EMPTYi)  
VIA4j=geomOr(EMPTYi VIA4i)  
VIAtj=geomAndNot(VIA4j geomButtOrOver(VIA4j CTM4j))  
VIAcj=geomAnd(VIA4j CTM4j)  
VIA4u=geomCat(VIA4i)  
VIAtu=geomAndNot(VIA4u geomButtOrOver(VIA4u CTM4u))  
VIAcu=geomAnd(VIA4u CTM4u)  
VIA4k=geomAndNot(VIA4i EMPTYi)  
VIAtk=geomAndNot(VIA4k geomButtOrOver(VIA4k CTM4k))  
VIAck=geomAnd(VIA4k CTM4k)  
geomConnect(
    buttOrOver(NTAPi NWELi)
    buttOrOver(NTAPi PSDi)
    buttOrOver(PTAPi NSDi)
    via(COi M1xd ILP1i NTAPi PTAPi PSDi NSDi)
    via(VIA1i M1xd M2xd)
    via(VIA2i M2xd M3xd)
    via(VIA3i M3xd M4xd)
    via(VIAt M4xd M5xd)
    via(VIAc CTM4i M5xd)
    via(VIADi M5xd MDxd)
    buttOrOver(VIA1_4stack_Final VIA1_Violate_S_4_A1)
    buttOrOver(VIA1_4stack_Final VIA2_Violate_S_4_A1)
    buttOrOver(VIA1_4stack_Final VIA3_Violate_S_4_A1)
    buttOrOver(VIA1_4stack_Final VIA4_Violate_S_4_A1)
    buttOrOver(VIA1_3stack_Final VIA1_Violate_S_3_A1)
    buttOrOver(VIA1_3stack_Final VIA2_Violate_S_3_A1)
    buttOrOver(VIA1_3stack_Final VIA3_Violate_S_3_A1)
    buttOrOver(VIA2_3stack_Final VIA2_Violate_S_3_A2)
    buttOrOver(VIA2_3stack_Final VIA3_Violate_S_3_A2)
    buttOrOver(VIA2_3stack_Final VIA4_Violate_S_3_A2)
    buttOrOver(VIA1_2stack_Final VIA1_Violate_S_2_A1)
    buttOrOver(VIA1_2stack_Final VIA2_Violate_S_2_A1)
    buttOrOver(VIA2_2stack_Final VIA2_Violate_S_2_A2)
    buttOrOver(VIA2_2stack_Final VIA3_Violate_S_2_A2)
    buttOrOver(VIA3_2stack_Final VIA3_Violate_S_2_A3)
    buttOrOver(VIA3_2stack_Final VIA4_Violate_S_2_A3)
    buttOrOver(M1HoleD LM1X)
    buttOrOver(M2HoleD LM2X)
    buttOrOver(M3HoleD LM3X)
    buttOrOver(M4HoleD LM4X)
    buttOrOver(M5HoleD LM5X)
    buttOrOver(MDHoleD LMDX)
    buttOrOver(ENSD NSDi)
    buttOrOver(EPSD PSDi)
    buttOrOver(NWEL DNW)
    buttOrOver(M5xd CBi)
    via(CBDi M5xd UBMn)
    buttOrOver(MDxd UBMd)
    via(CBDi M5xd PPIi)
    buttOrOver(PPIi UBMd)
    buttOrOver(NTAPj NWELj)
    buttOrOver(NTAPj PSDj)
    buttOrOver(PTAPj NSDj)
    via(COj M1j ILP1j NTAPj PTAPj PSDj NSDj)
    via(VIA1j M1j M2j)
    via(VIA2j M2j M3j)
    via(VIA3j M3j M4j)
    via(VIAtj M4j M5j)
    via(VIAcj CTM4j M5j)
    via(VIADj M5j MDj)
    buttOrOver(M5j CBj)
    via(CBDj M5j UBMnj)
    buttOrOver(MDj UBMdj)
    via(CBDj M5j PPIj)
    buttOrOver(PPIj UBMdj)
    buttOrOver(NTAPu NWELu)
    buttOrOver(NTAPu PSDu)
    buttOrOver(PTAPu NSDu)
    via(COu M1u ILP1u NTAPu PTAPu PSDu NSDu)
    via(VIA1u M1u M2u)
    via(VIA2u M2u M3u)
    via(VIA3u M3u M4u)
    via(VIAtu M4u M5u)
    via(VIAcu CTM4u M5u)
    via(VIADu M5u MDu)
    buttOrOver(M5u CBu)
    via(CBDu M5u UBMnu)
    buttOrOver(MDu UBMdu)
    via(CBDu M5u PPIu)
    buttOrOver(PPIu UBMdu)
    buttOrOver(NTAPk NWELk)
    buttOrOver(NTAPk PSDk)
    buttOrOver(PTAPk NSDk)
    via(COk M1k ILP1k NTAPk PTAPk PSDk NSDk)
    via(VIA1k M1k M2k)
    via(VIA2k M2k M3k)
    via(VIA3k M3k M4k)
    via(VIAtk M4k M5k)
    via(VIAck CTM4k M5k)
    via(VIADk M5k MDk)
    buttOrOver(M5k CBk)
    via(CBDk M5k UBMnk)
    buttOrOver(MDk UBMdk)
    via(CBDk M5k PPIk)
    buttOrOver(PPIk UBMdk)
)
M1x=geomAndNot(M1i M1SLOTi)  

M2x=geomAndNot(M2i M2SLOTi)  

M3x=geomAndNot(M3i M3SLOTi)  

M4x=geomAndNot(M4i M4SLOTi)  

M5x=geomAndNot(M5i M5SLOTi)  

MDx=geomAndNot(MDi MDSLOTi)  

;; /////////////////////////////////////////////////////////////////////////////// 

;;  EXCLUDE UNCHECKED REGIONS 
;; -------------------------- 

;;  Front-End Layer 
;; ---------------- 
PWELi=geomAndNot(BULK NWELi)  
PWEL=geomAndNot(PWELi EXCL)  
VTMP=geomAndNot(VTMPi EXCL)  
VTMN=geomAndNot(VTMNi EXCL)  
OD2=geomAndNot(OD2i EXCL)  
CO=geomAndNot(COi EXCL)  

;;  Back-End Layer 
;; --------------- 
M1_A=geomAndNot(M1xd geomInside(M1xd EXCL))  
VIAD=geomAndNot(VIADi geomInside(VIADi EXCL_S))  
MD=geomAndNot(MDxd geomInside(MDxd EXCL_S))  
CB=geomAndNot(CBi EXCL_S)  
CBD=geomAndNot(CBDi EXCL_S)  
RPO=geomAndNot(RPOi EXCL)  
NTN=geomAndNot(NTNi EXCL)  
PLMIDE=geomAndNot(PLMIDEi EXCL_S) ;; FUSE	= FUSEi	NOT EXCL  
FW=geomAndNot(FWi EXCL_S)  
LW=geomAndNot(LWI EXCL_S)  
HRI=geomAndNot(HRIi EXCL)  
ESD=geomAndNot(ESDi EXCL_S)  
ESDIMP=geomAndNot(ESDIMPi EXCL_S)  

CTM2=geomAndNot(CTM2i EXCL_S)  
CTM3=geomAndNot(CTM3i EXCL_S)  
CTM4=geomAndNot(CTM4i EXCL_S)  
CTM5=geomAndNot(CTM5i EXCL_S)  

;;  GLOBAL DERIVED LAYERS FOR RULE CHECKS 
;; -------------------------------------- 
ALL_OD=geomOr(ODi DOD) ;; For OD density check  
ALL_PO=geomOr(POLYi DPO) ;; For POLY density check  

POLY_ISO=geomAndNot(POLY OD) ;;  Interconnect POLY  
LVGT=geomAndNot(ALL_GATE OD2) ;;  1.8V gate  
HVGT=geomAnd(ALL_GATE OD2) ;;  3.3V gate  
RNWEL=geomStraddle(NWEL RWDMY) ;;  NWEL resistor (UNDER OD & STI)  
NONWR=geomAndNot(NWEL RNWEL) ;;  NWEL - NWR(OD) - NWR(STI)  
NTAP=geomAnd(NPOD NONWR) ;;  NWEL Pick-Up  
PTAP=geomAndNot(PPOD NWEL) ;;  Substrate(PWEL) Pick-Up  

GATE_W=geomGetEdge(POLY inside OD) ;;  Gate width  
GATE_L=geomGetEdge(OD inside POLY) ;;  Channel length  
GATE_NP=geomAnd(ALL_GATE NP) ;;  N+ Gate  
GATE_PP=geomAnd(ALL_GATE PP) ;;  P+ Gate  

FPO1=geomCat(POLY_ISO) ;;  Field poly  
RPO_NOT_SDI=geomAndNot(RPO SDI)  
PORES=geomAnd(FPO1 RPO_NOT_SDI) ;;  POLY resistor region  
ILP1=geomAndNot(POLY_ISO RPO) ;;  Interconnection poly  
FFOD=geomOutside(geomOutside(OD RWDMY) ALL_GATE)  
ODRES=geomAnd(FFOD RPO_NOT_SDI) ;;  OD resistor region  

DACT=geomOr(NACT PACT) ;;  NMOS and PMOS Device  
DSTP=geomOr(NTAP PTAP) ;;  NWEL and PWEL Pick-Up  
IMP=geomOr(PP NP) ;;  N+ and P+ implant  

HRDMY=geomOr(geomOr(DMP2V DMN2V) RLPPDMY) ;;  High resistance poly resistor dummy layer for DRC  
HREP=geomAnd(PORES HRDMY) ;;  High precision and resistacne poly resistor  

HVN_GOX=geomAnd(NPOD OD2) ;;  Device n-type diffusion for thick gate NMOS  
HVP_GOX=geomAnd(PPOD OD2) ;;  Device p-type diffusion for thick gate PMOS  
HV_NGATE_W=geomGetEdge(GATE_W inside HVN_GOX) ;;  3.3V NMOS gate edges  
HV_PGATE_W=geomGetEdge(GATE_W inside HVP_GOX) ;;  3.3V PMOS gate edges  

BUTT_NTAP=geomButtOnly(geomOutside(NTAP PACT) PACT) ;;  NWEL Tap butting p-type active diffusion  
NONB_NTAP=geomAndNot(NTAP geomButtOnly(geomOutside(NTAP PACT) PACT)) ;;  Non-butting ntap  
BUTT_PTAP=geomButtOnly(geomOutside(PTAP NACT) NACT) ;;  PWEL Tap butting n-type active diffusion  
NONB_PTAP=geomAndNot(PTAP geomButtOnly(geomOutside(PTAP NACT) NACT)) ;;  Non-butting ptap  
PP_BEDGE=geomOr(geomGetEdge(BUTT_PTAP coincident NACT) geomGetEdge(BUTT_PTAP butting NACT)) ;;  PP edge to form butted tap  
NP_BEDGE=geomOr(geomGetEdge(BUTT_NTAP coincident PACT) geomGetEdge(BUTT_NTAP butting PACT)) ;;  NP edge to form butted tap  
OD2_BEDGE=geomGetEdge(OD2 inside OD)  

ACT_OD=geomButtOrOver(OD POLY)  
PNSD=geomAndNot(ACT_OD ALL_GATE)  
SDPO2=geomButtOrOver(PNSD POLY keep==2) ;;  S/D between two Poly gate  

CO_DIFF=geomOutside(CO POLY_ISO) ;;  Diffusion contacts + floating contacts  
CO_POLY=geomAndNot(CO geomOutside(CO POLY_ISO)) ;;  POLY contacts  
ASD1=geomEnclose(PNSD CO_DIFF)   ;;  For checks such as PP.C.4/C.5, NP.C.4/C.5.  
EXGATE_NP=geomSize(geomAnd(geomSize(GATE_NP 0.03 noClipAcute) POLY) NP_C_5 noClipAcute)  
EXGATE_PP=geomSize(geomAnd(geomSize(GATE_PP 0.03 noClipAcute) POLY) PP_C_5 noClipAcute)  
FUSE_LMARK=geomOr(geomOr(CB FW) LW)  
RNGX=geomAndNot(PMDMY FUSE_LMARK)  

CHIPx=geomCat(CHIP)  
if(FULL_CHIP==1 then
    CHIP_CORE=geomSize(CHIPx (-(10+SR_S_1)) noClipAcute) ;;  sealring + assembly isolation  

else
    CHIP_CORE=geomCat(CHIPx)  
)
PADH=geomHoles(CB)  
SCORE=geomInside(CHIP_CORE PADH)  
SR_CHIP=geomButtOrOver(CHIP SCORE)  
SR=geomAndNot(SR_CHIP geomSize(SR_CHIP (-10) noClipAcute))  
SR_CB=geomAnd(CB SR)  
SR_CO=geomAnd(CO SR)  
SR_VIA1=geomAnd(VIA1 SR)  
SR_VIA2=geomAnd(VIA2 SR)  
SR_VIA3=geomAnd(VIA3 SR)  
SR_VIA4=geomAnd(VIA4 SR)  
SR_M1=geomAnd(M1 SR)  
SR_M2=geomAnd(M2 SR)  
SR_M3=geomAnd(M3 SR)  
SR_M4=geomAnd(M4 SR)  
SR_M5=geomAnd(M5 SR)  

;;  For SEAL-RING and CHIP CORNER checks. 
CHIP_WISR=geomButtOrOver(CHIPx SCORE)  
SR_EDGE=geomAndNot(CHIP_WISR SCORE)  

CHIP_NOSR=geomAndNot(CHIPx geomButtOrOver(CHIPx SR_EDGE))  
CHIP_NOSR1=geomCat(CHIP_NOSR)  
CHIP_NOSR2=geomCat(CHIP_NOSR)  
if(FULL_CHIP==1 then
    if(BigSealringCorner==1 then
        EMPTY_AREA=geomStretchCorner(geomGetCorner(CHIP_NOSR1 keep==90) 350 angleAll) ;;  with seal-ring  
        SR_EXC=geomStretchCorner(geomGetCorner(SR_EDGE keep==270.0) 350 angleAll)  

    else
        if(SmallSealringCorner==1 then
            EMPTY_AREA=geomStretchCorner(geomGetCorner(CHIP_NOSR2 keep==90) 125 angleAll) ;;  with seal-ring  
            SR_EXC=geomStretchCorner(geomGetCorner(SR_EDGE keep==270.0) 125 angleAll)  

        else
            EMPTY_AREA=geomStretchCorner(geomGetCorner(CHIP_NOSR1 keep==90) 350 angleAll) ;;  with seal-ring  
            SR_EXC=geomStretchCorner(geomGetCorner(SR_EDGE keep==270.0) 350 angleAll)  

        )
    )
    SRCSR=geomOr(SR_EDGE SR_EXC) ;;  Sealring + Corner + Assembly isolation  
    CHIP_CHAMFERED=geomAndNot(geomAndNot(CHIPx EMPTY_AREA) SRCSR)  
    CHIP_EDGE=geomAndNot(CHIPx SR_EDGE)  
    ASS_REGION=geomAndNot(geomSize(CHIP_EDGE SR_S_1 noClipAcute) CHIP_EDGE)  

)

SR_VIAD=geomAnd(VIAD SR)  

SBDOD=geomAnd(geomAnd(OD SBDDMY) NWEL)  

NW_SBD=geomButtOrOver(NWEL SBDOD)  
DNW_SBD=geomButtOrOver(DNW SBDOD)  

PP_SBD=geomButtOrOver(PP SBDOD)  

PP_SBD_HOLE=geomHoles(PP_SBD innermost)  
PP_SBD_ALL=geomOr(PP_SBD PP_SBD_HOLE)  

PP_NSBD=geomAndNot(PP PP_SBD)  

PPOD_SBD=geomButtOrOver(SBDOD PP)  
NPOD_SBD=geomAnd(SBDOD NP)  

PPOD_SBD_GAP=geomSize(PPOD_SBD 0.48 edges)  
PPOD_SBD_G=geomButtOnly(geomOutside(PPOD_SBD_GAP NPOD_SBD) NPOD_SBD)  
NPOD_SBD_GAP=geomSize(NPOD_SBD 0.48 edges)  
NPOD_SBD_G=geomButtOnly(geomOutside(NPOD_SBD_GAP PPOD_SBD) PPOD_SBD)  

SBDOD_ALL=geomOr(geomOr(PPOD_SBD NPOD_SBD) PPOD_SBD_G)  

PPOD_SBD_W=geomGetEdge(PPOD_SBD butting NPOD_SBD_G  wholeEdge)  
PPOD_SBD_L=geomAndNot(PPOD_SBD geomGetEdge(PPOD_SBD butting NPOD_SBD_G  wholeEdge) edges)  
NPOD_SBD_W=geomGetEdge(NPOD_SBD butting PPOD_SBD_G  wholeEdge)  

;;  BUILD CONNECTION FOR RULE CHECKS 
;; --------------------------------- 

let( /* HRI.WARN */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "HRI.WARN  RLPPDMY overlap OD is not allowed" )    
    errorLayer(geomAnd(RLPPDMY OD) RULE_COMMENT)
)

;; ************************************************************************************* 
;;  
;;   warning messages to check whether some switchs are used corretly or not. 
;;  
;; ************************************************************************************* 
;; ====================================================================================== 
;;  Process selection warning. 
;; ====================================================================================== 
if(MIX_MODE==0 then
    let( /* WARN.PROCESS_1 */ (RULE_COMMENT MM_LAYERS)
        sprintf(RULE_COMMENT "WARN.PROCESS_1  MIX_MODE switch should be turned on for Mixed Singal/RF process" )    
        MM_LAYERS=geomOr(geomOr(geomOr(geomOr(geomOr(CTM4i INDDMY) HRIi) DNWi) VTMPi) VTMNi)  
        errorLayer(geomButtOrOver(CHIPx MM_LAYERS) RULE_COMMENT)
    )

)

if(MIX_MODE==1 then
    if(VOLTAGE_1_8V==0 then
        let( /* WARN.PROCESS_2 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "WARN.PROCESS_2  Pls turn on (#DEFINE 1.8V) switch if you use Mixed Singal/RF process" )    
            errorLayer(geomCat(CHIPx) RULE_COMMENT)
        )

    )
    if(VOLTAGE_3_3V==0 then
        let( /* WARN.PROCESS_3 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "WARN.PROCESS_3  Pls turn on (#DEFINE 3.3V) switch if you use Mixed Singal/RF process" )    
            errorLayer(geomCat(CHIPx) RULE_COMMENT)
        )

    )
    if(LP==1 then
        let( /* WARN.PROCESS_4 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "WARN.PROCESS_4  Pls turn off (#DEFINE LP) switch if you use Mixed Singal/RF process."
                "Low power is not supported in Mixed Signal process"
            )  )    
            errorLayer(geomCat(CHIPx) RULE_COMMENT)
        )

    )
    if(VOLTAGE_1_5V==1 then
        let( /* WARN.PROCESS_5 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "WARN.PROCESS_5  Pls turn off (#DEFINE 1.5V) switch if you use Mixed Singal/RF process"
                "Low voltage is not supported in Mixed Signal process"
            )  )    
            errorLayer(geomCat(CHIPx) RULE_COMMENT)
        )

    )
    if(VOLTAGE_5V==1 then
        let( /* WARN.PROCESS_6 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "WARN.PROCESS_6  Pls turn off (#DEFINE 5V) switch if you use Mixed Singal/RF process"
                "1.8V/5V is not supported in Mixed Signal process"
            )  )    
            errorLayer(geomCat(CHIPx) RULE_COMMENT)
        )

    )

)
if(C016==1 then

        A3=drcAntenna(VIA3_Violate_S_2_A2 (VIA3_Violate_S_2_A2) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A3=geomOr(A3_VIA3_Violate_S_2_A2)
    B2=geomOr(A2 A3)  
    errorLayer(geomSize(geomSize(B2 VIA_Merge noClipAcute) -VIA_Merge noClipAcute) RULE_COMMENT)
)

let( /* VIA3.S.5_Array3_4_M */ (RULE_COMMENT B3)
    sprintf(RULE_COMMENT strcat(
        "VIA3.S.5_Array3_4_M  Minimum space between two VIAs in 2-level continuous stacking VIA arrays with below condition >=0.49um"
        "Via3 violate VIA_S_3 spacing in Via3/Via4 array & density large or equal %f"
    )  VIA_D_1)    
    processAntenna(
        gate((VIA3_2stack_Final VIA3_2stack_Final))
        antenna(VIA3_Violate_S_2_A3)
        ratio = VIA3_Violate_S_2_A3.area/VIA3_2stack_Final.area
        A3=drcAntenna(VIA3_Violate_S_2_A3 (VIA3_Violate_S_2_A3) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A3=geomOr(A3_VIA3_Violate_S_2_A3)
    processAntenna(
        gate((VIA3_2stack_Final VIA3_2stack_Final))
        antenna(VIA4_Violate_S_2_A3)
        ratio = VIA4_Violate_S_2_A3.area/VIA3_2stack_Final.area
        A4=drcAntenna(VIA4_Violate_S_2_A3 (VIA4_Violate_S_2_A3) ratio keep>=VIA_D_1 suppressErrorMessage)
    )
    A4=geomOr(A4_VIA4_Violate_S_2_A3)
    B3=geomOr(A3 A4)  
    errorLayer(geomSize(geomSize(B3 VIA_Merge noClipAcute) -VIA_Merge noClipAcute) RULE_COMMENT)
)

CB_CUP=geomButtOrOver(CB WBDMY)  

;;  VIA4 checks 
;; ============= 

VIA4R=geomOutside(VIA4 CB_CUP)  
VIA4R_CORE=geomAndNot(VIA4R SR_VIA4)  
let( /* VIA4.W.1 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT "VIA4.W.1  VIA4 must be %f x %f" VIAn_W_1 VIAn_W_1)    
    A=geomAndNot(VIA4R_CORE geomGetRectangle(VIA4R_CORE length==VIAn_W_1 width==VIAn_W_1 swap))  
    errorLayer(geomAndNot(geomOutside(A RNGX) CB) RULE_COMMENT)
)

let( /* VIA4.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "VIA4.S.1  Min. VIA4 spacing < %f" VIAn_S_1)    
    drc(VIA4R 0<sepNotch<VIAn_S_1 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* VIA4.E.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "VIA4.E.1  Min. extension of a M4 region beyond a VIA4 region < 0.01" )    
    drc(M4 VIA4R enc<0.01 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAndNot(VIA4R M4) RULE_COMMENT)
)

let( /* VIA4.E.2 */ (RULE_COMMENT X)
    sprintf(RULE_COMMENT "VIA4.E.2  Min. extension of a M4 end-of-line region beyond VIA4 region < 0.06" )    
    X=drc(M4 VIA4R enc<0.06 edgeb oppositeB shielded withIntersection)  
    drc(geomGetEdge(X coincident geomGetVertex(geomSize(X -0.001 edges) keep >4)) width<0.36  edge only_perp shielded RULE_COMMENT)  
)

if(Recommend==1 then
    let( /* VIA4.E.3 */ (RULE_COMMENT X)
        sprintf(RULE_COMMENT "VIA4.E.3  Min. extension of M4 beyond the overlap area that VIA4 and VIA3 are fully or partially touching < %f" VIA4_E_3)    
        X=geomAnd(VIA4R VIA3)  
        drc(M4 X enc<VIA4_E_3 shielded withIntersection withSingularPoint RULE_COMMENT)
    )

)

if(CHECK_ALRDL==1 then
    if(THICK_20K==0 then
        if(THICK_40K==0 then
            VIADR=geomOutside(VIAD CB_CUP)  
            VIADR_CORE=geomAndNot(VIADR SR_VIAD)  
            let( /* VIAD.W.1 */ (RULE_COMMENT A)
                sprintf(RULE_COMMENT "VIAD.W.1  VIAD must be %f x %f" VIAD_W_1 VIAD_W_1)    
                A=geomAndNot(VIADR_CORE geomGetRectangle(VIADR_CORE length==VIAD_W_1 width==VIAD_W_1 swap))  
                errorLayer(geomAndNot(geomOutside(A RNGX) CB) RULE_COMMENT)
            )

            let( /* VIAD.S.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "VIAD.S.1  Min. VIAD spacing < %f" VIAD_S_1)    
                drc(VIADR 0<sepNotch<VIAD_S_1 shielded withIntersection withSingularPoint RULE_COMMENT)
            )

            let( /* VIAD.E.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "VIAD.E.1  Min. extension of a M5 region beyond a VIAD region < 0.01" )    
                drc(M5 VIADR enc<0.01 shielded withIntersection withSingularPoint RULE_COMMENT)
                errorLayer(geomAndNot(VIADR M5) RULE_COMMENT)
            )

            let( /* VIAD.E.2 */ (RULE_COMMENT X)
                sprintf(RULE_COMMENT "VIAD.E.2  Min. extension of a M5 end-of-line region beyond VIAD region < 0.06" )    
                X=drc(M5 VIADR enc<0.06 edgeb oppositeB shielded withIntersection)  
                drc(geomGetEdge(X coincident geomGetVertex(geomSize(X -0.001 edges) keep >4)) width<0.36  edge only_perp shielded RULE_COMMENT)  
            )

            if(Recommend==1 then
                let( /* VIAD.E.3 */ (RULE_COMMENT X)
                    sprintf(RULE_COMMENT "VIAD.E.3  Min. extension of M5 beyond the overlap area that VIAD and VIA4 are fully or partially touching < %f" VIAD_E_3)    
                    X=geomAnd(VIADR VIA4R)  
                    drc(M5 X enc<VIAD_E_3 shielded withIntersection withSingularPoint RULE_COMMENT)
                )

            )

        )

    )

)

if(THICK_20K==0 then
    if(THICK_40K==0 then
        let( /* M5.W.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "M5.W.1  Min. M5 width < 0.44" )    
            drc(M5 width<0.44 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
        )

        let( /* M5.S.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "M5.S.1  Min. M5 space < 0.46" )    
            drc(M5 0<sepNotch<0.46 shielded withIntersection withSingularPoint RULE_COMMENT)
        )

        let( /* M5.S.2 */ (RULE_COMMENT M5_S5 M5_G5 M5_Wide M5_Exp M5_Branch M5_Branch_edge M5_Check M5_Branch_Check)
            sprintf(RULE_COMMENT "M5.S.2  Min. space to wide M5 (>10um) < 0.6" )    
            M5_S5=geomGrow(M5 (-5) (-5) (-5) (-5))     
            M5_G5=geomGrow(M5_S5 5 5 5 5)     
            M5_Wide=geomAnd(M5_G5 M5)  
            M5_Exp=geomSizeAnd(M5_Wide M5 0.322 1 noClipAcute)  
            M5_Branch=geomAndNot(M5_Exp M5_Wide)  
            M5_Branch_edge=geomGetEdge(M5_Branch coincident M5)  
            M5_Check=geomAnd(M5 geomSize(M5_Exp 0.6 noClipAcute))  
            M5_Branch_Check=geomAnd(M5 geomSize(M5_Branch_edge 0.6 chainEdges))  
            M5_WideC=geomCat(M5_Wide)
            geomStamp(M5_WideC M5xd)
            M5_CheckC=geomCat(M5_Check)
            geomStamp(M5_CheckC M5xd)
            M5_BranchC=geomCat(M5_Branch)
            geomStamp(M5_BranchC M5xd)
            M5_Branch_CheckC=geomCat(M5_Branch_Check)
            geomStamp(M5_Branch_CheckC M5xd)
            drc(M5_WideC M5_CheckC sep<0.6 0<withIntersection<90 diffNet shielded RULE_COMMENT)
            drc(M5_BranchC M5_Branch_CheckC sep<0.6 0<withIntersection<90 diffNet shielded RULE_COMMENT)
        )

        let( /* M5.E.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "M5.E.1  Min. extension of a M5 region beyond a VIA4 region < 0.09" )    
            drc(M5 VIA4 enc<0.09 edge shielded withIntersection withSingularPoint RULE_COMMENT)
            errorLayer(geomAndNot(VIA4 M5) RULE_COMMENT)
        )

        let( /* M5.A.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "M5.A.1  Min. M5 area region < 0.562" )    
            drc(M5 area<0.562 RULE_COMMENT) 
        )

        if(CHECK_ALRDL==1 then
            let( /* MD.W.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "MD.W.1  Min. MD width < 0.44" )    
                drc(MD width<0.44 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
            )

            let( /* MD.S.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "MD.S.1  Min. MD space < 0.46" )    
                drc(MD 0<sepNotch<0.46 shielded withIntersection withSingularPoint RULE_COMMENT)
            )

            let( /* MD.S.2 */ (RULE_COMMENT MD_S5 MD_G5 MD_Wide MD_Exp MD_Branch MD_Branch_edge MD_Check MD_Branch_Check)
                sprintf(RULE_COMMENT "MD.S.2  Min. space to wide MD (>10um) < 0.6" )    
                MD_S5=geomGrow(MD (-5) (-5) (-5) (-5))     
                MD_G5=geomGrow(MD_S5 5 5 5 5)     
                MD_Wide=geomAnd(MD_G5 MD)  
                MD_Exp=geomSizeAnd(MD_Wide MD 0.322 1 noClipAcute)  
                MD_Branch=geomAndNot(MD_Exp MD_Wide)  
                MD_Branch_edge=geomGetEdge(MD_Branch coincident MD)  
                MD_Check=geomAnd(MD geomSize(MD_Exp 0.6 noClipAcute))  
                MD_Branch_Check=geomAnd(MD geomSize(MD_Branch_edge 0.6 chainEdges))  
                MD_WideC=geomCat(MD_Wide)
                geomStamp(MD_WideC MDxd)
                MD_CheckC=geomCat(MD_Check)
                geomStamp(MD_CheckC MDxd)
                MD_BranchC=geomCat(MD_Branch)
                geomStamp(MD_BranchC MDxd)
                MD_Branch_CheckC=geomCat(MD_Branch_Check)
                geomStamp(MD_Branch_CheckC MDxd)
                drc(MD_WideC MD_CheckC sep<0.6 0<withIntersection<90 diffNet shielded RULE_COMMENT)
                drc(MD_BranchC MD_Branch_CheckC sep<0.6 0<withIntersection<90 diffNet shielded RULE_COMMENT)
            )

            let( /* MD.E.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "MD.E.1  Min. extension of a MD region beyond a VIAD region < 0.09" )    
                drc(MD VIAD enc<0.09 edge shielded withIntersection withSingularPoint RULE_COMMENT)
                errorLayer(geomAndNot(VIAD MD) RULE_COMMENT)
            )

            let( /* MD.A.1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "MD.A.1  Min. MD area region < 0.562" )    
                drc(MD area<0.562 RULE_COMMENT) 
            )

        )

    )

)

;;  METAL RATIO CHECKS 
;; ====================== 
let( /* PO.R.3 */ (RULE_COMMENT ALL_POLY)
    sprintf(RULE_COMMENT "PO.R.3  Min poly area coverage < 14%%" )    
    ALL_POLY=geomOr(POLYi DPO)  
    processCoverage(measure(DENSITY_OUT_1=layerList(ALL_POLY)))
    errorLayer(geomGetCoverage(DENSITY_OUT_1 0<=keep<0.14) RULE_COMMENT)
)

let( /* M1.R.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M1.R.1  Min M1 area coverage < 30%%" )    
    processCoverage(measure(DENSITY_OUT_2=layerList(M1xd)))
    errorLayer(geomGetCoverage(DENSITY_OUT_2 0<=keep<0.3) RULE_COMMENT)
)

let( /* M2.R.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M2.R.1  Min M2 area coverage < 30%%" )    
    processCoverage(measure(DENSITY_OUT_3=layerList(M2xd)))
    errorLayer(geomGetCoverage(DENSITY_OUT_3 0<=keep<0.3) RULE_COMMENT)
)

let( /* M3.R.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M3.R.1  Min M3 area coverage < 30%%" )    
    processCoverage(measure(DENSITY_OUT_4=layerList(M3xd)))
    errorLayer(geomGetCoverage(DENSITY_OUT_4 0<=keep<0.3) RULE_COMMENT)
)

let( /* M4.R.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "M4.R.1  Min M4 area coverage < 30%%" )    
    processCoverage(measure(DENSITY_OUT_5=layerList(M4xd)))
    errorLayer(geomGetCoverage(DENSITY_OUT_5 0<=keep<0.3) RULE_COMMENT)
)

if(THICK_20K==0 then
    if(THICK_40K==0 then
        let( /* M5.R.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "M5.R.1  Min M5 area coverage < 30%%" )    
            processCoverage(measure(DENSITY_OUT_6=layerList(M5xd)))
            errorLayer(geomGetCoverage(DENSITY_OUT_6 0<=keep<0.3) RULE_COMMENT)
        )

        let( /* MD.R.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "MD.R.1  Min MD area coverage < 30%%" )    
            processCoverage(measure(DENSITY_OUT_7=layerList(MDxd)))
            errorLayer(geomGetCoverage(DENSITY_OUT_7 0<keep<0.3) RULE_COMMENT)
        )

    )

)

;;  Dummy Pad 
;; ========== 

DP_V1=geomAnd(DPDMY VIA1)  
DP_V2=geomAnd(DPDMY VIA2)  
DP_V3=geomAnd(DPDMY VIA3)  
DP_V4=geomAnd(DPDMY VIA4)  
DP_VD=geomAnd(DPDMY VIAD)  

let( /* ADP.R.0A */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "ADP.R.0A  chip corner dummy pad structure should be M1/M2.../M5" )    
    errorLayer(geomAndNot(DPDMY M1) RULE_COMMENT)
    errorLayer(geomAndNot(DPDMY M2) RULE_COMMENT)
    errorLayer(geomAndNot(DPDMY M3) RULE_COMMENT)
    errorLayer(geomAndNot(DPDMY M4) RULE_COMMENT)
    errorLayer(geomAndNot(DPDMY M5) RULE_COMMENT)
)

let( /* ADP.R.0B */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "ADP.R.0B  chip corner dummy pad structure should be VIA1/VIA2.../VIA5" )    
    errorLayer(geomAndNot(DPDMY geomEnclose(DPDMY VIA1)  ) RULE_COMMENT)
    errorLayer(geomAndNot(DPDMY geomEnclose(DPDMY VIA2)  ) RULE_COMMENT)
    errorLayer(geomAndNot(DPDMY geomEnclose(DPDMY VIA3)  ) RULE_COMMENT)
    errorLayer(geomAndNot(DPDMY geomEnclose(DPDMY VIA4)  ) RULE_COMMENT)
)

let( /* ADP.R.0C */ (RULE_COMMENT GRP1 GRP2)
    sprintf(RULE_COMMENT "ADP.R.0C  Via structure in Dummy Pad" )    
    GRP1=geomOr(DP_V2 DP_V4)  
    GRP2=geomOr(geomOr(DP_V1 DP_V3) DP_VD)  
    errorLayer(geomAnd(GRP1 GRP2) RULE_COMMENT)
)

let( /* ADP.S.1_VIA1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "ADP.S.1_VIA1  Via1 spacing (the same level) < 0.58um." )    
    drc(DP_V1 0<sepNotch<0.58 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* ADP.S.1_VIA2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "ADP.S.1_VIA2  Via2 spacing (the same level) < 0.58um." )    

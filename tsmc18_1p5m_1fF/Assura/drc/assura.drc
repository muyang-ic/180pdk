;;  ADP.W.1 is checked by VIAx.W.1 ( x= 1..3) 
;;  ADP.W.2 is checked by VIA4.W.1 

;;  Guideline 

let( /* ADP.S.2g */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "ADP.S.2g  dummy pad spacing < 2um." )    
    drc(DPDMY 0<sepNotch<2 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* ADP.W.3g */ (RULE_COMMENT DPADG)
    sprintf(RULE_COMMENT "ADP.W.3g  dummy pad width > 80um" )    
    DPADG=geomOr(drc(DPDMY width<=80 opposite shielded) geomStretchCorner(geomGetCorner(DPDMY 0<keep<90) 80 angleAll))  
    errorLayer(geomAndNot(DPDMY DPADG) RULE_COMMENT)
)

let( /* ADP.W.4g */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "ADP.W.4g  dummy pad width < 40um" )    
    drc(DPDMY width<40 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
)


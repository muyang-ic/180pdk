;; ====================================================================================== 
;;  Voltage selection warning. 
;; ====================================================================================== 

if(VOLTAGE_3_3V==0 then
    if(VOLTAGE_2_5V==0 then
        if(VOLTAGE_5V==0 then
            let( /* WARN.VOLTAGE_1 */ (RULE_COMMENT)
                sprintf(RULE_COMMENT "WARN.VOLTAGE_1  There must be specified an option of HIGH_VOLTAGE" )    
                errorLayer(geomCat(CHIPx) RULE_COMMENT)
            )

        )

    )

)

if(VOLTAGE_1_8V==0 then
    if(VOLTAGE_1_5V==0 then
        let( /* WARN.VOLTAGE_2 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "WARN.VOLTAGE_2  There must be specified an option of CORE_VOLTAGE" )    
            errorLayer(geomCat(CHIPx) RULE_COMMENT)
        )

    )

)

if(VOLTAGE_3_3V==1 then
    if(VOLTAGE_2_5V==1 then
        let( /* WARN.VOLTAGE_3 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "WARN.VOLTAGE_3  Only one HIGH_VOLTAGE can be specified every time." )    
            errorLayer(geomCat(CHIPx) RULE_COMMENT)
        )

    )
    if(VOLTAGE_5V==1 then
        let( /* WARN.VOLTAGE_4 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "WARN.VOLTAGE_4  Only one HIGH_VOLTAGE can be specified every time." )    
            errorLayer(geomCat(CHIPx) RULE_COMMENT)
        )

    )

)

if(VOLTAGE_1_8V==1 then
    if(VOLTAGE_1_5V==1 then
        let( /* WARN.VOLTAGE_5 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "WARN.VOLTAGE_5  Only one CORE_VOLTAGE can be specified every time." )    
            errorLayer(geomCat(CHIPx) RULE_COMMENT)
        )

    )

)

if(VOLTAGE_1_8V==1 then
    if(VOLTAGE_2_5V==1 then
        let( /* WARN.VOLTAGE_6 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT "WARN.VOLTAGE_6  1.8V and 2.5V can not be specified at the same time." )    
            errorLayer(geomCat(CHIPx) RULE_COMMENT)
        )

    )

)

if(VOLTAGE_1_5V==1 then

;; LAYER  FUSEi	235	// Fuse window 

;;  Dummy Metal layers 
;; ------------------- 

;;  Metal Slot layers 
;; ------------------ 

;;  Capacitor Top Metal Layers 
;; --------------------------- 

;;  Dummy Layers 
;; ------------- 

M1xd=geomAndNot(geomOr(M1i M1DMY) M1SLOTi)  
M2xd=geomAndNot(geomOr(M2i M2DMY) M2SLOTi)  
M3xd=geomAndNot(geomOr(M3i M3DMY) M3SLOTi)  
M4xd=geomAndNot(geomOr(M4i M4DMY) M4SLOTi)  
M5xd=geomAndNot(geomOr(M5i M5DMY) M5SLOTi)  
MDxd=geomAndNot(geomOr(MDi MDDMY) MDSLOTi)  
EXCL=geomAndNot(EXCLi LOGO)  
NWEL=geomAndNot(NWELi geomInside(NWELi EXCL))  
DNW=geomAndNot(DNWi EXCL)  
ODi=geomOr(geomOr(DIFFi NDIFFi) PDIFFi)  
NRODi=geomAndNot(ODi RPOi)  
NPODi=geomAnd(NPi NRODi)  
NONWRi=geomAndNot(NWELi geomButtOrOver(NWELi RWDMY)) ;;  NWEL - NWR(OD) - NWR(STI)  
NTAPi=geomAnd(NPODi NONWRi) ;;  NWEL Pick-Up  
PPODi=geomAnd(PPi NRODi)  
PTAPi=geomAndNot(PPODi NWELi) ;;  Substrate(PWEL) Pick-Up  
PACTi=geomAnd(PPODi NONWRi) ;;  PMOS Device  
PSDi=geomAndNot(PACTi POLYi) ;;  PMOS source/drain,separated  
NACTi=geomAndNot(NPODi NWELi) ;;  NMOS Device  
NSDi=geomAndNot(NACTi POLYi) ;;  NMOS source/drain,separated  
ILP1i=geomAndNot(POLYi RPOi) ;;  Interconnection poly  
VIAt=geomAndNot(VIA4i geomButtOrOver(VIA4i CTM4i))  
VIAc=geomAnd(VIA4i CTM4i)  
M1=geomAndNot(M1xd EXCL)  
VIA1=geomAndNot(VIA1i EXCL)  
VIA1_M=geomButtOrOver(VIA1 M1)  
VIA1Merge1=geomSizeAnd(VIA1_M M1 0.46 (VIA_S_1/2) noClipAcute)  
VIA1Merge2=geomSize(geomSize(VIA1_M (VIA_S_1/2) noClipAcute) -(VIA_S_1/2) noClipAcute) ;;  Any space <= VIA1_S_1 um treated as "array"  
VIA1Merge_pre1=geomAnd(VIA1Merge1 VIA1Merge2) ;;  Find merged via array(s)  
VIA1Merge_pre11=geomEncloseRect(VIA1Merge_pre1 VIA_W_1 VIA_S_2L) ;;  Find at least one width >= VIA_W_1  
VIA1Merge_pre12=geomButtOrOver(VIA1_M VIA1Merge_pre11) ;;  find VIA1 in the effective via arrary  
VIA1Merge_pre13=geomSize(geomSize(VIA1Merge_pre12 (VIA_S_1/2) noClipAcute) -(VIA_S_1/2) noClipAcute) ;;  Any space <= VIA1_S_1 um treated as "array"  
VIA1Merge_pre2=geomAnd(VIA1Merge1 VIA1Merge_pre13) ;;  Find merged via array(s)  
VIA1_same_array=geomSize(geomSize(VIA1Merge_pre2 -(VIA_Filter/2) noClipAcute) (VIA_Filter/2) noClipAcute) ;;  For broken small metal connection  
BULK=geomSize(CHIP 1.0 noClipAcute)  
if(CHECK_SRAM_EXCL==1 then
    EXCL_S=geomAndNot(CHIP BULK) ;;  Use an empty layer to disable the usage of EXCL  

else
    EXCL_S=geomCat(EXCL) ;;  EXCL_S = EXCL  
)
M2=geomAndNot(M2xd geomInside(M2xd EXCL_S))  
VIA2=geomAndNot(VIA2i geomInside(VIA2i EXCL_S))  
VIA2_M=geomButtOrOver(VIA2 M2)  
VIA2Merge1=geomSizeAnd(VIA2_M M2 0.46 (VIA_S_1/2) noClipAcute)  
VIA2Merge2=geomSize(geomSize(VIA2_M (VIA_S_1/2) noClipAcute) -(VIA_S_1/2) noClipAcute) ;;  Any space <= VIA1_S_1 um treated as "array"  
VIA2Merge_pre1=geomAnd(VIA2Merge1 VIA2Merge2) ;;  Find merged via array(s)  
VIA2Merge_pre11=geomEncloseRect(VIA2Merge_pre1 VIA_W_1 VIA_S_2L) ;;  Find at least one width >= VIA_W_1  
VIA2Merge_pre12=geomButtOrOver(VIA2_M VIA2Merge_pre11) ;;  find VIA2 in the effective via arrary  
VIA2Merge_pre13=geomSize(geomSize(VIA2Merge_pre12 (VIA_S_1/2) noClipAcute) -(VIA_S_1/2) noClipAcute) ;;  Any space <= VIA1_S_1 um treated as "array"  
VIA2Merge_pre2=geomAnd(VIA2Merge1 VIA2Merge_pre13) ;;  Find merged via array(s)  
VIA2_same_array=geomSize(geomSize(VIA2Merge_pre2 -(VIA_Filter/2) noClipAcute) (VIA_Filter/2) noClipAcute) ;;  For broken small metal connection  
M3=geomAndNot(M3xd geomInside(M3xd EXCL_S))  
VIA3=geomAndNot(VIA3i geomInside(VIA3i EXCL_S))  
VIA3_M=geomButtOrOver(VIA3 M3)  
VIA3Merge1=geomSizeAnd(VIA3_M M3 0.46 (VIA_S_1/2) noClipAcute)  
VIA3Merge2=geomSize(geomSize(VIA3_M (VIA_S_1/2) noClipAcute) -(VIA_S_1/2) noClipAcute) ;;  Any space <= VIA1_S_1 um treated as "array"  
VIA3Merge_pre1=geomAnd(VIA3Merge1 VIA3Merge2) ;;  Find merged via array(s)  
VIA3Merge_pre11=geomEncloseRect(VIA3Merge_pre1 VIA_W_1 VIA_S_2L) ;;  Find at least one width >= VIA_W_1  
VIA3Merge_pre12=geomButtOrOver(VIA3_M VIA3Merge_pre11) ;;  find VIA3 in the effective via arrary  
VIA3Merge_pre13=geomSize(geomSize(VIA3Merge_pre12 (VIA_S_1/2) noClipAcute) -(VIA_S_1/2) noClipAcute) ;;  Any space <= VIA1_S_1 um treated as "array"  
VIA3Merge_pre2=geomAnd(VIA3Merge1 VIA3Merge_pre13) ;;  Find merged via array(s)  
VIA3_same_array=geomSize(geomSize(VIA3Merge_pre2 -(VIA_Filter/2) noClipAcute) (VIA_Filter/2) noClipAcute) ;;  For broken small metal connection  
M4=geomAndNot(M4xd geomInside(M4xd EXCL_S))  
VIA4=geomAndNot(VIA4i geomInside(VIA4i EXCL_S))  
VIA4_M=geomButtOrOver(VIA4 M4)  
VIA4Merge1=geomSizeAnd(VIA4_M M4 0.46 (VIA_S_1/2) noClipAcute)  
VIA4Merge2=geomSize(geomSize(VIA4_M (VIA_S_1/2) noClipAcute) -(VIA_S_1/2) noClipAcute) ;;  Any space <= VIA1_S_1 um treated as "array"  
VIA4Merge_pre1=geomAnd(VIA4Merge1 VIA4Merge2) ;;  Find merged via array(s)  
VIA4Merge_pre11=geomEncloseRect(VIA4Merge_pre1 VIA_W_1 VIA_S_2L) ;;  Find at least one width >= VIA_W_1  
VIA4Merge_pre12=geomButtOrOver(VIA4_M VIA4Merge_pre11) ;;  find VIA4 in the effective via arrary  
VIA4Merge_pre13=geomSize(geomSize(VIA4Merge_pre12 (VIA_S_1/2) noClipAcute) -(VIA_S_1/2) noClipAcute) ;;  Any space <= VIA1_S_1 um treated as "array"  
VIA4Merge_pre2=geomAnd(VIA4Merge1 VIA4Merge_pre13) ;;  Find merged via array(s)  
VIA4_same_array=geomSize(geomSize(VIA4Merge_pre2 -(VIA_Filter/2) noClipAcute) (VIA_Filter/2) noClipAcute) ;;  For broken small metal connection  
VIA1_same_array_4stack_pre1=geomAnd(geomAnd(geomAnd(drc(VIA1_same_array area>=VIA_A_4)  drc(VIA2_same_array area>=VIA_A_4) ) drc(VIA3_same_array area>=VIA_A_4) ) drc(VIA4_same_array area>=VIA_A_4) )  
VIA1_same_array_4stack_pre2=drc(VIA1_same_array_4stack_pre1 area>=VIA_A_4)   
VIA1_4stack_pre3=geomEncloseRect(VIA1_same_array_4stack_pre2 VIA_W_1 VIA_S_2L) ;;  Find at least one width >= VIA_W_1  
VIA1_Reg_3_S_4=drc(VIA1_4stack_pre3 0<sepNotch<=VIA_S_5 opposite shielded withIntersection withSingularPoint)  
M5=geomAndNot(M5xd geomInside(M5xd EXCL_S))  
M1_4stack_pre3=geomOr(geomOr(geomOr(geomOr(geomButtOrOver(M1 VIA1_4stack_pre3) geomButtOrOver(M2 VIA1_4stack_pre3)) geomButtOrOver(M3 VIA1_4stack_pre3)) geomButtOrOver(M4 VIA1_4stack_pre3)) geomButtOrOver(M5 VIA1_4stack_pre3))  
VIA1_Reg_3_S_4_pre=geomAndNot(VIA1_Reg_3_S_4 M1_4stack_pre3)  
VIA1_Reg_3_S_4_1=geomEncloseRect(VIA1_Reg_3_S_4_pre VIA_S_2L 0.005)  
VIA1_4stack_pre4=geomButtOrOver(VIA1_4stack_pre3 geomButtOrOver(VIA1_Reg_3_S_4 VIA1_Reg_3_S_4_1))  
VIA1ArrayS1_S_4=drc(VIA1_4stack_pre4 0<sepNotch<=VIA_S_5 opposite shielded withIntersection withSingularPoint) ;;  Space of different "smae array" smaller than VIA_S_2  
VIA1ArrayS2_S_4=geomAndNot(geomAndNot(geomAndNot(geomAndNot(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) geomInside(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) M2)) geomInside(geomAndNot(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) geomInside(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) M2)) M3)) geomInside(geomAndNot(geomAndNot(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) geomInside(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) M2)) geomInside(geomAndNot(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) geomInside(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) M2)) M3)) M4)) geomInside(geomAndNot(geomAndNot(geomAndNot(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) geomInside(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) M2)) geomInside(geomAndNot(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) geomInside(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) M2)) M3)) geomInside(geomAndNot(geomAndNot(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) geomInside(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) M2)) geomInside(geomAndNot(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) geomInside(geomAndNot(VIA1ArrayS1_S_4 geomInside(VIA1ArrayS1_S_4 M1)) M2)) M3)) M4)) M5))  
VIA1_4stack_pre5=geomButtOrOver(VIA1_4stack_pre4 VIA1ArrayS2_S_4)  
M1_4stack_pre4=drc(M1_4stack_pre3 0<sepNotch<=VIA_S_2 opposite shielded withIntersection withSingularPoint)  
M1_4stack_pre4_edge=geomGetEdge(M1_4stack_pre3 butting M1_4stack_pre4)  
M1_4stack_pre5=geomSize(M1_4stack_pre4_edge -VIA_S_4 edges)  
M1_4stack_pre5_region_1=geomButtOrOver(M1_4stack_pre5 VIA1_4stack_pre5 keep>0)  
M1_4stack_pre5_region=geomButtOrOver(M1_4stack_pre4 M1_4stack_pre5_region_1 keep>=2)  
M1_4stack_pre6=geomOr(M1_4stack_pre5_region M1_4stack_pre5_region_1)  
M1_4stack_pre7=geomButtOrOver(M1_4stack_pre6 VIA1_4stack_pre5 keep>=2)  
VIA1_4stack_Final=geomButtOrOver(VIA1_4stack_pre5 M1_4stack_pre7)  
VIA1_S_4_A1=geomButtOrOver(VIA1 VIA1_4stack_Final)  
VIA1_Reg_4_S_4_A1=drc(VIA1_S_4_A1 0<sepNotch<VIA_S_3 shielded withIntersection withSingularPoint) ;;  VIA1s space smaller than 0.49 (inside small array)  
VIA1_Violate_S_4_A1=geomButtOrOver(VIA1_S_4_A1 VIA1_Reg_4_S_4_A1)  
VIA2_S_4_A1=geomButtOrOver(VIA2 VIA1_4stack_Final)  
VIA2_Reg_4_S_4_A1=drc(VIA2_S_4_A1 0<sepNotch<VIA_S_3 shielded withIntersection withSingularPoint) ;;  VIA2s space smaller than 0.49 (inside small array)  
VIA2_Violate_S_4_A1=geomButtOrOver(VIA2_S_4_A1 VIA2_Reg_4_S_4_A1)  
VIA3_S_4_A1=geomButtOrOver(VIA3 VIA1_4stack_Final)  
VIA3_Reg_4_S_4_A1=drc(VIA3_S_4_A1 0<sepNotch<VIA_S_3 shielded withIntersection withSingularPoint) ;;  VIA3s space smaller than 0.49 (inside small array)  
VIA3_Violate_S_4_A1=geomButtOrOver(VIA3_S_4_A1 VIA3_Reg_4_S_4_A1)  
VIA4_S_4_A1=geomButtOrOver(VIA4 VIA1_4stack_Final)  
VIA4_Reg_4_S_4_A1=drc(VIA4_S_4_A1 0<sepNotch<VIA_S_3 shielded withIntersection withSingularPoint) ;;  VIA4s space smaller than 0.49 (inside small array)  
VIA4_Violate_S_4_A1=geomButtOrOver(VIA4_S_4_A1 VIA4_Reg_4_S_4_A1)  
VIA1_same_array_3stack_pre1=geomAnd(geomAnd(drc(VIA1_same_array area>=VIA_A_3)  drc(VIA2_same_array area>=VIA_A_3) ) drc(VIA3_same_array area>=VIA_A_3) )  
VIA1_same_array_3stack_pre2=drc(VIA1_same_array_3stack_pre1 area>=VIA_A_3)   
VIA1_3stack_pre3=geomEncloseRect(VIA1_same_array_3stack_pre2 VIA_W_1 VIA_S_2L) ;;  Find at least one width >=VIA_W_1  
VIA1_Reg_3_S_3=drc(VIA1_3stack_pre3 0<sepNotch<=VIA_S_5 opposite shielded withIntersection withSingularPoint)  
M1_3stack_pre3=geomOr(geomOr(geomOr(geomButtOrOver(M1 VIA1_3stack_pre3) geomButtOrOver(M2 VIA1_3stack_pre3)) geomButtOrOver(M3 VIA1_3stack_pre3)) geomButtOrOver(M4 VIA1_3stack_pre3))  
VIA1_Reg_3_S_3_pre=geomAndNot(VIA1_Reg_3_S_3 M1_3stack_pre3)  
VIA1_Reg_3_S_3_1=geomEncloseRect(VIA1_Reg_3_S_3_pre VIA_S_2L 0.005) ;;  Find parallel run length >= VIA_S_2L  

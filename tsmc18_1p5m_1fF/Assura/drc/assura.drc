layerDefs( "df2"
  NWELi   =layer("NWELL" type("drawing" "pin"))	;;  Nwell technology  
  DIFFi   =layer("DIFF" type("boundary" "drain" "drawing" "pin" "net"))	;;  Active areas  
  DOD     =layer("DIFF" type("dummy"))	;;  Dummy OD (DIFF)  
  ODBLK   =layer("ODBLK" type("dummy"))	;;  DOD blocking for insertion  
  PDIFFi  =layer("PDIFF" type("drawing"))	;;  Active areas  
  NDIFFi  =layer("NDIFF" type("drawing"))	;;  Active areas  
  OD2i    =layer("OD2" type("drawing"))	;;  Define thick gate oxides  
  POLYi   =layer("POLY1" type("net" "boundary" "drawing" "drawing1"))	;;  Polysilicon gates, interconnect  
  DPO     =layer("POLY1" type("dummy"))	;;  Dummy Poly  
  POBLK   =layer("POBLK" type("dummy"))	;;  DPO blocking for insertion  
  PPi     =layer("PIMP" type("drawing"))	;;  P+ S/D imlant  
  NPi     =layer("NIMP" type("drawing"))	;;  N+ S/D imlant  
  NLVTi   =layer("NLVT" type("drawing"))	 
  DTi     =layer("SiGe" type("DT"))	;;  Deep trench  
  DTBLK   =layer("SiGe" type("dummy"))	;;  Deep trench block  
  FLASH   =layer("FLASH" type("drawing"))	;;  FLASH IP outline  
  BJTDUMMY=layer("BJTDUMMY" type("dummy" "drawing" "dummy3" "dummy7" "dummy4" "dummy5"))	;;  BJT dummy layer  
  DIODUMMY=layer("DIODUMMY" type("dummy2" "dummy1" "drawing"))	;;  Diode dummy layer  
RPDUMMY = layer(("HVPRDMY" type("drawing")) ("RP4TDUMMY" type("drawing")) ("RPDUMMY" type("drawing5" "drawing" "drawing1")) )
  COi     =layer("CONT" type("drawing" "pin"))	;;  Define connection from M1 to S/D and Gate  
  M1i     =layer("METAL1" type("HV60" "BSD" "drawing" "BSL"))	;;  First Metal layer  
  VIA1i   =layer("VIA12" type("dummy" "drawing" "pin"))	;;  Define connection from M2 to M1  
  M2i     =layer("METAL2" type("drawing"))	;;  Second Metal layer  
  VIA2i   =layer("VIA23" type("dummy" "drawing" "pin"))	;;  Define connection from M3 to M2  
  M3i     =layer("METAL3" type("drawing"))	;;  Third Metal layer  
  VIA3i   =layer("VIA34" type("drawing" "pin"))	;;  Define connection from M4 to M3  
  M4i     =layer("METAL4" type("drawing"))	;;  Fourth Metal layer  
  VIA4i   =layer("VIA45" type("drawing" "pin"))	;;  Define connection from M5 to M4  
  M5i     =layer("METAL5" type("drawing"))	;;  Fifth Metal layer  
  VIADi   =layer("VIAD" type("boundary" "drawing" "pin" "net"))	;;  Define connect from MD to Top Metal  
  MDi     =layer("MD" type("boundary" "drawing" "net"))	;;  RDL Metal layer above Top Metal  
  CBi     =layer("PAD" type("BSL" "drawing"))	;;  Passivation opening for Bond Pad  
  CBDi    =layer("CBD" type("BSL" "drawing"))	;;  Definition of passivation window for bump  
  UBMi    =layer("UBM" type("BSL" "drawing"))	;;  Bond Pad definition for RDL  
PPIi = layer(("AP" type("dummy" "pin" "BSP" "BSL" "drawing1" "BSD" "boundary" "drawing")) ("PPI" type("drawing")) )
  RPOi    =layer("RPO" type("drawing"))	;;  Salicided Block Layer  
  NTNi    =layer("NTN" type("dummy" "drawing"))	;;  Native NMOS blocked implantation  
  PLMIDEi =layer("PLMIDE" type("drawing"))	;;  Polymide (if drawn)  
  DNWi    =layer("DNW" type("drawing"))	;;  Deep N-WELL  
  VTMPi   =layer("VTM_P" type("drawing"))	;;  Blocking region of PMOS VT implantation  
  VTMNi   =layer("VTM_N" type("drawing"))	;;  Blocking region of NMOS VT implantation  
  PV_P    =layer("PV_P" type("drawing"))	;;  PV_P pmos varactor p+ implant layer  
  PV_N    =layer("PV_N" type("drawing"))	;;  PV_N pmos varactor n+ blocking layer  
  HRIi    =layer("HRI" type("dummy1" "drawing10" "drawing"))	;;  High Resistor implant  
  M1DMY   =layer("METAL1" type("dummy"))	;;  Metal1 dummy (if drawn)  
  M2DMY   =layer("METAL2" type("dummy"))	;;  Metal2 dummy (if drawn)  
  M3DMY   =layer("METAL3" type("dummy"))	;;  Metal3 dummy (if drawn)  
  M4DMY   =layer("METAL4" type("dummy"))	;;  Metal4 dummy (if drawn)  
  M5DMY   =layer("METAL5" type("dummy"))	;;  Metal5 dummy (if drawn)  
  MDDMY   =layer("MD" type("dummy"))	;;  MD dummy (if drawn)  
  M1SLOTi =layer("METAL1" type("slot"))	;;  Metal1 slot (if drawn)  
  M2SLOTi =layer("METAL2" type("slot"))	;;  Metal2 slot (if drawn)  
  M3SLOTi =layer("METAL3" type("slot"))	;;  Metal3 slot (if drawn)  
  M4SLOTi =layer("METAL4" type("slot"))	;;  Metal4 slot (if drawn)  
  M5SLOTi =layer("METAL5" type("slot"))	;;  Metal5 slot (if drawn)  
  MDSLOTi =layer("MD" type("slot"))	;;  MD slot (if drawn)  
  CTM2i   =layer("CTM2" type("drawing"))	;;  Capacitor Top Metal-2  
  CTM3i   =layer("CTM3" type("drawing"))	;;  Capacitor Top Metal-3  
  CTM4i   =layer("CTM4" type("drawing"))	;;  Capacitor Top Metal-4  
  CTM5i   =layer("CTM5" type("drawing"))	;;  Capacitor Top Metal-5  
  HOTWL   =layer("HOTWL" type("drawing"))	;;  Hot N-Well (SEE README HOT_NWEL NOTES)  
  EXCLi   =layer("EXCL" type("drawing"))	;;  Exclude layer  
  DRCDMY  =layer("DRCDUMMY" type("drawing"))	;;  DRC I/O waiver  
  RWDMY   =layer("RWDUMMY" type("dummy" "drawing5" "drawing" "drawing1"))	;;  NWEL Resistor dummy layer  
  DPDMY   =layer("DPDUMMY" type("drawing"))	;;  Dummy Pad area dummy layer  
  PLDMY   =layer("PLDUMMY" type("drawing"))	;;  Power Line area dummy layer  
  SDI     =layer("SDI" type("drawing"))	;;  IO ESD region dummy layer  
  ESD1DMY =layer("ESD1DUMMY" type("drawing"))	;;  IO ESD region dummy layer, RPO must enclose whole gate  
  ESD2DMY =layer("ESD2DUMMY" type("drawing"))	;;  IO ESD region dummy layer, RPO enclose gate 0.05 for 3.3V  
  ESD3DMY =layer("ESD3DUMMY" type("drawing"))	 
  CTMDMY  =layer("CTMDUMMY" type("dummy" "drawing6" "drawing7" "drawing4" "drawing5" "drawing2" "drawing3" "drawing1" "drawing"))	;;  Cover metal as a capacitor bottom plate  
  RLPPDMY =layer("RLPPDUMMY" type("drawing"))	;;  HRI high Poly resistor dummy layer  
  DMN2V   =layer("DMN2V" type("drawing"))	;;  Dummy layer to ensure N2V in N+ poly/OD resistor  
  DMP2V   =layer("DMP2V" type("drawing"))	;;  Dummy layer to ensure P2V in P+ poly/OD resistor  
  VARDMY  =layer("VARDUMMY" type("drawing4" "drawing2" "drawing" "drawing3" "drawing1"))	;;  Dummy layer to cover varactor device  
  PMDMY   =layer("PMDMY" type("drawing"))	;;  Dummy layer to cover fuse window and protection ring structur  
  FWi     =layer("FW" type("drawing"))	;;  Fuse window when x, (x+1) = 3  
  LMARK   =layer("LMARK" type("drawing"))	;;  L target window for bump process  
  LWI     =layer("LW" type("drawing"))	;;  L target window for bump process  
  WBDMY   =layer("WBDMY" type("drawing"))	;;  Dummy layer to cover the CUP pad  
  ESDi    =layer("ESD" type("drawing"))	;;  For 0.18um 1.8V/5V on i/o esd's implant only.  
  ESDIMPi =layer("ESD" type("drawing2"))	;;  For 0.18um 3.3V esd NMOS only.  
  INDDMY  =layer("INDDUMMY" type("drawing"))	;;  Dummy layer to define inductor  
  SEALRING=layer("SEALRING" type("drawing" "drawing1"))	;;  SEAL-RING Layer used for SR.S.1 check  
  LOGO    =layer("LOGO" type("drawing"))	;;  Dummy layer for product labels and LOGO  
  LUPWDMY =layer("LUPWDMY" type("drawing"))	;;  DRC dummy layer to waive Latch-Up rules for verified IP.  
  SBDDMY  =layer("SBDDMY" type("drawing"))	;; A layer for DRC,LVS and creating mask logic operation Use "SBDDMY" to fully cover schottky barrier diode.  
  RFDUMMY =layer("RFDUMMY" type("drawing1"))	;;  recognize RF dummy layer for LVS purpose.  
  RES200  =layer("LUPWDMY" type("dummy4"))	;;  dummy layer to recognize 200 ohm or above resistor  
  MATCHING=layer("DRCDUMMY" type("dummy3"))	;;  dummy layer to enable pair check  
  VDDDMY  =layer("LUPWDMY" type("dummy1"))	 
  VSSDMY  =layer("LUPWDMY" type("dummy2"))	 
  TSVi    =layer("TSV" type("dummy" "drawing" "pin"))	;;  TSV region define layer.  
  DM1EXCL =layer("DMEXCL" type("dummy1"))	 
  DM2EXCL =layer("DMEXCL" type("dummy2"))	 
  DM3EXCL =layer("DMEXCL" type("dummy3"))	 
  DM4EXCL =layer("DMEXCL" type("dummy4"))	 
  DM5EXCL =layer("DMEXCL" type("dummy5"))	 
  DMDEXCL =layer("DMEXCL" type("dummyf"))	 
  LAYER_40=text("METAL1" type("BSP" "pin"))	 
  LAYER_41=text("METAL2" type("pin"))	 
  LAYER_42=text("PPI" type("pin" "drawing1") "METAL3" type("pin"))	 
  LAYER_43=text("METAL4" type("pin"))	 
  LAYER_44=text("METAL5" type("pin"))	 
  CHIP    =cellBoundary(root)   
)

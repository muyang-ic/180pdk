    drc(DOD INDDMY sep<DOD_C_9 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DOD INDDMY) RULE_COMMENT)
)

let( /* DOD.C.13 */ (RULE_COMMENT)

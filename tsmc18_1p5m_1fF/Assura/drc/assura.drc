    PWR_M2iu_TEXT=geomGetTexted(geomTextShape(LAYER_41, 1.0) LAYER_41 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  

    PWR_M3iu_BY_TEXT=geomGetTexted(M3k LAYER_42 "AVDDBG" "AVDDR" "AVDWELL" "VDWELL" "VD33APST" "VDD5V" "TAVD33" "VD33PST" "AVDD" "TAVDD" "TAVD33PST" "TAVDDPST" "AVD33B" "VDD" "AVD33G" "DVDD" "AVDDG" "AVDDB" "VDDG" "VDDPST" "VD33REF" "VD33" "AVD33R" "VDDSA")  
    GND_M3iu_BY_TEXT=geomGetTexted(M3k LAYER_42 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  
    PAD_M3iu_BY_TEXT=geomGetTexted(M3k LAYER_42 "*")  
    GND_M3iu_TEXT=geomGetTexted(geomTextShape(LAYER_42, 1.0) LAYER_42 "AVDDBG" "AVDDR" "AVDWELL" "VDWELL" "VD33APST" "VDD5V" "TAVD33" "VD33PST" "AVDD" "TAVDD" "TAVD33PST" "TAVDDPST" "AVD33B" "VDD" "AVD33G" "DVDD" "AVDDG" "AVDDB" "VDDG" "VDDPST" "VD33REF" "VD33" "AVD33R" "VDDSA")  
    PWR_M3iu_TEXT=geomGetTexted(geomTextShape(LAYER_42, 1.0) LAYER_42 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  

    PWR_M4iu_BY_TEXT=geomGetTexted(M4k LAYER_43 "AVDDBG" "AVDDR" "AVDWELL" "VDWELL" "VD33APST" "VDD5V" "TAVD33" "VD33PST" "AVDD" "TAVDD" "TAVD33PST" "TAVDDPST" "AVD33B" "VDD" "AVD33G" "DVDD" "AVDDG" "AVDDB" "VDDG" "VDDPST" "VD33REF" "VD33" "AVD33R" "VDDSA")  
    GND_M4iu_BY_TEXT=geomGetTexted(M4k LAYER_43 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  
    PAD_M4iu_BY_TEXT=geomGetTexted(M4k LAYER_43 "*")  
    GND_M4iu_TEXT=geomGetTexted(geomTextShape(LAYER_43, 1.0) LAYER_43 "AVDDBG" "AVDDR" "AVDWELL" "VDWELL" "VD33APST" "VDD5V" "TAVD33" "VD33PST" "AVDD" "TAVDD" "TAVD33PST" "TAVDDPST" "AVD33B" "VDD" "AVD33G" "DVDD" "AVDDG" "AVDDB" "VDDG" "VDDPST" "VD33REF" "VD33" "AVD33R" "VDDSA")  
    PWR_M4iu_TEXT=geomGetTexted(geomTextShape(LAYER_43, 1.0) LAYER_43 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  

    PWR_M5iu_BY_TEXT=geomGetTexted(M5k LAYER_44 "AVDDBG" "AVDDR" "AVDWELL" "VDWELL" "VD33APST" "VDD5V" "TAVD33" "VD33PST" "AVDD" "TAVDD" "TAVD33PST" "TAVDDPST" "AVD33B" "VDD" "AVD33G" "DVDD" "AVDDG" "AVDDB" "VDDG" "VDDPST" "VD33REF" "VD33" "AVD33R" "VDDSA")  
    GND_M5iu_BY_TEXT=geomGetTexted(M5k LAYER_44 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  
    PAD_M5iu_BY_TEXT=geomGetTexted(M5k LAYER_44 "*")  
    GND_M5iu_TEXT=geomGetTexted(geomTextShape(LAYER_44, 1.0) LAYER_44 "AVDDBG" "AVDDR" "AVDWELL" "VDWELL" "VD33APST" "VDD5V" "TAVD33" "VD33PST" "AVDD" "TAVDD" "TAVD33PST" "TAVDDPST" "AVD33B" "VDD" "AVD33G" "DVDD" "AVDDG" "AVDDB" "VDDG" "VDDPST" "VD33REF" "VD33" "AVD33R" "VDDSA")  
    PWR_M5iu_TEXT=geomGetTexted(geomTextShape(LAYER_44, 1.0) LAYER_44 "VSSPST" "AVS33R" "AVSSUB" "VSSREF" "VSSAPST" "VS33APST" "DVSS" "AVS33G" "AVSSBG" "TAVSS" "AVS33B" "AVSSB" "GND" "VSSG" "VSSUB" "VSS" "AVSS" "TAVSSPST" "AGND" "AVSSR" "AVSSG")  

else
    if(CONNECT_ALL_RESISTOR==1 then
        NTAPiu=geomAndNot(NTAPu EMPTYi)  
        PTAPiu=geomAndNot(PTAPu EMPTYi)  
        NSDiu=geomAndNot(NSDu EMPTYi)  
        PSDiu=geomAndNot(PSDu EMPTYi)  
        CBiu=geomAndNot(CBu EMPTYi)  

        UBMniu=geomAndNot(UBMnu EMPTYi)  
        UBMdiu=geomAndNot(UBMdu EMPTYi)  
        PWR_M1iu_BY_TEXT=geomGetTexted(M1u LAYER_40 "AVDDBG" "AVDDR" "AVDWELL" "VDWELL" "VD33APST" "VDD5V" "TAVD33" "VD33PST" "AVDD" "TAVDD" "TAVD33PST" "TAVDDPST" "AVD33B" "VDD" "AVD33G" "DVDD" "AVDDG" "AVDDB" "VDDG" "VDDPST" "VD33REF" "VD33" "AVD33R" "VDDSA")  

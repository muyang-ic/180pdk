 d_and2_and1_and1 =  geomAnd(d_and2_and1 oddn26_d3)  
 d_and2_and1_and11 =  geomAnd(d_and2_and1_and1 oddn27_d4)  
 d_and2_and1_and111 =  geomAnd(d_and2_and1_and11 oddn28_d5)  
 d_and2_and1_and1111 =  geomAnd(d_and2_and1_and111 oddn29_d6)  
 d_and2_and1_and11111 =  geomAnd(d_and2_and1_and1111 oddn210_d7)  
 d_and2_and1_and111111 =  geomAnd(d_and2_and1_and11111 oddn211_d8)  
 d_and2_and1_and1111111 =  geomAnd(d_and2_and1_and111111 oddn212_d9)  
 oddn213_err2 = geomButtOrOver( oddn21_d d_and2_and1_and1111111  )   
 err2_not2 =  geomAndNot(oddn213_err2 OD_EXC)  
 oddn214_f2 = drc( err2_not2  area >= 62500 ) 
 oddn215_f = geomOr(oddn23_f1 oddn214_f2)  
 processCoverage( 
	backup
         
 measure(
          windowSize = 500 stepSize = 250
     chip_not_od_exc_den4_pc =  calculate(
           if( area(oddn215_f) > 0   then
             area(ODx) / area(CHIP_NOT_OD_EXC)
                    
               else
                    -1
             )
            ) 
            chip_not_od_exc_den4 = output( chip_not_od_exc_den4_pc squareSize = 500  keep > OD_R_2)

         ) ;end measure
 ) ;end processCoverage
 errorLayer( chip_not_od_exc_den4 
	"OD.R.2  {OD OR DOD} local density (maximum) over window 500um x 500um stepping 250um <= 80%  ") ;



if(FULL_CHIP==1 then
    let( /* OD.R.3 */ (RULE_COMMENT)

        sprintf(RULE_COMMENT "OD.R.3  Minimum {OD or DOD} density across full chip >= %f" OD_R_3)    
        processCoverage(withinLayer(CHIP) measure(DENSITY_OUT_33=layerList(ODx)))
        errorLayer(geomGetCoverage(DENSITY_OUT_33 0<=keep<OD_R_3) RULE_COMMENT)
    )

    let( /* OD.R.4 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "OD.R.4  Maximum {OD or DOD} density across full chip <= %f" OD_R_4)    
        processCoverage(withinLayer(CHIP) measure(DENSITY_OUT_34=layerList(ODx)))
        errorLayer(geomGetCoverage(DENSITY_OUT_34 keep>OD_R_4) RULE_COMMENT)
    )

)

if(FULL_CHIP==1 then
    if(Recommend==1 then
        let( /* DOD.R.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "DOD.R.1  DOD is required."
                "The DOD CAD layer (TSMC default, 3:1)must be different from the OD CAD layer."
            )  )    
            errorLayer(geomAndNot(CHIP_CHAMFERED geomButtOrOver(CHIP_CHAMFERED DOD)) RULE_COMMENT)
        )

    )

    let( /* DOD.R.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "DOD.R.2  DOD inside chip corner stress relief area is not allowed." )    
        errorLayer(geomButtOrOver(DOD EMPTY_AREA) RULE_COMMENT)
    )

)

let( /* DOD.R.3 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DOD.R.3  The only shapes allowed are square(or rectangular) and solid" )    
    errorLayer(geomHoles(DOD) RULE_COMMENT)
    errorLayer(geomAndNot(DOD geomGetRectangle(DOD swap)) RULE_COMMENT)
)

;; DUMMY PO RULE 
;; ================ 
;; DPO VARIABLE 

let( /* DPO.W.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DPO.W.1  Minimum width >= %f um" DPO_W_1)    
    drc(DPO width<DPO_W_1 shielded withCornerTouch withNoAngledEdgeTolerance RULE_COMMENT)
)

let( /* DPO.S.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DPO.S.1  Minimum space between two DPO >= %f um" DPO_S_1)    
    drc(DPO 0<sepNotch<DPO_S_1 shielded withIntersection withSingularPoint RULE_COMMENT)
)

let( /* DPO.C.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DPO.C.1  Minimum clearance from DPO to OD (overlap is not allowed) >= %f um" DPO_C_1)    
    drc(DPO ODi sep<DPO_C_1 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DPO ODi) RULE_COMMENT)
)

let( /* DPO.C.2 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DPO.C.2  Minimum clearance from DPO to PO (overlap is not allowed) >= %f um" DPO_C_2)    
    drc(DPO POLYi sep<DPO_C_2 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DPO POLYi) RULE_COMMENT)
)

let( /* DPO.C.4 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DPO.C.4  Minimum clearance from DPO to FW (overlap is not allowed) >= %f um" DPO_C_4)    
    drc(DPO FWi sep<DPO_C_4 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DPO FWi) RULE_COMMENT)
)

let( /* DPO.C.5 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DPO.C.5  Minimum clearance from DPO to LMARK (overlap is not allowed) >= %f um" DPO_C_5)    
    drc(DPO LMARK sep<DPO_C_5 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DPO LMARK) RULE_COMMENT)
)

let( /* DPO.C.6 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DPO.C.6  Minimum clearance from DPO to LOGO (overlap is not allowed) >= %f um" DPO_C_6)    
    drc(DPO LOGO sep<DPO_C_6 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DPO LOGO) RULE_COMMENT)
)

let( /* DPO.C.7 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DPO.C.7  Minimum clearance from DPO to INDDMY (overlap is not allowed) >= %f um" DPO_C_7)    
    drc(DPO INDDMY sep<DPO_C_7 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DPO INDDMY) RULE_COMMENT)
)

let( /* DPO.C.9 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DPO.C.9  Minimum clearance from DPO to DOD (overlap is not allowed) >= %f um" DPO_C_9)    
    drc(DPO DOD sep<DPO_C_9 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DPO DOD) RULE_COMMENT)
)

let( /* DPO.C.12 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DPO.C.12  Minimum clearance from DPO to BJTDMY (overlap is not allowed) >= %f um" DPO_C_12)    
    drc(DPO BJTDUMMY sep<DPO_C_12 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DPO BJTDUMMY) RULE_COMMENT)
)

let( /* DPO.C.13 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DPO.C.13  Minimum clearance from DPO to DTi (overlap is not allowed) >= %f um" DPO_C_13)    
    drc(DPO DTi sep<DPO_C_13 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DPO DTi) RULE_COMMENT)
)

let( /* DPO.C.14 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DPO.C.14  Minimum clearance from DPO to FLASH (overlap is not allowed) >= %f um" DPO_C_14)    
    drc(DPO FLASH sep<DPO_C_14 shielded withIntersection withSingularPoint RULE_COMMENT)
    errorLayer(geomAnd(DPO FLASH) RULE_COMMENT)
)

if(FULL_CHIP==1 then
    let( /* DPO.E.1 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "DPO.E.1  Minimum extension of chip edge beyond DPO >= %f" DPO_E_1)    
        errorLayer(geomAndNot(DPO geomSize(CHIP_CHAMFERED (-DPO_E_1) noClipAcute)) RULE_COMMENT)
    )

)

let( /* DPO.A.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DPO.A.1  Minimum area of DPO >= %f" DPO_A_1)    
    drc(DPO area<DPO_A_1 RULE_COMMENT) 
)

if(FULL_CHIP==1 then
    let( /* PO.R.5 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "PO.R.5  Minimum {PO OR DPO} density across full chip >= %f" PO_R_5)    
        processCoverage(withinLayer(CHIP) measure(DENSITY_OUT_35=layerList(ALL_PO)))
        errorLayer(geomGetCoverage(DENSITY_OUT_35 0<=keep<PO_R_5) RULE_COMMENT)
    )

    if(Recommend==1 then
        let( /* DPO.R.1 */ (RULE_COMMENT)
            sprintf(RULE_COMMENT strcat(
                "DPO.R.1  DPO is required."
                "The DPO CAD layer (TSMC default, 13:1)must be different from the PO CAD layer."
            )  )    
            errorLayer(geomAndNot(CHIP_CHAMFERED geomButtOrOver(CHIP_CHAMFERED DPO)) RULE_COMMENT)
        )

    )

    let( /* DPO.R.2 */ (RULE_COMMENT)
        sprintf(RULE_COMMENT "DPO.R.2  DPO inside chip corner stress relief area is not allowed." )    
        errorLayer(geomButtOrOver(DPO EMPTY_AREA) RULE_COMMENT)
    )

)

let( /* DPO.R.3 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DPO.R.3  The only shapes allowed are square (or rectangular) and solid" )    
    errorLayer(geomHoles(DPO) RULE_COMMENT)
    errorLayer(geomAndNot(DPO geomGetRectangle(DPO swap)) RULE_COMMENT)
)

;;  Matching check 
;; ================ 

POLY_PAIR_CHECK=geomButtOrOver(geomButtOrOver(POLY OD) MATCHING)  
POLY_PAIR_CHECK_G_M1=geomInside(POLY_PAIR_CHECK M1xd)  
POLY_PAIR_CHECK_B_M1=geomStraddle(POLY_PAIR_CHECK M1xd)  
POLY_PAIR_CHECK_O_M1=geomOutside(POLY_PAIR_CHECK M1xd)  
POLY_PAIR_CHECK_G_M2=geomInside(POLY_PAIR_CHECK M2xd)  
POLY_PAIR_CHECK_B_M2=geomStraddle(POLY_PAIR_CHECK M2xd)  
POLY_PAIR_CHECK_O_M2=geomOutside(POLY_PAIR_CHECK M2xd)  
POLY_PAIR_CHECK_G_M3=geomInside(POLY_PAIR_CHECK M3xd)  
POLY_PAIR_CHECK_B_M3=geomStraddle(POLY_PAIR_CHECK M3xd)  
POLY_PAIR_CHECK_O_M3=geomOutside(POLY_PAIR_CHECK M3xd)  
POLY_PAIR_CHECK_G_M4=geomInside(POLY_PAIR_CHECK M4xd)  
POLY_PAIR_CHECK_B_M4=geomStraddle(POLY_PAIR_CHECK M4xd)  
POLY_PAIR_CHECK_O_M4=geomOutside(POLY_PAIR_CHECK M4xd)  
POLY_PAIR_CHECK_G_M5=geomInside(POLY_PAIR_CHECK M5xd)  
POLY_PAIR_CHECK_B_M5=geomStraddle(POLY_PAIR_CHECK M5xd)  
POLY_PAIR_CHECK_O_M5=geomOutside(POLY_PAIR_CHECK M5xd)  
POLY_PAIR_CHECK_G_MD=geomInside(POLY_PAIR_CHECK MDxd)  
POLY_PAIR_CHECK_B_MD=geomStraddle(POLY_PAIR_CHECK MDxd)  
POLY_PAIR_CHECK_O_MD=geomOutside(POLY_PAIR_CHECK MDxd)  

let( /* AN.R.40_M1 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT "AN.R.40_M1  differential pair fully covered by metal layer and the other is not fully covered is not allowed" )    
    A=geomButtOrOver(MATCHING POLY_PAIR_CHECK_G_M1)  
    errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_B_M1) RULE_COMMENT)
    errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_O_M1) RULE_COMMENT)
)

let( /* AN.R.40_M2 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT "AN.R.40_M2  differential pair fully covered by metal layer and the other is not fully covered is not allowed" )    
    A=geomButtOrOver(MATCHING POLY_PAIR_CHECK_G_M2)  
    errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_B_M2) RULE_COMMENT)
    errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_O_M2) RULE_COMMENT)
)

let( /* AN.R.40_M3 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT "AN.R.40_M3  differential pair fully covered by metal layer and the other is not fully covered is not allowed" )    
    A=geomButtOrOver(MATCHING POLY_PAIR_CHECK_G_M3)  
    errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_B_M3) RULE_COMMENT)
    errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_O_M3) RULE_COMMENT)
)

let( /* AN.R.40_M4 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT "AN.R.40_M4  differential pair fully covered by metal layer and the other is not fully covered is not allowed" )    
    A=geomButtOrOver(MATCHING POLY_PAIR_CHECK_G_M4)  
    errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_B_M4) RULE_COMMENT)
    errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_O_M4) RULE_COMMENT)
)

let( /* AN.R.40_M5 */ (RULE_COMMENT A)
    sprintf(RULE_COMMENT "AN.R.40_M5  differential pair fully covered by metal layer and the other is not fully covered is not allowed" )    
    A=geomButtOrOver(MATCHING POLY_PAIR_CHECK_G_M5)  
    errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_B_M5) RULE_COMMENT)
    errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_O_M5) RULE_COMMENT)
)

if(Recommend==1 then
    let( /* AN.R.41_M1 */ (RULE_COMMENT A)
        sprintf(RULE_COMMENT "AN.R.41_M1  For the critical differential pair inside MATCHING layer, unbalance metal shielding is not allowed" )    
        A=geomButtOrOver(MATCHING POLY_PAIR_CHECK_B_M1)  
        errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_O_M1) RULE_COMMENT)
        errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_B_M1 keep>1) RULE_COMMENT)
    )

    let( /* AN.R.41_M2 */ (RULE_COMMENT A)
        sprintf(RULE_COMMENT "AN.R.41_M2  For the critical differential pair inside MATCHING layer, unbalance metal shielding is not allowed" )    
        A=geomButtOrOver(MATCHING POLY_PAIR_CHECK_B_M2)  
        errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_O_M2) RULE_COMMENT)
        errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_B_M2 keep>1) RULE_COMMENT)
    )

    let( /* AN.R.41_M3 */ (RULE_COMMENT A)
        sprintf(RULE_COMMENT "AN.R.41_M3  For the critical differential pair inside MATCHING layer, unbalance metal shielding is not allowed" )    
        A=geomButtOrOver(MATCHING POLY_PAIR_CHECK_B_M3)  
        errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_O_M3) RULE_COMMENT)
        errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_B_M3 keep>1) RULE_COMMENT)
    )

    let( /* AN.R.41_M4 */ (RULE_COMMENT A)
        sprintf(RULE_COMMENT "AN.R.41_M4  For the critical differential pair inside MATCHING layer, unbalance metal shielding is not allowed" )    
        A=geomButtOrOver(MATCHING POLY_PAIR_CHECK_B_M4)  
        errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_O_M4) RULE_COMMENT)
        errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_B_M4 keep>1) RULE_COMMENT)
    )

    let( /* AN.R.41_M5 */ (RULE_COMMENT A)
        sprintf(RULE_COMMENT "AN.R.41_M5  For the critical differential pair inside MATCHING layer, unbalance metal shielding is not allowed" )    
        A=geomButtOrOver(MATCHING POLY_PAIR_CHECK_B_M5)  
        errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_O_M5) RULE_COMMENT)
        errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_B_M5 keep>1) RULE_COMMENT)
    )

)

if(CHECK_ALRDL==1 then
    let( /* AN.R.40_MD */ (RULE_COMMENT A)
        sprintf(RULE_COMMENT "AN.R.40_MD  differential pair fully covered by metal layer and the other is not fully covered is not allowed" )    
        A=geomButtOrOver(MATCHING POLY_PAIR_CHECK_G_MD)  
        errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_B_MD) RULE_COMMENT)
        errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_O_MD) RULE_COMMENT)
    )

    if(Recommend==1 then
        let( /* AN.R.41_MD */ (RULE_COMMENT A)
            sprintf(RULE_COMMENT "AN.R.41_MD  For the critical differential pair inside MATCHING layer, unbalance metal shielding is not allowed" )    
            A=geomButtOrOver(MATCHING POLY_PAIR_CHECK_B_MD)  
            errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_O_MD) RULE_COMMENT)
            errorLayer(geomButtOrOver(A POLY_PAIR_CHECK_B_MD keep>1) RULE_COMMENT)
        )

    )

)

let( /* DRM.R.1 */ (RULE_COMMENT)
    sprintf(RULE_COMMENT "DRM.R.1  DRM.R.1 is a warning message to remind the users to check the related DRMs. Please refer to DRM.R.1 in the DRM for details." )    
    errorLayer(geomCat(CHIPx) RULE_COMMENT)
)

)
